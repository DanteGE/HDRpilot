<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>HDRpilot</AssemblyName>
    <RootNamespace>HdrPilot.App</RootNamespace>
    <UseWPF>true</UseWPF>
    <!-- Nur für NotifyIcon (Tray) und die Symbol-Extraktion aus EXE-Dateien. -->
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\HdrPilot.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- WFO0003 betrifft WinForms-Apps; dies ist eine WPF-App, deren DPI-Modus (PerMonitorV2) im Manifest steht. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF und WinForms haben gleichnamige Typen (Application, MessageBox): WinForms nur explizit verwenden. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HdrPilot.Core\HdrPilot.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- Hintergrund-App: Der GC gibt belegten Speicher eher zurück (gemessen rund 18 MB weniger privater Speicher, E59). -->
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\HdrPilot.ico" />
  </ItemGroup>

  <!-- Oberflächentexte: Resources\*.resx (neutral = Deutsch), stark typisierte Klassen werden beim Build erzeugt.
       Englisch kommt später als Resources\*.en.resx dazu. -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\*.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>HdrPilot.App.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>%(Filename)</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)%(Filename).Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <!--
    WPF übersetzt vor dem eigentlichen Build eine temporäre Assembly (Projekt *_wpftmp), die alle C#-Dateien braucht.
    Deshalb werden die Ressourcen-Klassen vorher erzeugt und dem temporären Projekt ausdrücklich mitgegeben.
    Im Hauptprojekt fügt GenerateResource sie selbst hinzu (sonst doppelt). Der Pfad ist ausgeschrieben statt
    $(IntermediateOutputPath): Unter Linux (dotnet build -p:EnableWindowsTargeting=true) hängt das SDK im temporären
    Projekt das Zielframework ein zweites Mal an (obj/Debug/net10.0-windows/net10.0-windows/), unter Windows nicht.
  -->
  <Target Name="HpGenerateResourceClassesEarly" BeforeTargets="MarkupCompilePass1" DependsOnTargets="PrepareResourceNames;ResolveReferences;CoreResGen" />
  <ItemGroup Condition="$(MSBuildProjectName.EndsWith('_wpftmp'))">
    <Compile Include="$(BaseIntermediateOutputPath)$(Configuration)\$(TargetFramework)\*Strings.Designer.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HdrPilot.Tests" />
  </ItemGroup>

</Project>
