<infra:ChromeWindow x:Class="HdrPilot.App.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:HdrPilot.App.Infrastructure"
                    xmlns:res="clr-namespace:HdrPilot.App.Resources"
                    xmlns:lib="clr-namespace:HdrPilot.App.Views.Library"
                    xmlns:vm="clr-namespace:HdrPilot.App.ViewModels.Library"
                    Title="{x:Static res:LibraryStrings.Window_Title}"
                    AutomationProperties.AutomationId="MainWindow"
                    AutomationProperties.Name="{x:Static res:LibraryStrings.Window_Title}"
                    Width="1460" Height="800" MinWidth="1000" MinHeight="620"
                    WindowStartupLocation="CenterScreen">
    <infra:ChromeWindow.Resources>
        <!--
            Eigenes Symbol (E86): Rechtsklick auf ein Spiel (die Zeile wird dabei gewählt) oder Klick auf das große Symbol im
            Detailbereich. Das Menü wirkt auf das gewählte Spiel; seinen DataContext (die Bibliothek) bekommt es über Tag des
            Elements, an dem es aufgeht. Je Verwendung eine Instanz (x:Shared): eine für alle Zeilen (über den Zeilenstil), eine
            für das große Symbol. Eine Vorlage bekommt es erst beim Öffnen.
        -->
        <ContextMenu x:Key="GameIconMenu" x:Shared="False" Style="{StaticResource Lib.ContextMenu}"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                     AutomationProperties.AutomationId="GameIconMenu" AutomationProperties.Name="{x:Static res:LibraryStrings.Icon_MenuName}">
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Icon_Change}" Command="{Binding ChangeIconCommand}"
                      AutomationProperties.AutomationId="ChangeIconMenuItem" AutomationProperties.Name="{x:Static res:LibraryStrings.Icon_Change}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xEB9F;" FontSize="15" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Icon_Reset}" Command="{Binding ResetIconCommand}"
                      AutomationProperties.AutomationId="ResetIconMenuItem" AutomationProperties.Name="{x:Static res:LibraryStrings.Icon_Reset}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE777;" FontSize="15" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Zeile der Spieleliste mit Kontextmenü auf der ganzen Fläche -->
        <Style x:Key="GameRowWithMenu" TargetType="ListBoxItem" BasedOn="{StaticResource Lib.GameRow}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="ContextMenu" Value="{StaticResource GameIconMenu}" />
        </Style>

        <!-- Zeile der Spieleliste -->
        <DataTemplate x:Key="GameRowTemplate" DataType="{x:Type vm:GameItemViewModel}">
            <Grid x:Name="Row" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="40" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid x:Name="IconBox" Width="40" Height="40">
                    <Border Style="{StaticResource Lib.SourceTile}" />
                    <TextBlock x:Name="FallbackGlyph" Style="{StaticResource Lib.SourceGlyph}" />
                    <Image Source="{Binding Icon}" Width="32" Height="32" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
                <StackPanel x:Name="Texts" Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                    <!-- Name, dahinter „AUTO HDR“ (Windows Auto HDR an, nur Anzeige, geschaltet wird in den Details); der Name kürzt sich -->
                    <lib:NameWithBadgesPanel>
                        <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Hp.Brush.Text}" />
                        <Border Style="{StaticResource Lib.AutoHdrBadge}" Margin="8,0,0,0"
                                Visibility="{Binding AutoHdr, Converter={StaticResource Lib.BoolToVisibility}}"
                                ToolTip="{x:Static res:LibraryStrings.Badge_AutoHdrTooltip}">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource Hp.Color.Accent3}" Opacity="0.3" />
                            </Border.Background>
                            <Border.BorderBrush>
                                <SolidColorBrush Color="{DynamicResource Hp.Color.Accent3}" Opacity="0.85" />
                            </Border.BorderBrush>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE706;" FontSize="9" Margin="0,0,4,0" />
                                <!-- Kennung am Text: ein Border hat keinen Automation-Peer, UI-Automation sähe es sonst nicht -->
                                <TextBlock Text="{x:Static res:LibraryStrings.Badge_AutoHdr}" VerticalAlignment="Center"
                                           AutomationProperties.AutomationId="AutoHdrBadge"
                                           AutomationProperties.Name="{x:Static res:LibraryStrings.Badge_AutoHdrTooltip}" />
                            </StackPanel>
                        </Border>
                    </lib:NameWithBadgesPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock Text="{Binding SourceName}" Style="{StaticResource Lib.SourceText}" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <!-- HDR laut PCGamingWiki: „HDR“ oder „HDR*“ (eingeschränkt) -->
                        <Border Style="{StaticResource Lib.HdrBadge}" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding HasHdrBadge, Converter={StaticResource Lib.BoolToVisibility}}"
                                ToolTip="{Binding HdrBadgeTooltip}"
                                AutomationProperties.AutomationId="HdrSupportBadge" AutomationProperties.Name="{Binding HdrBadgeTooltip}">
                            <TextBlock Text="{Binding HdrBadgeText}" FontSize="9.5" FontWeight="Bold" />
                        </Border>
                        <Border Style="{StaticResource Hp.Badge.New}" Margin="8,0,0,0" Padding="6,0,6,1" VerticalAlignment="Center"
                                Visibility="{Binding IsNew, Converter={StaticResource Lib.BoolToVisibility}}">
                            <TextBlock Text="{x:Static res:LibraryStrings.Badge_New}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextOnAccent}"
                                       AutomationProperties.AutomationId="NewBadge" />
                        </Border>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsRunning, Converter={StaticResource Lib.BoolToVisibility}}">
                            <Ellipse Width="7" Height="7" Fill="{DynamicResource Hp.Brush.HdrOn}" VerticalAlignment="Center" />
                            <TextBlock Text="{x:Static res:LibraryStrings.Badge_Running}" FontSize="12" Margin="5,0,0,0" Foreground="{DynamicResource Hp.Brush.AccentSolid}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                    Visibility="{Binding IsInstalled, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}">
                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7BA;" FontSize="11" Foreground="{DynamicResource Hp.Brush.Warning}" />
                            <TextBlock Text="{x:Static res:LibraryStrings.Badge_NotInstalled}" FontSize="12" Margin="5,0,0,0" Foreground="{DynamicResource Hp.Brush.Warning}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
                <CheckBox Grid.Column="2" Style="{StaticResource Lib.RowToggleSwitch}" IsChecked="{Binding HdrAuto}" VerticalAlignment="Center"
                          AutomationProperties.AutomationId="HdrAutoToggle"
                          AutomationProperties.Name="{x:Static res:LibraryStrings.Row_HdrAutoName}"
                          ToolTip="{x:Static res:LibraryStrings.Row_HdrAutoName}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                    <Setter TargetName="IconBox" Property="Opacity" Value="0.45" />
                    <Setter TargetName="Texts" Property="Opacity" Value="0.6" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Quellen-Filter -->
        <DataTemplate x:Key="SourceOptionTemplate" DataType="{x:Type vm:SourceFilterOption}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" CornerRadius="8" Padding="7,1,7,2" Margin="10,0,0,0" VerticalAlignment="Center"
                        Background="{DynamicResource Hp.Brush.SurfaceSelected}">
                    <TextBlock Text="{Binding Count}" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                </Border>
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <!-- Sortierung -->
        <DataTemplate x:Key="SortOptionTemplate" DataType="{x:Type vm:SortOption}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Lib.Glyph}" Text="{Binding Glyph}" FontSize="13" Margin="0,0,9,0"
                           Foreground="{DynamicResource Hp.Brush.AccentSolid}" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <!-- Bildschirm-Auswahl -->
        <DataTemplate x:Key="DisplayOptionTemplate" DataType="{x:Type vm:DisplayOptionViewModel}">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Style="{StaticResource Lib.Glyph}" Text="&#xE7F4;" Margin="0,0,10,0"
                           Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                <TextBlock x:Name="Detail" DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"
                           Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGlobal}" Value="True">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE713;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHdrCapable}" Value="True">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Hp.Brush.Warning}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- EXE-Datei mit Herkunft -->
        <DataTemplate x:Key="ExecutableTemplate" DataType="{x:Type vm:ExecutableItemViewModel}">
            <Grid x:Name="Root">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xECAA;" FontSize="16" Margin="2,0,10,0" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                <StackPanel Grid.Column="1">
                    <DockPanel LastChildFill="True">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Hp.Badge}" Padding="6,0,6,1" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding OriginText}" FontSize="10.5" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                        </Border>
                        <TextBlock x:Name="FileName" Text="{Binding FileName}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"
                                   Foreground="{DynamicResource Hp.Brush.Text}" ToolTip="{Binding Path}" />
                    </DockPanel>
                    <TextBlock Text="{Binding Folder}" FontSize="11.5" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Hp.Brush.TextSecondary}" ToolTip="{Binding Path}"
                               Visibility="{Binding Folder, Converter={StaticResource Lib.BoolToVisibility}}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInactive}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                    <Setter TargetName="FileName" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Vorschlag aus einem Suchordner -->
        <DataTemplate x:Key="CandidateTemplate" DataType="{x:Type vm:CandidateItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="34" Height="34">
                    <Border CornerRadius="9" Background="{DynamicResource Hp.Brush.Source.Manual}" Opacity="0.16" />
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE8B7;" FontSize="15" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Hp.Brush.Source.Manual}" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.Text}" />
                    <TextBlock Text="{Binding DetailText}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.TextSecondary}" ToolTip="{Binding Folder}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Lib.SmallGhostButton}" VerticalAlignment="Center"
                        Command="{Binding DataContext.AddCandidateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                        AutomationProperties.AutomationId="AddCandidateButton"
                        AutomationProperties.Name="{x:Static res:LibraryStrings.Candidate_Add}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,7,0" />
                        <TextBlock Text="{x:Static res:LibraryStrings.Candidate_Add}" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Fehler eines Scanners -->
        <DataTemplate x:Key="ScanErrorTemplate" DataType="{x:Type vm:ScanErrorItem}">
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Hp.Brush.Text}" />
                <TextBlock Text="{Binding Path}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.TextSecondary}"
                           ToolTip="{Binding Path}" Visibility="{Binding HasPath, Converter={StaticResource Lib.BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>
    </infra:ChromeWindow.Resources>

    <Grid x:Name="Root" Margin="24,0,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Kopf: Titel, Kennzahlen, HDR-Status und Schnellaktionen -->
        <Grid x:Name="HeaderArea">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Hp.Text.Title}" Text="{x:Static res:LibraryStrings.Header_Title}" />
                <Border Width="56" Height="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="1,7,0,10" Background="{DynamicResource Hp.Brush.Accent}" />
                <StackPanel Orientation="Horizontal">
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Hp.Brush.TextSecondary}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding TotalText}" Margin="7,0,0,0" FontSize="13" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,18,0">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Hp.Brush.HdrOn}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding HdrAutoText}" Margin="7,0,0,0" FontSize="13" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Visibility="{Binding NewCount, Converter={StaticResource Lib.BoolToVisibility}}">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource Hp.Brush.AccentSolid}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding NewText}" Margin="7,0,0,0" FontSize="13" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- HDR-Status der Zielbildschirme: leuchtet, solange HDR an ist (Puls nur bei aktivem Fenster) -->
                <Grid x:Name="HdrPill" MinWidth="230" VerticalAlignment="Center">
                    <Border x:Name="HdrPillTint" CornerRadius="14" Background="{DynamicResource Hp.Brush.HdrOn}" Opacity="0" />
                    <Border CornerRadius="14" BorderThickness="1" Padding="14,8,18,9" Background="{DynamicResource Hp.Brush.Surface}">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Border}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsHdrOn}" Value="True">
                                        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel Orientation="Horizontal">
                            <Grid Width="16" Height="16" VerticalAlignment="Center">
                                <Ellipse x:Name="HdrHalo" Width="16" Height="16" Fill="{DynamicResource Hp.Brush.HdrOn}" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <Ellipse.RenderTransform>
                                        <ScaleTransform ScaleX="1" ScaleY="1" />
                                    </Ellipse.RenderTransform>
                                    <Ellipse.Effect>
                                        <BlurEffect Radius="6" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <Ellipse x:Name="HdrCore" Width="10" Height="10">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Fill" Value="{DynamicResource Hp.Brush.HdrOff}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsHdrOn}" Value="True">
                                                    <Setter Property="Fill" Value="{DynamicResource Hp.Brush.HdrOn}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                            </Grid>
                            <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource Lib.Overline}" Text="{x:Static res:LibraryStrings.Hdr_Overline}" />
                                <TextBlock Text="{Binding HdrStatusText}" FontSize="14" FontWeight="SemiBold" Margin="0,1,0,0" MaxWidth="320" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Hp.Brush.Text}" ToolTip="{Binding HdrStatusText}"
                                           AutomationProperties.AutomationId="HdrStatus" />
                                <TextBlock Text="{Binding ActiveSessionText}" FontSize="11.5" Margin="0,1,0,0" MaxWidth="320" TextTrimming="CharacterEllipsis"
                                           Foreground="{DynamicResource Hp.Brush.AccentSolid}"
                                           Visibility="{Binding HasActiveSession, Converter={StaticResource Lib.BoolToVisibility}}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <Button Style="{StaticResource Lib.ToolbarButton}" Margin="12,0,0,0" Command="{Binding ToggleHdrCommand}"
                        AutomationProperties.AutomationId="ToggleHdrButton" AutomationProperties.Name="{Binding HdrToggleText}"
                        ToolTip="{x:Static res:LibraryStrings.Hdr_ToggleTooltip}" ToolTipService.ShowOnDisabled="True">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE706;" Margin="0,0,8,0" />
                        <TextBlock Text="{Binding HdrToggleText}" />
                    </StackPanel>
                </Button>
                <ToggleButton Style="{StaticResource Lib.PauseChip}" Margin="10,0,0,0" IsChecked="{Binding IsPaused}"
                              AutomationProperties.AutomationId="PauseToggle" AutomationProperties.Name="{x:Static res:LibraryStrings.Pause_Name}"
                              ToolTip="{x:Static res:LibraryStrings.Pause_Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE769;" Margin="0,0,8,0" />
                        <TextBlock>
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{x:Static res:LibraryStrings.Pause_Label}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsPaused}" Value="True">
                                            <Setter Property="Text" Value="{x:Static res:LibraryStrings.Pause_Active}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </ToggleButton>
                <Button Style="{StaticResource Lib.ToolbarIconButton}" Margin="10,0,0,0" Content="&#xE713;" Command="{Binding OpenSettingsCommand}"
                        AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Settings_Name}"
                        ToolTip="{x:Static res:LibraryStrings.Settings_Name}" />
            </StackPanel>
        </Grid>

        <!--
            Werkzeugleiste: Suche, Filter und Sortierung, Aktionen. Passt sich der Fensterbreite an (MainWindow.xaml.cs):
            breit alles in einer Zeile; etwas schmaler „Neu einlesen“ nur als Symbol; schmal Filter und Sortierung in
            einer zweiten Zeile unter der Suche.
        -->
        <Grid x:Name="ToolbarArea" Grid.Row="1" Margin="0,22,0,0">
            <Grid.ColumnDefinitions>
                <!-- Mindestbreite: Platzhalter „Spiele durchsuchen …   Strg+F“ bleibt lesbar -->
                <ColumnDefinition Width="*" MinWidth="260" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <Grid>
                <TextBox x:Name="SearchBox" Style="{StaticResource Lib.SearchBox}" Tag="{x:Static res:LibraryStrings.Search_Placeholder}"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="{x:Static res:LibraryStrings.Search_Name}" />
                <Button Style="{StaticResource Lib.LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0"
                        Foreground="{DynamicResource Hp.Brush.TextMuted}" Command="{Binding ClearSearchCommand}"
                        Visibility="{Binding HasSearchText, Converter={StaticResource Lib.BoolToVisibility}}"
                        AutomationProperties.AutomationId="ClearSearchButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Search_Clear}"
                        ToolTip="{x:Static res:LibraryStrings.Search_Clear}">
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE711;" FontSize="11" Margin="4" />
                </Button>
            </Grid>

            <StackPanel x:Name="FilterGroup" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Left">
                <ComboBox x:Name="SourceFilter" Width="196" Margin="10,0,0,0" Style="{StaticResource Lib.ComboBox}"
                          ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" ItemTemplate="{StaticResource SourceOptionTemplate}"
                          ItemContainerStyle="{StaticResource Lib.SourceComboBoxItem}"
                          AutomationProperties.AutomationId="SourceFilter" AutomationProperties.Name="{x:Static res:LibraryStrings.Filter_SourceName}" />
                <ComboBox x:Name="SortOrder" Width="206" Margin="8,0,0,0" Style="{StaticResource Lib.ComboBox}"
                          ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" ItemTemplate="{StaticResource SortOptionTemplate}"
                          AutomationProperties.AutomationId="SortOrder" AutomationProperties.Name="{x:Static res:LibraryStrings.Sort_Name}"
                          ToolTip="{x:Static res:LibraryStrings.Sort_Name}" />
                <ToggleButton Margin="10,0,0,0" Style="{StaticResource Lib.Chip}" IsChecked="{Binding OnlySelected}"
                              AutomationProperties.AutomationId="OnlySelectedToggle" AutomationProperties.Name="{x:Static res:LibraryStrings.Filter_OnlySelectedName}"
                              ToolTip="{x:Static res:LibraryStrings.Filter_OnlySelectedName}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE706;" FontSize="13" Margin="0,0,7,0" />
                        <TextBlock Text="{x:Static res:LibraryStrings.Filter_OnlySelected}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Margin="8,0,0,0" Style="{StaticResource Lib.Chip}" IsChecked="{Binding OnlyNew}"
                              AutomationProperties.AutomationId="OnlyNewToggle" AutomationProperties.Name="{x:Static res:LibraryStrings.Filter_OnlyNewName}"
                              ToolTip="{x:Static res:LibraryStrings.Filter_OnlyNewName}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE735;" FontSize="12" Margin="0,0,7,0" />
                        <TextBlock Text="{x:Static res:LibraryStrings.Filter_OnlyNew}" />
                    </StackPanel>
                </ToggleButton>
                <ToggleButton Margin="8,0,0,0" Style="{StaticResource Lib.Chip}" IsChecked="{Binding OnlyHdrCapable}"
                              AutomationProperties.AutomationId="OnlyHdrCapableToggle" AutomationProperties.Name="{x:Static res:LibraryStrings.Filter_OnlyHdrCapableName}"
                              ToolTip="{x:Static res:LibraryStrings.Filter_OnlyHdrCapableName}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE790;" FontSize="12" Margin="0,0,7,0" />
                        <TextBlock Text="{x:Static res:LibraryStrings.Filter_OnlyHdrCapable}" />
                    </StackPanel>
                </ToggleButton>
            </StackPanel>

            <StackPanel x:Name="ActionGroup" Grid.Column="2" Orientation="Horizontal">
                <Button x:Name="MarkAllSeenButton" Margin="18,0,0,0" Style="{StaticResource Lib.ToolbarIconButton}" Content="&#xE890;" Command="{Binding MarkAllSeenCommand}"
                        AutomationProperties.AutomationId="MarkAllSeenButton" AutomationProperties.Name="{x:Static res:LibraryStrings.MarkAllSeen_Name}"
                        ToolTip="{x:Static res:LibraryStrings.MarkAllSeen_Name}" ToolTipService.ShowOnDisabled="True" />
                <Button Margin="8,0,0,0" Style="{StaticResource Lib.ToolbarButton}" Command="{Binding RescanCommand}"
                        AutomationProperties.AutomationId="RescanButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Rescan_Button}"
                        ToolTip="{x:Static res:LibraryStrings.Rescan_Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="RescanGlyph" Style="{StaticResource Lib.Glyph}" Text="&#xE72C;" FontSize="13" Margin="0,0,8,0" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                        <!-- Schmales Fenster: nur das Symbol (Name und Tooltip bleiben) -->
                        <TextBlock x:Name="RescanText">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{x:Static res:LibraryStrings.Rescan_Button}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsScanning}" Value="True">
                                            <Setter Property="Text" Value="{x:Static res:LibraryStrings.Rescan_Running}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
                <Button Margin="8,0,0,0" Style="{StaticResource Lib.AccentButton}" Height="40" Padding="16,0" Command="{Binding AddGameCommand}"
                        AutomationProperties.AutomationId="AddGameButton" AutomationProperties.Name="{x:Static res:LibraryStrings.AddGame_Button}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static res:LibraryStrings.AddGame_Button}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Fehler je Scanner (nur bei Fehlern) -->
        <Expander x:Name="ScanErrorsExpander" Grid.Row="2" Margin="0,14,0,0" Style="{StaticResource Lib.WarningExpander}" Header="{Binding ScanErrorsHeader}"
                  Visibility="{Binding HasScanErrors, Converter={StaticResource Lib.BoolToVisibility}}"
                  AutomationProperties.AutomationId="ScanErrors" AutomationProperties.Name="{Binding ScanErrorsHeader}">
            <!-- Begrenzte Höhe: viele Fehler dürfen die Spieleliste nicht verdrängen -->
            <ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                <ItemsControl ItemsSource="{Binding ScanErrors}" ItemTemplate="{StaticResource ScanErrorTemplate}" Margin="0,0,8,0" />
            </ScrollViewer>
        </Expander>

        <!--
            Liste und Detailbereich: beide wachsen mit dem Fenster (Sternbreiten), der Trenner dazwischen verschiebt die
            Aufteilung. Den Anteil des Detailbereichs setzt und merkt MainWindow.xaml.cs (AppSettings.LibraryDetailsRatio).
        -->
        <Grid x:Name="ColumnsArea" Grid.Row="3" Margin="0,16,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="65*" MinWidth="{x:Static vm:LibraryLayout.ListMinWidth}" />
                <ColumnDefinition Width="16" />
                <ColumnDefinition x:Name="DetailsColumn" Width="35*" MinWidth="{x:Static vm:LibraryLayout.DetailsMinWidth}" />
            </Grid.ColumnDefinitions>

            <!-- Liste (mit Vorschlägen darüber) -->
            <Grid x:Name="ListArea">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Vorschläge: ganze Kopfzeile klappt auf und zu; offen höchstens zwei Zeilen hoch, damit die Spieleliste Platz behält -->
                <Border Style="{StaticResource Hp.Card}" Padding="6" Margin="0,0,0,12"
                        Visibility="{Binding HasCandidates, Converter={StaticResource Lib.BoolToVisibility}}">
                    <StackPanel>
                        <ToggleButton x:Name="CandidatesToggle" Style="{StaticResource Lib.SectionHeaderToggle}" IsChecked="True"
                                      AutomationProperties.AutomationId="CandidatesToggle" AutomationProperties.Name="{x:Static res:LibraryStrings.Candidates_Toggle}"
                                      ToolTip="{x:Static res:LibraryStrings.Candidates_Toggle}">
                            <DockPanel>
                                <Grid Width="30" Height="30" Margin="0,0,12,0">
                                    <Border CornerRadius="9" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0.16" />
                                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE8B7;" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource Hp.Brush.AccentSolid}" />
                                </Grid>
                                <Border DockPanel.Dock="Right" CornerRadius="8" Padding="8,1,8,2" Margin="10,0,0,0" Background="{DynamicResource Hp.Brush.Accent}" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding CandidatesCountText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextOnAccent}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Static res:LibraryStrings.Candidates_Title}" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource Hp.Brush.Text}" />
                                    <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Candidates_Hint}" Margin="0,2,0,0" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </ToggleButton>
                        <ListBox x:Name="CandidateList" Style="{StaticResource Lib.ListBox}" MaxHeight="122" Margin="8,4,4,2" ItemsSource="{Binding Candidates}"
                                 Visibility="{Binding IsChecked, ElementName=CandidatesToggle, Converter={StaticResource Lib.BoolToVisibility}}"
                                 ItemContainerStyle="{StaticResource Lib.PlainRow}" ItemTemplate="{StaticResource CandidateTemplate}"
                                 AutomationProperties.AutomationId="CandidateList" AutomationProperties.Name="{x:Static res:LibraryStrings.Candidates_Title}" />
                    </StackPanel>
                </Border>

                <Border x:Name="ListCard" Grid.Row="1" Style="{StaticResource Hp.Card}" Padding="8,12,4,8" MinHeight="150">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="12,0,26,10">
                            <TextBlock DockPanel.Dock="Right" Style="{StaticResource Lib.Overline}" Text="{x:Static res:LibraryStrings.List_HdrAutoColumn}" VerticalAlignment="Center" />
                            <TextBlock Style="{StaticResource Lib.Overline}" Text="{Binding ResultText}" VerticalAlignment="Center" />
                        </DockPanel>
                        <!-- Nicht mit dem aktuellen Element der Sicht verbinden: Neufiltern darf die Auswahl nicht verschieben. -->
                        <ListBox x:Name="GameList" Grid.Row="1" Style="{StaticResource Lib.ListBox}" Padding="4,0,0,0"
                                 IsSynchronizedWithCurrentItem="False"
                                 ItemsSource="{Binding GamesView}" SelectedItem="{Binding SelectedGame}"
                                 ItemContainerStyle="{StaticResource GameRowWithMenu}" ItemTemplate="{StaticResource GameRowTemplate}"
                                 AutomationProperties.AutomationId="GameList" AutomationProperties.Name="{x:Static res:LibraryStrings.List_Name}" />

                        <!-- Leere Bibliothek -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                                    Visibility="{Binding IsLibraryEmpty, Converter={StaticResource Lib.BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7FC;" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource Hp.Brush.Accent}" />
                            <TextBlock Style="{StaticResource Hp.Text.Subtitle}" Text="{x:Static res:LibraryStrings.List_EmptyTitle}" HorizontalAlignment="Center" Margin="0,14,0,6" />
                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.List_EmptyText}" TextAlignment="Center" />
                        </StackPanel>

                        <!-- Keine Treffer -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                                    Visibility="{Binding IsFilterEmpty, Converter={StaticResource Lib.BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE721;" FontSize="38" HorizontalAlignment="Center" Foreground="{DynamicResource Hp.Brush.Accent}" />
                            <TextBlock Style="{StaticResource Hp.Text.Subtitle}" Text="{x:Static res:LibraryStrings.List_NoMatchTitle}" HorizontalAlignment="Center" Margin="0,14,0,6" />
                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.List_NoMatchText}" TextAlignment="Center" />
                            <Button Style="{StaticResource Lib.LinkButton}" HorizontalAlignment="Center" Margin="0,12,0,0" Command="{Binding ClearFiltersCommand}"
                                    AutomationProperties.AutomationId="ResetFiltersButton" AutomationProperties.Name="{x:Static res:LibraryStrings.List_ResetFilters}"
                                    Content="{x:Static res:LibraryStrings.List_ResetFilters}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Hinweiszeile -->
                <Grid x:Name="StatusToast" Grid.Row="1" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="24,0,24,18" MaxWidth="560"
                      Visibility="{Binding HasStatus, Converter={StaticResource Lib.BoolToVisibility}}">
                    <Border CornerRadius="12" Background="{DynamicResource Hp.Brush.SurfaceInput}" BorderBrush="{DynamicResource Hp.Brush.BorderStrong}" BorderThickness="1">
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="20" ShadowDepth="4" Direction="270" Opacity="0.3" Color="{DynamicResource Hp.Color.Shadow}" />
                        </Border.Effect>
                    </Border>
                    <Border Style="{StaticResource Lib.StatusTint}" CornerRadius="12" Tag="{Binding StatusKind}" />
                    <DockPanel Margin="14,10,8,10">
                        <Button DockPanel.Dock="Right" Style="{StaticResource Lib.LinkButton}" Foreground="{DynamicResource Hp.Brush.TextMuted}" Margin="10,0,0,0"
                                VerticalAlignment="Center" Command="{Binding DismissStatusCommand}"
                                AutomationProperties.AutomationId="DismissStatusButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Status_Dismiss}">
                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE711;" FontSize="10" Margin="4" />
                        </Button>
                        <TextBlock DockPanel.Dock="Left" Style="{StaticResource Lib.StatusGlyph}" Tag="{Binding StatusKind}" Margin="0,0,10,0" />
                        <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13" VerticalAlignment="Center" Foreground="{DynamicResource Hp.Brush.Text}"
                                   AutomationProperties.AutomationId="StatusMessage" />
                    </DockPanel>
                </Grid>
            </Grid>

            <!-- Trenner: zwischen Liste und Details auch in der Tab-Reihenfolge -->
            <GridSplitter x:Name="LibrarySplitter" Grid.Column="1" Style="{StaticResource Lib.Splitter}"
                          DragCompleted="OnSplitterDragCompleted" KeyUp="OnSplitterKeyUp" MouseDoubleClick="OnSplitterDoubleClick"
                          AutomationProperties.AutomationId="LibrarySplitter" AutomationProperties.Name="{x:Static res:LibraryStrings.Splitter_Name}"
                          ToolTip="{x:Static res:LibraryStrings.Splitter_Tooltip}" ToolTipService.InitialShowDelay="900" />

            <!-- Detailbereich -->
            <Border x:Name="DetailsArea" Grid.Column="2" Style="{StaticResource Hp.Card}" Padding="0">
                <ScrollViewer x:Name="DetailsPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                              AutomationProperties.AutomationId="DetailsPanel" AutomationProperties.Name="{x:Static res:LibraryStrings.Details_Name}">
                    <Grid Margin="20,20,18,18">
                        <!-- Nichts gewählt -->
                        <StackPanel VerticalAlignment="Center" Margin="12,70,12,0"
                                    Visibility="{Binding HasDetails, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}">
                            <Grid Width="84" Height="84" HorizontalAlignment="Center">
                                <Border CornerRadius="24" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0.16" />
                                <Border CornerRadius="24" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.Accent}" Opacity="0.55" />
                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7FC;" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource Hp.Brush.Accent}" />
                            </Grid>
                            <TextBlock Style="{StaticResource Hp.Text.Subtitle}" Text="{x:Static res:LibraryStrings.Details_EmptyTitle}" HorizontalAlignment="Center" Margin="0,20,0,8" />
                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Details_EmptyText}" TextAlignment="Center" FontSize="13" LineHeight="20" />
                        </StackPanel>

                        <!-- Gewähltes Spiel -->
                        <Grid Visibility="{Binding HasDetails, Converter={StaticResource Lib.BoolToVisibility}}">
                            <StackPanel x:Name="DetailsContent" DataContext="{Binding Details}">
                                <!-- Kopf des Spiels -->
                                <Grid Margin="0,0,0,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="64" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- Klick öffnet „Symbol ändern…“ / „Symbol zurücksetzen“ (dasselbe Menü wie der Rechtsklick in der Liste) -->
                                    <Button x:Name="DetailIconButton" Style="{StaticResource Lib.IconButton}" Width="64" Height="64" VerticalAlignment="Top"
                                            Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                            ContextMenu="{StaticResource GameIconMenu}" Click="OnDetailIconClick"
                                            ToolTip="{x:Static res:LibraryStrings.Icon_ButtonName}" ToolTipService.InitialShowDelay="900"
                                            AutomationProperties.AutomationId="DetailIconButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Icon_ButtonName}">
                                        <Grid Width="64" Height="64" DataContext="{Binding Item}">
                                            <Border CornerRadius="16" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0.2" />
                                            <Border CornerRadius="16" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.Accent}" Opacity="0.6" />
                                            <TextBlock x:Name="DetailGlyph" Style="{StaticResource Lib.SourceGlyph}" FontSize="26" />
                                            <Image x:Name="DetailIcon" Source="{Binding Icon}" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality" />
                                        </Grid>
                                    </Button>
                                    <StackPanel Grid.Column="1" Margin="16,2,0,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Item.Name}" Style="{StaticResource Hp.Text.Subtitle}" FontSize="20" FontWeight="Bold" TextWrapping="Wrap"
                                                   AutomationProperties.AutomationId="DetailName" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Border Style="{StaticResource Hp.Badge}" Margin="0,0,6,4" DataContext="{Binding Item}">
                                                <TextBlock Text="{Binding SourceName}" Style="{StaticResource Lib.SourceText}" FontSize="11.5" FontWeight="SemiBold" />
                                            </Border>
                                            <Border Style="{StaticResource Hp.Badge}" Margin="0,0,6,4" BorderBrush="{DynamicResource Hp.Brush.AccentSolid}"
                                                    Visibility="{Binding Item.IsRunning, Converter={StaticResource Lib.BoolToVisibility}}">
                                                <TextBlock Text="{x:Static res:LibraryStrings.Badge_Running}" FontSize="11.5" Foreground="{DynamicResource Hp.Brush.AccentSolid}" />
                                            </Border>
                                            <Border Style="{StaticResource Hp.Badge}" Margin="0,0,6,4" BorderBrush="{DynamicResource Hp.Brush.Warning}"
                                                    Visibility="{Binding Item.IsInstalled, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}">
                                                <TextBlock Text="{x:Static res:LibraryStrings.Badge_NotInstalled}" FontSize="11.5" Foreground="{DynamicResource Hp.Brush.Warning}" />
                                            </Border>
                                        </WrapPanel>
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{Binding LastPlayedText}" Margin="0,2,0,0"
                                                   Visibility="{Binding HasLastPlayed, Converter={StaticResource Lib.BoolToVisibility}}" />
                                    </StackPanel>
                                </Grid>

                                <!-- Nicht mehr installiert -->
                                <Grid Margin="0,0,0,12" Visibility="{Binding Item.IsInstalled, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}">
                                    <Border Style="{StaticResource Lib.StatusTint}" Tag="{x:Static vm:StatusKind.Warning}" />
                                    <DockPanel Margin="12,9">
                                        <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{x:Static vm:StatusKind.Warning}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{x:Static res:LibraryStrings.Details_NotInstalled}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hp.Brush.Text}" />
                                    </DockPanel>
                                </Grid>

                                <!-- Starten und Verknüpfungen: die häufigste Aktion zuerst, noch vor der Automatik -->
                                <Border x:Name="LaunchSection" Style="{StaticResource Lib.Section}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Lib.SectionTitle}" Text="{x:Static res:LibraryStrings.Details_SectionLaunch}" />
                                        <Button Style="{StaticResource Lib.AccentButton}" HorizontalAlignment="Stretch" Command="{Binding LaunchCommand}"
                                                AutomationProperties.AutomationId="LaunchButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Launch_Button}">
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE768;" FontSize="13" Margin="0,0,9,0" />
                                                <TextBlock Text="{x:Static res:LibraryStrings.Launch_Button}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Launch_Hint}" Margin="0,8,0,12"
                                                   Visibility="{Binding CanLaunchGame, Converter={StaticResource Lib.BoolToVisibility}}" />
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Launch_NoCommand}" Margin="0,8,0,12"
                                                   AutomationProperties.AutomationId="LaunchNoCommandHint"
                                                   Visibility="{Binding CanLaunchGame, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button Style="{StaticResource Lib.SmallGhostButton}" Command="{Binding CreateDesktopShortcutCommand}"
                                                    AutomationProperties.AutomationId="CreateDesktopShortcutButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Shortcut_DesktopName}"
                                                    ToolTip="{x:Static res:LibraryStrings.Shortcut_DesktopName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE71B;" FontSize="12" Margin="0,0,7,0" />
                                                    <TextBlock Text="{x:Static res:LibraryStrings.Shortcut_Desktop}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Grid.Column="2" Style="{StaticResource Lib.SmallGhostButton}" Command="{Binding CreateStartMenuShortcutCommand}"
                                                    AutomationProperties.AutomationId="CreateStartMenuShortcutButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Shortcut_StartMenuName}"
                                                    ToolTip="{x:Static res:LibraryStrings.Shortcut_StartMenuName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE718;" FontSize="12" Margin="0,0,7,0" />
                                                    <TextBlock Text="{x:Static res:LibraryStrings.Shortcut_StartMenu}" />
                                                </StackPanel>
                                            </Button>
                                        </Grid>

                                        <!-- Notlösung nur für Steam-Spiele: Startoption, mit der Steam das Spiel über HdrPilot startet -->
                                        <StackPanel x:Name="SteamLaunchOptionArea" Visibility="{Binding IsSteam, Converter={StaticResource Lib.BoolToVisibility}}">
                                            <Border Height="1" Margin="0,12" Background="{DynamicResource Hp.Brush.Border}" />
                                            <Button Style="{StaticResource Lib.SmallGhostButton}" HorizontalAlignment="Stretch" Command="{Binding CopySteamLaunchOptionCommand}"
                                                    AutomationProperties.AutomationId="CopySteamLaunchOptionButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Steam_CopyLaunchOptionName}"
                                                    ToolTip="{x:Static res:LibraryStrings.Steam_CopyLaunchOptionName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE8C8;" FontSize="12" Margin="0,0,7,0" />
                                                    <TextBlock Text="{x:Static res:LibraryStrings.Steam_CopyLaunchOption}" TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Steam_LaunchOptionHint}" Margin="0,7,0,0"
                                                       AutomationProperties.AutomationId="SteamLaunchOptionHint" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Ergebnis von Start, Verknüpfung oder Steam-Startoption -->
                                <Grid Margin="0,0,0,12" Visibility="{Binding HasLaunchMessage, Converter={StaticResource Lib.BoolToVisibility}}">
                                    <Border Style="{StaticResource Lib.StatusTint}" Tag="{Binding MessageKind}" />
                                    <DockPanel Margin="12,9">
                                        <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{Binding MessageKind}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hp.Brush.Text}"
                                                   AutomationProperties.AutomationId="DetailMessage" />
                                    </DockPanel>
                                </Grid>

                                <!-- Automatik -->
                                <Border x:Name="AutomationSection" Style="{StaticResource Lib.Section}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Lib.SectionTitle}" Text="{x:Static res:LibraryStrings.Details_SectionAutomation}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{x:Static res:LibraryStrings.Details_HdrAuto}" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.Text}" />
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Details_HdrAutoHint}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource Lib.ToggleSwitch}" VerticalAlignment="Center" IsChecked="{Binding Item.HdrAuto}"
                                                      AutomationProperties.AutomationId="DetailHdrAuto" AutomationProperties.Name="{x:Static res:LibraryStrings.Details_HdrAuto}" />
                                        </Grid>
                                        <Border Height="1" Margin="0,12" Background="{DynamicResource Hp.Brush.Border}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{x:Static res:LibraryStrings.Details_Restore}" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.Text}" />
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Details_RestoreHint}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource Lib.ToggleSwitch}" VerticalAlignment="Center" IsChecked="{Binding RestoreAfter}"
                                                      AutomationProperties.AutomationId="DetailRestore" AutomationProperties.Name="{x:Static res:LibraryStrings.Details_Restore}" />
                                        </Grid>
                                        <Border Height="1" Margin="0,12" Background="{DynamicResource Hp.Brush.Border}" />
                                        <TextBlock Text="{x:Static res:LibraryStrings.Details_Display}" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.Text}" />
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Details_DisplayHint}" Margin="0,2,0,8" />
                                        <ComboBox Style="{StaticResource Lib.ComboBox}" ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}"
                                                  ItemTemplate="{StaticResource DisplayOptionTemplate}"
                                                  AutomationProperties.AutomationId="DetailDisplay" AutomationProperties.Name="{x:Static res:LibraryStrings.Details_Display}" />
                                    </StackPanel>
                                </Border>

                                <!--
                                    Bild (E88): „Windows Auto HDR“ ist etwas anderes als „HDR automatisch“ darüber. Windows rechnet
                                    das SDR-Bild in HDR um; HDRpilot schaltet dafür den globalen Auto-HDR-Schalter direkt vor einem
                                    Start über HDRpilot ein und danach zurück. Bei eigenem HDR laut PCGamingWiki zurückgenommen
                                    dargestellt, aber bedienbar.
                                -->
                                <Border x:Name="PictureSection" Style="{StaticResource Lib.Section}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Lib.SectionTitle}" Text="{x:Static res:LibraryStrings.Details_SectionPicture}" />
                                        <Grid x:Name="AutoHdrRow">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.Style>
                                                <Style TargetType="Grid">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsAutoHdrSubdued}" Value="True">
                                                            <Setter Property="Opacity" Value="0.55" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Grid.Style>
                                            <StackPanel Margin="0,0,12,0">
                                                <TextBlock Text="{x:Static res:LibraryStrings.Details_AutoHdr}" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.Text}" />
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Details_AutoHdrHint}" Margin="0,2,0,0" />
                                            </StackPanel>
                                            <CheckBox Grid.Column="1" Style="{StaticResource Lib.ToggleSwitch}" VerticalAlignment="Center" IsChecked="{Binding AutoHdr}"
                                                      AutomationProperties.AutomationId="DetailAutoHdr" AutomationProperties.Name="{x:Static res:LibraryStrings.Details_AutoHdr}"
                                                      AutomationProperties.HelpText="{x:Static res:LibraryStrings.Details_AutoHdrHint}" />
                                        </Grid>
                                        <!-- Wirkt nur bei Starts, die HDRpilot vorher kennt (E88): immer sichtbar, auch vor dem Einschalten -->
                                        <DockPanel Margin="0,10,0,0">
                                            <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{x:Static vm:StatusKind.Info}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top" />
                                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Details_AutoHdrStartHint}"
                                                       AutomationProperties.AutomationId="DetailAutoHdrStartHint" />
                                        </DockPanel>
                                        <DockPanel Margin="0,10,0,0" Visibility="{Binding ShowAutoHdrNativeHint, Converter={StaticResource Lib.BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{x:Static vm:StatusKind.Info}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top" />
                                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{Binding AutoHdrNativeHint}"
                                                       AutomationProperties.AutomationId="DetailAutoHdrNativeHint" />
                                        </DockPanel>
                                        <DockPanel Margin="0,10,0,0" Visibility="{Binding ShowAutoHdrNeedsHdrHint, Converter={StaticResource Lib.BoolToVisibility}}">
                                            <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{x:Static vm:StatusKind.Info}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top" />
                                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Details_AutoHdrNeedsHdr}"
                                                       AutomationProperties.AutomationId="DetailAutoHdrNeedsHdrHint" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Ergebnis der angebotenen Steam-Startoption nach dem Einschalten von Auto HDR (G9.7) -->
                                <Grid Margin="0,0,0,12" Visibility="{Binding HasPictureMessage, Converter={StaticResource Lib.BoolToVisibility}}">
                                    <Border Style="{StaticResource Lib.StatusTint}" Tag="{Binding MessageKind}" />
                                    <DockPanel Margin="12,9">
                                        <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{Binding MessageKind}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hp.Brush.Text}"
                                                   AutomationProperties.AutomationId="DetailAutoHdrMessage" />
                                    </DockPanel>
                                </Grid>

                                <!-- EXE-Dateien -->
                                <Border x:Name="ExecutablesSection" Style="{StaticResource Lib.Section}">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource Lib.SectionTitle}" Text="{x:Static res:LibraryStrings.Details_SectionExecutables}" Margin="0,0,0,4" />
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Details_ExecutablesHint}" Margin="0,0,0,10" />
                                        <ListBox Style="{StaticResource Lib.ListBox}" MaxHeight="230" Margin="-4,0,-4,0" ItemsSource="{Binding Executables}" SelectedItem="{Binding SelectedExecutable}"
                                                 ItemContainerStyle="{StaticResource Lib.PlainRow}" ItemTemplate="{StaticResource ExecutableTemplate}"
                                                 Visibility="{Binding HasExecutables, Converter={StaticResource Lib.BoolToVisibility}}"
                                                 AutomationProperties.AutomationId="DetailExecutables" AutomationProperties.Name="{x:Static res:LibraryStrings.Details_SectionExecutables}" />
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Exe_Empty}" FontStyle="Italic"
                                                   Visibility="{Binding HasExecutables, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}" />
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button Style="{StaticResource Lib.SmallGhostButton}" Margin="0,0,6,6" Command="{Binding AddExeCommand}"
                                                    AutomationProperties.AutomationId="AddExeButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Exe_AddName}"
                                                    ToolTip="{x:Static res:LibraryStrings.Exe_AddName}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,6,0" />
                                                    <TextBlock Text="{x:Static res:LibraryStrings.Exe_Add}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Lib.SmallGhostButton}" Margin="0,0,6,6" Command="{Binding RemoveExeCommand}"
                                                    AutomationProperties.AutomationId="RemoveExeButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Exe_RemoveName}"
                                                    ToolTip="{x:Static res:LibraryStrings.Exe_RemoveName}" ToolTipService.ShowOnDisabled="True"
                                                    Visibility="{Binding IsSelectedExecutableExcluded, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE738;" FontSize="12" Margin="0,0,6,0" />
                                                    <TextBlock Text="{x:Static res:LibraryStrings.Exe_Remove}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Lib.SmallGhostButton}" Margin="0,0,6,6" Command="{Binding IncludeExeCommand}"
                                                    AutomationProperties.AutomationId="IncludeExeButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Exe_IncludeName}"
                                                    Visibility="{Binding IsSelectedExecutableExcluded, Converter={StaticResource Lib.BoolToVisibility}}">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7A7;" FontSize="12" Margin="0,0,6,0" />
                                                    <TextBlock Text="{x:Static res:LibraryStrings.Exe_Include}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Lib.SmallGhostButton}" Margin="0,0,6,6" Command="{Binding RelearnExeCommand}"
                                                    AutomationProperties.AutomationId="RelearnExeButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Exe_RelearnName}"
                                                    ToolTip="{x:Static res:LibraryStrings.Exe_RelearnName}" ToolTipService.ShowOnDisabled="True">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE81C;" FontSize="12" Margin="0,0,6,0" />
                                                    <TextBlock Text="{x:Static res:LibraryStrings.Exe_Relearn}" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Ergebnis einer Aktion an den EXE-Dateien (direkt darunter, auch wenn der Bereich gescrollt ist) -->
                                <Grid Margin="0,0,0,12" Visibility="{Binding HasExecutablesMessage, Converter={StaticResource Lib.BoolToVisibility}}">
                                    <Border Style="{StaticResource Lib.StatusTint}" Tag="{Binding MessageKind}" />
                                    <DockPanel Margin="12,9">
                                        <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{Binding MessageKind}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hp.Brush.Text}"
                                                   AutomationProperties.AutomationId="DetailExeMessage" />
                                    </DockPanel>
                                </Grid>

                                <!-- Installationsordner -->
                                <StackPanel Margin="2,0,2,8" Visibility="{Binding HasInstallDir, Converter={StaticResource Lib.BoolToVisibility}}">
                                    <TextBlock Style="{StaticResource Lib.Overline}" Text="{x:Static res:LibraryStrings.Details_InstallDir}" Margin="0,0,0,4" />
                                    <TextBlock Text="{Binding InstallDir}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                                </StackPanel>

                                <Button Style="{StaticResource Lib.DangerButton}" HorizontalAlignment="Left" Margin="0,10,0,0" Command="{Binding RemoveGameCommand}"
                                        Visibility="{Binding IsManual, Converter={StaticResource Lib.BoolToVisibility}}"
                                        AutomationProperties.AutomationId="RemoveGameButton" AutomationProperties.Name="{x:Static res:LibraryStrings.RemoveGame_Button}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE74D;" FontSize="12" Margin="0,0,7,0" />
                                        <TextBlock Text="{x:Static res:LibraryStrings.RemoveGame_Button}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</infra:ChromeWindow>
