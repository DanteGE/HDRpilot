<infra:ChromeWindow x:Class="HdrPilot.App.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:HdrPilot.App.Infrastructure"
                    xmlns:res="clr-namespace:HdrPilot.App.Resources"
                    xmlns:lib="clr-namespace:HdrPilot.App.Views.Library"
                    xmlns:shell="clr-namespace:HdrPilot.App.Views.Shell"
                    xmlns:vm="clr-namespace:HdrPilot.App.ViewModels.Library"
                    xmlns:art="clr-namespace:HdrPilot.Core.Artwork;assembly=HdrPilot.Core"
                    Title="{x:Static res:LibraryStrings.Window_Title}"
                    AutomationProperties.AutomationId="MainWindow"
                    AutomationProperties.Name="{x:Static res:LibraryStrings.Window_Title}"
                    ContentUnderTitleBar="True"
                    Width="1600" Height="1000" MinWidth="1000" MinHeight="620"
                    WindowStartupLocation="CenterScreen">
    <infra:ChromeWindow.Resources>
        <!--
            Eigenes Symbol (E86): Klick auf die Kachel „Symbol“ im Detailbereich. Das Menü wirkt auf das gewählte Spiel; seinen
            DataContext (die Bibliothek) bekommt es über Tag des Elements, an dem es aufgeht. Je Verwendung eine Instanz.
        -->
        <ContextMenu x:Key="GameIconMenu" x:Shared="False" Style="{StaticResource Lib.ContextMenu}"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                     AutomationProperties.AutomationId="GameIconMenu" AutomationProperties.Name="{x:Static res:LibraryStrings.Icon_MenuName}">
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Icon_Change}" Command="{Binding ChangeIconCommand}"
                      AutomationProperties.AutomationId="ChangeIconMenuItem" AutomationProperties.Name="{x:Static res:LibraryStrings.Icon_Change}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xEB9F;" FontSize="15" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Icon_Reset}" Command="{Binding ResetIconCommand}"
                      AutomationProperties.AutomationId="ResetIconMenuItem" AutomationProperties.Name="{x:Static res:LibraryStrings.Icon_Reset}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE777;" FontSize="15" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Querformat-Bild eines Spiels (64 × 36), sonst Farbfeld mit Symbol bzw. Monogramm: Listenzeile und Kopf des Kontextmenüs -->
        <DataTemplate x:Key="GameThumbnail" DataType="{x:Type vm:GameItemViewModel}">
            <Grid Width="64" Height="36">
                <Border CornerRadius="7" Background="{Binding NameField}" />
                <TextBlock x:Name="Mono" Text="{Binding Monogram}" FontFamily="{StaticResource Lib.Font.Display}" FontWeight="Bold" FontSize="12"
                           Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="SmallIcon" Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
                <Border CornerRadius="7" lib:ImageFill.Source="{Binding Thumbnail}" Visibility="{Binding HasThumbnail, Converter={StaticResource Lib.BoolToVisibility}}" />
                <Border CornerRadius="7" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.Line}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="SmallIcon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon, Converter={StaticResource Lib.BoolToVisibility}}" Value="Visible">
                    <Setter TargetName="Mono" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Vorschau der Listenzeile: Querformat-Bild (GameThumbnail) oder Symbol, je nach Wahl in der Kopfzeile der Liste -->
        <DataTemplate x:Key="RowThumbnail" DataType="{x:Type vm:GameItemViewModel}">
            <Grid>
                <ContentPresenter x:Name="ImageThumb" Content="{Binding}" ContentTemplate="{StaticResource GameThumbnail}" />
                <Grid x:Name="IconThumb" Width="32" Height="32" Visibility="Collapsed">
                    <Border Style="{StaticResource Lib.SourceTile}" />
                    <TextBlock Style="{StaticResource Lib.SourceGlyph}" />
                    <Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapScalingMode="HighQuality" />
                </Grid>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsThumbnailIcon, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                    <Setter TargetName="ImageThumb" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="IconThumb" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            Kontextmenü eines Spiels mit Kopf wie im Prototyp (.ctx .ch): Vorschau, Name und „Quelle · zuletzt gespielt“ des
            gewählten Spiels, auf das die Einträge wirken. Nur der Kopf ist neu, Fläche und Schatten wie Lib.ContextMenu.
        -->
        <Style x:Key="GameContextMenuStyle" TargetType="ContextMenu" BasedOn="{StaticResource Lib.ContextMenu}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Grid Margin="8,4,12,18">
                            <Border Style="{StaticResource Lib.PopupShadow}" />
                            <Border Style="{StaticResource Lib.PopupBody}">
                                <StackPanel>
                                    <DockPanel Margin="6,4,6,8" DataContext="{Binding SelectedGame}" Visibility="{Binding Converter={StaticResource Lib.BoolToVisibility}}">
                                        <ContentControl Width="64" Height="36" Focusable="False" IsTabStop="False" Content="{Binding}" ContentTemplate="{StaticResource GameThumbnail}" />
                                        <StackPanel Margin="12,0,4,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Bold" MaxWidth="240" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.Text}" />
                                            <TextBlock FontSize="12" FontWeight="Normal" Margin="0,2,0,0" MaxWidth="240" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.TextSecondary}">
                                                <TextBlock.Text>
                                                    <MultiBinding StringFormat="{x:Static res:LibraryStrings.Context_Subtitle}">
                                                        <Binding Path="SourceName" />
                                                        <Binding Path="LastPlayedText" />
                                                    </MultiBinding>
                                                </TextBlock.Text>
                                            </TextBlock>
                                        </StackPanel>
                                    </DockPanel>
                                    <Border Height="1" Margin="6,0,6,5" Background="{DynamicResource Hp.Brush.Line}"
                                            Visibility="{Binding SelectedGame, Converter={StaticResource Lib.BoolToVisibility}}" />
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Kontextmenü eines Spiels (Rechtsklick auf Zeile oder Kachel, Umschalt+F10/Menütaste, „···“ im Detailbereich). Die
            Zeile wird dabei gewählt; Einträge wirken auf das gewählte Spiel. Nur bestehende Funktionen, in der Reihenfolge des
            Prototyps.
        -->
        <ContextMenu x:Key="GameContextMenu" x:Shared="False" Style="{StaticResource GameContextMenuStyle}"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}"
                     AutomationProperties.AutomationId="GameContextMenu" AutomationProperties.Name="{x:Static res:LibraryStrings.Context_MenuName}">
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Context_Launch}" InputGestureText="{x:Static res:LibraryStrings.Key_Enter}"
                      Command="{Binding Details.LaunchCommand}"
                      AutomationProperties.AutomationId="ContextLaunch" AutomationProperties.Name="{x:Static res:LibraryStrings.Context_Launch}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE768;" FontSize="13" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Context_HdrAuto}" IsCheckable="True" IsChecked="{Binding SelectedGame.HdrAuto}"
                      AutomationProperties.AutomationId="ContextHdrAuto" AutomationProperties.Name="{x:Static res:LibraryStrings.Context_HdrAuto}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE706;" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Context_Restore}" IsCheckable="True" IsChecked="{Binding Details.RestoreAfter}"
                      AutomationProperties.AutomationId="ContextRestore" AutomationProperties.Name="{x:Static res:LibraryStrings.Context_Restore}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE777;" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Context_AutoHdr}" IsCheckable="True" IsChecked="{Binding Details.AutoHdr}"
                      AutomationProperties.AutomationId="ContextAutoHdr" AutomationProperties.Name="{x:Static res:LibraryStrings.Context_AutoHdr}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE9D9;" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator Style="{StaticResource Lib.MenuSeparator}" />
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Context_ChooseArtwork}" Command="{Binding ChooseArtworkCommand}"
                      AutomationProperties.AutomationId="ChooseArtworkMenuItem" AutomationProperties.Name="{x:Static res:LibraryStrings.Context_ChooseArtwork}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xEB9F;" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Icon_Change}" Command="{Binding ChangeIconCommand}"
                      AutomationProperties.AutomationId="ChangeIconMenuItem" AutomationProperties.Name="{x:Static res:LibraryStrings.Icon_Change}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE8B9;" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Icon_Reset}" Command="{Binding ResetIconCommand}"
                      AutomationProperties.AutomationId="ResetIconMenuItem" AutomationProperties.Name="{x:Static res:LibraryStrings.Icon_Reset}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE777;" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <Separator Style="{StaticResource Lib.MenuSeparator}" />
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Context_Desktop}" Command="{Binding Details.CreateDesktopShortcutCommand}"
                      AutomationProperties.AutomationId="ContextDesktopShortcut" AutomationProperties.Name="{x:Static res:LibraryStrings.Context_Desktop}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7F4;" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Context_StartMenu}" Command="{Binding Details.CreateStartMenuShortcutCommand}"
                      AutomationProperties.AutomationId="ContextStartMenuShortcut" AutomationProperties.Name="{x:Static res:LibraryStrings.Context_StartMenu}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE8FC;" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
            <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Context_OpenFolder}" Command="{Binding OpenInstallFolderCommand}"
                      AutomationProperties.AutomationId="ContextOpenFolder" AutomationProperties.Name="{x:Static res:LibraryStrings.Context_OpenFolder}">
                <MenuItem.Icon>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE838;" FontSize="14" />
                </MenuItem.Icon>
            </MenuItem>
        </ContextMenu>

        <!-- Zeile der Spieleliste mit Kontextmenü auf der ganzen Fläche -->
        <Style x:Key="GameRowWithMenu" TargetType="ListBoxItem" BasedOn="{StaticResource Lib.GameRow}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="ContextMenu" Value="{StaticResource GameContextMenu}" />
        </Style>

        <!-- Kachel mit Kontextmenü; Glanz unter der Maus (MainWindow.xaml.cs) -->
        <Style x:Key="GameTileWithMenu" TargetType="ListBoxItem" BasedOn="{StaticResource Lib.Tile}">
            <Setter Property="Tag" Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=ListBox}}" />
            <Setter Property="ContextMenu" Value="{StaticResource GameContextMenu}" />
            <EventSetter Event="MouseMove" Handler="OnTileMouseMove" />
        </Style>

        <!-- Zeile der Spieleliste (Prototyp .row): Vorschau | Spiel mit Kennzeichen | Quelle | Zuletzt gespielt | HDR | HDR automatisch -->
        <DataTemplate x:Key="GameRowTemplate" DataType="{x:Type vm:GameItemViewModel}">
            <Grid x:Name="Row" Height="46">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentPresenter x:Name="Thumb" Content="{Binding}" ContentTemplate="{StaticResource RowThumbnail}" VerticalAlignment="Center" />
                <!-- Name, dahinter „AUTO HDR“ (Windows Auto HDR an, nur Anzeige), „NEU“, „Läuft“, „Nicht installiert“; der Name kürzt sich -->
                <lib:NameWithBadgesPanel x:Name="Texts" Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="Bold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Hp.Brush.Text}" VerticalAlignment="Center" />
                    <Border Style="{StaticResource Lib.AutoHdrBadge}" Margin="8,0,0,0"
                            Visibility="{Binding AutoHdr, Converter={StaticResource Lib.BoolToVisibility}}"
                            ToolTip="{x:Static res:LibraryStrings.Badge_AutoHdrTooltip}">
                        <Border.Background>
                            <SolidColorBrush Color="{DynamicResource Hp.Color.C3}" Opacity="0.28" />
                        </Border.Background>
                        <Border.BorderBrush>
                            <SolidColorBrush Color="{DynamicResource Hp.Color.C3}" Opacity="0.8" />
                        </Border.BorderBrush>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="{x:Static infra:AppGlyphs.AutoHdr}" FontSize="9" Margin="0,0,4,0" />
                            <!-- Kennung am Text: ein Border hat keinen Automation-Peer, UI-Automation sähe es sonst nicht -->
                            <TextBlock Text="{x:Static res:LibraryStrings.Badge_AutoHdr}" VerticalAlignment="Center"
                                       AutomationProperties.AutomationId="AutoHdrBadge"
                                       AutomationProperties.Name="{x:Static res:LibraryStrings.Badge_AutoHdrTooltip}" />
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Lib.NewBadge}" Margin="6,0,0,0" Visibility="{Binding IsNew, Converter={StaticResource Lib.BoolToVisibility}}">
                        <TextBlock Text="{x:Static res:LibraryStrings.Badge_New}" AutomationProperties.AutomationId="NewBadge" />
                    </Border>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsRunning, Converter={StaticResource Lib.BoolToVisibility}}">
                        <Ellipse Width="7" Height="7" Fill="{StaticResource Lib.Brush.Ok}" VerticalAlignment="Center" />
                        <TextBlock Text="{x:Static res:LibraryStrings.Badge_Running}" FontSize="12" FontWeight="SemiBold" Margin="5,0,0,0" Foreground="{DynamicResource Hp.Brush.Success}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,0,0,0" VerticalAlignment="Center"
                                Visibility="{Binding IsInstalled, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7BA;" FontSize="11" Foreground="{DynamicResource Hp.Brush.Warning}" />
                        <TextBlock Text="{x:Static res:LibraryStrings.Badge_NotInstalled}" FontSize="12" Margin="5,0,0,0" Foreground="{DynamicResource Hp.Brush.Warning}" />
                    </StackPanel>
                </lib:NameWithBadgesPanel>
                <StackPanel x:Name="SourceCell" Grid.Column="2" Width="{Binding (lib:GameListColumns.SourceWidth), RelativeSource={RelativeSource Self}}" Margin="14,0,0,0" Orientation="Horizontal" VerticalAlignment="Center"
                            Visibility="{Binding (lib:GameListColumns.ShowSource), RelativeSource={RelativeSource Self}, Converter={StaticResource Lib.BoolToVisibility}}">
                    <Ellipse Style="{StaticResource Lib.SourceDot}" />
                    <TextBlock Text="{Binding SourceName}" Margin="8,0,0,0" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Hp.Brush.TextSecondary}" VerticalAlignment="Center" />
                </StackPanel>
                <TextBlock x:Name="LastPlayedCell" Grid.Column="3" Width="{Binding (lib:GameListColumns.LastPlayedWidth), RelativeSource={RelativeSource Self}}" Margin="14,0,0,0" Text="{Binding LastPlayedText}" FontSize="12.5"
                           Foreground="{DynamicResource Hp.Brush.TextSecondary}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                           Visibility="{Binding (lib:GameListColumns.ShowLastPlayed), RelativeSource={RelativeSource Self}, Converter={StaticResource Lib.BoolToVisibility}}" />
                <Grid x:Name="HdrCell" Grid.Column="4" Width="{Binding (lib:GameListColumns.HdrWidth), RelativeSource={RelativeSource Self}}" Margin="14,0,0,0" VerticalAlignment="Center"
                      Visibility="{Binding (lib:GameListColumns.ShowHdr), RelativeSource={RelativeSource Self}, Converter={StaticResource Lib.BoolToVisibility}}">
                    <TextBlock Text="{x:Static res:LibraryStrings.List_HdrUnknown}" FontSize="12" Foreground="{DynamicResource Hp.Brush.TextMuted}" VerticalAlignment="Center"
                               Visibility="{Binding ShowHdrPill, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}" />
                    <!-- HDR laut PCGamingWiki: „NATIV“, „TEILWEISE“, „MOD“ -->
                    <Border Style="{StaticResource Lib.HdrBadge}"
                            Visibility="{Binding ShowHdrPill, Converter={StaticResource Lib.BoolToVisibility}}"
                            ToolTip="{Binding HdrBadgeTooltip}"
                            AutomationProperties.AutomationId="HdrSupportBadge" AutomationProperties.Name="{Binding HdrBadgeTooltip}">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="NativeDot" Width="6" Height="6" Margin="0,0,5,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{DynamicResource Hp.Color.C3}" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding HdrPillText}" VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>
                </Grid>
                <StackPanel Grid.Column="5" Width="118" Margin="14,0,0,0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock x:Name="SwitchState" Text="{Binding HdrAutoStateText}" Width="64" TextAlignment="Right" Margin="0,0,10,0" FontSize="11" FontWeight="Bold"
                               Foreground="{DynamicResource Hp.Brush.TextMuted}" VerticalAlignment="Center" />
                    <CheckBox Style="{StaticResource Lib.RowToggleSwitch}" IsChecked="{Binding HdrAuto}" VerticalAlignment="Center"
                              AutomationProperties.AutomationId="HdrAutoToggle"
                              AutomationProperties.Name="{x:Static res:LibraryStrings.Row_HdrAutoName}"
                              ToolTip="{x:Static res:LibraryStrings.Row_HdrAutoName}" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                    <Setter TargetName="Thumb" Property="Opacity" Value="0.45" />
                    <Setter TargetName="Texts" Property="Opacity" Value="0.6" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HdrAuto}" Value="True">
                    <Setter TargetName="SwitchState" Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HdrSupport}" Value="Native">
                    <Setter TargetName="NativeDot" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            Kachel in Raster und Regal (Prototyp .tile): Cover (oder erzeugtes Cover: Farbfeld, Symbol, Name), oben links die
            Kennzeichen, beim Überfahren und bei Auswahl Name, Quelle und der Schalter „HDR automatisch“, sonst ein kleines
            Sonnen-Zeichen, wenn er an ist. Gewählt: gestrichelter Ring im Takt (nur Stufe „Voll“). Nur 2D, keine Effekte.
        -->
        <DataTemplate x:Key="GameTileTemplate" DataType="{x:Type vm:GameItemViewModel}">
            <Grid x:Name="TileRoot" RenderTransformOrigin="0.5,0.5" Background="Transparent">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <ScaleTransform ScaleX="1" ScaleY="1" />
                        <TranslateTransform Y="0" />
                    </TransformGroup>
                </Grid.RenderTransform>
                <!-- Hof unter der gewählten Kachel (Verlauf, kein Schatten-Effekt) -->
                <Border x:Name="SelectedHalo" CornerRadius="22" Margin="-10,-6,-10,-16" Opacity="0" IsHitTestVisible="False">
                    <Border.Background>
                        <RadialGradientBrush RadiusX="0.56" RadiusY="0.56" Center="0.5,0.56" GradientOrigin="0.5,0.56">
                            <GradientStop Color="{DynamicResource Hp.Color.C2}" Offset="0.55" />
                            <GradientStop Color="#00000000" Offset="1" />
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="Card" CornerRadius="16" Background="#FF0D0E14">
                    <Grid>
                        <!-- Erzeugtes Cover, solange kein Bild da ist -->
                        <Border CornerRadius="16" Background="{Binding NameField}" />
                        <Border CornerRadius="16" Background="{StaticResource Lib.Brush.GeneratedShade}" />
                        <Border x:Name="GenIcon" Width="{Binding ActualWidth, ElementName=Card, Converter={StaticResource Lib.Scale}, ConverterParameter=0.46}"
                                Height="{Binding ActualWidth, ElementName=Card, Converter={StaticResource Lib.Scale}, ConverterParameter=0.46}"
                                VerticalAlignment="Top" HorizontalAlignment="Center" Margin="0,30,0,0" CornerRadius="18" BorderThickness="1" BorderBrush="#3DFFFFFF">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                    <GradientStop Color="#2EFFFFFF" Offset="0" />
                                    <GradientStop Color="#0DFFFFFF" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <Grid>
                                <TextBlock x:Name="GenMono" Text="{Binding Monogram}" FontFamily="{StaticResource Lib.Font.Display}" FontWeight="Bold"
                                           FontSize="{Binding ActualWidth, ElementName=Card, Converter={StaticResource Lib.Scale}, ConverterParameter=0.15;10;34}"
                                           Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <Image x:Name="GenIconImage" Source="{Binding Icon}" Margin="14" RenderOptions.BitmapScalingMode="HighQuality" />
                            </Grid>
                        </Border>
                        <TextBlock x:Name="GenName" Text="{Binding Name}" Margin="14,0,14,14" VerticalAlignment="Bottom" TextWrapping="Wrap" MaxHeight="96"
                                   TextTrimming="CharacterEllipsis" FontFamily="{StaticResource Lib.Font.Display}" FontWeight="Bold" LineHeight="20"
                                   FontSize="{Binding ActualWidth, ElementName=Card, Converter={StaticResource Lib.Scale}, ConverterParameter=0.105;9;22}"
                                   Foreground="#FFFFFFFF" />
                        <!-- Cover -->
                        <Border x:Name="CoverArt" CornerRadius="16" lib:ImageFill.Source="{Binding Cover}" Visibility="{Binding HasCover, Converter={StaticResource Lib.BoolToVisibility}}">
                            <Border.Background>
                                <ImageBrush Stretch="UniformToFill">
                                    <ImageBrush.RelativeTransform>
                                        <ScaleTransform CenterX="0.5" CenterY="0.5" ScaleX="1" ScaleY="1" />
                                    </ImageBrush.RelativeTransform>
                                </ImageBrush>
                            </Border.Background>
                        </Border>
                        <!-- HDR an: Glanz von oben -->
                        <Border x:Name="HdrGlow" CornerRadius="16" Opacity="0">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0.5,1" EndPoint="0.5,0">
                                    <GradientStop Color="#00000000" Offset="0.45" />
                                    <GradientStop Color="{DynamicResource Hp.Color.C3}" Offset="1.6" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Scrim" CornerRadius="16" Background="{StaticResource Lib.Brush.TileScrim}" Opacity="0" VerticalAlignment="Bottom"
                                Height="{Binding ActualHeight, ElementName=Card, Converter={StaticResource Lib.Scale}, ConverterParameter=0.42}" />
                        <!-- Glanz unter der Maus (Lage setzt MainWindow.xaml.cs) -->
                        <Border x:Name="Shine" CornerRadius="16" Opacity="0">
                            <Border.Background>
                                <RadialGradientBrush RadiusX="0.9" RadiusY="0.6" Center="0.5,0.2" GradientOrigin="0.5,0.2">
                                    <GradientStop Color="#42FFFFFF" Offset="0" />
                                    <GradientStop Color="#0DFFFFFF" Offset="0.35" />
                                    <GradientStop Color="#00FFFFFF" Offset="0.6" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="16" BorderThickness="1" BorderBrush="#14FFFFFF" />
                        <Border x:Name="SelectRim" CornerRadius="16" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.AccentStrong}" Opacity="0" />
                        <!-- Kennzeichen oben links -->
                        <StackPanel Margin="9,9,0,0" HorizontalAlignment="Left" VerticalAlignment="Top">
                            <Border CornerRadius="5" Height="19" Padding="6,0" Background="#8C0A0B10" BorderBrush="#6BFFFFFF" BorderThickness="1" HorizontalAlignment="Left"
                                    Visibility="{Binding HasHdrBadge, Converter={StaticResource Lib.BoolToVisibility}}">
                                <TextBlock Text="{x:Static res:LibraryStrings.Badge_Hdr}" FontSize="9.5" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                            </Border>
                            <Border Style="{StaticResource Lib.AutoHdrBadge}" Margin="0,4,0,0" HorizontalAlignment="Left" Background="{DynamicResource Hp.Brush.Accent}" BorderThickness="0"
                                    Visibility="{Binding AutoHdr, Converter={StaticResource Lib.BoolToVisibility}}" TextElement.Foreground="{DynamicResource Hp.Brush.TextOnAccent}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="{x:Static infra:AppGlyphs.AutoHdr}" FontSize="9" Margin="0,0,4,0" />
                                    <TextBlock Text="{x:Static res:LibraryStrings.Badge_AutoHdr}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource Lib.NewBadge}" Margin="0,4,0,0" HorizontalAlignment="Left" Background="#FFFFFFFF" TextElement.Foreground="#FF0A0B10"
                                    Visibility="{Binding IsNew, Converter={StaticResource Lib.BoolToVisibility}}">
                                <TextBlock Text="{x:Static res:LibraryStrings.Badge_New}" />
                            </Border>
                        </StackPanel>
                        <!-- Name und Quelle unten -->
                        <StackPanel x:Name="Footer" VerticalAlignment="Bottom" Margin="11,0,50,10">
                            <TextBlock x:Name="TileName" Text="{Binding Name}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" MaxHeight="34" TextTrimming="CharacterEllipsis"
                                       Foreground="#FFFFFFFF" Opacity="0" />
                            <StackPanel x:Name="TileSource" Orientation="Horizontal" Margin="0,6,0,0" Opacity="0">
                                <Ellipse Style="{StaticResource Lib.SourceDot}" Width="6" Height="6" />
                                <TextBlock Text="{Binding SourceName}" Margin="6,0,0,0" FontSize="11.5" FontWeight="Bold" Foreground="#FFC9CDDB" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
                <lib:DashRing x:Name="Ring" Margin="-3" CornerRadius="18" Stroke="{DynamicResource Hp.Brush.HdrOn}" Visibility="Collapsed" />
                <!-- HDR automatisch: Sonne in Ruhe, Schalter beim Überfahren und bei Auswahl -->
                <Border x:Name="SunBadge" Width="24" Height="24" CornerRadius="12" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,9,9"
                        Background="{DynamicResource Hp.Brush.Accent}" BorderBrush="#73050609" BorderThickness="2" IsHitTestVisible="False"
                        Visibility="{Binding HdrAuto, Converter={StaticResource Lib.BoolToVisibility}}">
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE706;" FontSize="12" HorizontalAlignment="Center" Foreground="{DynamicResource Hp.Brush.TextOnAccent}" />
                </Border>
                <CheckBox x:Name="TileSwitch" Style="{StaticResource Lib.TileToggleSwitch}" IsChecked="{Binding HdrAuto}" HorizontalAlignment="Right" VerticalAlignment="Bottom"
                          Margin="0,0,9,10" Visibility="Collapsed"
                          AutomationProperties.AutomationId="TileHdrAutoToggle" AutomationProperties.Name="{x:Static res:LibraryStrings.Row_HdrAutoName}"
                          ToolTip="{x:Static res:LibraryStrings.Row_HdrAutoName}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasCover}" Value="True">
                    <Setter TargetName="GenIcon" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="GenName" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasCover}" Value="False">
                    <Setter TargetName="TileName" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                    <Setter TargetName="GenIconImage" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Icon, Converter={StaticResource Lib.BoolToVisibility}}" Value="Visible">
                    <Setter TargetName="GenMono" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.ShowsHdrOn, RelativeSource={RelativeSource AncestorType=ListBox}}" Value="True">
                    <Setter TargetName="HdrGlow" Property="Opacity" Value="1" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsInstalled}" Value="False">
                    <Setter TargetName="Card" Property="Opacity" Value="0.55" />
                </DataTrigger>
                <!-- Gewählt: Ring im Takt, Hof, Quelle und Schalter -->
                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Ring" Property="Visibility" Value="Visible" />
                    <!-- Takt des Rings: MainWindow.RingClock (im Code erzeugt; als Quelle in einer Vorlage würde er eingefroren) -->
                    <Setter TargetName="Ring" Property="Phase" Value="{Binding RingClock.Phase, RelativeSource={RelativeSource AncestorType=Window}}" />
                    <Setter TargetName="SelectedHalo" Property="Opacity" Value="0.6" />
                    <Setter TargetName="SelectRim" Property="Opacity" Value="1" />
                    <Setter TargetName="Scrim" Property="Opacity" Value="1" />
                    <Setter TargetName="TileSource" Property="Opacity" Value="1" />
                    <Setter TargetName="SunBadge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TileSwitch" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="Scrim" Property="Opacity" Value="1" />
                    <Setter TargetName="TileName" Property="Opacity" Value="1" />
                    <Setter TargetName="TileSource" Property="Opacity" Value="1" />
                    <Setter TargetName="SunBadge" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TileSwitch" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsKeyboardFocusWithin, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                    <Setter TargetName="SelectRim" Property="Opacity" Value="1" />
                    <Setter TargetName="TileSwitch" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <!-- Stufe „Voll“: Kachel hebt sich beim Überfahren (−10 px, 1,035), Bild zoomt leicht, Glanz unter der Maus -->
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True" />
                        <Condition Binding="{Binding IsFull, Source={x:Static lib:LibraryMotion.Instance}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter TargetName="Shine" Property="Opacity" Value="1" />
                    <MultiDataTrigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TileRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="-10" Duration="0:0:0.45" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                <DoubleAnimation Storyboard.TargetName="TileRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1.035" Duration="0:0:0.45" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                <DoubleAnimation Storyboard.TargetName="TileRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1.035" Duration="0:0:0.45" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                <DoubleAnimation Storyboard.TargetName="CoverArt" Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.8" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                <DoubleAnimation Storyboard.TargetName="CoverArt" Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.8" EasingFunction="{StaticResource Hp.Ease.Out}" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.EnterActions>
                    <MultiDataTrigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="TileRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[1].(TranslateTransform.Y)" To="0" Duration="0:0:0.45" EasingFunction="{StaticResource Hp.Ease.Out}" FillBehavior="Stop" />
                                <DoubleAnimation Storyboard.TargetName="TileRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Hp.Ease.Out}" FillBehavior="Stop" />
                                <DoubleAnimation Storyboard.TargetName="TileRoot" Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[0].(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.45" EasingFunction="{StaticResource Hp.Ease.Out}" FillBehavior="Stop" />
                                <DoubleAnimation Storyboard.TargetName="CoverArt" Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.5" FillBehavior="Stop" />
                                <DoubleAnimation Storyboard.TargetName="CoverArt" Storyboard.TargetProperty="(Border.Background).(ImageBrush.RelativeTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.5" FillBehavior="Stop" />
                            </Storyboard>
                        </BeginStoryboard>
                    </MultiDataTrigger.ExitActions>
                </MultiDataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Quellen-Filter -->
        <DataTemplate x:Key="SourceOptionTemplate" DataType="{x:Type vm:SourceFilterOption}">
            <DockPanel LastChildFill="True">
                <Border DockPanel.Dock="Right" Style="{StaticResource Lib.Count}" Margin="10,0,0,0">
                    <TextBlock Text="{Binding Count}" />
                </Border>
                <Ellipse DockPanel.Dock="Left" Width="8" Height="8" Margin="0,0,9,0" VerticalAlignment="Center" Fill="{DynamicResource Hp.Brush.TextMuted}" x:Name="Dot" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Source}" Value="Steam">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Hp.Brush.Source.Steam}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="Epic">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Hp.Brush.Source.Epic}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="Xbox">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Hp.Brush.Source.Xbox}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="Gog">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Hp.Brush.Source.Gog}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="Ubisoft">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Hp.Brush.Source.Ubisoft}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="EA">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Hp.Brush.Source.EA}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="BattleNet">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Hp.Brush.Source.BattleNet}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Source}" Value="Manual">
                    <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Hp.Brush.Source.Manual}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Sortierung -->
        <DataTemplate x:Key="SortOptionTemplate" DataType="{x:Type vm:SortOption}">
            <DockPanel LastChildFill="True">
                <TextBlock DockPanel.Dock="Left" Style="{StaticResource Lib.Glyph}" Text="{Binding Glyph}" FontSize="13" Margin="0,0,9,0"
                           Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                <TextBlock x:Name="SortLabel" Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </DataTemplate>

        <!-- Bildschirm-Auswahl -->
        <DataTemplate x:Key="DisplayOptionTemplate" DataType="{x:Type vm:DisplayOptionViewModel}">
            <DockPanel LastChildFill="True">
                <TextBlock x:Name="Glyph" DockPanel.Dock="Left" Style="{StaticResource Lib.Glyph}" Text="&#xE7F4;" Margin="0,0,9,0"
                           Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                <TextBlock x:Name="Detail" DockPanel.Dock="Right" Text="{Binding Detail}" FontSize="11.5" Margin="8,0,0,0" VerticalAlignment="Center"
                           FontWeight="Normal" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                <TextBlock Text="{Binding Label}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsGlobal}" Value="True">
                    <Setter TargetName="Glyph" Property="Text" Value="&#xE713;" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHdrCapable}" Value="True">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Hp.Brush.AccentText}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsConnected}" Value="False">
                    <Setter TargetName="Glyph" Property="Foreground" Value="{DynamicResource Hp.Brush.Warning}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- EXE-Datei mit Herkunft (Prototyp .exe): Dateiname in Festbreitenschrift, Ordner in der Mitte gekürzt -->
        <DataTemplate x:Key="ExecutableTemplate" DataType="{x:Type vm:ExecutableItemViewModel}">
            <Grid x:Name="Root" MinHeight="30">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7C3;" FontSize="15" Margin="0,0,10,0" Foreground="{DynamicResource Hp.Brush.AccentText}" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock x:Name="FileName" Text="{Binding FileName}" FontFamily="{DynamicResource Hp.Font.Mono}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"
                               Foreground="{DynamicResource Hp.Brush.Text}" ToolTip="{Binding Path}" />
                    <lib:MiddleEllipsisText FullText="{Binding DisplayFolder}" FontSize="11" Margin="0,1,0,0" Foreground="{DynamicResource Hp.Brush.TextMuted}"
                                            Visibility="{Binding Folder, Converter={StaticResource Lib.BoolToVisibility}}" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="10,0,0,0" VerticalAlignment="Center">
                    <Ellipse x:Name="OriginDot" Width="6" Height="6" Margin="0,0,5,0" Fill="{DynamicResource Hp.Brush.Success}" VerticalAlignment="Center" />
                    <TextBlock x:Name="Origin" Text="{Binding OriginText}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Success}" VerticalAlignment="Center" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInactive}" Value="True">
                    <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                    <Setter TargetName="OriginDot" Property="Fill" Value="{DynamicResource Hp.Brush.TextMuted}" />
                    <Setter TargetName="Origin" Property="Foreground" Value="{DynamicResource Hp.Brush.TextMuted}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsExcluded}" Value="True">
                    <Setter TargetName="FileName" Property="TextDecorations" Value="Strikethrough" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Vorschlag aus einem Suchordner -->
        <DataTemplate x:Key="CandidateTemplate" DataType="{x:Type vm:CandidateItemViewModel}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid Width="34" Height="34">
                    <Border CornerRadius="9" Background="{DynamicResource Hp.Brush.Source.Manual}" Opacity="0.16" />
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE8B7;" FontSize="15" HorizontalAlignment="Center"
                               Foreground="{DynamicResource Hp.Brush.Source.Manual}" />
                </Grid>
                <StackPanel Grid.Column="1" Margin="12,0,10,0" VerticalAlignment="Center">
                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.Text}" />
                    <TextBlock Text="{Binding DetailText}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.TextSecondary}" ToolTip="{Binding Folder}" />
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource Lib.SmallGhostButton}" VerticalAlignment="Center"
                        Command="{Binding DataContext.AddCandidateCommand, RelativeSource={RelativeSource AncestorType=ListBox}}" CommandParameter="{Binding}"
                        AutomationProperties.AutomationId="AddCandidateButton"
                        AutomationProperties.Name="{x:Static res:LibraryStrings.Candidate_Add}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE710;" FontSize="12" Margin="0,0,7,0" />
                        <TextBlock Text="{x:Static res:LibraryStrings.Candidate_Add}" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Fehler eines Scanners -->
        <DataTemplate x:Key="ScanErrorTemplate" DataType="{x:Type vm:ScanErrorItem}">
            <StackPanel Margin="0,0,0,6">
                <TextBlock Text="{Binding Text}" TextWrapping="Wrap" FontSize="13" Foreground="{DynamicResource Hp.Brush.Text}" />
                <TextBlock Text="{Binding Path}" FontSize="11.5" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.TextSecondary}"
                           ToolTip="{Binding Path}" Visibility="{Binding HasPath, Converter={StaticResource Lib.BoolToVisibility}}" />
            </StackPanel>
        </DataTemplate>

        <!-- Symbol-Kachel links vom Namen (Ersatz-Titelbild): Glas mit Symbol, sonst Monogramm auf den Namensfarben -->
        <DataTemplate x:Key="HeroIconTile" DataType="{x:Type vm:HeroViewModel}">
            <Grid>
                <Border CornerRadius="20" Background="{Binding Item.NameField}" />
                <Border x:Name="Glass" CornerRadius="20" BorderThickness="1" BorderBrush="#38FFFFFF">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#2BFFFFFF" Offset="0" />
                            <GradientStop Color="#0AFFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <TextBlock x:Name="Mono" Text="{Binding Monogram}" FontFamily="{StaticResource Lib.Font.Display}" FontWeight="Bold" FontSize="26" Foreground="#FFFFFFFF"
                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                <Image x:Name="Icon" Source="{Binding IconImage}" Margin="16" RenderOptions.BitmapScalingMode="HighQuality" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IconImage}" Value="{x:Null}">
                    <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IconImage, Converter={StaticResource Lib.BoolToVisibility}}" Value="Visible">
                    <Setter TargetName="Mono" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!-- Titel im schmalen Titelbereich (Liste, Raster): Logo, sonst der Name in der Titelschrift -->
        <DataTemplate x:Key="HeroTitleCompact" DataType="{x:Type vm:HeroViewModel}">
            <Grid>
                <!-- Logo in Bildpunkten gemessen (nicht nach dpi-Angabe der Datei), nur verkleinert -->
                <Viewbox MaxWidth="380" MaxHeight="94" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Visibility="{Binding HasLogo, Converter={StaticResource Lib.BoolToVisibility}}">
                    <Image Source="{Binding Logo}" Width="{Binding LogoWidth}" Height="{Binding LogoHeight}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Viewbox>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Visibility="{Binding ShowName, Converter={StaticResource Lib.BoolToVisibility}}">
                    <ContentControl Width="72" Height="72" Margin="0,0,18,0" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource HeroIconTile}"
                                    Visibility="{Binding ShowIconTile, Converter={StaticResource Lib.BoolToVisibility}}" />
                    <!-- Umbruchbreite vom Fenster (FitCompactHero): wird es eng, bricht der Name um statt abgeschnitten zu werden -->
                    <Viewbox StretchDirection="DownOnly" MaxHeight="84" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid MaxWidth="{Binding CompactNameWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Lib.Font.Display}" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" LineHeight="38"
                                       Foreground="{DynamicResource Lib.Brush.HeroTitle}" />
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Lib.Font.Display}" FontSize="36" FontWeight="Bold" TextWrapping="Wrap" LineHeight="38"
                                       Foreground="{DynamicResource Lib.Brush.HeroSheen}" OpacityMask="{Binding SheenMask, RelativeSource={RelativeSource AncestorType=Window}}" IsHitTestVisible="False" />
                        </Grid>
                    </Viewbox>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Titel im großen Titelbereich (Regal) -->
        <DataTemplate x:Key="HeroTitleLarge" DataType="{x:Type vm:HeroViewModel}">
            <Grid>
                <!-- Logo in Bildpunkten gemessen (nicht nach dpi-Angabe der Datei), nur verkleinert -->
                <Viewbox MaxWidth="600" MaxHeight="190" Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                         Visibility="{Binding HasLogo, Converter={StaticResource Lib.BoolToVisibility}}">
                    <Image Source="{Binding Logo}" Width="{Binding LogoWidth}" Height="{Binding LogoHeight}" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                </Viewbox>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Bottom" Visibility="{Binding ShowName, Converter={StaticResource Lib.BoolToVisibility}}">
                    <ContentControl Width="128" Height="128" Margin="0,0,24,0" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource HeroIconTile}"
                                    Visibility="{Binding ShowIconTile, Converter={StaticResource Lib.BoolToVisibility}}" />
                    <Viewbox StretchDirection="DownOnly" MaxHeight="150" HorizontalAlignment="Left" VerticalAlignment="Center">
                        <Grid MaxWidth="820">
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Lib.Font.Display}" FontSize="58" FontWeight="Bold" TextWrapping="Wrap" LineHeight="60"
                                       Foreground="{DynamicResource Lib.Brush.HeroTitle}" />
                            <TextBlock Text="{Binding Name}" FontFamily="{StaticResource Lib.Font.Display}" FontSize="58" FontWeight="Bold" TextWrapping="Wrap" LineHeight="60"
                                       Foreground="{DynamicResource Lib.Brush.HeroSheen}" OpacityMask="{Binding SheenMask, RelativeSource={RelativeSource AncestorType=Window}}" IsHitTestVisible="False" />
                        </Grid>
                    </Viewbox>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <!-- Angaben im Titelbereich: Quelle, HDR-Angabe, AUTO HDR, NEU (über dem Bild, hell) -->
        <DataTemplate x:Key="HeroMeta" DataType="{x:Type vm:HeroViewModel}">
            <StackPanel Orientation="Horizontal">
                <Border Height="26" CornerRadius="13" Padding="9,0,11,0" Background="{StaticResource Lib.Brush.ArtChip}" BorderBrush="{StaticResource Lib.Brush.ArtChipLine}" BorderThickness="1">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Ellipse Style="{StaticResource Lib.SourceDot}" Width="8" Height="8" />
                        <TextBlock Text="{Binding SourceName}" Margin="7,0,0,0" FontSize="13" FontWeight="Bold" Foreground="#FFFFFFFF" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Lib.ArtTag}" Margin="10,0,0,0">
                    <TextBlock Text="{Binding HdrKindLabel}" VerticalAlignment="Center" />
                </Border>
                <Border Style="{StaticResource Lib.AutoHdrBadge}" Margin="8,0,0,0" Height="22" Background="{DynamicResource Hp.Brush.Accent}" BorderThickness="0"
                        TextElement.Foreground="{DynamicResource Hp.Brush.TextOnAccent}"
                        Visibility="{Binding Item.AutoHdr, Converter={StaticResource Lib.BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="{x:Static infra:AppGlyphs.AutoHdr}" FontSize="9" Margin="0,0,4,0" />
                        <TextBlock Text="{x:Static res:LibraryStrings.Badge_AutoHdr}" VerticalAlignment="Center" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Lib.NewBadge}" Margin="8,0,0,0" Height="22" Background="#FFFFFFFF" TextElement.Foreground="#FF0A0B10"
                        Visibility="{Binding Item.IsNew, Converter={StaticResource Lib.BoolToVisibility}}">
                    <TextBlock Text="{x:Static res:LibraryStrings.Badge_New}" VerticalAlignment="Center" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!-- Vorschau-Kachel im Abschnitt „BILDER“ (Inhalt einer Schaltfläche) -->
        <DataTemplate x:Key="ArtworkTileTemplate" DataType="{x:Type vm:ArtworkTileViewModel}">
            <Grid Height="58">
                <Border CornerRadius="10" Background="{DynamicResource Hp.Brush.Surface1}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1" />
                <Grid Margin="4,4,4,20">
                    <Border CornerRadius="7" Background="{Binding Item.NameField}" />
                    <TextBlock Text="{Binding FallbackText}" FontFamily="{StaticResource Lib.Font.Display}" FontWeight="Bold" FontSize="11" Foreground="#FFFFFFFF"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                    <Border x:Name="Fill" CornerRadius="7" Visibility="{Binding HasPreview, Converter={StaticResource Lib.BoolToVisibility}}" Background="#FF0C0D12" ClipToBounds="True">
                        <Image x:Name="Picture" Source="{Binding Preview}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                    </Border>
                </Grid>
                <Ellipse x:Name="Dot" Width="8" Height="8" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,6,6,0"
                         Fill="{StaticResource Lib.Brush.Amber}" Stroke="#73000000" StrokeThickness="2" />
                <TextBlock Text="{Binding Label}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextSecondary}"
                           HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,4" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsLocal}" Value="True">
                    <Setter TargetName="Dot" Property="Fill" Value="{StaticResource Lib.Brush.Ok}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Contain}" Value="True">
                    <Setter TargetName="Picture" Property="Stretch" Value="Uniform" />
                    <Setter TargetName="Picture" Property="Margin" Value="3" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </infra:ChromeWindow.Resources>

    <Grid x:Name="Root">
        <!-- Umgebungslicht in den Farben des Spiels (Farbfeld, Leuchtflächen, Verlauf zum Grund) -->
        <lib:AmbientBackdrop x:Name="Ambient" />

        <!-- Titelbild mit Überblendung, langsamem Zoom, Strahlen, Lichtpunkten und den Elementen des HDR-Moments -->
        <lib:HeroStage x:Name="Hero" VerticalAlignment="Top" Height="220"
                       AutomationProperties.AutomationId="HeroStage" AutomationProperties.Name="{x:Static res:LibraryStrings.Hero_Name}" />

        <!-- Inhalt des Titelbereichs: Liste und Raster schmal (Logo links, Angaben daneben), Regal groß mit Starten-Zeile -->
        <Grid x:Name="HeroContent" VerticalAlignment="Top" Height="220" Margin="32,0,0,0" DataContext="{Binding Hero}"
              Visibility="{Binding Converter={StaticResource Lib.BoolToVisibility}}">
            <Grid.RenderTransform>
                <TranslateTransform />
            </Grid.RenderTransform>
            <!-- Liste und Raster -->
            <Grid x:Name="HeroCompact" VerticalAlignment="Bottom" Margin="0,98,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <ContentControl x:Name="CompactTitle" Grid.RowSpan="2" VerticalAlignment="Bottom" Focusable="False" Margin="0,0,26,0"
                                Content="{Binding}" ContentTemplate="{StaticResource HeroTitleCompact}" />
                <StackPanel x:Name="CompactOverline" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="0,0,0,10">
                    <Border Width="28" Height="2" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,10,0" Background="{DynamicResource Hp.Brush.AccentShine}" />
                    <TextBlock Style="{StaticResource Lib.ArtOverline}" Text="{Binding Overline}" />
                </StackPanel>
                <ContentControl x:Name="CompactMeta" Grid.Column="1" Grid.Row="1" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource HeroMeta}" />
                <!--
                    Starten und „Beim Start …“ rechts wie im Prototyp (gleicher Befehl wie im Detailbereich). Reicht der Platz neben
                    Logo und Angaben nicht, entfällt zuerst die Angabe, dann der Knopf (MainWindow.xaml.cs, FitCompactActions).
                -->
                <StackPanel x:Name="CompactActions" Grid.Column="2" Grid.RowSpan="2" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="24,0,0,0"
                            DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button x:Name="CompactLaunchButton" Style="{StaticResource Lib.PlayButton}" Command="{Binding Details.LaunchCommand}"
                            AutomationProperties.AutomationId="CompactLaunchButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Launch_Button}"
                            ToolTip="{x:Static res:LibraryStrings.Launch_Hint}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE768;" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="{x:Static res:LibraryStrings.Launch_ButtonShort}" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="CompactLaunchChip" Margin="10,0,0,0" Height="50" CornerRadius="15" Padding="16,0" Background="#57000000" BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE706;" FontSize="15" Margin="0,0,10,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{DynamicResource Hp.Color.C3}" />
                                </TextBlock.Foreground>
                            </TextBlock>
                            <StackPanel>
                                <TextBlock Text="{x:Static res:LibraryStrings.Hero_ChipLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Lib.Brush.ArtCaption}" />
                                <TextBlock Text="{Binding Hero.ChipText}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource Hp.Brush.TextOnArt}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
            <!-- Regal -->
            <StackPanel x:Name="HeroLarge" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="0,0,0,74" Visibility="Collapsed">
                <StackPanel x:Name="LargeOverline" Orientation="Horizontal">
                    <Border Width="28" Height="2" CornerRadius="1" VerticalAlignment="Center" Margin="0,0,10,0" Background="{DynamicResource Hp.Brush.AccentShine}" />
                    <TextBlock Style="{StaticResource Lib.ArtOverline}" Text="{Binding Overline}" />
                </StackPanel>
                <ContentControl x:Name="LargeTitle" Margin="0,14,0,0" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource HeroTitleLarge}" />
                <ContentControl x:Name="LargeMeta" Margin="0,18,0,0" Focusable="False" Content="{Binding}" ContentTemplate="{StaticResource HeroMeta}" />
                <!-- Starten | Desktop | Startmenü | Beim Start … -->
                <StackPanel x:Name="LargeActions" Orientation="Horizontal" Margin="0,22,0,0" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}">
                    <Button x:Name="HeroLaunchButton" Style="{StaticResource Lib.PlayButton}" Command="{Binding Details.LaunchCommand}"
                            AutomationProperties.AutomationId="HeroLaunchButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Launch_Button}"
                            ToolTip="{x:Static res:LibraryStrings.Launch_Hint}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE768;" FontSize="15" Margin="0,0,12,0" />
                            <TextBlock Text="{x:Static res:LibraryStrings.Launch_ButtonShort}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Lib.ArtButton}" Margin="10,0,0,0" Command="{Binding Details.CreateDesktopShortcutCommand}"
                            AutomationProperties.AutomationId="HeroDesktopButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Shortcut_DesktopName}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7F4;" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock Text="{x:Static res:LibraryStrings.Shortcut_Desktop}" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource Lib.ArtButton}" Margin="10,0,0,0" Command="{Binding Details.CreateStartMenuShortcutCommand}"
                            AutomationProperties.AutomationId="HeroStartMenuButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Shortcut_StartMenuName}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE8FC;" FontSize="14" Margin="0,0,9,0" />
                            <TextBlock Text="{x:Static res:LibraryStrings.Shortcut_StartMenu}" />
                        </StackPanel>
                    </Button>
                    <Border x:Name="LargeLaunchChip" Margin="10,0,0,0" Height="50" CornerRadius="15" Padding="16,0" Background="#57000000" BorderBrush="#1FFFFFFF" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE706;" FontSize="15" Margin="0,0,10,0">
                                <TextBlock.Foreground>
                                    <SolidColorBrush Color="{DynamicResource Hp.Color.C3}" />
                                </TextBlock.Foreground>
                            </TextBlock>
                            <StackPanel>
                                <TextBlock Text="{x:Static res:LibraryStrings.Hero_ChipLabel}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Lib.Brush.ArtCaption}" />
                                <TextBlock Text="{Binding Hero.ChipText}" FontSize="13" FontWeight="Bold" Margin="0,4,0,0" Foreground="{DynamicResource Hp.Brush.TextOnArt}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- Kopf: Logo, Titel, Kennzahlen; rechts Bildschirm-Kapsel mit HDR-Schalter, Pause, Einstellungen -->
        <Grid x:Name="HeaderArea" VerticalAlignment="Top" Height="52" Margin="32,40,32,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Grid x:Name="BrandTile" Width="44" Height="44">
                    <Border CornerRadius="14" Background="#9E0A0B11" BorderBrush="#24FFFFFF" BorderThickness="1" />
                    <Border x:Name="BrandTileOn" CornerRadius="14" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                    <Viewbox Width="26" Height="26">
                        <Canvas Width="24" Height="24">
                            <Path x:Name="BrandFill" Data="M7,17 A5,5 0 0 1 17,17 Z" Opacity="0" Fill="{DynamicResource Hp.Brush.TextOnAccent}" />
                            <Path x:Name="BrandGlyph" Data="M4,17 H20 M7,17 A5,5 0 0 1 17,17 M12,6.5 V8.7 M6.4,9.4 L7.9,10.9 M17.6,9.4 L16.1,10.9"
                                  StrokeThickness="2.1" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Stroke="{DynamicResource Hp.Brush.AccentText}" />
                        </Canvas>
                    </Viewbox>
                </Grid>
                <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="{x:Static res:LibraryStrings.Header_Title}" FontFamily="{StaticResource Lib.Font.Display}" FontSize="21" FontWeight="Bold"
                               Foreground="{DynamicResource Hp.Brush.TextOnArt}" />
                    <StackPanel x:Name="HeaderStats" Orientation="Horizontal" Margin="0,5,0,0"
                                AutomationProperties.Name="{x:Static res:LibraryStrings.Stats_Name}">
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Ellipse Width="6" Height="6" Fill="{StaticResource Lib.Brush.ArtMuted}" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding TotalText}" Margin="6,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextOnArtSecondary}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,14,0">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{DynamicResource Hp.Color.C1}" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding HdrAutoText}" Margin="6,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextOnArtSecondary}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Visibility="{Binding NewCount, Converter={StaticResource Lib.BoolToVisibility}}">
                            <Ellipse Width="6" Height="6" VerticalAlignment="Center">
                                <Ellipse.Fill>
                                    <SolidColorBrush Color="{DynamicResource Hp.Color.C3}" />
                                </Ellipse.Fill>
                            </Ellipse>
                            <TextBlock Text="{Binding NewText}" Margin="6,0,0,0" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextOnArtSecondary}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <!-- Bildschirm-Kapsel: echte Werte laut DXGI, Skala bis zur Spitze bei eingeschaltetem HDR (nie 1000) -->
                <Grid x:Name="NitsCapsule" Height="52" AutomationProperties.AutomationId="NitsCapsule" AutomationProperties.Name="{x:Static res:LibraryStrings.Nits_CapsuleName}"
                      ToolTip="{Binding Nits.Tooltip}">
                    <Border x:Name="CapsuleHalo" CornerRadius="20" Margin="-4" Background="{DynamicResource Hp.Brush.AccentSoft}" Opacity="0" />
                    <Border x:Name="CapsuleBody" CornerRadius="16" Background="{StaticResource Lib.Brush.HeaderGlass}" BorderBrush="{StaticResource Lib.Brush.HeaderLine}" BorderThickness="1" />
                    <Border x:Name="CapsuleRing" CornerRadius="16" BorderBrush="{DynamicResource Hp.Brush.AccentStrong}" BorderThickness="1" Opacity="0" />
                    <StackPanel Orientation="Horizontal" Margin="16,0,4,0">
                        <!-- Statuspunkt: aus grau, an im Glanz mit Puls (Dauer-Effekt) -->
                        <Grid Width="10" Height="10" VerticalAlignment="Center">
                            <Ellipse x:Name="CapsulePulse" Stroke="{DynamicResource Hp.Brush.Shine}" StrokeThickness="2" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <ScaleTransform ScaleX="1" ScaleY="1" />
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <Ellipse x:Name="CapsuleDot" Fill="#FF7A7F94" />
                        </Grid>
                        <StackPanel Margin="14,0,14,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Nits.DisplayName}" FontSize="10.5" FontWeight="Bold" Foreground="{StaticResource Lib.Brush.ArtCaption}" MaxWidth="220" TextTrimming="CharacterEllipsis"
                                       AutomationProperties.AutomationId="NitsDisplayName" AutomationProperties.Name="{Binding Nits.DisplayName}" />
                            <TextBlock Text="{Binding HdrShortText}" FontFamily="{StaticResource Lib.Font.Display}" FontSize="14" FontWeight="Bold" Margin="0,4,0,0"
                                       Foreground="{DynamicResource Hp.Brush.TextOnArt}" ToolTip="{Binding HdrStatusText}"
                                       AutomationProperties.AutomationId="HdrStatus" AutomationProperties.Name="{Binding HdrStatusText}" />
                        </StackPanel>
                        <Border Width="1" Margin="0,12" Background="{StaticResource Lib.Brush.HeaderLine}" />
                        <StackPanel x:Name="Readouts" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                            <StackPanel MinWidth="52" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static res:LibraryStrings.Nits_Peak}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Lib.Brush.ArtMuted}" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock x:Name="PeakValue" Text="{Binding Nits.PeakText}" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="13" FontWeight="SemiBold" Foreground="#FFAEB3C6"
                                               AutomationProperties.AutomationId="NitsPeak" AutomationProperties.Name="{Binding Nits.PeakName}" />
                                    <TextBlock Text="{x:Static res:LibraryStrings.Nits_Unit}" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="10" Margin="2,2,0,0" Foreground="{StaticResource Lib.Brush.ArtMuted}"
                                               Visibility="{Binding Nits.HasValues, Converter={StaticResource Lib.BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel MinWidth="52" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static res:LibraryStrings.Nits_FullFrame}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Lib.Brush.ArtMuted}" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock x:Name="FullFrameValue" Text="{Binding Nits.FullFrameText}" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="13" FontWeight="SemiBold" Foreground="#FFAEB3C6"
                                               AutomationProperties.AutomationId="NitsFullFrame" AutomationProperties.Name="{Binding Nits.FullFrameName}" />
                                    <TextBlock Text="{x:Static res:LibraryStrings.Nits_Unit}" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="10" Margin="2,2,0,0" Foreground="{StaticResource Lib.Brush.ArtMuted}"
                                               Visibility="{Binding Nits.HasValues, Converter={StaticResource Lib.BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                            <StackPanel x:Name="MinimumReadout" MinWidth="52" Margin="0,0,12,0">
                                <TextBlock Text="{x:Static res:LibraryStrings.Nits_Minimum}" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Lib.Brush.ArtMuted}" />
                                <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                    <TextBlock x:Name="MinimumValue" Text="{Binding Nits.MinimumText}" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="13" FontWeight="SemiBold" Foreground="#FFAEB3C6"
                                               AutomationProperties.AutomationId="NitsMinimum" AutomationProperties.Name="{Binding Nits.MinimumName}" />
                                    <TextBlock Text="{x:Static res:LibraryStrings.Nits_Unit}" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="10" Margin="2,2,0,0" Foreground="{StaticResource Lib.Brush.ArtMuted}"
                                               Visibility="{Binding Nits.HasValues, Converter={StaticResource Lib.BoolToVisibility}}" />
                                </StackPanel>
                            </StackPanel>
                            <!-- Skala 0 … Spitze (Maximum = Spitze bei eingeschaltetem HDR), Marke beim Vollbild -->
                            <Border x:Name="ScaleBlock">
                                <StackPanel Width="88" Margin="0,0,14,0" VerticalAlignment="Center"
                                            Visibility="{Binding Nits.HasValues, Converter={StaticResource Lib.BoolToVisibility}}">
                                    <lib:NitsScaleBar x:Name="NitsScale" Minimum="0" Maximum="{Binding Nits.ScaleMaximum}" Value="{Binding Nits.ScaleMaximum, Mode=OneWay}" FullFrame="{Binding Nits.Display.FullFrameNits, Mode=OneWay}"
                                                      Track="#1FFFFFFF" Fill="#FF6E7388" Mark="#FFFFFFFF"
                                                      AutomationProperties.AutomationId="NitsScale" AutomationProperties.Name="{x:Static res:LibraryStrings.Nits_ScaleName}" />
                                    <DockPanel Margin="0,3,0,0">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Nits.ScaleEndText}" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="9" Foreground="{StaticResource Lib.Brush.ArtMuted}" />
                                        <TextBlock Text="0" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="9" Foreground="{StaticResource Lib.Brush.ArtMuted}" />
                                    </DockPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                        <!-- HDR jetzt umschalten (bestehender Befehl): Verlauf, bei HDR an als Glas -->
                        <Grid VerticalAlignment="Center">
                            <Canvas x:Name="HdrBurst" Width="0" Height="0" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="22,0,0,0" IsHitTestVisible="False" />
                            <Button x:Name="ToggleHdrButton" Style="{StaticResource Lib.HdrButton}" Tag="{Binding ShowsHdrOn}" Command="{Binding ToggleHdrCommand}"
                                    AutomationProperties.AutomationId="ToggleHdrButton" AutomationProperties.Name="{Binding HdrToggleText}"
                                    ToolTip="{x:Static res:LibraryStrings.Hdr_ToggleTooltip}" ToolTipService.ShowOnDisabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE706;" FontSize="16" Margin="0,0,9,0" />
                                    <TextBlock Text="{Binding HdrToggleText}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>
                <ToggleButton x:Name="PauseToggle" Style="{StaticResource Lib.PauseChip}" Margin="12,0,0,0" IsChecked="{Binding IsPaused}"
                              AutomationProperties.AutomationId="PauseToggle" AutomationProperties.Name="{x:Static res:LibraryStrings.Pause_Name}"
                              ToolTip="{x:Static res:LibraryStrings.Pause_Tooltip}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="PauseGlyph" Style="{StaticResource Lib.Glyph}" Text="&#xE769;" FontSize="13" Margin="0,0,9,0" />
                        <TextBlock x:Name="PauseText" Text="{x:Static res:LibraryStrings.Pause_Label}" />
                    </StackPanel>
                </ToggleButton>
                <Button Style="{StaticResource Lib.GlassIconButton}" Margin="10,0,0,0" Content="&#xE713;" Command="{Binding OpenSettingsCommand}"
                        AutomationProperties.AutomationId="SettingsButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Settings_Name}"
                        ToolTip="{x:Static res:LibraryStrings.Settings_Name}" />
            </StackPanel>
        </Grid>

        <!--
            Spalten: Liste (mit Werkzeugleiste darüber) links, Detailbereich rechts, dazwischen der Trenner. Beide wachsen mit
            dem Fenster; die Aufteilung setzt und merkt MainWindow.xaml.cs (AppSettings.LibraryDetailsRatio). Im Regal nimmt
            die Liste die ganze Breite und der Detailbereich wird zur Schublade über allem.
        -->
        <Grid x:Name="ColumnsArea" Margin="32,104,32,40">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ListColumn" Width="65*" MinWidth="{x:Static vm:LibraryLayout.ListMinWidth}" />
                <ColumnDefinition x:Name="SplitterColumn" Width="24" />
                <ColumnDefinition x:Name="DetailsColumn" Width="35*" MinWidth="{x:Static vm:LibraryLayout.DetailsMinWidth}" MaxWidth="{x:Static lib:ShowcaseLayout.MaxPaneWidth}" />
            </Grid.ColumnDefinitions>

            <!--
                Ziehgriff zwischen Titelbereich und Liste (nur Liste, Wunsch des Nutzers 2026-10-16): direkt unter dem Inhalt
                des Titelbereichs, über der Werkzeugleiste. Lage, Bereich und Merken (AppSettings.LibraryHeroRatio) setzt
                MainWindow.xaml.cs; in der Tab-Reihenfolge vor der Werkzeugleiste.
            -->
            <lib:HeroSplitter x:Name="HeroSplitter" Style="{StaticResource Lib.HeroSplitter}" Margin="0,100,0,0"
                              Moved="OnHeroSplitterMoved" Committed="OnHeroSplitterCommitted" ResetRequested="OnHeroSplitterReset"
                              AutomationProperties.AutomationId="HeroSplitter" AutomationProperties.Name="{x:Static res:LibraryStrings.HeroSplitter_Name}"
                              AutomationProperties.HelpText="{x:Static res:LibraryStrings.HeroSplitter_Help}"
                              ToolTip="{x:Static res:LibraryStrings.HeroSplitter_Tooltip}" ToolTipService.InitialShowDelay="900" />

            <!-- Liste mit Werkzeugleiste, Hinweisen und den drei Ansichten -->
            <Grid x:Name="ListArea" Margin="0,114,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="40" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--
                    Werkzeugleiste: Suche, Quelle, Sortierung, Filter-Chips, Ansicht, Neu einlesen, gesehen, hinzufügen. Wird es
                    eng, faltet sie stufenweise (MainWindow.xaml.cs): erst Beschriftungen, dann die Chips in „Filter“.
                -->
                <DockPanel x:Name="ToolbarArea" LastChildFill="True" Margin="0,0,0,0">
                    <StackPanel x:Name="ActionGroup" DockPanel.Dock="Right" Orientation="Horizontal">
                        <Border Style="{StaticResource Lib.SegmentFrame}" Margin="8,0,0,0" AutomationProperties.Name="{x:Static res:LibraryStrings.View_Name}">
                            <!-- Linien-Symbole des Prototyps: auch ohne Beschriftung (ab Stufe 2) sind Raster und Regal unterscheidbar -->
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="ViewListButton" Style="{StaticResource Lib.SegmentRadio}" GroupName="LibraryView" IsChecked="{Binding IsListView}"
                                             AutomationProperties.AutomationId="ViewListButton" AutomationProperties.Name="{x:Static res:LibraryStrings.View_List}"
                                             ToolTip="{x:Static res:LibraryStrings.View_ListTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <shell:LineIcon Width="15" Height="15" VerticalAlignment="Center" StrokeThickness="2" Data="M9 6h11M9 12h11M9 18h11M4.5 6h.01M4.5 12h.01M4.5 18h.01" />
                                        <TextBlock x:Name="ViewListLabel" Text="{x:Static res:LibraryStrings.View_List}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ViewGridButton" Style="{StaticResource Lib.SegmentRadio}" GroupName="LibraryView" IsChecked="{Binding IsGridView}"
                                             AutomationProperties.AutomationId="ViewGridButton" AutomationProperties.Name="{x:Static res:LibraryStrings.View_Grid}"
                                             ToolTip="{x:Static res:LibraryStrings.View_GridTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <shell:LineIcon Width="15" Height="15" VerticalAlignment="Center" StrokeThickness="2" Data="M4 4h6v6H4zM14 4h6v6h-6zM4 14h6v6H4zM14 14h6v6h-6z" />
                                        <TextBlock x:Name="ViewGridLabel" Text="{x:Static res:LibraryStrings.View_Grid}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton x:Name="ViewShelfButton" Style="{StaticResource Lib.SegmentRadio}" GroupName="LibraryView" IsChecked="{Binding IsShelfView}"
                                             AutomationProperties.AutomationId="ViewShelfButton" AutomationProperties.Name="{x:Static res:LibraryStrings.View_Shelf}"
                                             ToolTip="{x:Static res:LibraryStrings.View_ShelfTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <shell:LineIcon Width="15" Height="15" VerticalAlignment="Center" StrokeThickness="2" Data="M3 6h18M3 18h18M6 9v6M10 9v6M14 9v6M18 9v6" />
                                        <TextBlock x:Name="ViewShelfLabel" Text="{x:Static res:LibraryStrings.View_Shelf}" Margin="6,0,0,0" />
                                    </StackPanel>
                                </RadioButton>
                            </StackPanel>
                        </Border>
                        <Button x:Name="RescanButton" Style="{StaticResource Lib.ToolbarIconButton}" Margin="8,0,0,0" Command="{Binding RescanCommand}"
                                AutomationProperties.AutomationId="RescanButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Rescan_Button}"
                                ToolTip="{x:Static res:LibraryStrings.Rescan_Tooltip}">
                            <TextBlock x:Name="RescanGlyph" Style="{StaticResource Lib.Glyph}" Text="&#xE72C;" FontSize="14" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                        </Button>
                        <Button x:Name="MarkAllSeenButton" Style="{StaticResource Lib.ToolbarIconButton}" Margin="8,0,0,0" Content="&#xE890;" Command="{Binding MarkAllSeenCommand}"
                                AutomationProperties.AutomationId="MarkAllSeenButton" AutomationProperties.Name="{x:Static res:LibraryStrings.MarkAllSeen_Name}"
                                ToolTip="{x:Static res:LibraryStrings.MarkAllSeen_Name}" ToolTipService.ShowOnDisabled="True" />
                        <Button x:Name="AddGameButton" Style="{StaticResource Lib.ToolbarButton}" Margin="8,0,0,0" Command="{Binding AddGameCommand}"
                                AutomationProperties.AutomationId="AddGameButton" AutomationProperties.Name="{x:Static res:LibraryStrings.AddGame_Button}"
                                ToolTip="{x:Static res:LibraryStrings.AddGame_Button}">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE710;" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.AccentText}" />
                                <TextBlock x:Name="AddGameLabel" Text="{x:Static res:LibraryStrings.AddGame_Button}" Margin="8,0,0,0" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <StackPanel x:Name="FilterGroup" Orientation="Horizontal" ClipToBounds="False">
                        <Grid x:Name="SearchHost" Width="236">
                            <TextBox x:Name="SearchBox" Style="{StaticResource Lib.SearchBox}" Tag="{x:Static res:LibraryStrings.Search_Short}"
                                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                     AutomationProperties.AutomationId="SearchBox" AutomationProperties.Name="{x:Static res:LibraryStrings.Search_Name}" />
                            <Border x:Name="SearchKey" Style="{StaticResource Lib.Kbd}" HorizontalAlignment="Right" Margin="0,0,10,0" IsHitTestVisible="False"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}">
                                <TextBlock Text="{x:Static res:LibraryStrings.Key_CtrlF}" />
                            </Border>
                            <Button Style="{StaticResource Lib.LinkButton}" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0"
                                    Foreground="{DynamicResource Hp.Brush.TextMuted}" Command="{Binding ClearSearchCommand}"
                                    Visibility="{Binding HasSearchText, Converter={StaticResource Lib.BoolToVisibility}}"
                                    AutomationProperties.AutomationId="ClearSearchButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Search_Clear}"
                                    ToolTip="{x:Static res:LibraryStrings.Search_Clear}">
                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE711;" FontSize="11" Margin="4" />
                            </Button>
                        </Grid>
                        <ComboBox x:Name="SourceFilter" Width="188" Margin="8,0,0,0" Style="{StaticResource Lib.ComboBox}"
                                  ItemsSource="{Binding SourceOptions}" SelectedItem="{Binding SelectedSource}" ItemTemplate="{StaticResource SourceOptionTemplate}"
                                  ItemContainerStyle="{StaticResource Lib.SourceComboBoxItem}"
                                  AutomationProperties.AutomationId="SourceFilter" AutomationProperties.Name="{x:Static res:LibraryStrings.Filter_SourceName}" />
                        <ComboBox x:Name="SortOrder" Width="196" Margin="8,0,0,0" Style="{StaticResource Lib.ComboBox}"
                                  ItemsSource="{Binding SortOptions}" SelectedItem="{Binding SelectedSortOption}" ItemTemplate="{StaticResource SortOptionTemplate}"
                                  AutomationProperties.AutomationId="SortOrder" AutomationProperties.Name="{x:Static res:LibraryStrings.Sort_Name}"
                                  ToolTip="{x:Static res:LibraryStrings.Sort_Name}" />
                        <StackPanel x:Name="ChipGroup" Orientation="Horizontal">
                            <ToggleButton Margin="8,0,0,0" Style="{StaticResource Lib.Chip}" IsChecked="{Binding OnlySelected}"
                                          AutomationProperties.AutomationId="OnlySelectedToggle" AutomationProperties.Name="{x:Static res:LibraryStrings.Filter_OnlySelectedName}"
                                          ToolTip="{x:Static res:LibraryStrings.Filter_OnlySelectedName}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Lib.ChipGlyph}" Text="&#xE706;" />
                                    <TextBlock Text="{x:Static res:LibraryStrings.Chip_HdrAuto}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Lib.ChipCount}">
                                        <TextBlock Text="{Binding HdrAutoCount}" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Margin="8,0,0,0" Style="{StaticResource Lib.Chip}" IsChecked="{Binding OnlyNew}"
                                          AutomationProperties.AutomationId="OnlyNewToggle" AutomationProperties.Name="{x:Static res:LibraryStrings.Filter_OnlyNewName}"
                                          ToolTip="{x:Static res:LibraryStrings.Filter_OnlyNewName}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Lib.ChipGlyph}" Text="&#xE734;" />
                                    <TextBlock Text="{x:Static res:LibraryStrings.Filter_OnlyNew}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Lib.ChipCount}">
                                        <TextBlock Text="{Binding NewCount}" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>
                            <ToggleButton Margin="8,0,0,0" Style="{StaticResource Lib.Chip}" IsChecked="{Binding OnlyHdrCapable}"
                                          AutomationProperties.AutomationId="OnlyHdrCapableToggle" AutomationProperties.Name="{x:Static res:LibraryStrings.Filter_OnlyHdrCapableName}"
                                          ToolTip="{x:Static res:LibraryStrings.Filter_OnlyHdrCapableName}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Lib.ChipGlyph}" Text="&#xE7F4;" />
                                    <TextBlock Text="{x:Static res:LibraryStrings.Filter_OnlyHdrCapable}" VerticalAlignment="Center" />
                                    <Border Style="{StaticResource Lib.ChipCount}">
                                        <TextBlock Text="{Binding HdrCapableCount}" />
                                    </Border>
                                </StackPanel>
                            </ToggleButton>
                        </StackPanel>
                        <!-- Zusammengefaltet: dieselben drei Filter in einem Menü -->
                        <Button x:Name="FilterMenuButton" Style="{StaticResource Lib.ToolbarButton}" Margin="8,0,0,0" Visibility="Collapsed" Click="OnFilterMenuClick"
                                Tag="{Binding}"
                                AutomationProperties.AutomationId="FilterMenuButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Toolbar_FilterName}">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource Lib.ContextMenu}" DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
                                    <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Chip_HdrAuto}" IsCheckable="True" IsChecked="{Binding OnlySelected}"
                                              InputGestureText="{Binding HdrAutoCount}" AutomationProperties.Name="{x:Static res:LibraryStrings.Filter_OnlySelectedName}">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE706;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Filter_OnlyNew}" IsCheckable="True" IsChecked="{Binding OnlyNew}"
                                              InputGestureText="{Binding NewCount}" AutomationProperties.Name="{x:Static res:LibraryStrings.Filter_OnlyNewName}">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE734;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Style="{StaticResource Lib.MenuItem}" Header="{x:Static res:LibraryStrings.Filter_OnlyHdrCapable}" IsCheckable="True" IsChecked="{Binding OnlyHdrCapable}"
                                              InputGestureText="{Binding HdrCapableCount}" AutomationProperties.Name="{x:Static res:LibraryStrings.Filter_OnlyHdrCapableName}">
                                        <MenuItem.Icon>
                                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7F4;" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE71C;" FontSize="13" Margin="0,0,8,0" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                                <TextBlock Text="{x:Static res:LibraryStrings.Toolbar_Filter}" />
                                <Border Style="{StaticResource Lib.Count}" Background="{DynamicResource Hp.Brush.Accent}" TextElement.Foreground="{DynamicResource Hp.Brush.TextOnAccent}"
                                        Visibility="{Binding ActiveFilterCount, Converter={StaticResource Lib.BoolToVisibility}}">
                                    <TextBlock Text="{Binding ActiveFilterCount}" />
                                </Border>
                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE70D;" FontSize="10" Margin="8,0,0,0" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <!-- Hinweise: Fehler je Scanner und Vorschläge aus Suchordnern (nur wenn es welche gibt) -->
                <StackPanel x:Name="NoticeArea" Grid.Row="1">
                    <Expander x:Name="ScanErrorsExpander" Margin="0,10,0,0" Style="{StaticResource Lib.WarningExpander}" Header="{Binding ScanErrorsHeader}"
                              Visibility="{Binding HasScanErrors, Converter={StaticResource Lib.BoolToVisibility}}"
                              AutomationProperties.AutomationId="ScanErrors" AutomationProperties.Name="{Binding ScanErrorsHeader}">
                        <!-- Begrenzte Höhe: viele Fehler dürfen die Spiele nicht verdrängen -->
                        <ScrollViewer MaxHeight="116" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False">
                            <ItemsControl ItemsSource="{Binding ScanErrors}" ItemTemplate="{StaticResource ScanErrorTemplate}" Margin="0,0,8,0" />
                        </ScrollViewer>
                    </Expander>
                    <!-- Vorschläge: ganze Kopfzeile klappt auf und zu; offen höchstens zwei Zeilen hoch -->
                    <Border CornerRadius="16" Padding="6" Margin="0,10,0,0" Background="{DynamicResource Hp.Brush.Glass}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1"
                            Visibility="{Binding HasCandidates, Converter={StaticResource Lib.BoolToVisibility}}">
                        <StackPanel>
                            <ToggleButton x:Name="CandidatesToggle" Style="{StaticResource Lib.SectionHeaderToggle}" IsChecked="False"
                                          AutomationProperties.AutomationId="CandidatesToggle" AutomationProperties.Name="{x:Static res:LibraryStrings.Candidates_Toggle}"
                                          ToolTip="{x:Static res:LibraryStrings.Candidates_Toggle}">
                                <DockPanel>
                                    <Grid Width="30" Height="30" Margin="0,0,12,0">
                                        <Border CornerRadius="9" Background="{DynamicResource Hp.Brush.AccentSoft}" />
                                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE8B7;" FontSize="14" HorizontalAlignment="Center" Foreground="{DynamicResource Hp.Brush.AccentText}" />
                                    </Grid>
                                    <Border DockPanel.Dock="Right" CornerRadius="8" Padding="8,1,8,2" Margin="10,0,0,0" Background="{DynamicResource Hp.Brush.Accent}" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding CandidatesCountText}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextOnAccent}" />
                                    </Border>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="{x:Static res:LibraryStrings.Candidates_Title}" FontWeight="Bold" FontSize="13.5" Foreground="{DynamicResource Hp.Brush.Text}" />
                                        <TextBlock Text="{x:Static res:LibraryStrings.Candidates_Hint}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                                    </StackPanel>
                                </DockPanel>
                            </ToggleButton>
                            <ListBox x:Name="CandidateList" Style="{StaticResource Lib.ListBox}" MaxHeight="122" Margin="8,6,4,2" ItemsSource="{Binding Candidates}"
                                     Visibility="{Binding IsChecked, ElementName=CandidatesToggle, Converter={StaticResource Lib.BoolToVisibility}}"
                                     ItemContainerStyle="{StaticResource Lib.PlainRow}" ItemTemplate="{StaticResource CandidateTemplate}"
                                     AutomationProperties.AutomationId="CandidateList" AutomationProperties.Name="{x:Static res:LibraryStrings.Candidates_Title}" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Grid x:Name="BodyArea" Grid.Row="2" Margin="0,10,0,0">
                    <!-- Liste (Prototyp .lst): Kopf mit sortierbaren Spalten, 46-px-Zeilen -->
                    <Border x:Name="ListCard" CornerRadius="20" Background="{DynamicResource Lib.Brush.ListCard}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1"
                            lib:GameListColumns.LightTheme="False">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="36" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid x:Name="ListHeader" Margin="12,0,16,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border x:Name="ThumbSwitch" CornerRadius="9" Padding="2" Height="26" Width="64" VerticalAlignment="Center" HorizontalAlignment="Left"
                                        Background="{DynamicResource Hp.Brush.Surface1}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1"
                                        AutomationProperties.Name="{x:Static res:LibraryStrings.List_ThumbnailsName}">
                                    <UniformGrid Columns="2">
                                        <RadioButton Style="{StaticResource Lib.SegmentRadio}" MinWidth="0" Padding="0" GroupName="Thumbnail" IsChecked="{Binding IsThumbnailImage}"
                                                     AutomationProperties.AutomationId="ThumbnailImageButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Thumbnail_Image}"
                                                     ToolTip="{x:Static res:LibraryStrings.Thumbnail_Image}">
                                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xEB9F;" FontSize="11" />
                                        </RadioButton>
                                        <RadioButton Style="{StaticResource Lib.SegmentRadio}" MinWidth="0" Padding="0" GroupName="Thumbnail" IsChecked="{Binding IsThumbnailIcon}"
                                                     AutomationProperties.AutomationId="ThumbnailIconButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Thumbnail_Icon}"
                                                     ToolTip="{x:Static res:LibraryStrings.Thumbnail_Icon}">
                                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xF0E2;" FontSize="11" />
                                        </RadioButton>
                                    </UniformGrid>
                                </Border>
                                <Button Grid.Column="1" Style="{StaticResource Lib.ColumnHeader}" Margin="14,0,0,0" Tag="{Binding IsSortedByName}"
                                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:GameSortOrder.Name}"
                                        AutomationProperties.AutomationId="ColumnSortName" AutomationProperties.Name="{x:Static res:LibraryStrings.Sort_ByName}"
                                        ToolTip="{x:Static res:LibraryStrings.List_SortByColumn}">
                                    <TextBlock Text="{Binding ListHeaderText}" />
                                </Button>
                                <TextBlock Grid.Column="2" Width="{Binding (lib:GameListColumns.SourceWidth), RelativeSource={RelativeSource Self}}" Margin="14,0,0,0" Text="{x:Static res:LibraryStrings.List_ColumnSource}" Style="{StaticResource Lib.Overline}"
                                           Visibility="{Binding (lib:GameListColumns.ShowSource), RelativeSource={RelativeSource Self}, Converter={StaticResource Lib.BoolToVisibility}}" />
                                <Button Grid.Column="3" Width="{Binding (lib:GameListColumns.LastPlayedWidth), RelativeSource={RelativeSource Self}}" Margin="14,0,0,0" Style="{StaticResource Lib.ColumnHeader}" Tag="{Binding IsSortedByLastPlayed}"
                                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:GameSortOrder.LastPlayed}"
                                        Visibility="{Binding (lib:GameListColumns.ShowLastPlayed), RelativeSource={RelativeSource Self}, Converter={StaticResource Lib.BoolToVisibility}}"
                                        AutomationProperties.AutomationId="ColumnSortLastPlayed" AutomationProperties.Name="{x:Static res:LibraryStrings.Sort_ByLastPlayed}"
                                        ToolTip="{x:Static res:LibraryStrings.List_SortByColumn}">
                                    <TextBlock Text="{x:Static res:LibraryStrings.List_ColumnLastPlayed}" />
                                </Button>
                                <Button Grid.Column="4" Width="{Binding (lib:GameListColumns.HdrWidth), RelativeSource={RelativeSource Self}}" Margin="14,0,0,0" Style="{StaticResource Lib.ColumnHeader}" Tag="{Binding IsSortedByHdr}"
                                        Command="{Binding SortByCommand}" CommandParameter="{x:Static vm:GameSortOrder.HdrSupport}"
                                        Visibility="{Binding (lib:GameListColumns.ShowHdr), RelativeSource={RelativeSource Self}, Converter={StaticResource Lib.BoolToVisibility}}"
                                        AutomationProperties.AutomationId="ColumnSortHdr" AutomationProperties.Name="{x:Static res:LibraryStrings.Sort_ByHdrSupport}"
                                        ToolTip="{x:Static res:LibraryStrings.List_SortByColumn}">
                                    <TextBlock Text="{x:Static res:LibraryStrings.List_ColumnHdr}" />
                                </Button>
                                <TextBlock Grid.Column="5" Width="118" Margin="14,0,0,0" TextAlignment="Right" Text="{x:Static res:LibraryStrings.List_HdrAutoColumn}" Style="{StaticResource Lib.Overline}" />
                            </Grid>
                            <Border Grid.Row="0" Height="1" VerticalAlignment="Bottom" Background="{DynamicResource Hp.Brush.Line}" />
                            <!-- Nicht mit dem aktuellen Element der Sicht verbinden: Neufiltern darf die Auswahl nicht verschieben. -->
                            <ListBox x:Name="GameList" Grid.Row="1" Style="{StaticResource Lib.ListBox}"
                                     IsSynchronizedWithCurrentItem="False"
                                     ItemContainerStyle="{StaticResource GameRowWithMenu}" ItemTemplate="{StaticResource GameRowTemplate}"
                                     AutomationProperties.AutomationId="GameList" AutomationProperties.Name="{x:Static res:LibraryStrings.List_Name}" />
                        </Grid>
                    </Border>

                    <!-- Raster: Spalten und Kachelgröße nach der Breite (RasterLayout), virtualisiert -->
                    <ListBox x:Name="GameGrid" Style="{StaticResource Lib.ListBox}" Visibility="Collapsed"
                             IsSynchronizedWithCurrentItem="False"
                             ItemContainerStyle="{StaticResource GameTileWithMenu}" ItemTemplate="{StaticResource GameTileTemplate}"
                             AutomationProperties.AutomationId="GameGrid" AutomationProperties.Name="{x:Static res:LibraryStrings.Grid_Name}">
                        <ListBox.ItemsPanel>
                            <!-- Innenabstand oben wie ShowcaseLayout.GridPaddingTop: danach richtet sich die Luft über der Werkzeugleiste -->
                            <ItemsPanelTemplate>
                                <lib:VirtualizingTilePanel Arrangement="Grid" Gap="16" Padding="4,12,4,24" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                    </ListBox>

                    <!-- Regal: eine Kachelreihe über die ganze Breite, seitenweise blättern -->
                    <Grid x:Name="ShelfArea" Visibility="Collapsed">
                        <ListBox x:Name="GameShelf" Style="{StaticResource Lib.ListBox}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                                 IsSynchronizedWithCurrentItem="False"
                                 ItemContainerStyle="{StaticResource GameTileWithMenu}" ItemTemplate="{StaticResource GameTileTemplate}"
                                 AutomationProperties.AutomationId="GameShelf" AutomationProperties.Name="{x:Static res:LibraryStrings.Shelf_Name}">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <lib:VirtualizingTilePanel Arrangement="Shelf" Gap="18" Padding="32,12,32,22" />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>
                        <Border Width="32" HorizontalAlignment="Left" IsHitTestVisible="False" Background="{DynamicResource Lib.Brush.ShelfFadeLeft}" />
                        <Border Width="32" HorizontalAlignment="Right" IsHitTestVisible="False" Background="{DynamicResource Lib.Brush.ShelfFadeRight}" />
                        <Button x:Name="ShelfPrevButton" Style="{StaticResource Lib.RoundButton}" Content="&#xE76B;" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="12,0,0,10"
                                Click="OnShelfPrevious" AutomationProperties.AutomationId="ShelfPrevButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Shelf_Previous}"
                                ToolTip="{x:Static res:LibraryStrings.Shelf_Previous}" />
                        <Button x:Name="ShelfNextButton" Style="{StaticResource Lib.RoundButton}" Content="&#xE76C;" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,12,10"
                                Click="OnShelfNext" AutomationProperties.AutomationId="ShelfNextButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Shelf_Next}"
                                ToolTip="{x:Static res:LibraryStrings.Shelf_Next}" />
                        <TextBlock x:Name="ShelfPosition" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,32,0" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="11"
                                   Foreground="{DynamicResource Hp.Brush.TextMuted}" AutomationProperties.AutomationId="ShelfPosition" />
                    </Grid>

                    <!-- Leere Bibliothek -->
                    <StackPanel x:Name="EmptyLibrary" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="360"
                                Visibility="{Binding IsLibraryEmpty, Converter={StaticResource Lib.BoolToVisibility}}">
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7FC;" FontSize="44" HorizontalAlignment="Center" Foreground="{DynamicResource Hp.Brush.AccentText}" />
                        <TextBlock Style="{StaticResource Hp.Text.Subtitle}" Text="{x:Static res:LibraryStrings.List_EmptyTitle}" HorizontalAlignment="Center" Margin="0,14,0,6" />
                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.List_EmptyText}" TextAlignment="Center" />
                    </StackPanel>

                    <!-- Keine Treffer -->
                    <Border x:Name="NoMatch" VerticalAlignment="Top" Margin="24,58,24,0" CornerRadius="18" Padding="22,18" Background="{DynamicResource Hp.Brush.Surface1}"
                            BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1"
                            Visibility="{Binding IsFilterEmpty, Converter={StaticResource Lib.BoolToVisibility}}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Style="{StaticResource Lib.Glyph}" Text="&#xE721;" FontSize="30" Margin="0,0,18,0" Foreground="{DynamicResource Hp.Brush.AccentText}" />
                            <Button DockPanel.Dock="Right" Style="{StaticResource Lib.PaneButton}" Margin="18,0,0,0" Command="{Binding ClearFiltersCommand}"
                                    AutomationProperties.AutomationId="ResetFiltersButton" AutomationProperties.Name="{x:Static res:LibraryStrings.List_ResetFilters}"
                                    Content="{x:Static res:LibraryStrings.List_ResetFilters}" />
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{x:Static res:LibraryStrings.List_NoMatchTitle}" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" />
                                <TextBlock Text="{x:Static res:LibraryStrings.List_NoMatchText}" FontSize="13" Margin="0,4,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </Grid>
            </Grid>

            <!-- Trenner: zwischen Liste und Details auch in der Tab-Reihenfolge -->
            <GridSplitter x:Name="LibrarySplitter" Grid.Column="1" Style="{StaticResource Lib.Splitter}" Margin="0,174,0,0"
                          DragCompleted="OnSplitterDragCompleted" KeyUp="OnSplitterKeyUp" MouseDoubleClick="OnSplitterDoubleClick"
                          AutomationProperties.AutomationId="LibrarySplitter" AutomationProperties.Name="{x:Static res:LibraryStrings.Splitter_Name}"
                          ToolTip="{x:Static res:LibraryStrings.Splitter_Tooltip}" ToolTipService.InitialShowDelay="900" />

            <!-- Regal: Abdunklung hinter der Schublade (Klick schließt) -->
            <Border x:Name="DrawerShade" Grid.ColumnSpan="3" Margin="0,-40,0,-40" Background="#80040509" Opacity="0" IsHitTestVisible="False"
                    MouseLeftButtonDown="OnDrawerShadeClick" />

            <!-- Detailbereich (Prototyp .pane); im Regal Schublade von rechts -->
            <Border x:Name="DetailsArea" Grid.Column="2" CornerRadius="24" Background="{DynamicResource Hp.Brush.Panel}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1"
                    ClipToBounds="True">
                <Border.RenderTransform>
                    <TranslateTransform />
                </Border.RenderTransform>
                <Grid>
                    <!-- Leuchten in den Spielfarben oben links und unten rechts, Glanzkante oben -->
                    <Border CornerRadius="24" IsHitTestVisible="False" Background="{DynamicResource Lib.Brush.PaneGlow}" />
                    <Border Height="1" VerticalAlignment="Top" Margin="24,0" Background="{DynamicResource Hp.Brush.AccentShine}" Opacity="0.7" IsHitTestVisible="False" />
                    <ScrollViewer x:Name="DetailsPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False"
                                  AutomationProperties.AutomationId="DetailsPanel" AutomationProperties.Name="{x:Static res:LibraryStrings.Details_Name}">
                        <Grid Margin="18,16,18,18">
                            <!-- Nichts gewählt -->
                            <StackPanel VerticalAlignment="Center" Margin="12,70,12,0"
                                        Visibility="{Binding HasDetails, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}">
                                <Grid Width="84" Height="84" HorizontalAlignment="Center">
                                    <Border CornerRadius="24" Background="{DynamicResource Hp.Brush.AccentSoft}" />
                                    <Border CornerRadius="24" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.AccentStrong}" />
                                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7FC;" FontSize="36" HorizontalAlignment="Center" Foreground="{DynamicResource Hp.Brush.AccentText}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hp.Text.Subtitle}" Text="{x:Static res:LibraryStrings.Details_EmptyTitle}" HorizontalAlignment="Center" Margin="0,20,0,8" />
                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Details_EmptyText}" TextAlignment="Center" FontSize="13" LineHeight="20" />
                            </StackPanel>

                            <!-- Gewähltes Spiel -->
                            <Grid Visibility="{Binding HasDetails, Converter={StaticResource Lib.BoolToVisibility}}">
                                <StackPanel x:Name="DetailsContent" DataContext="{Binding Details}">
                                    <!-- Kopf: Spielprofil mit Cover, Name, Quelle · Haupt-EXE, Menü (und im Regal Schließen) -->
                                    <Grid x:Name="ProfileHeader" Margin="0,0,0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="46" Height="62" VerticalAlignment="Center">
                                            <Border CornerRadius="10" Background="{Binding Item.NameField}" />
                                            <TextBlock Text="{Binding Item.Monogram}" FontFamily="{StaticResource Lib.Font.Display}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFFFF"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            <Border CornerRadius="10" lib:ImageFill.Source="{Binding CoverPreview}" Visibility="{Binding CoverPreview, Converter={StaticResource Lib.BoolToVisibility}}" />
                                            <Border CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.Line}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Lib.Overline}" Text="{x:Static res:LibraryStrings.Profile_Overline}" />
                                            <TextBlock Text="{Binding Item.Name}" FontSize="15" FontWeight="Bold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource Hp.Brush.Text}" ToolTip="{Binding Item.Name}"
                                                       AutomationProperties.AutomationId="DetailName" />
                                            <TextBlock Text="{Binding ProfileSubtitle}" FontSize="12" Margin="0,2,0,0" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button x:Name="ProfileMenuButton" Style="{StaticResource Lib.PaneButton}" Width="32" Height="32" Padding="0" Click="OnProfileMenuClick"
                                                    Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" ContextMenu="{StaticResource GameContextMenu}"
                                                    AutomationProperties.AutomationId="ProfileMenuButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Profile_More}"
                                                    ToolTip="{x:Static res:LibraryStrings.Profile_More}">
                                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE712;" FontSize="13" />
                                            </Button>
                                            <Button x:Name="DrawerCloseButton" Style="{StaticResource Lib.PaneButton}" Width="32" Height="32" Padding="0" Margin="6,0,0,0" Visibility="Collapsed"
                                                    Click="OnDrawerClose"
                                                    AutomationProperties.AutomationId="DrawerCloseButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Drawer_Close}"
                                                    ToolTip="{x:Static res:LibraryStrings.Drawer_Close}">
                                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE711;" FontSize="12" />
                                            </Button>
                                        </StackPanel>
                                        <Border Grid.ColumnSpan="3" Height="1" VerticalAlignment="Bottom" Margin="0,0,0,-12" Background="{DynamicResource Hp.Brush.Line}" />
                                    </Grid>

                                    <!-- Nicht mehr installiert -->
                                    <Grid Margin="0,18,0,0" Visibility="{Binding Item.IsInstalled, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}">
                                        <Border Style="{StaticResource Lib.StatusTint}" Tag="{x:Static vm:StatusKind.Warning}" />
                                        <DockPanel Margin="12,9">
                                            <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{x:Static vm:StatusKind.Warning}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{x:Static res:LibraryStrings.Details_NotInstalled}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hp.Brush.Text}" />
                                        </DockPanel>
                                    </Grid>

                                    <!-- Starten und Verknüpfungen: die häufigste Aktion zuerst, noch vor der Automatik -->
                                    <Border x:Name="LaunchSection" Style="{StaticResource Lib.Section}" Margin="0,22,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,8">
                                                <TextBlock Style="{StaticResource Lib.SectionTitle}" Text="{x:Static res:LibraryStrings.Details_SectionLaunch}" />
                                                <Border Style="{StaticResource Lib.SectionLine}" />
                                            </DockPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.25*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Button x:Name="LaunchButton" Style="{StaticResource Lib.AccentButton}" HorizontalAlignment="Stretch" Padding="8,0" Command="{Binding LaunchCommand}"
                                                        AutomationProperties.AutomationId="LaunchButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Launch_Button}"
                                                        ToolTip="{x:Static res:LibraryStrings.Launch_Hint}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock x:Name="LaunchGlyph" Style="{StaticResource Lib.Glyph}" Text="&#xE768;" FontSize="12" Margin="0,0,8,0" />
                                                        <TextBlock x:Name="LaunchLabel" Text="{x:Static res:LibraryStrings.Launch_ButtonShort}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Grid.Column="2" Style="{StaticResource Lib.PaneButton}" Padding="6,0" Command="{Binding CreateDesktopShortcutCommand}"
                                                        AutomationProperties.AutomationId="CreateDesktopShortcutButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Shortcut_DesktopName}"
                                                        ToolTip="{x:Static res:LibraryStrings.Shortcut_DesktopName}">
                                                    <TextBlock Text="{x:Static res:LibraryStrings.Shortcut_Desktop}" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                                <Button Grid.Column="4" Style="{StaticResource Lib.PaneButton}" Padding="6,0" Command="{Binding CreateStartMenuShortcutCommand}"
                                                        AutomationProperties.AutomationId="CreateStartMenuShortcutButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Shortcut_StartMenuName}"
                                                        ToolTip="{x:Static res:LibraryStrings.Shortcut_StartMenuName}">
                                                    <TextBlock Text="{x:Static res:LibraryStrings.Shortcut_StartMenu}" TextTrimming="CharacterEllipsis" />
                                                </Button>
                                            </Grid>
                                            <!-- Startbefehl, wie HDRpilot ihn ausführt (Pfade in der Mitte gekürzt) -->
                                            <DockPanel Margin="0,8,0,0" Visibility="{Binding HasLaunchCommandText, Converter={StaticResource Lib.BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE8A7;" FontSize="11" Margin="0,0,6,0" Foreground="{DynamicResource Hp.Brush.TextMuted}" />
                                                <lib:MiddleEllipsisText FullText="{Binding LaunchCommandText}" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="11" Foreground="{DynamicResource Hp.Brush.TextMuted}" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Launch_NoCommand}" Margin="0,8,0,0"
                                                       AutomationProperties.AutomationId="LaunchNoCommandHint"
                                                       Visibility="{Binding CanLaunchGame, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}" />

                                            <!-- Notlösung nur für Steam-Spiele: Startoption, mit der Steam das Spiel über HDRpilot startet -->
                                            <StackPanel x:Name="SteamLaunchOptionArea" Margin="0,10,0,0" Visibility="{Binding IsSteam, Converter={StaticResource Lib.BoolToVisibility}}">
                                                <Button Style="{StaticResource Lib.SmallGhostButton}" HorizontalAlignment="Stretch" Command="{Binding CopySteamLaunchOptionCommand}"
                                                        AutomationProperties.AutomationId="CopySteamLaunchOptionButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Steam_CopyLaunchOptionName}"
                                                        ToolTip="{x:Static res:LibraryStrings.Steam_CopyLaunchOptionName}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE8C8;" FontSize="12" Margin="0,0,7,0" />
                                                        <TextBlock Text="{x:Static res:LibraryStrings.Steam_CopyLaunchOption}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Steam_LaunchOptionHint}" Margin="0,6,0,0"
                                                           AutomationProperties.AutomationId="SteamLaunchOptionHint" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Ergebnis von Start, Verknüpfung oder Steam-Startoption -->
                                    <Grid Margin="0,10,0,0" Visibility="{Binding HasLaunchMessage, Converter={StaticResource Lib.BoolToVisibility}}">
                                        <Border Style="{StaticResource Lib.StatusTint}" Tag="{Binding MessageKind}" />
                                        <DockPanel Margin="12,9">
                                            <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{Binding MessageKind}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hp.Brush.Text}"
                                                       AutomationProperties.AutomationId="DetailMessage" />
                                        </DockPanel>
                                    </Grid>

                                    <!-- Automatik -->
                                    <Border x:Name="AutomationSection" Style="{StaticResource Lib.Section}" Margin="0,14,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Style="{StaticResource Lib.SectionTitle}" Text="{x:Static res:LibraryStrings.Details_SectionAutomation}" />
                                                <Border Style="{StaticResource Lib.SectionLine}" />
                                            </DockPanel>
                                            <Border Style="{StaticResource Lib.SwitchRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Static res:LibraryStrings.Details_HdrAuto}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" />
                                                        <TextBlock Text="{x:Static res:LibraryStrings.Details_HdrAutoHint}" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource Lib.ToggleSwitch}" VerticalAlignment="Center" IsChecked="{Binding Item.HdrAuto}"
                                                              AutomationProperties.AutomationId="DetailHdrAuto" AutomationProperties.Name="{x:Static res:LibraryStrings.Details_HdrAuto}" />
                                                </Grid>
                                            </Border>
                                            <Border Style="{StaticResource Lib.SwitchRow}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                                        <TextBlock Text="{x:Static res:LibraryStrings.Details_Restore}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" />
                                                        <TextBlock Text="{x:Static res:LibraryStrings.Details_RestoreHint}" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                                                    </StackPanel>
                                                    <CheckBox Grid.Column="1" Style="{StaticResource Lib.ToggleSwitch}" VerticalAlignment="Center" IsChecked="{Binding RestoreAfter}"
                                                              AutomationProperties.AutomationId="DetailRestore" AutomationProperties.Name="{x:Static res:LibraryStrings.Details_Restore}" />
                                                </Grid>
                                            </Border>
                                            <!-- Bildschirm: Text oben, Auswahl darunter in voller Breite (Wunsch des Nutzers; nebeneinander
                                                 schnitt die Auswahl bei schmalem Detailbereich den Text ab) -->
                                            <Border Style="{StaticResource Lib.SwitchRow}">
                                                <StackPanel>
                                                    <TextBlock Text="{x:Static res:LibraryStrings.Details_Display}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" />
                                                    <TextBlock Text="{x:Static res:LibraryStrings.Details_DisplayHint}" FontSize="12" Margin="0,1,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                                                    <ComboBox Style="{StaticResource Lib.ComboBox}" Height="34" Margin="0,10,0,0" HorizontalAlignment="Stretch" FontSize="12" ItemsSource="{Binding Displays}" SelectedItem="{Binding SelectedDisplay}"
                                                              ItemTemplate="{StaticResource DisplayOptionTemplate}"
                                                              AutomationProperties.AutomationId="DetailDisplay" AutomationProperties.Name="{x:Static res:LibraryStrings.Details_Display}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!--
                                        Bild (E88): „Windows Auto HDR“ ist etwas anderes als „HDR automatisch“ darüber. Windows rechnet
                                        das SDR-Bild in HDR um; HDRpilot schaltet dafür den globalen Auto-HDR-Schalter direkt vor einem
                                        Start über HDRpilot ein und danach zurück. Bei eigenem HDR laut PCGamingWiki zurückgenommen
                                        dargestellt, aber bedienbar.
                                    -->
                                    <Border x:Name="PictureSection" Style="{StaticResource Lib.Section}" Margin="0,14,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <TextBlock Style="{StaticResource Lib.SectionTitle}" Text="{x:Static res:LibraryStrings.Details_SectionPicture}" />
                                                <Border Style="{StaticResource Lib.SectionLine}" />
                                            </DockPanel>
                                            <!-- Eigenes HDR: Titel und Schalter blasser (deutlich heller als gesperrt), die Erklärung bleibt gut lesbar -->
                                            <Grid x:Name="AutoHdrRow">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Margin="0,0,12,0">
                                                    <WrapPanel>
                                                        <TextBlock x:Name="AutoHdrTitle" Text="{x:Static res:LibraryStrings.Details_AutoHdr}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" VerticalAlignment="Center">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsAutoHdrSubdued}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.7" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <Border Style="{StaticResource Lib.Tag}" DataContext="{Binding Item}">
                                                            <TextBlock Text="{Binding HdrTagText}" />
                                                        </Border>
                                                    </WrapPanel>
                                                    <TextBlock Text="{x:Static res:LibraryStrings.Details_AutoHdrWhere}" FontSize="12" Margin="0,2,0,0" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                                                    <TextBlock x:Name="AutoHdrExplanation" Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Details_AutoHdrHint}" Margin="0,4,0,0" />
                                                </StackPanel>
                                                <CheckBox Grid.Column="1" Margin="0,0,8,0" VerticalAlignment="Center" IsChecked="{Binding AutoHdr}"
                                                          AutomationProperties.AutomationId="DetailAutoHdr" AutomationProperties.Name="{x:Static res:LibraryStrings.Details_AutoHdr}"
                                                          AutomationProperties.HelpText="{x:Static res:LibraryStrings.Details_AutoHdrHint}">
                                                    <CheckBox.Style>
                                                        <Style TargetType="CheckBox" BasedOn="{StaticResource Lib.ToggleSwitch}">
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding IsAutoHdrSubdued}" Value="True">
                                                                    <Setter Property="Opacity" Value="0.7" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </CheckBox.Style>
                                                </CheckBox>
                                            </Grid>
                                            <!-- Wirkt nur bei Starts, die HDRpilot vorher kennt (E88): immer sichtbar, auch vor dem Einschalten -->
                                            <DockPanel Margin="0,8,0,0">
                                                <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{x:Static vm:StatusKind.Info}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top" />
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Details_AutoHdrStartHint}"
                                                           AutomationProperties.AutomationId="DetailAutoHdrStartHint" />
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,0" Visibility="{Binding ShowAutoHdrNativeHint, Converter={StaticResource Lib.BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{x:Static vm:StatusKind.Info}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top" />
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{Binding AutoHdrNativeHint}"
                                                           AutomationProperties.AutomationId="DetailAutoHdrNativeHint" />
                                            </DockPanel>
                                            <DockPanel Margin="0,8,0,0" Visibility="{Binding ShowAutoHdrNeedsHdrHint, Converter={StaticResource Lib.BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{x:Static vm:StatusKind.Info}" FontSize="12" Margin="0,1,8,0" VerticalAlignment="Top" />
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Details_AutoHdrNeedsHdr}"
                                                           AutomationProperties.AutomationId="DetailAutoHdrNeedsHdrHint" />
                                            </DockPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Ergebnis der angebotenen Steam-Startoption nach dem Einschalten von Auto HDR (G9.7) -->
                                    <Grid Margin="0,10,0,0" Visibility="{Binding HasPictureMessage, Converter={StaticResource Lib.BoolToVisibility}}">
                                        <Border Style="{StaticResource Lib.StatusTint}" Tag="{Binding MessageKind}" />
                                        <DockPanel Margin="12,9">
                                            <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{Binding MessageKind}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hp.Brush.Text}"
                                                       AutomationProperties.AutomationId="DetailAutoHdrMessage" />
                                        </DockPanel>
                                    </Grid>

                                    <!-- EXE-Dateien -->
                                    <Border x:Name="ExecutablesSection" Style="{StaticResource Lib.Section}" Margin="0,14,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,4">
                                                <Button DockPanel.Dock="Right" Style="{StaticResource Lib.LinkButton}" Margin="10,0,0,0" Command="{Binding AddExeCommand}" VerticalAlignment="Center"
                                                        AutomationProperties.AutomationId="AddExeButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Exe_AddName}"
                                                        ToolTip="{x:Static res:LibraryStrings.Exe_AddName}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE710;" FontSize="11" Margin="0,0,5,0" />
                                                        <TextBlock Text="{x:Static res:LibraryStrings.Exe_Add}" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Style="{StaticResource Lib.SectionTitle}" Text="{Binding ExecutablesHeader}" />
                                                <Border Style="{StaticResource Lib.SectionLine}" />
                                            </DockPanel>
                                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Details_ExecutablesHint}" Margin="0,0,0,8" />
                                            <ListBox Style="{StaticResource Lib.ListBox}" MaxHeight="230" ItemsSource="{Binding Executables}" SelectedItem="{Binding SelectedExecutable}"
                                                     ItemContainerStyle="{StaticResource Lib.PlainRow}" ItemTemplate="{StaticResource ExecutableTemplate}"
                                                     Visibility="{Binding HasExecutables, Converter={StaticResource Lib.BoolToVisibility}}"
                                                     AutomationProperties.AutomationId="DetailExecutables" AutomationProperties.Name="{x:Static res:LibraryStrings.Details_SectionExecutables}" />
                                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:LibraryStrings.Exe_Empty}" FontStyle="Italic"
                                                       Visibility="{Binding HasExecutables, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}" />
                                            <WrapPanel Margin="0,4,0,0">
                                                <Button Style="{StaticResource Lib.SmallGhostButton}" Margin="0,0,6,6" Command="{Binding RemoveExeCommand}"
                                                        AutomationProperties.AutomationId="RemoveExeButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Exe_RemoveName}"
                                                        ToolTip="{x:Static res:LibraryStrings.Exe_RemoveName}" ToolTipService.ShowOnDisabled="True"
                                                        Visibility="{Binding IsSelectedExecutableExcluded, Converter={StaticResource Lib.BoolToVisibility}, ConverterParameter=invert}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE738;" FontSize="12" Margin="0,0,6,0" />
                                                        <TextBlock Text="{x:Static res:LibraryStrings.Exe_Remove}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource Lib.SmallGhostButton}" Margin="0,0,6,6" Command="{Binding IncludeExeCommand}"
                                                        AutomationProperties.AutomationId="IncludeExeButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Exe_IncludeName}"
                                                        Visibility="{Binding IsSelectedExecutableExcluded, Converter={StaticResource Lib.BoolToVisibility}}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7A7;" FontSize="12" Margin="0,0,6,0" />
                                                        <TextBlock Text="{x:Static res:LibraryStrings.Exe_Include}" />
                                                    </StackPanel>
                                                </Button>
                                                <Button Style="{StaticResource Lib.SmallGhostButton}" Margin="0,0,6,6" Command="{Binding RelearnExeCommand}"
                                                        AutomationProperties.AutomationId="RelearnExeButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Exe_RelearnName}"
                                                        ToolTip="{x:Static res:LibraryStrings.Exe_RelearnName}" ToolTipService.ShowOnDisabled="True">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE81C;" FontSize="12" Margin="0,0,6,0" />
                                                        <TextBlock Text="{x:Static res:LibraryStrings.Exe_Relearn}" />
                                                    </StackPanel>
                                                </Button>
                                            </WrapPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Ergebnis einer Aktion an den EXE-Dateien (direkt darunter, auch wenn der Bereich gescrollt ist) -->
                                    <Grid Margin="0,4,0,0" Visibility="{Binding HasExecutablesMessage, Converter={StaticResource Lib.BoolToVisibility}}">
                                        <Border Style="{StaticResource Lib.StatusTint}" Tag="{Binding MessageKind}" />
                                        <DockPanel Margin="12,9">
                                            <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{Binding MessageKind}" Margin="0,0,10,0" VerticalAlignment="Top" />
                                            <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hp.Brush.Text}"
                                                       AutomationProperties.AutomationId="DetailExeMessage" />
                                        </DockPanel>
                                    </Grid>

                                    <!-- Bilder: Titelbild, Logo, Cover (öffnen „Bild wählen…“), Symbol (öffnet „Symbol ändern…“) -->
                                    <Border x:Name="ArtworkSection" Style="{StaticResource Lib.Section}" Margin="0,14,0,0">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,6">
                                                <Button x:Name="ChooseArtworkButton" DockPanel.Dock="Right" Style="{StaticResource Lib.LinkButton}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                        Command="{Binding DataContext.ChooseArtworkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        AutomationProperties.AutomationId="ChooseArtworkButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Artwork_Choose}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xEB9F;" FontSize="12" Margin="0,0,6,0" />
                                                        <TextBlock Text="{x:Static res:LibraryStrings.Artwork_Choose}" />
                                                    </StackPanel>
                                                </Button>
                                                <TextBlock Style="{StaticResource Lib.SectionTitle}" Text="{x:Static res:LibraryStrings.Artwork_Section}" />
                                                <Border Style="{StaticResource Lib.SectionLine}" />
                                            </DockPanel>
                                            <UniformGrid Columns="4">
                                                <Button Style="{StaticResource Lib.IconButton}" Margin="0,0,6,0" Content="{Binding ArtworkTiles[0]}" ContentTemplate="{StaticResource ArtworkTileTemplate}"
                                                        Command="{Binding DataContext.ChooseArtworkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{x:Static art:ArtworkKind.Hero}"
                                                        ToolTip="{Binding ArtworkTiles[0].Tooltip}" AutomationProperties.AutomationId="ArtworkTileHero" AutomationProperties.Name="{x:Static res:LibraryStrings.Artwork_TileHero}" />
                                                <Button Style="{StaticResource Lib.IconButton}" Margin="0,0,6,0" Content="{Binding ArtworkTiles[1]}" ContentTemplate="{StaticResource ArtworkTileTemplate}"
                                                        Command="{Binding DataContext.ChooseArtworkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{x:Static art:ArtworkKind.Logo}"
                                                        ToolTip="{Binding ArtworkTiles[1].Tooltip}" AutomationProperties.AutomationId="ArtworkTileLogo" AutomationProperties.Name="{x:Static res:LibraryStrings.Artwork_TileLogo}" />
                                                <Button Style="{StaticResource Lib.IconButton}" Margin="0,0,6,0" Content="{Binding ArtworkTiles[2]}" ContentTemplate="{StaticResource ArtworkTileTemplate}"
                                                        Command="{Binding DataContext.ChooseArtworkCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{x:Static art:ArtworkKind.Cover}"
                                                        ToolTip="{Binding ArtworkTiles[2].Tooltip}" AutomationProperties.AutomationId="ArtworkTileCover" AutomationProperties.Name="{x:Static res:LibraryStrings.Artwork_TileCover}" />
                                                <!-- Klick öffnet „Symbol ändern…“ / „Symbol zurücksetzen“ (dasselbe wie im Kontextmenü) -->
                                                <Button x:Name="DetailIconButton" Style="{StaticResource Lib.IconButton}" Content="{Binding ArtworkTiles[3]}" ContentTemplate="{StaticResource ArtworkTileTemplate}"
                                                        Tag="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}"
                                                        ContextMenu="{StaticResource GameIconMenu}" Click="OnDetailIconClick"
                                                        ToolTip="{x:Static res:LibraryStrings.Icon_ButtonName}" ToolTipService.InitialShowDelay="900"
                                                        AutomationProperties.AutomationId="DetailIconButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Icon_ButtonName}" />
                                            </UniformGrid>
                                            <DockPanel Margin="0,8,0,0" Visibility="{Binding HasArtworkSummary, Converter={StaticResource Lib.BoolToVisibility}}">
                                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xEDA2;" FontSize="12" Margin="0,1,7,0" VerticalAlignment="Top" Foreground="{DynamicResource Hp.Brush.TextMuted}" />
                                                <TextBlock Text="{Binding ArtworkSummary}" FontSize="11.5" TextWrapping="Wrap" Foreground="{DynamicResource Hp.Brush.TextMuted}"
                                                           AutomationProperties.AutomationId="DetailArtworkSummary" />
                                            </DockPanel>
                                            <Border Margin="0,8,0,0" CornerRadius="10" Padding="10,8" BorderThickness="1"
                                                    Visibility="{Binding HasGeneratedSummary, Converter={StaticResource Lib.BoolToVisibility}}">
                                                <Border.Background>
                                                    <SolidColorBrush Color="{DynamicResource Hp.Color.C2}" Opacity="0.12" />
                                                </Border.Background>
                                                <Border.BorderBrush>
                                                    <SolidColorBrush Color="{DynamicResource Hp.Color.C2}" Opacity="0.3" />
                                                </Border.BorderBrush>
                                                <DockPanel>
                                                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE945;" FontSize="13" Margin="0,0,8,0">
                                                        <TextBlock.Foreground>
                                                            <SolidColorBrush Color="{DynamicResource Hp.Color.C2}" />
                                                        </TextBlock.Foreground>
                                                    </TextBlock>
                                                    <Button DockPanel.Dock="Right" Style="{StaticResource Lib.LinkButton}" Foreground="{DynamicResource Hp.Brush.Text}" Margin="10,0,0,0" VerticalAlignment="Center"
                                                            Command="{Binding DataContext.ChooseArtworkCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            AutomationProperties.AutomationId="ChangeArtworkButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Artwork_Choose}">
                                                        <TextBlock Text="{x:Static res:LibraryStrings.Artwork_Change}" TextDecorations="Underline" />
                                                    </Button>
                                                    <TextBlock Text="{Binding GeneratedSummary}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Hp.Brush.TextSecondary}" VerticalAlignment="Center" />
                                                </DockPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!-- Installationsordner -->
                                    <StackPanel Margin="0,16,0,8" Visibility="{Binding HasInstallDir, Converter={StaticResource Lib.BoolToVisibility}}">
                                        <TextBlock Style="{StaticResource Lib.Overline}" Text="{x:Static res:LibraryStrings.Details_InstallDir}" Margin="0,0,0,4" />
                                        <TextBlock Text="{Binding InstallDir}" FontSize="12" TextWrapping="Wrap" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                                    </StackPanel>

                                    <Button Style="{StaticResource Lib.DangerButton}" HorizontalAlignment="Left" Margin="0,8,0,0" Command="{Binding RemoveGameCommand}"
                                            Visibility="{Binding IsManual, Converter={StaticResource Lib.BoolToVisibility}}"
                                            AutomationProperties.AutomationId="RemoveGameButton" AutomationProperties.Name="{x:Static res:LibraryStrings.RemoveGame_Button}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE74D;" FontSize="12" Margin="0,0,7,0" />
                                            <TextBlock Text="{x:Static res:LibraryStrings.RemoveGame_Button}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Regal: kompakte Automatik-Karte über dem Titelbild; „Details“ (Taste I) öffnet den vollen Detailbereich -->
        <Border x:Name="AutomationCard" HorizontalAlignment="Right" VerticalAlignment="Top" Width="330" Margin="0,104,32,0" Padding="16,14" CornerRadius="22"
                Background="{DynamicResource Lib.Brush.Card}" BorderBrush="{DynamicResource Lib.Brush.CardLine}" BorderThickness="1" Visibility="Collapsed"
                AutomationProperties.AutomationId="AutomationCard" AutomationProperties.Name="{x:Static res:LibraryStrings.Card_Name}">
            <StackPanel>
                <TextBlock Text="{x:Static res:LibraryStrings.Card_Title}" FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource Lib.Brush.CardMuted}" />
                <TextBlock Text="{Binding SelectedGame.Name}" FontSize="15" FontWeight="Bold" Margin="0,6,0,10" TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Lib.Brush.CardText}" />
                <Border Height="1" Background="{DynamicResource Lib.Brush.CardLine}" />
                <DockPanel MinHeight="48">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Lib.ToggleSwitch}" VerticalAlignment="Center" IsChecked="{Binding SelectedGame.HdrAuto}"
                              AutomationProperties.AutomationId="CardHdrAuto" AutomationProperties.Name="{x:Static res:LibraryStrings.Card_HdrAuto}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:LibraryStrings.Card_HdrAuto}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Lib.Brush.CardText}" />
                        <TextBlock Text="{x:Static res:LibraryStrings.Card_HdrAutoHint}" FontSize="11.5" Margin="0,2,0,0" Foreground="{DynamicResource Lib.Brush.CardSecondary}" />
                    </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource Lib.Brush.CardLine}" />
                <DockPanel MinHeight="48">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Lib.ToggleSwitch}" VerticalAlignment="Center" IsChecked="{Binding Details.RestoreAfter}"
                              AutomationProperties.AutomationId="CardRestore" AutomationProperties.Name="{x:Static res:LibraryStrings.Details_Restore}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="{x:Static res:LibraryStrings.Card_Restore}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Lib.Brush.CardText}" />
                        <TextBlock Text="{x:Static res:LibraryStrings.Card_RestoreHint}" FontSize="11.5" Margin="0,2,0,0" Foreground="{DynamicResource Lib.Brush.CardSecondary}" />
                    </StackPanel>
                </DockPanel>
                <Border Height="1" Background="{DynamicResource Lib.Brush.CardLine}" />
                <DockPanel MinHeight="48">
                    <CheckBox DockPanel.Dock="Right" Style="{StaticResource Lib.ToggleSwitch}" VerticalAlignment="Center" IsChecked="{Binding Details.AutoHdr}"
                              AutomationProperties.AutomationId="CardAutoHdr" AutomationProperties.Name="{x:Static res:LibraryStrings.Card_AutoHdr}" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock x:Name="CardAutoHdrTitle" Text="{x:Static res:LibraryStrings.Card_AutoHdr}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Lib.Brush.CardText}" />
                        <Border Style="{StaticResource Lib.Tag}" Margin="0,4,0,0" HorizontalAlignment="Left" DataContext="{Binding SelectedGame}">
                            <TextBlock Text="{Binding HdrTagText}" />
                        </Border>
                    </StackPanel>
                </DockPanel>
                <Button x:Name="DetailsDrawerButton" Style="{StaticResource Lib.PaneButton}" Margin="0,10,0,0" HorizontalContentAlignment="Stretch" Command="{Binding ToggleDetailsDrawerCommand}"
                        AutomationProperties.AutomationId="DetailsDrawerButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Card_DetailsName}"
                        ToolTip="{x:Static res:LibraryStrings.Card_DetailsName}">
                    <DockPanel Width="270">
                        <Border DockPanel.Dock="Right" Style="{StaticResource Lib.Kbd}">
                            <TextBlock Text="{x:Static res:LibraryStrings.Key_I}" />
                        </Border>
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE8A0;" FontSize="13" Margin="0,0,10,0" />
                        <TextBlock Text="{x:Static res:LibraryStrings.Card_Details}" VerticalAlignment="Center" />
                    </DockPanel>
                </Button>
            </StackPanel>
        </Border>

        <!-- Statuszeile: Automatik, Ansicht, Tastenhinweise, Effekte -->
        <DockPanel x:Name="StatusBar" VerticalAlignment="Bottom" Height="20" Margin="32,0,32,9" LastChildFill="False"
                   AutomationProperties.Name="{x:Static res:LibraryStrings.Status_Name}">
            <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                <Ellipse x:Name="StatusDot" Width="7" Height="7" VerticalAlignment="Center" Fill="{StaticResource Lib.Brush.Ok}" />
                <TextBlock Text="{Binding AutomationStateText}" Margin="7,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.TextSecondary}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="AutomationState" />
            </StackPanel>
            <TextBlock x:Name="ViewSummary" DockPanel.Dock="Left" Text="{Binding ViewSummaryText}" Margin="18,0,0,0" FontSize="12" FontWeight="SemiBold"
                       Foreground="{DynamicResource Hp.Brush.TextMuted}" VerticalAlignment="Center" AutomationProperties.AutomationId="ViewSummary" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="18,0,0,0">
                <TextBlock x:Name="EffectsGlyph" Style="{StaticResource Lib.Glyph}" Text="&#xE945;" FontSize="12" Margin="0,0,6,0" Foreground="{DynamicResource Hp.Brush.AccentText}" />
                <TextBlock Text="{Binding EffectsText}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.TextMuted}" VerticalAlignment="Center"
                           AutomationProperties.AutomationId="EffectsState" />
            </StackPanel>
            <StackPanel x:Name="KeyHints" DockPanel.Dock="Right" Orientation="Horizontal" TextElement.FontSize="12" TextElement.FontWeight="SemiBold"
                        TextElement.Foreground="{DynamicResource Hp.Brush.TextMuted}">
                <Border Style="{StaticResource Lib.Kbd}"><TextBlock Text="{x:Static res:LibraryStrings.Key_Up}" /></Border>
                <Border Style="{StaticResource Lib.Kbd}" Margin="3,0,6,0"><TextBlock Text="{x:Static res:LibraryStrings.Key_Down}" /></Border>
                <TextBlock Text="{x:Static res:LibraryStrings.Keys_Selection}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Border Style="{StaticResource Lib.Kbd}" Margin="0,0,6,0"><TextBlock Text="{x:Static res:LibraryStrings.Key_Enter}" /></Border>
                <TextBlock Text="{x:Static res:LibraryStrings.Keys_Launch}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Border Style="{StaticResource Lib.Kbd}" Margin="0,0,6,0"><TextBlock Text="{x:Static res:LibraryStrings.Key_Space}" /></Border>
                <TextBlock Text="{x:Static res:LibraryStrings.Keys_HdrAuto}" VerticalAlignment="Center" Margin="0,0,18,0" />
                <Border Style="{StaticResource Lib.Kbd}" Margin="0,0,6,0"><TextBlock Text="{x:Static res:LibraryStrings.Key_ShiftF10}" /></Border>
                <TextBlock Text="{x:Static res:LibraryStrings.Keys_Menu}" VerticalAlignment="Center" />
            </StackPanel>
        </DockPanel>

        <!-- Hinweis unten mittig über der Statuszeile (verdeckt nie das Titelbild) -->
        <Grid x:Name="StatusToast" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="32,0,32,40" MaxWidth="640"
              Visibility="{Binding HasStatus, Converter={StaticResource Lib.BoolToVisibility}}" AutomationProperties.Name="{x:Static res:LibraryStrings.Toast_Name}">
            <Border Style="{StaticResource Lib.PopupShadow}" Margin="-6,4,-6,-12" />
            <Border CornerRadius="16" Background="{DynamicResource Hp.Brush.Menu}" BorderBrush="{DynamicResource Hp.Brush.LineStrong}" BorderThickness="1" />
            <DockPanel Margin="8,8,10,8">
                <Grid DockPanel.Dock="Left" Width="32" Height="32" Margin="0,0,12,0" VerticalAlignment="Center">
                    <Border CornerRadius="10" Background="{DynamicResource Hp.Brush.Accent}" />
                    <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{Binding StatusKind}" HorizontalAlignment="Center" Foreground="{DynamicResource Hp.Brush.TextOnAccent}" />
                </Grid>
                <Button DockPanel.Dock="Right" Style="{StaticResource Lib.LinkButton}" Foreground="{DynamicResource Hp.Brush.TextMuted}" Margin="12,0,0,0"
                        VerticalAlignment="Center" Command="{Binding DismissStatusCommand}"
                        AutomationProperties.AutomationId="DismissStatusButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Status_Dismiss}">
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE711;" FontSize="10" Margin="4" />
                </Button>
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Hp.Brush.Text}"
                           AutomationProperties.AutomationId="StatusMessage" />
            </DockPanel>
        </Grid>

        <!-- Fensterkante: feine Linie; bei HDR an in der Spielfarbe; im HDR-Moment ein Puls in den Spielfarben (2 px) -->
        <Border x:Name="EdgeLine" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.Line}" IsHitTestVisible="False" />
        <Border x:Name="EdgeGlow" BorderThickness="2" Opacity="0" IsHitTestVisible="False" />
    </Grid>
</infra:ChromeWindow>
