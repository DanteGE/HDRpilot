<?xml version="1.0" encoding="utf-8"?>
<!--
  Auslieferung: eine einzelne, eigenständige EXE für Windows x64 (keine installierte .NET-Runtime nötig).
  Aufruf: tools\publish.ps1 (oder dotnet publish src\HdrPilot.App -p:PublishProfile=win-x64).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- WPF bringt eigene native DLLs mit; sie stecken mit in der EXE und werden beim ersten Start entpackt. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Keine Kompression: Assemblys werden direkt aus der EXE eingeblendet statt entpackt im Speicher gehalten (E60). -->
    <EnableCompressionInSingleFile>false</EnableCompressionInSingleFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>
</Project>
