<infra:ChromeWindow x:Class="HdrPilot.App.Setup.UI.UninstallWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:infra="clr-namespace:HdrPilot.App.Infrastructure"
                    xmlns:res="clr-namespace:HdrPilot.App.Resources"
                    xmlns:ui="clr-namespace:HdrPilot.App.Setup.UI"
                    mc:Ignorable="d"
                    d:DataContext="{d:DesignInstance ui:UninstallViewModel}"
                    Title="{x:Static res:SetupStrings.UninstallWindowTitle}"
                    AutomationProperties.AutomationId="UninstallWindow"
                    AutomationProperties.Name="{x:Static res:SetupStrings.UninstallWindowTitle}"
                    Width="580" SizeToContent="Height" ResizeMode="NoResize"
                    WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <ResourceDictionary Source="SetupResources.xaml" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Return" Command="{Binding ConfirmCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid x:Name="Root">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Kopf: installierte Version und was entfernt wird -->
        <StackPanel x:Name="Header" Margin="32,2,32,4">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Style="{StaticResource Setup.HeaderTile}">
                    <Border CornerRadius="17" Background="{DynamicResource Hp.Brush.Accent}" />
                    <Border CornerRadius="17" Background="{DynamicResource Hp.Brush.BackgroundGlow}" Opacity="0.6" />
                    <TextBlock Style="{StaticResource Setup.HeaderGlyph}" Text="&#xE74D;" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource Hp.Text.Title}" FontSize="24" TextWrapping="Wrap"
                               AutomationProperties.AutomationId="UninstallTitle"
                               Text="{Binding Title}" />
                    <TextBlock Style="{StaticResource Hp.Text.Caption}" FontSize="13" Margin="0,3,0,0"
                               Text="{x:Static res:SetupStrings.UninstallInfo}"
                               Visibility="{Binding IsInstalled, Converter={StaticResource Hp.Shell.BoolToVisibility}}" />
                </StackPanel>
            </Grid>
            <Border Height="3" Margin="0,14,0,0" CornerRadius="1.5" Background="{DynamicResource Hp.Brush.Accent}" />
        </StackPanel>

        <StackPanel x:Name="Body" Grid.Row="1" Margin="32,16,32,12">
            <!-- Daten: Standard behalten -->
            <CheckBox Style="{StaticResource Hp.Shell.CheckCard}"
                      AutomationProperties.AutomationId="UninstallRemoveData"
                      AutomationProperties.Name="{x:Static res:SetupStrings.UninstallRemoveData}"
                      AutomationProperties.HelpText="{x:Static res:SetupStrings.UninstallKeepDataNote}"
                      IsChecked="{Binding RemoveData, Mode=TwoWay}"
                      Visibility="{Binding IsInstalled, Converter={StaticResource Hp.Shell.BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource Hp.Shell.Label}" TextWrapping="Wrap" Text="{x:Static res:SetupStrings.UninstallRemoveData}" />
                    <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,3,0,0" Text="{x:Static res:SetupStrings.UninstallKeepDataNote}" />
                </StackPanel>
            </CheckBox>

            <!-- Steam-Startoptionen, die noch auf HDRpilot zeigen: die Spiele starteten sonst nicht mehr -->
            <Border Style="{StaticResource Setup.WarningRow}" Margin="0,12,0,0"
                    Visibility="{Binding HasSteamGames, Converter={StaticResource Hp.Shell.BoolToVisibility}}">
                <DockPanel>
                    <TextBlock Style="{StaticResource Hp.Shell.Glyph}" Text="&#xE7BA;" FontSize="15" Margin="0,1,12,0" VerticalAlignment="Top" Foreground="{DynamicResource Hp.Brush.Warning}" />
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hp.Text.Body}" FontSize="13" LineHeight="19"
                                   AutomationProperties.AutomationId="UninstallSteamWarning"
                                   Text="{x:Static res:SetupStrings.UninstallSteamWarning}" />
                        <ItemsControl Margin="0,6,0,0" Focusable="False"
                                      AutomationProperties.AutomationId="UninstallSteamGames"
                                      ItemsSource="{Binding SteamGames}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="0,3,0,0">
                                        <Ellipse Width="5" Height="5" Margin="2,0,10,0" VerticalAlignment="Center" Fill="{DynamicResource Hp.Brush.Warning}" />
                                        <TextBlock Style="{StaticResource Hp.Text.Body}" FontSize="13" FontWeight="SemiBold" Text="{Binding}" />
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- Kopie im Temp-Ordner ließ sich nicht anlegen oder starten -->
            <DockPanel Margin="2,12,0,0" Visibility="{Binding HasError, Converter={StaticResource Hp.Shell.BoolToVisibility}}">
                <TextBlock Style="{StaticResource Hp.Shell.Glyph}" Text="&#xE7BA;" FontSize="14" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Hp.Brush.Danger}" />
                <TextBlock Style="{StaticResource Hp.Text.Body}" FontSize="13" Foreground="{DynamicResource Hp.Brush.Danger}"
                           AutomationProperties.AutomationId="UninstallErrorText"
                           Text="{Binding ErrorText}" />
            </DockPanel>
        </StackPanel>

        <Border Grid.Row="2" Background="{DynamicResource Hp.Brush.Surface}" BorderBrush="{DynamicResource Hp.Brush.Border}" BorderThickness="0,1,0,0" Padding="32,14,32,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" MinHeight="40">
                <Button x:Name="CancelButton" Style="{StaticResource Hp.GhostButton}" MinWidth="120"
                        AutomationProperties.AutomationId="UninstallCancelButton"
                        AutomationProperties.Name="{x:Static res:SetupStrings.UninstallCancelButton}"
                        Command="{Binding CancelCommand}"
                        Content="{x:Static res:SetupStrings.UninstallCancelButton}" />
                <Button x:Name="ConfirmButton" Style="{StaticResource Hp.AccentButton}" MinWidth="150" Margin="12,0,0,0"
                        AutomationProperties.AutomationId="UninstallConfirmButton"
                        AutomationProperties.Name="{x:Static res:SetupStrings.UninstallConfirmButton}"
                        Command="{Binding ConfirmCommand}"
                        Visibility="{Binding IsInstalled, Converter={StaticResource Hp.Shell.BoolToVisibility}}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Hp.Shell.ButtonGlyph}" Text="&#xE74D;" />
                        <TextBlock Text="{x:Static res:SetupStrings.UninstallConfirmButton}" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</infra:ChromeWindow>
