<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:HdrPilot.App.Infrastructure">
    <!--
        Gemeinsame Bausteine im Gamer-Stil. Alle Farben kommen aus Tokens.Dark/Light.xaml (DynamicResource),
        damit hell/dunkel zur Laufzeit wechselt. Animationen laufen nur bei Zustandswechseln (kurz),
        nie dauerhaft im Hintergrund.
    -->
    <FontFamily x:Key="Hp.Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Hp.Font.Display">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="Hp.Font.Icons">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

    <CubicEase x:Key="Hp.Ease.Out" EasingMode="EaseOut" />
    <QuarticEase x:Key="Hp.Ease.Snappy" EasingMode="EaseOut" />

    <!-- Texte -->
    <Style x:Key="Hp.Text.Title" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Display}" />
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
    </Style>
    <Style x:Key="Hp.Text.Subtitle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Display}" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
    </Style>
    <Style x:Key="Hp.Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Hp.Text.Caption" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="Hp.Text.Overline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextMuted}" />
    </Style>

    <!-- Karte -->
    <Style x:Key="Hp.Card" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="16" />
    </Style>

    <!-- Abzeichen (z. B. Quelle, "NEU") -->
    <Style x:Key="Hp.Badge" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.BorderStrong}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="Hp.Badge.New" TargetType="Border" BasedOn="{StaticResource Hp.Badge}">
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Accent}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- Akzent-Schaltfläche: Verlauf, beim Überfahren leichtes Anheben und Leuchten -->
    <Style x:Key="Hp.AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextOnAccent}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="10" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0">
                            <Border.Effect>
                                <BlurEffect Radius="14" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Body" CornerRadius="10" Background="{DynamicResource Hp.Brush.Accent}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Focus" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.Text}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.18" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.18" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.18" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Zurückhaltende Schaltfläche: transparent, Rahmen, Hover-Fläche -->
    <Style x:Key="Hp.GhostButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Body" CornerRadius="10" Background="Transparent" BorderThickness="1"
                            BorderBrush="{DynamicResource Hp.Brush.BorderStrong}" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceSelected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Symbol-Schaltfläche (Segoe Fluent Icons als Inhalt) -->
    <Style x:Key="Hp.IconButton" TargetType="Button" BasedOn="{StaticResource Hp.GhostButton}">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Icons}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Padding" Value="9" />
    </Style>

    <!--
        HDR-Schalter: CheckBox als animierter Schalter. Spur bekommt den HDR-Verlauf, der Knopf gleitet
        (150 ms, Easing) und leuchtet im eingeschalteten Zustand.
    -->
    <Style x:Key="Hp.ToggleSwitch" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <StackPanel Orientation="Horizontal" Background="Transparent">
                        <Grid Width="46" Height="24" VerticalAlignment="Center">
                            <Border x:Name="TrackOff" CornerRadius="12" Background="{DynamicResource Hp.Brush.HdrOff}" />
                            <Border x:Name="TrackOn" CornerRadius="12" Background="{DynamicResource Hp.Brush.HdrOn}" Opacity="0">
                                <Border.Effect>
                                    <DropShadowEffect Color="{DynamicResource Hp.Color.Glow}" BlurRadius="0" ShadowDepth="0" Opacity="0.9" />
                                </Border.Effect>
                            </Border>
                            <Border x:Name="FocusRing" CornerRadius="14" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.AccentSolid}" Opacity="0" />
                            <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{DynamicResource Hp.Brush.ToggleThumb}" HorizontalAlignment="Left" Margin="3,0,0,0">
                                <Ellipse.RenderTransform>
                                    <TranslateTransform X="0" />
                                </Ellipse.RenderTransform>
                                <Ellipse.Effect>
                                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Opacity="0.35" Color="{DynamicResource Hp.Color.Shadow}" />
                                </Ellipse.Effect>
                            </Ellipse>
                        </Grid>
                        <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="22" Duration="0:0:0.16" EasingFunction="{StaticResource Hp.Ease.Snappy}" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="14" Duration="0:0:0.3" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16" EasingFunction="{StaticResource Hp.Ease.Snappy}" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="(UIElement.Effect).(DropShadowEffect.BlurRadius)" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Titelleisten-Knöpfe des eigenen Fensterrahmens -->
    <Style x:Key="Hp.CaptionButton" TargetType="Button">
        <Setter Property="Width" Value="46" />
        <Setter Property="Height" Value="34" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Icons}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Body" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hp.CaptionCloseButton" TargetType="Button" BasedOn="{StaticResource Hp.CaptionButton}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Body" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="#FFE81123" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Fenster mit eigenem Rahmen: Verlaufshintergrund mit Akzent-Schimmer, eigene Titelleiste.
        Fenster leiten von infra:ChromeWindow ab (Befehle für Minimieren/Maximieren/Schließen, runde Ecken).
    -->
    <Style x:Key="Hp.ChromeWindowStyle" TargetType="infra:ChromeWindow">
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.WindowBackground}" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="WindowChrome.WindowChrome">
            <Setter.Value>
                <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="infra:ChromeWindow">
                    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource Hp.Brush.Border}" BorderThickness="1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="40" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Grid.RowSpan="2" Background="{DynamicResource Hp.Brush.BackgroundGlow}" IsHitTestVisible="False" />
                            <DockPanel Grid.Row="0" Background="{DynamicResource Hp.Brush.TitleBar}">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                    <Button x:Name="PART_Minimize" Style="{StaticResource Hp.CaptionButton}" Content="&#xE921;" Command="SystemCommands.MinimizeWindowCommand"
                                            AutomationProperties.AutomationId="CaptionMinimize" AutomationProperties.Name="Minimieren" />
                                    <Button x:Name="PART_Maximize" Style="{StaticResource Hp.CaptionButton}" Content="&#xE922;" Command="SystemCommands.MaximizeWindowCommand"
                                            AutomationProperties.AutomationId="CaptionMaximize" AutomationProperties.Name="Maximieren" />
                                    <Button x:Name="PART_Restore" Style="{StaticResource Hp.CaptionButton}" Content="&#xE923;" Command="SystemCommands.RestoreWindowCommand" Visibility="Collapsed"
                                            AutomationProperties.AutomationId="CaptionRestore" AutomationProperties.Name="Wiederherstellen" />
                                    <Button Style="{StaticResource Hp.CaptionCloseButton}" Content="&#xE8BB;" Command="SystemCommands.CloseWindowCommand"
                                            AutomationProperties.AutomationId="CaptionClose" AutomationProperties.Name="Schließen" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                                    <Image Source="{TemplateBinding Icon}" Width="18" Height="18" Margin="0,0,10,0" />
                                    <TextBlock Text="{TemplateBinding Title}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.TextSecondary}" VerticalAlignment="Center" />
                                </StackPanel>
                            </DockPanel>
                            <ContentPresenter Grid.Row="1" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="WindowState" Value="Maximized">
                            <Setter TargetName="Frame" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Frame" Property="Margin" Value="7" />
                            <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_Restore" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="ResizeMode" Value="NoResize">
                            <Setter TargetName="PART_Maximize" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
