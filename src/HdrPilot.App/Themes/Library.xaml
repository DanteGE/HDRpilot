        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Schlichte Zeile (EXE-Liste, Vorschläge) -->
    <Style x:Key="Lib.PlainRow" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="10" Background="{DynamicResource Hp.Brush.Surface1}" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.Line}" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SelectionFill}" />
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.SelectionRing}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.FocusRing}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aufklappbarer Warnbereich (Fehler je Scanner) -->
    <Style x:Key="Lib.WarningExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Border CornerRadius="14" Background="{DynamicResource Hp.Brush.Glass}" />
                        <Border CornerRadius="14" Background="{DynamicResource Hp.Brush.Warning}" Opacity="0.1" />
                        <Border CornerRadius="14" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.Warning}" Opacity="0.7" />
                        <DockPanel>
                            <ToggleButton x:Name="HeaderToggle" Style="{x:Null}" DockPanel.Dock="Top" Focusable="True" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="14,10">
                                            <DockPanel>
                                                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Style="{StaticResource Lib.Glyph}" Text="&#xE70D;" FontSize="11"
                                                           Foreground="{DynamicResource Hp.Brush.Warning}" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource Hp.Brush.Warning}" Margin="0,0,10,0" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Hp.Brush.Warning}" />
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Margin="40,0,14,12" Visibility="Collapsed" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Getönte Hinweisfläche; Farbe nach Tag (StatusKind: Info, Success, Warning, Error) -->
    <Style x:Key="Lib.StatusTint" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Opacity" Value="0.14" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Error">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Lib.StatusGlyph" TargetType="TextBlock" BasedOn="{StaticResource Lib.Glyph}">
        <Setter Property="Text" Value="&#xE946;" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.AccentText}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Success">
                <Setter Property="Text" Value="&#xE73E;" />
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warning">
                <Setter Property="Text" Value="&#xE7BA;" />
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Error">
                <Setter Property="Text" Value="&#xE783;" />
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Trenner zwischen Spieleliste und Detailbereich für Tastatur und UI-Automation (Pfeiltasten links/rechts); mit
        Tastaturfokus zeigt er die feine Linie in der Fokusfarbe. Die Maus erreicht ihn nicht: Über ihm liegt die
        Bildlaufleiste im Spalt (Lib.GapScrollBar), die für die Maus Linie, Ziehen und Doppelklick übernimmt. Einen ruhenden
        Griff gibt es nicht mehr; er sah wie eine Bildlaufleiste aus (Wunsch des Nutzers 2026-10-22).
    -->
    <Style x:Key="Lib.Splitter" TargetType="GridSplitter">
        <Setter Property="Width" Value="24" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="ResizeDirection" Value="Columns" />
        <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
        <Setter Property="ShowsPreview" Value="False" />
        <Setter Property="DragIncrement" Value="1" />
        <Setter Property="KeyboardIncrement" Value="24" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GridSplitter">
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Line" Width="2" HorizontalAlignment="Center" Margin="0,18" Background="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Pille der Bildlaufleiste im Spalt: in Ruhe dezent (4 px, wie der frühere Griff), beim Überfahren und Ziehen 6 px breit
        in der Akzentfarbe. Trefferfläche 12 px breit in der Mitte des Spalts: Daneben bleibt die Linie des Trenners auch auf
        der Höhe einer langen Pille zu greifen.
    -->
    <Style x:Key="Lib.GapThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Cursor" Value="Arrow" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid Width="12" HorizontalAlignment="Center" Background="Transparent">
                        <Border x:Name="Pill" Width="4" CornerRadius="2" HorizontalAlignment="Center" Background="{DynamicResource Hp.Brush.LineStrong}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Width" Value="6" />
                            <Setter TargetName="Pill" Property="CornerRadius" Value="3" />
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Hp.Brush.Accent}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Pill" Property="Width" Value="6" />
                            <Setter TargetName="Pill" Property="CornerRadius" Value="3" />
                            <Setter TargetName="Pill" Property="Background" Value="{DynamicResource Hp.Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Bildlaufleiste im Spalt zwischen Liste bzw. Raster und Detailbereich (lib:GapScrollBar, Wunsch des Nutzers 2026-10-22):
        Die Pille ist die Bildlaufleiste der aktiven Ansicht, ihre Bahn reicht so weit wie deren sichtbarer Bereich
        (TrackMargin); ohne Bildlauf blendet Track sie aus. Der ganze Spalt nimmt die Maus an (für den Trenner darunter):
        Beim Überfahren außerhalb der Pille erscheint die feine Linie, beim Ziehen der Breite in der Akzentfarbe.
    -->
    <Style x:Key="Lib.GapScrollBar" TargetType="lib:GapScrollBar">
        <Setter Property="Orientation" Value="Vertical" />
        <Setter Property="Width" Value="Auto" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="ContextMenuService.IsEnabled" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="lib:GapScrollBar">
                    <Grid Background="{TemplateBinding Background}" UseLayoutRounding="True">
                        <Border x:Name="Line" Width="1" HorizontalAlignment="Center" Margin="0,18" Background="{DynamicResource Hp.Brush.LineStrong}"
                                Opacity="0" IsHitTestVisible="False" />
                        <Track x:Name="PART_Track" IsDirectionReversed="True" Margin="{TemplateBinding TrackMargin}">
                            <Track.Thumb>
                                <Thumb x:Name="Pill" Style="{StaticResource Lib.GapThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition SourceName="Pill" Property="IsMouseOver" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Line" Property="Opacity" Value="0.8" />
                        </MultiTrigger>
                        <Trigger Property="ShowsLine" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsResizing" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                            <Setter TargetName="Line" Property="Background" Value="{DynamicResource Hp.Brush.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Ziehgriff unter dem Titelbereich der Liste (lib:HeroSplitter): wie Lib.Splitter, nur waagerecht. In Ruhe ein dezenter
        Griff in der Mitte der Liste, beim Überfahren, Ziehen oder mit Tastaturfokus leuchtet er in der Akzentfarbe, dazu eine
        feine Linie über die Breite der Liste. Mit Tastatur bedienbar (Pfeiltasten oben/unten, siehe HeroSplitter).
    -->
    <Style x:Key="Lib.HeroSplitter" TargetType="lib:HeroSplitter">
        <Setter Property="Height" Value="{x:Static lib:ShowcaseLayout.HeroSplitterHeight}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Cursor" Value="SizeNS" />
        <Setter Property="Focusable" Value="True" />
        <Setter Property="IsTabStop" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="lib:HeroSplitter">
                    <!--
                        Griff und Linie in der Mitte: genau auf der Unterkante des Titelbilds (ShowcaseLayout.HeroSplitterOverlap);
                        die Linie endet 12 px vor Lasche bzw. Kapsel der Werkzeugleiste (LineMargin, gesetzt vom Fenster)
                    -->
                    <Grid Background="{TemplateBinding Background}">
                        <Border x:Name="Line" Height="1" VerticalAlignment="Center" Margin="{TemplateBinding LineMargin}" Background="{DynamicResource Hp.Brush.LineStrong}" Opacity="0" />
                        <Border x:Name="Rest" Width="36" Height="4" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource Hp.Brush.LineStrong}" />
                        <Border x:Name="Grip" Width="52" Height="4" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center"
                                Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Opacity" Value="1" />
                            <Setter TargetName="Line" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Grip" Property="Opacity" Value="1" />
                            <Setter TargetName="Line" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Grip" Property="Opacity" Value="1" />
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource Hp.Brush.FocusRing}" />
                            <Setter TargetName="Line" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Abschnitt des Detailbereichs (Prototyp .sec): ohne eigene Fläche, Überschrift mit auslaufender Linie -->
    <Style x:Key="Lib.Section" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,10,0,0" />
    </Style>
    <Style x:Key="Lib.SectionLine" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Color="{DynamicResource Hp.Color.AccentText}" Offset="0" />
                    <GradientStop Color="#00000000" Offset="1" />
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- Zeile mit Schalter im Detailbereich (Prototyp .rw): Fläche beim Überfahren -->
    <Style x:Key="Lib.SwitchRow" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="Margin" Value="-8,0,0,0" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="Background" Value="Transparent" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface1}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Kontextmenü der Bibliothek (Rechtsklick, Umschalt+F10, Klick auf das Symbol): deckende Menüfläche, Schatten aus
        einem Verlauf darunter (kein Effekt). Nur geöffnet sichtbar, kostet also nichts in der Liste.
    -->
    <Style x:Key="Lib.ContextMenu" TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MinWidth" Value="268" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid Margin="8,4,12,18">
                        <Border Style="{StaticResource Lib.PopupShadow}" />
                        <Border Style="{StaticResource Lib.PopupBody}">
                            <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eintrag im Kontextmenü (Prototyp .mi): Symbol links, Haken rechts für Schalter, Tastenkürzel grau -->
    <Style x:Key="Lib.MenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Height" Value="34" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid Background="Transparent" Margin="0,1">
                        <Border x:Name="Hover" CornerRadius="10" Background="{DynamicResource Hp.Brush.Surface1}" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Visibility="Collapsed" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="Gesture" Grid.Column="2" Text="{TemplateBinding InputGestureText}" Margin="16,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="10.5" Foreground="{DynamicResource Hp.Brush.TextMuted}" />
                            <TextBlock x:Name="Check" Grid.Column="2" Style="{StaticResource Lib.Glyph}" Text="&#xE73E;" FontSize="13" Margin="16,0,0,0"
                                       Foreground="{DynamicResource Hp.Brush.AccentText}" Visibility="Collapsed" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsCheckable" Value="True" />
                                <Condition Property="IsChecked" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Check" Property="Visibility" Value="Visible" />
                        </MultiTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Lib.MenuSeparator" TargetType="Separator">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Border Height="1" Margin="6,5" Background="{DynamicResource Hp.Brush.Line}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Kachel im Abschnitt „BILDER“ als Schaltfläche (Titelbild, Logo, Cover; das Symbol öffnet „Symbol ändern…“):
        beim Überfahren leuchtet der Rahmen.
    -->
    <Style x:Key="Lib.IconButton" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <ContentPresenter />
                        <Border x:Name="Glow" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.AccentStrong}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                            <Setter TargetName="Glow" Property="BorderBrush" Value="{DynamicResource Hp.Brush.FocusRing}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Rund: Blättern im Regal (Prototyp .nv) -->
    <Style x:Key="Lib.RoundButton" TargetType="Button">
        <Setter Property="Width" Value="42" />
        <Setter Property="Height" Value="42" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Icons}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse Margin="-3,0,-3,-8" IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <RadialGradientBrush>
                                    <GradientStop Color="#55000000" Offset="0.6" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>
                        <Ellipse x:Name="Body" Fill="{DynamicResource Hp.Brush.Menu}" Stroke="{DynamicResource Hp.Brush.Line}" StrokeThickness="1" />
                        <Ellipse x:Name="Focus" Margin="-3" Stroke="{DynamicResource Hp.Brush.FocusRing}" StrokeThickness="2" Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Fill" Value="{DynamicResource Hp.Brush.Surface3}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0" />
                            <Setter Property="IsHitTestVisible" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Karte (Detailbereich, Automatik-Karte, Dialog): Panelfläche, feine Linie, Glanzkante oben -->
    <Style x:Key="Lib.Panel" TargetType="Border">
        <Setter Property="CornerRadius" Value="24" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Panel}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Wahl im Dialog „Bild wählen…“ (Prototyp .cho) -->
    <Style x:Key="Lib.ChoiceItem" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="Margin" Value="0,0,12,12" />
        <Setter Property="Width" Value="150" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="16" Background="{DynamicResource Hp.Brush.Surface1}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1" />
                        <Border x:Name="Ring" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                        <ContentPresenter />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Werkzeugleiste „Fließleiste mit Lichtnaht“ (abgenommene Vorschau leiste.html, Wunsch des Nutzers 2026-10-17): Filter
        als Symbolknöpfe mit Zähler, Ansicht und „Spiel hinzufügen“ nur als Symbol, Tooltips Lib.ToolTip, Lasche/Kapsel
        (ToolbarToggle, im Code gebaut) und ihr Menü. Werte für dunkel; hell ersetzt das Fenster die Lib.Brush.Tab…- und
        Lib.Brush.CountBadge…-Pinsel (MainWindow.xaml.cs).
    -->
    <SolidColorBrush x:Key="Lib.Brush.TabGlass" Color="#D10E0F16" />
    <SolidColorBrush x:Key="Lib.Brush.TabLine" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Lib.Brush.CountBadge" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="Lib.Brush.CountBadgeLine" Color="Transparent" />
    <SolidColorBrush x:Key="Lib.Brush.NewBadge" Color="#FFFF94B9" />
    <SolidColorBrush x:Key="Lib.Brush.NewBadgeText" Color="#FF14070C" />

    <!--
        Filter als Symbolknopf 40×40 (lib:FilterToggle, Vorschau .f-flt): Glas wie Lib.FieldFrame; an: Fläche C1 18 %, Rahmen
        AccentStrong, Hof AccentSoft und gefülltes Symbol (Übergänge im Code nach der Effektstufe). Symbol 2 px unter der Mitte,
        Zähler-Plakette innen oben rechts (2 px Abstand, 12 hoch). Tastaturfokus: Ring 2 px mit −3 Abstand. Gedrückt: 0,96.
    -->
    <Style x:Key="Lib.FilterToggle" TargetType="lib:FilterToggle">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="lib:FilterToggle">
                    <Grid x:Name="Root" Background="Transparent" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform />
                        </Grid.RenderTransform>
                        <Border x:Name="PART_Halo" CornerRadius="16" Margin="-4" Background="{DynamicResource Hp.Brush.AccentSoft}" Opacity="0" IsHitTestVisible="False" />
                        <Border x:Name="Body" Style="{StaticResource Lib.FieldFrame}" />
                        <Border x:Name="PART_On" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.AccentStrong}" Opacity="0" IsHitTestVisible="False">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource Hp.Color.C1}" Opacity="0.18" />
                            </Border.Background>
                        </Border>
                        <Grid x:Name="PART_Icon" Width="30" Height="18" Margin="5,13,5,9" IsHitTestVisible="False">
                            <lib:FilterGlyph x:Name="PART_Glyph" Kind="{TemplateBinding Kind}" HorizontalAlignment="Center" VerticalAlignment="Center"
                                             Stroke="{DynamicResource Hp.Brush.TextSecondary}" Fill="{DynamicResource Hp.Brush.Accent}"
                                             OnForeground="{DynamicResource Hp.Brush.TextOnAccent}" />
                        </Grid>
                        <Border x:Name="PART_Badge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,2,0" MinWidth="13" Height="12" Padding="3,0"
                                CornerRadius="6" BorderBrush="{DynamicResource Lib.Brush.CountBadgeLine}" IsHitTestVisible="False">
                            <TextBlock x:Name="PART_BadgeText" FontSize="9" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                       Typography.NumeralAlignment="Tabular" Margin="0,-1,0,0" />
                        </Border>
                        <Border x:Name="Focus" CornerRadius="15" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Visibility="Collapsed" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
                            <Setter TargetName="PART_Glyph" Property="Stroke" Value="{DynamicResource Hp.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="RenderTransform">
                                <Setter.Value>
                                    <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Tooltip der Werkzeugleiste (Lib.ToolTip, Vorschau .tip): deckend Hp.Brush.Menu, Rahmen LineStrong, Radius 12,
        Innenabstand 12/9, höchstens 300 breit; Schatten als Lib.PopupShadow-Fläche, kein DropShadowEffect. Mittig unter dem
        Element mit 8 px Abstand. Erscheint nach 1000 ms, der des Nachbarknopfs sofort innerhalb von 400 ms (ToolTipService),
        auch bei Tastaturfokus. Einblenden: Voll 140 ms (Deckkraft, Y 4 → 0), Reduziert 100 ms nur Deckkraft, Aus sofort.
    -->
    <Style x:Key="Lib.ToolTip" TargetType="ToolTip">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="Placement" Value="Bottom" />
        <Setter Property="lib:ToolbarTipPlacement.Centered" Value="True" />
        <Setter Property="DataContext" Value="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <Grid x:Name="Root" Margin="10,4,10,16">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Border Style="{StaticResource Lib.PopupShadow}" CornerRadius="16" />
                        <Border CornerRadius="12" Padding="12,9,12,10" MaxWidth="300" Background="{DynamicResource Hp.Brush.Menu}"
                                BorderBrush="{DynamicResource Hp.Brush.LineStrong}" BorderThickness="1">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsOpen, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsFull, Source={x:Static lib:LibraryMotion.Instance}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.14" EasingFunction="{StaticResource Hp.Ease.Out}" FillBehavior="Stop" />
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" From="4" To="0" Duration="0:0:0.14" EasingFunction="{StaticResource Hp.Ease.Out}" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsOpen, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="True" />
                                <Condition Binding="{Binding IsFull, Source={x:Static lib:LibraryMotion.Instance}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.1" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Inhalt eines Tooltips: Titel mit Tastenkappe, Erklärung, Fußzeile (Mono 11, Anfang hervorgehoben); leere Teile entfallen -->
    <Style x:Key="Lib.ToolbarTip" TargetType="lib:ToolbarTip">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="lib:ToolbarTip">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{TemplateBinding Title}" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="{DynamicResource Hp.Brush.Text}" />
                            <Border x:Name="Key" Style="{StaticResource Lib.Kbd}" Margin="8,0,0,0" Height="17" Padding="5,0,5,1">
                                <TextBlock Text="{TemplateBinding Shortcut}" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                        <TextBlock x:Name="Body" Text="{TemplateBinding Text}" Margin="0,4,0,0" FontSize="12" LineHeight="16.8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                        <Border x:Name="Foot" Margin="0,7,0,0" Padding="0,7,0,0" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Hp.Brush.Line}">
                            <TextBlock FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="11" LineHeight="14.3" TextWrapping="Wrap" Foreground="{DynamicResource Hp.Brush.TextSecondary}">
                                <Run Text="{Binding FooterLead, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.AccentText}" /><Run Text="{Binding Footer, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
                            </TextBlock>
                        </Border>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Shortcut" Value="">
                            <Setter TargetName="Key" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Body" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="Footer" Value="" />
                                <Condition Property="FooterLead" Value="" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Foot" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Sortierung der Werkzeugleiste (wie Lib.ComboBox): Symbol und Beschriftung der gewählten Sortierung. Unterhalb von 914
        Listenbreite nur das Symbol (lib:ToolbarPanel.IconOnly, 60 breit); die Beschriftung weicht dabei nach links aus
        (Teil „Label“, Deckkraft und Versatz setzt das Fenster).
    -->
    <Style x:Key="Lib.SortComboBox" TargetType="ComboBox" BasedOn="{StaticResource Lib.ComboBox}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Style="{x:Null}" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Body" Style="{StaticResource Lib.FieldFrame}">
                                        <TextBlock x:Name="Chevron" Style="{StaticResource Lib.Glyph}" Text="&#xE70D;" FontSize="10" HorizontalAlignment="Right" Margin="0,0,13,0"
                                                   Foreground="{DynamicResource Hp.Brush.TextSecondary}" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Hp.Brush.AccentText}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <Grid x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" ClipToBounds="True">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Style="{StaticResource Lib.Glyph}" Width="16" TextAlignment="Center" FontSize="14" Foreground="{DynamicResource Hp.Brush.TextSecondary}"
                                       Text="{Binding SelectedItem.Glyph, RelativeSource={RelativeSource TemplatedParent}}" />
                            <TextBlock x:Name="Label" Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                                       Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Grid>
                        <Border x:Name="FocusFrame" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.AccentStrong}" Opacity="0" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="8" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Grid Margin="6,0,6,14" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Style="{StaticResource Lib.PopupShadow}" />
                                <Border Style="{StaticResource Lib.PopupBody}" MinWidth="236" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="True">
                            <Setter TargetName="PART_Popup" Property="PopupAnimation" Value="Fade" />
                        </DataTrigger>
                        <Trigger Property="lib:ToolbarPanel.IconOnly" Value="True">
                            <Setter TargetName="ContentSite" Property="Margin" Value="14,0,0,0" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusFrame" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusFrame" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ansicht nur als Symbol (Vorschau .f-seg .sb): 38×32, gewählt in TextOnAccent auf der gleitenden Fläche (MainWindow) -->
    <Style x:Key="Lib.SegmentIconRadio" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="32" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Focus" CornerRadius="9" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Visibility="Collapsed" />
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Eintrag im Menü der Werkzeugleiste (Vorschau .mi): bei Filtern Haken links, Zahl (Tag, Mono) und Tastenkappe rechts;
        „Leiste aus-/einblenden“ und „Alle Filter zurücksetzen“ ohne Haken-Spalte.
    -->
    <Style x:Key="Lib.ToolbarMenuItem" TargetType="MenuItem" BasedOn="{StaticResource Lib.MenuItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid Background="Transparent" Margin="0,1">
                        <Border x:Name="Hover" CornerRadius="10" Background="{DynamicResource Hp.Brush.Surface1}" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Visibility="Collapsed" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="Check" Style="{StaticResource Lib.Glyph}" Text="&#xE73E;" FontSize="11" Width="14" Margin="0,0,10,0"
                                       Foreground="{DynamicResource Hp.Brush.AccentText}" Opacity="0" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <TextBlock x:Name="Count" Grid.Column="2" Text="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" Margin="16,0,0,0" VerticalAlignment="Center"
                                       FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                            <Border x:Name="Key" Grid.Column="3" Style="{StaticResource Lib.Kbd}" Margin="10,0,0,0" Height="17" Padding="5,0,5,1">
                                <TextBlock Text="{TemplateBinding InputGestureText}" VerticalAlignment="Center" />
                            </Border>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsCheckable" Value="False">
                            <Setter TargetName="Check" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="InputGestureText" Value="">
                            <Setter TargetName="Key" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ✕ der Kapsel: eigener Knopf 24×24 „Suche und Filter zurücksetzen“ (nur eingeklappt und gefiltert) -->
    <Style x:Key="Lib.CapsuleReset" TargetType="Button">
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="12" Background="Transparent" />
                        <Border x:Name="Focus" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Visibility="Collapsed" />
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE711;" FontSize="9" HorizontalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tastaturfokus von Lasche und Kapsel: Ring 2 px um die Fläche -->
    <Style x:Key="Lib.TabFocus" TargetType="Control">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border Margin="-2" CornerRadius="13" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
