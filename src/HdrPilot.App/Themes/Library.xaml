    <!--
        Zeile der Spieleliste (Prototyp .row, 46 px): Fläche beim Überfahren; gewählt dunkel ein Verlauf in der Spielfarbe
        (Tag der Zeile, siehe Vorlage) mit Leiste Akzent → Glanz am linken Rand, hell Akzent 14 % mit Ring. Keine Effekte.
    -->
    <Style x:Key="Lib.GameRow" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="Padding" Value="12,0,16,0" />
        <Setter Property="Height" Value="46" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <Border x:Name="Body" Background="Transparent" />
                        <Border x:Name="Selected" Opacity="0" Background="{DynamicResource Lib.Brush.RowSelection}" />
                        <Border x:Name="SelectedRing" Opacity="0" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.SelectionRing}" />
                        <Border x:Name="Bar" Width="3" CornerRadius="0,3,3,0" HorizontalAlignment="Left" Margin="0,7" Opacity="0" Background="{DynamicResource Hp.Brush.AccentShine}" />
                        <Border x:Name="FocusFrame" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.AccentStrong}" Opacity="0" />
                        <Border Height="1" VerticalAlignment="Bottom" Margin="12,0" Background="{DynamicResource Hp.Brush.Line}" Opacity="0.6" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface1}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsSelected, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding (lib:GameListColumns.LightTheme), RelativeSource={RelativeSource Self}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="SelectedRing" Property="Opacity" Value="1" />
                        </MultiDataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusFrame" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

