<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lib="clr-namespace:HdrPilot.App.Views.Library">
    <!--
        Library: Stile der Spielebibliothek (Hauptfenster und ihre Dialoge). Farben nur über DynamicResource aus
        Tokens.Dark/Light.xaml. Alle Schlüssel beginnen mit "Lib.", es gibt keine impliziten Stile (andere Fenster
        bleiben unberührt). Animationen sind kurz und laufen nur, wenn Windows Animationen erlaubt
        (lib:LibraryMotion); Listenzeilen haben keine Effekte (DropShadow/Blur), nur Flächen und Verläufe.
    -->
    <lib:BoolToVisibilityConverter x:Key="Lib.BoolToVisibility" />

    <!-- Symbol aus Segoe Fluent Icons -->
    <Style x:Key="Lib.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Icons}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <!-- Kleine Überschrift in Großbuchstaben: wie Hp.Text.Overline, aber kontrastreicher (lesbar in hell und dunkel) -->
    <Style x:Key="Lib.Overline" TargetType="TextBlock" BasedOn="{StaticResource Hp.Text.Overline}">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
    </Style>

    <Style x:Key="Lib.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Lib.Overline}">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!-- Farbe je Quelle (Text, Symbol) -->
    <Style x:Key="Lib.SourceText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.Manual}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="Steam">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.Steam}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Epic">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.Epic}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Xbox">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.Xbox}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Gog">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.Gog}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Ubisoft">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.Ubisoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="EA">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.EA}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="BattleNet">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.BattleNet}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Getönte Kachel je Quelle (Hintergrund des Spielsymbols) -->
    <Style x:Key="Lib.SourceTile" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Opacity" Value="0.16" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.Manual}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="Steam">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.Steam}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Epic">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.Epic}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Xbox">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.Xbox}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Gog">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.Gog}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Ubisoft">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.Ubisoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="EA">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.EA}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="BattleNet">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.BattleNet}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Ersatzsymbol je Quelle, nur solange kein EXE-Symbol geladen ist (DataContext: GameItemViewModel) -->
    <Style x:Key="Lib.SourceGlyph" TargetType="TextBlock" BasedOn="{StaticResource Lib.SourceText}">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Icons}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="&#xE7FC;" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="Xbox">
                <Setter Property="Text" Value="&#xE990;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Manual">
                <Setter Property="Text" Value="&#xE8B7;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Suchfeld: Lupe, Platzhalter (Tag), Verlaufsrahmen bei Fokus -->
    <Style x:Key="Lib.SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="38,0,36,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="10" BorderThickness="1"
                                Background="{DynamicResource Hp.Brush.SurfaceInput}" BorderBrush="{DynamicResource Hp.Brush.Border}" />
                        <Border x:Name="FocusFrame" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <TextBlock x:Name="SearchGlyph" Style="{StaticResource Lib.Glyph}" Text="&#xE721;" Margin="14,0,0,0" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource Hp.Brush.TextMuted}" />
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="39,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.TextMuted}" Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusFrame" Property="Opacity" Value="1" />
                            <Setter TargetName="SearchGlyph" Property="Foreground" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eingabefeld der Dialoge -->
    <Style x:Key="Lib.TextBox" TargetType="TextBox" BasedOn="{StaticResource Lib.SearchBox}">
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="10" BorderThickness="1"
                                Background="{DynamicResource Hp.Brush.SurfaceInput}" BorderBrush="{DynamicResource Hp.Brush.Border}" />
                        <Border x:Name="FocusFrame" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="13,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.TextMuted}" Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.BorderStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusFrame" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Auswahlliste im HdrPilot-Stil (Popup deckend, mit Schatten nur am Popup) -->
    <Style x:Key="Lib.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Margin="0,1">
                        <Border x:Name="Body" CornerRadius="8" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,7" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceSelected}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eintrag im Quellen-Filter: Name für UI-Automation mit aktueller Anzahl („Steam (631)“) -->
    <Style x:Key="Lib.SourceComboBoxItem" TargetType="ComboBoxItem" BasedOn="{StaticResource Lib.ComboBoxItem}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
    </Style>

    <Style x:Key="Lib.ComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="14,0,38,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MaxDropDownHeight" Value="360" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Lib.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Style="{x:Null}" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Body" CornerRadius="10" BorderThickness="1"
                                            Background="{DynamicResource Hp.Brush.SurfaceInput}" BorderBrush="{DynamicResource Hp.Brush.Border}">
                                        <TextBlock x:Name="Chevron" Style="{StaticResource Lib.Glyph}" Text="&#xE70D;" FontSize="11" HorizontalAlignment="Right" Margin="0,0,14,0"
                                                   Foreground="{DynamicResource Hp.Brush.TextSecondary}" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.BorderStrong}" />
                                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        <Border x:Name="FocusFrame" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.Accent}" Opacity="0" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="4" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Border Margin="0,0,14,16" MinWidth="{TemplateBinding ActualWidth}" MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    CornerRadius="12" BorderThickness="1" Padding="5"
                                    Background="{DynamicResource Hp.Brush.SurfaceInput}" BorderBrush="{DynamicResource Hp.Brush.BorderStrong}">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="4" Direction="270" Opacity="0.35" Color="{DynamicResource Hp.Color.Shadow}" />
                                </Border.Effect>
                                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="True">
                            <Setter TargetName="PART_Popup" Property="PopupAnimation" Value="Fade" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusFrame" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusFrame" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Filter-Chip (ToggleButton). Eingeschaltet: Verlaufsrahmen in BorderBrush. -->
    <Style x:Key="Lib.Chip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Accent}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="14,0,16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="20" BorderThickness="1"
                                Background="{DynamicResource Hp.Brush.SurfaceInput}" BorderBrush="{DynamicResource Hp.Brush.Border}" />
                        <Border x:Name="On" CornerRadius="20" BorderThickness="1.5" BorderBrush="{TemplateBinding BorderBrush}"
                                Background="{DynamicResource Hp.Brush.SurfaceSelected}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.BorderStrong}" />
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="On" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource Hp.Ease.Out}" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Auf-/Zuklappen (eingeschaltet = offen): Pfeil dreht sich -->
    <Style x:Key="Lib.CollapseToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Body" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <TextBlock x:Name="Chevron" Style="{StaticResource Lib.Glyph}" Text="&#xE70E;" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="180" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kopf eines aufklappbaren Abschnitts: die ganze Zeile ist klickbar, Pfeil rechts (eingeschaltet = offen) -->
    <Style x:Key="Lib.SectionHeaderToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Body" CornerRadius="10" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="8,6">
                        <DockPanel>
                            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Style="{StaticResource Lib.Glyph}" Text="&#xE70D;" FontSize="11" Margin="12,0,2,0"
                                       Foreground="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Pause-Chip: eingeschaltet in Warnfarbe -->
    <Style x:Key="Lib.PauseChip" TargetType="ToggleButton" BasedOn="{StaticResource Lib.Chip}">
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Warning}" />
        <Style.Triggers>
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Warning}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        Akzent-Schaltfläche wie Hp.AccentButton (Verlauf, Leuchten beim Überfahren), aber Anheben und Einblenden des
        Leuchtens nur, wenn Windows Animationen erlaubt; sonst leuchtet sie beim Überfahren ohne Bewegung.
    -->
    <Style x:Key="Lib.AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextOnAccent}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="18,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="10" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0">
                            <Border.Effect>
                                <BlurEffect Radius="14" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="Body" CornerRadius="10" Background="{DynamicResource Hp.Brush.Accent}" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Focus" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.Text}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.75" Duration="0:0:0.18" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.03" Duration="0:0:0.18" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.03" Duration="0:0:0.18" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Glow" Property="Opacity" Value="0.6" />
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kleinere Schaltflächen -->
    <Style x:Key="Lib.SmallGhostButton" TargetType="Button" BasedOn="{StaticResource Hp.GhostButton}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="11,7" />
    </Style>
    <!-- Schaltfläche der Werkzeugleiste: gefüllt wie Suchfeld und Chips, Rahmen leuchtet beim Überfahren -->
    <Style x:Key="Lib.ToolbarButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="14,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="10" BorderThickness="1"
                                Background="{DynamicResource Hp.Brush.SurfaceInput}" BorderBrush="{DynamicResource Hp.Brush.Border}" />
                        <Border x:Name="Glow" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceSelected}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Lib.ToolbarIconButton" TargetType="Button" BasedOn="{StaticResource Lib.ToolbarButton}">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Icons}" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="Lib.DangerButton" TargetType="Button" BasedOn="{StaticResource Lib.SmallGhostButton}">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Danger}" />
    </Style>
    <Style x:Key="Lib.LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.AccentSolid}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Body" Background="Transparent" Padding="2">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Schalter für Listenzeilen: wie Hp.ToggleSwitch (gleiches Aussehen und Gleiten), aber ohne Effekte,
        weil er in jeder sichtbaren Zeile steht.
    -->
    <Style x:Key="Lib.RowToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource Hp.ToggleSwitch}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="46" Height="24" Background="Transparent">
                        <Border x:Name="TrackOff" CornerRadius="12" Background="{DynamicResource Hp.Brush.HdrOff}" />
                        <Border x:Name="TrackOn" CornerRadius="12" Background="{DynamicResource Hp.Brush.HdrOn}" Opacity="0" />
                        <Border x:Name="FocusRing" CornerRadius="14" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.AccentSolid}" Opacity="0" />
                        <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{DynamicResource Hp.Brush.ToggleThumb}" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!-- Mit Animationen: Knopf gleitet. Ohne (Windows-Einstellung): sofort umgestellt. -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="22" Duration="0:0:0.16" EasingFunction="{StaticResource Hp.Ease.Snappy}" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16" EasingFunction="{StaticResource Hp.Ease.Snappy}" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Thumb" Property="Margin" Value="25,0,0,0" />
                            <Setter TargetName="TrackOn" Property="Opacity" Value="1" />
                        </MultiDataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Großer Schalter im Detailbereich: wie Hp.ToggleSwitch mit Leuchten (nur ein Element, Effekt erlaubt),
        aber Gleiten und Leuchten nur, wenn Windows Animationen erlaubt.
    -->
    <Style x:Key="Lib.ToggleSwitch" TargetType="CheckBox" BasedOn="{StaticResource Hp.ToggleSwitch}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid Width="46" Height="24" Background="Transparent">
                        <Border x:Name="TrackOff" CornerRadius="12" Background="{DynamicResource Hp.Brush.HdrOff}" />
                        <Border x:Name="TrackOn" CornerRadius="12" Background="{DynamicResource Hp.Brush.HdrOn}" Opacity="0">
                            <Border.Effect>
                                <DropShadowEffect Color="{DynamicResource Hp.Color.Glow}" BlurRadius="12" ShadowDepth="0" Opacity="0.75" />
                            </Border.Effect>
                        </Border>
                        <Border x:Name="FocusRing" CornerRadius="14" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.AccentSolid}" Opacity="0" />
                        <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="{DynamicResource Hp.Brush.ToggleThumb}" HorizontalAlignment="Left" Margin="3,0,0,0">
                            <Ellipse.RenderTransform>
                                <TranslateTransform X="0" />
                            </Ellipse.RenderTransform>
                        </Ellipse>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="22" Duration="0:0:0.16" EasingFunction="{StaticResource Hp.Ease.Snappy}" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Thumb" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.X)" To="0" Duration="0:0:0.16" EasingFunction="{StaticResource Hp.Ease.Snappy}" />
                                        <DoubleAnimation Storyboard.TargetName="TrackOn" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.16" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Thumb" Property="Margin" Value="25,0,0,0" />
                            <Setter TargetName="TrackOn" Property="Opacity" Value="1" />
                        </MultiDataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="Opacity" Value="0.9" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Liste ohne eigenen Rahmen, virtualisiert mit Wiederverwendung der Zeilen -->
    <Style x:Key="Lib.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel IsItemsHost="True" />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <ScrollViewer x:Name="ScrollHost" Focusable="False" Padding="0"
                                      CanContentScroll="{TemplateBinding ScrollViewer.CanContentScroll}"
                                      HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                                      VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Zeile der Spieleliste: beim Überfahren hebt sie sich leicht an und bekommt einen Verlaufsrahmen,
        die Auswahl zeigt einen Akzentbalken. Keine Effekte, nur Flächen.
    -->
    <Style x:Key="Lib.GameRow" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding Name}" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="Padding" Value="12,7,14,7" />
        <Setter Property="Margin" Value="0,0,6,3" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid x:Name="Root" Background="Transparent">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Border x:Name="Body" CornerRadius="12" Background="Transparent" />
                        <Border x:Name="Selected" CornerRadius="12" BorderThickness="1" Opacity="0"
                                Background="{DynamicResource Hp.Brush.SurfaceSelected}" BorderBrush="{DynamicResource Hp.Brush.BorderStrong}" />
                        <Border x:Name="HoverFrame" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,12" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <Border x:Name="FocusFrame" CornerRadius="12" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.AccentSolid}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="HoverFrame" Property="Opacity" Value="0.6" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="-2" Duration="0:0:0.18" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0.6" Duration="0:0:0.18" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Root" Storyboard.TargetProperty="(UIElement.RenderTransform).(TranslateTransform.Y)" To="0" Duration="0:0:0.22" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetName="HoverFrame" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusFrame" Property="Opacity" Value="0.7" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Schlichte Zeile (EXE-Liste, Vorschläge) -->
    <Style x:Key="Lib.PlainRow" TargetType="ListBoxItem">
        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Margin" Value="0,0,0,2" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="9" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" />
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" HorizontalAlignment="Left" Margin="0,8" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceSelected}" />
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.BorderStrong}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Aufklappbarer Warnbereich (Fehler je Scanner) -->
    <Style x:Key="Lib.WarningExpander" TargetType="Expander">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Grid>
                        <Border CornerRadius="12" Background="{DynamicResource Hp.Brush.Warning}" Opacity="0.1" />
                        <Border CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.Warning}" Opacity="0.7" />
                        <DockPanel>
                            <ToggleButton x:Name="HeaderToggle" Style="{x:Null}" DockPanel.Dock="Top" Focusable="True" Cursor="Hand" FocusVisualStyle="{x:Null}"
                                          HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch"
                                          IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border Background="Transparent" Padding="14,10">
                                            <DockPanel>
                                                <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Style="{StaticResource Lib.Glyph}" Text="&#xE70D;" FontSize="11"
                                                           Foreground="{DynamicResource Hp.Brush.Warning}" RenderTransformOrigin="0.5,0.5">
                                                    <TextBlock.RenderTransform>
                                                        <RotateTransform />
                                                    </TextBlock.RenderTransform>
                                                </TextBlock>
                                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7BA;" Foreground="{DynamicResource Hp.Brush.Warning}" Margin="0,0,10,0" />
                                                <ContentPresenter VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Chevron" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" />
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                                <ContentPresenter Content="{TemplateBinding Header}" TextElement.FontWeight="SemiBold" TextElement.Foreground="{DynamicResource Hp.Brush.Warning}" />
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite" Margin="40,0,14,12" Visibility="Collapsed" />
                        </DockPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Getönte Hinweisfläche; Farbe nach Tag (StatusKind: Info, Success, Warning, Error) -->
    <Style x:Key="Lib.StatusTint" TargetType="Border">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Opacity" Value="0.14" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Success">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warning">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Error">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Lib.StatusGlyph" TargetType="TextBlock" BasedOn="{StaticResource Lib.Glyph}">
        <Setter Property="Text" Value="&#xE946;" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Success">
                <Setter Property="Text" Value="&#xE73E;" />
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Success}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Warning">
                <Setter Property="Text" Value="&#xE7BA;" />
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Warning}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="Error">
                <Setter Property="Text" Value="&#xE783;" />
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Danger}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Karte des Detailbereichs (Abschnitt) -->
    <Style x:Key="Lib.Section" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.SurfaceInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,12" />
    </Style>
</ResourceDictionary>
