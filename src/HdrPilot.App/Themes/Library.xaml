<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lib="clr-namespace:HdrPilot.App.Views.Library">
    <!--
        Library: Stile der Spielebibliothek im Stil „Showcase Hero“ (E89; Hauptfenster und seine Dialoge). Farben nur über
        DynamicResource aus den Schlüsseln von Theming/ThemeKeys.cs (die Darstellung erzeugt sie aus Palette und Thema);
        was die Bibliothek zusätzlich braucht, steht hier als „Lib.“-Schlüssel. Keine impliziten Stile (andere Fenster
        bleiben unberührt). Keine Effekte (BlurEffect, DropShadowEffect), keine Mischmodi: Leuchten und Schatten sind
        Verläufe und geschichtete Flächen. Übergänge laufen nur, wenn lib:LibraryMotion sie erlaubt (Effektstufe und
        Windows-Animationseffekte).
    -->
    <lib:BoolToVisibilityConverter x:Key="Lib.BoolToVisibility" />
    <lib:IsVisibleConverter x:Key="Lib.IsVisible" />
    <lib:ScaleConverter x:Key="Lib.Scale" />

    <!-- Titelschrift (gleich Hp.Font.Display der Darstellung: Bahnschrift, mitgeliefert mit Windows) -->
    <FontFamily x:Key="Lib.Font.Display">Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>

    <!-- Flächen über dem Titelbild: in hell und dunkel dunkles Glas mit heller Schrift (Prototyp .glass, .hbar) -->
    <SolidColorBrush x:Key="Lib.Brush.HeaderGlass" Color="#A30A0B11" />
    <SolidColorBrush x:Key="Lib.Brush.HeaderGlassHover" Color="#CC1E202C" />
    <SolidColorBrush x:Key="Lib.Brush.HeaderLine" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Lib.Brush.HeaderLineStrong" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="Lib.Brush.ArtChip" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="Lib.Brush.ArtChipLine" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Lib.Brush.ArtCaption" Color="#FFA9AEC2" />
    <SolidColorBrush x:Key="Lib.Brush.ArtMuted" Color="#FF8D92A8" />
    <SolidColorBrush x:Key="Lib.Brush.ArtDark" Color="#73060810" />
    <!-- Läuft (Starten-Schaltfläche, Statuspunkt) und Pause (Bernstein) -->
    <LinearGradientBrush x:Key="Lib.Brush.Running" StartPoint="0,0.4" EndPoint="1,0.6">
        <GradientStop Color="#FF2BD67B" Offset="0" />
        <GradientStop Color="#FF12A35A" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Lib.Brush.Ok" Color="#FF3DDC84" />
    <SolidColorBrush x:Key="Lib.Brush.Amber" Color="#FFFFB020" />
    <SolidColorBrush x:Key="Lib.Brush.AmberText" Color="#FFFFC453" />
    <SolidColorBrush x:Key="Lib.Brush.AmberRing" Color="#BFFFB020" />
    <!-- Kachel: dunkle Ecken unter Name und Schalter, Lichthof unter der Maus -->
    <LinearGradientBrush x:Key="Lib.Brush.TileScrim" StartPoint="0.5,1" EndPoint="0.5,0">
        <GradientStop Color="#F205060A" Offset="0" />
        <GradientStop Color="#8C05060A" Offset="0.5" />
        <GradientStop Color="#0005060A" Offset="1" />
    </LinearGradientBrush>
    <!--
        Pinsel, die das Bibliotheksfenster je Thema und Spielfarbe in seinen eigenen Ressourcen ersetzt (MainWindow.xaml.cs);
        hier die Werte für dunkel, solange es das noch nicht getan hat.
    -->
    <!-- Gewählte Listenzeile: dunkel ein Verlauf in der Spielfarbe, hell Akzent 14 % -->
    <SolidColorBrush x:Key="Lib.Brush.RowSelection" Color="#24FF8A3D" />
    <!-- Fläche der Liste (dunkel: Fenstergrund 55 %, hell: Weiß 62 %) -->
    <SolidColorBrush x:Key="Lib.Brush.ListCard" Color="#8C120B12" />
    <!-- Detailbereich als Schublade im Regal: deckend (MainWindow färbt nach dem Spiel) -->
    <SolidColorBrush x:Key="Lib.Brush.Drawer" Color="#FF0B0C12" />
    <!-- Leuchten im Detailbereich (Spielfarben oben links, Zweitfarbe unten rechts) -->
    <SolidColorBrush x:Key="Lib.Brush.PaneGlow" Color="Transparent" />
    <!-- Automatik-Karte im Regal -->
    <LinearGradientBrush x:Key="Lib.Brush.Card" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#D112131B" Offset="0" />
        <GradientStop Color="#DB090A0F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Lib.Brush.CardLine" Color="#21FFFFFF" />
    <SolidColorBrush x:Key="Lib.Brush.CardText" Color="#FFF4F5FA" />
    <SolidColorBrush x:Key="Lib.Brush.CardSecondary" Color="#FFB4B9CB" />
    <SolidColorBrush x:Key="Lib.Brush.CardMuted" Color="#FF8D92A8" />
    <!-- Ränder der Kachelreihe im Regal laufen in den Fenstergrund aus -->
    <SolidColorBrush x:Key="Lib.Brush.ShelfFadeLeft" Color="Transparent" />
    <SolidColorBrush x:Key="Lib.Brush.ShelfFadeRight" Color="Transparent" />
    <!-- Name statt Logo: Weiß, unten in die helle Spielfarbe; darüber der wandernde Glanz -->
    <SolidColorBrush x:Key="Lib.Brush.HeroTitle" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Lib.Brush.HeroSheen" Color="Transparent" />
    <LinearGradientBrush x:Key="Lib.Brush.GeneratedShade" StartPoint="0.5,0" EndPoint="0.5,1">
        <GradientStop Color="#0D05060A" Offset="0" />
        <GradientStop Color="#4005060A" Offset="0.48" />
        <GradientStop Color="#DB05060A" Offset="1" />
    </LinearGradientBrush>

    <!-- Symbol aus Segoe Fluent Icons -->
    <Style x:Key="Lib.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Icons}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <!-- Kleine Überschrift in Großbuchstaben (Prototyp .cap2/.lb) -->
    <Style x:Key="Lib.Overline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style x:Key="Lib.SectionTitle" TargetType="TextBlock" BasedOn="{StaticResource Lib.Overline}">
        <Setter Property="Margin" Value="0,0,10,0" />
    </Style>

    <!-- Kleine Überschrift über dem Titelbild (Prototyp .ov): hell, mit Linie davor (die Linie setzt die Vorlage) -->
    <Style x:Key="Lib.ArtOverline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextOnArt}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Farbe je Quelle (Text) -->
    <Style x:Key="Lib.SourceText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.Manual}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="Steam">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.Steam}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Epic">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.Epic}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Xbox">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.Xbox}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Gog">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.Gog}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Ubisoft">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.Ubisoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="EA">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.EA}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="BattleNet">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.BattleNet}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Quiver">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Source.Quiver}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Farbpunkt je Quelle (Prototyp .sr i/.srcp i) -->
    <Style x:Key="Lib.SourceDot" TargetType="Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Fill" Value="{DynamicResource Hp.Brush.Source.Manual}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="Steam">
                <Setter Property="Fill" Value="{DynamicResource Hp.Brush.Source.Steam}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Epic">
                <Setter Property="Fill" Value="{DynamicResource Hp.Brush.Source.Epic}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Xbox">
                <Setter Property="Fill" Value="{DynamicResource Hp.Brush.Source.Xbox}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Gog">
                <Setter Property="Fill" Value="{DynamicResource Hp.Brush.Source.Gog}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Ubisoft">
                <Setter Property="Fill" Value="{DynamicResource Hp.Brush.Source.Ubisoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="EA">
                <Setter Property="Fill" Value="{DynamicResource Hp.Brush.Source.EA}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="BattleNet">
                <Setter Property="Fill" Value="{DynamicResource Hp.Brush.Source.BattleNet}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Quiver">
                <Setter Property="Fill" Value="{DynamicResource Hp.Brush.Source.Quiver}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Getönte Kachel je Quelle (Hintergrund des Spielsymbols) -->
    <Style x:Key="Lib.SourceTile" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Opacity" Value="0.16" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.Manual}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="Steam">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.Steam}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Epic">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.Epic}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Xbox">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.Xbox}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Gog">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.Gog}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Ubisoft">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.Ubisoft}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="EA">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.EA}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="BattleNet">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.BattleNet}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Quiver">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Source.Quiver}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Ersatzsymbol je Quelle, nur solange kein Symbol geladen ist (DataContext: GameItemViewModel) -->
    <Style x:Key="Lib.SourceGlyph" TargetType="TextBlock" BasedOn="{StaticResource Lib.SourceText}">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Text" Value="&#xE7FC;" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source}" Value="Xbox">
                <Setter Property="Text" Value="&#xE990;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Source}" Value="Manual">
                <Setter Property="Text" Value="&#xE8B7;" />
            </DataTrigger>
            <DataTrigger Binding="{Binding Icon}" Value="{x:Null}">
                <Setter Property="Visibility" Value="Visible" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Tastenkappe (Prototyp kbd) -->
    <Style x:Key="Lib.Kbd" TargetType="Border">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="5,2,5,3" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Line}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource Hp.Font.Mono}" />
        <Setter Property="TextElement.FontSize" Value="10.5" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
    </Style>

    <!-- Zähler in Chips und Auswahllisten (Prototyp .ct) -->
    <Style x:Key="Lib.Count" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="7,2,7,3" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
        <Setter Property="TextElement.FontFamily" Value="{DynamicResource Hp.Font.Mono}" />
        <Setter Property="TextElement.FontSize" Value="10.5" />
        <Setter Property="TextElement.FontWeight" Value="SemiBold" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
    </Style>

    <!-- Glasfläche der Werkzeugleiste (Suche, Auswahllisten, Chips, Schaltflächen) -->
    <Style x:Key="Lib.FieldFrame" TargetType="Border">
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Glass}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Suchfeld: Lupe, Platzhalter (Tag), „Strg+F“, Rahmen in Akzentfarbe bei Fokus -->
    <Style x:Key="Lib.SearchBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Hp.Brush.AccentStrong}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="38,0,70,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Body" Style="{StaticResource Lib.FieldFrame}" />
                        <Border x:Name="FocusFrame" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.AccentStrong}" Opacity="0" />
                        <Border x:Name="FocusHalo" CornerRadius="15" Margin="-3" BorderThickness="3" BorderBrush="{DynamicResource Hp.Brush.AccentSoft}" Opacity="0" />
                        <TextBlock x:Name="SearchGlyph" Style="{StaticResource Lib.Glyph}" Text="&#xE721;" FontSize="14" Margin="14,0,0,0" HorizontalAlignment="Left"
                                   Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                        <!-- Platz wie der eingegebene Text: rechts nur so viel, wie der Hinweis „Strg+F“ gerade braucht (Werkzeugleiste) -->
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="{TemplateBinding Padding}" Padding="1,0,0,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.TextMuted}" Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusFrame" Property="Opacity" Value="1" />
                            <Setter TargetName="FocusHalo" Property="Opacity" Value="1" />
                            <Setter TargetName="SearchGlyph" Property="Foreground" Value="{DynamicResource Hp.Brush.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eingabefeld der Dialoge -->
    <Style x:Key="Lib.TextBox" TargetType="TextBox" BasedOn="{StaticResource Lib.SearchBox}">
        <Setter Property="Padding" Value="12,0,12,0" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="10" BorderThickness="1"
                                Background="{DynamicResource Hp.Brush.SurfaceInput}" BorderBrush="{DynamicResource Hp.Brush.LineStrong}" />
                        <Border x:Name="FocusFrame" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                        <TextBlock x:Name="Placeholder" Text="{TemplateBinding Tag}" Margin="13,0,12,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource Hp.Brush.TextMuted}" Visibility="Collapsed" />
                        <ScrollViewer x:Name="PART_ContentHost" Style="{x:Null}" VerticalAlignment="Center" Focusable="False"
                                      HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusFrame" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eintrag einer Auswahlliste (Prototyp .mi): Fläche beim Überfahren, Akzent 22 % gewählt -->
    <Style x:Key="Lib.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="AutomationProperties.Name" Value="{Binding}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Margin="0,1">
                        <Border x:Name="Body" CornerRadius="10" Background="Transparent" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface1}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.AccentSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eintrag im Quellen-Filter: Name für UI-Automation mit aktueller Anzahl („Steam (631)“) -->
    <Style x:Key="Lib.SourceComboBoxItem" TargetType="ComboBoxItem" BasedOn="{StaticResource Lib.ComboBoxItem}">
        <Setter Property="AutomationProperties.Name" Value="{Binding AutomationName}" />
    </Style>

    <!-- Aufklappfläche (Menüs, Auswahllisten): deckend, Schatten als geschichtete Flächen statt Effekt -->
    <Style x:Key="Lib.PopupBody" TargetType="Border">
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Menu}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.LineStrong}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Lib.PopupShadow" TargetType="Border">
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Margin" Value="-4,2,-4,-10" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Background">
            <Setter.Value>
                <RadialGradientBrush RadiusX="0.56" RadiusY="0.58" Center="0.5,0.56" GradientOrigin="0.5,0.56">
                    <GradientStop Color="#59000000" Offset="0.7" />
                    <GradientStop Color="#00000000" Offset="1" />
                </RadialGradientBrush>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Auswahlliste der Werkzeugleiste (Quelle, Sortierung): Glasfläche, Pfeil am rechten Ende, Rahmen beim Öffnen -->
    <Style x:Key="Lib.ComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0,34,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="MaxDropDownHeight" Value="380" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Lib.ComboBoxItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton x:Name="Toggle" Style="{x:Null}" Focusable="False" ClickMode="Press" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border x:Name="Body" Style="{StaticResource Lib.FieldFrame}">
                                        <TextBlock x:Name="Chevron" Style="{StaticResource Lib.Glyph}" Text="&#xE70D;" FontSize="10" HorizontalAlignment="Right" Margin="0,0,13,0"
                                                   Foreground="{DynamicResource Hp.Brush.TextSecondary}" RenderTransformOrigin="0.5,0.5">
                                            <TextBlock.RenderTransform>
                                                <RotateTransform Angle="0" />
                                            </TextBlock.RenderTransform>
                                        </TextBlock>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Chevron" Property="RenderTransform">
                                                <Setter.Value>
                                                    <RotateTransform Angle="180" />
                                                </Setter.Value>
                                            </Setter>
                                            <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource Hp.Brush.AccentText}" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>
                        <ContentPresenter x:Name="ContentSite" IsHitTestVisible="False" Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                          VerticalAlignment="Center" HorizontalAlignment="Stretch" />
                        <Border x:Name="FocusFrame" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.AccentStrong}" Opacity="0" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" VerticalOffset="8" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}" PopupAnimation="None">
                            <Grid Margin="6,0,6,14" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                <Border Style="{StaticResource Lib.PopupShadow}" />
                                <Border Style="{StaticResource Lib.PopupBody}" MinWidth="236" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="True">
                            <Setter TargetName="PART_Popup" Property="PopupAnimation" Value="Fade" />
                        </DataTrigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="FocusFrame" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDropDownOpen" Value="True">
                            <Setter TargetName="FocusFrame" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Filter-Chip (ToggleButton, Prototyp .ch): Glasfläche; eingeschaltet Akzent 18 % mit Rahmen und leuchtendem Hof,
        der Zähler wird zum Verlauf. Der Inhalt füllt den Chip (Werkzeugleiste: Symbol und Text links, Zähler rechts), auch
        wenn die Leiste ihn streckt.
    -->
    <Style x:Key="Lib.Chip" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="11,0,10,0" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Grid>
                        <Border x:Name="Halo" CornerRadius="16" Margin="-4" Background="{DynamicResource Hp.Brush.AccentSoft}" Opacity="0" />
                        <Border x:Name="Body" Style="{StaticResource Lib.FieldFrame}" />
                        <Border x:Name="On" CornerRadius="12" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.AccentStrong}" Opacity="0">
                            <Border.Background>
                                <SolidColorBrush Color="{DynamicResource Hp.Color.C1}" Opacity="0.18" />
                            </Border.Background>
                        </Border>
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.FocusRing}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="On" Property="Opacity" Value="1" />
                            <Setter TargetName="Halo" Property="Opacity" Value="0.55" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsEnabled, Source={x:Static lib:LibraryMotion.Instance}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="On" Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.2" EasingFunction="{StaticResource Hp.Ease.Out}" FillBehavior="Stop" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Zähler im Chip: eingeschaltet als Verlauf in Akzentfarben (DataContext egal, Bezug auf den Chip) -->
    <Style x:Key="Lib.ChipCount" TargetType="Border" BasedOn="{StaticResource Lib.Count}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <Setter Property="Background" Value="{DynamicResource Hp.Brush.Accent}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.TextOnAccent}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Lib.ChipGlyph" TargetType="TextBlock" BasedOn="{StaticResource Lib.Glyph}">
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsChecked, RelativeSource={RelativeSource AncestorType=ToggleButton}}" Value="True">
                <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.AccentText}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Kennzeichen „HDR“ in der Liste (HDR laut PCGamingWiki): „NATIV“ mit leuchtendem Punkt in Glanzfarbe, „TEILWEISE“
        auf heller Fläche, „MOD“ nur umrandet (Prototyp .hp). DataContext: GameItemViewModel.
    -->
    <Style x:Key="Lib.HdrBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Padding" Value="8,0,8,0" />
        <Setter Property="Height" Value="22" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.LineStrong}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="TextElement.FontSize" Value="10" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HdrSupport}" Value="Native">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource Hp.Color.C3}" Opacity="0.2" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource Hp.Color.C3}" Opacity="0.5" />
                    </Setter.Value>
                </Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding HdrSupport}" Value="ModOnly">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        Kennzeichen „AUTO HDR“ hinter dem Namen (E88: „Windows Auto HDR“ für das Spiel an, nur Anzeige): Fläche im
        Akzentverlauf mit Text in Kontrastfarbe (Prototyp .bd.g). Die Farben setzt die Vorlage je Zeile.
    -->
    <Style x:Key="Lib.AutoHdrBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,0,6,1" />
        <Setter Property="Height" Value="19" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="TextElement.FontSize" Value="9.5" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>

    <!-- „NEU“: weiße Fläche, dunkle Schrift (im hellen Thema umgekehrt) -->
    <Style x:Key="Lib.NewBadge" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,0,6,1" />
        <Setter Property="Height" Value="19" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.WindowBackground}" />
        <Setter Property="TextElement.FontSize" Value="9.5" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
    </Style>

    <!-- Kennzeichen über dem Titelbild (Prototyp .kd): HDR-Angabe, umrandet; „Natives HDR“ in Glanzfarbe -->
    <Style x:Key="Lib.ArtTag" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="9,0" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="#38FFFFFF" />
        <Setter Property="Background" Value="#6B080A10" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextElement.Foreground" Value="#FFE8EAF2" />
        <Setter Property="TextElement.FontSize" Value="10.5" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsHdrNative}" Value="True">
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource Hp.Color.Ambient3}" Opacity="0.7" />
                    </Setter.Value>
                </Setter>
                <Setter Property="TextElement.Foreground" Value="#FFFFFFFF" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Kennzeichen im Detailbereich (Prototyp .tg2): HDR-Angabe neben „Windows Auto HDR“ -->
    <Style x:Key="Lib.Tag" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,2,6,3" />
        <Setter Property="Margin" Value="8,0,0,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Setter Property="TextElement.FontSize" Value="10" />
        <Setter Property="TextElement.FontWeight" Value="Bold" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding HdrSupport}" Value="Native">
                <Setter Property="Background">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource Hp.Color.C3}" Opacity="0.22" />
                    </Setter.Value>
                </Setter>
                <Setter Property="BorderBrush">
                    <Setter.Value>
                        <SolidColorBrush Color="{DynamicResource Hp.Color.C3}" Opacity="0.45" />
                    </Setter.Value>
                </Setter>
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.Text}" />
            </DataTrigger>
            <DataTrigger Binding="{Binding HdrSupport}" Value="Unknown">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.LineStrong}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.TextMuted}" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Auf-/Zuklappen (eingeschaltet = offen): Pfeil dreht sich -->
    <Style x:Key="Lib.CollapseToggle" TargetType="ToggleButton">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Body" CornerRadius="8" Background="Transparent" BorderThickness="1" BorderBrush="Transparent">
                        <TextBlock x:Name="Chevron" Style="{StaticResource Lib.Glyph}" Text="&#xE70E;" FontSize="11" HorizontalAlignment="Center"
                                   Foreground="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                            <TextBlock.RenderTransform>
                                <RotateTransform Angle="180" />
                            </TextBlock.RenderTransform>
                        </TextBlock>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="0" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface1}" />
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.FocusRing}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kopf eines aufklappbaren Abschnitts: die ganze Zeile ist klickbar, Pfeil rechts (eingeschaltet = offen) -->
    <Style x:Key="Lib.SectionHeaderToggle" TargetType="ToggleButton">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Body" CornerRadius="12" Background="Transparent" BorderThickness="1" BorderBrush="Transparent" Padding="8,6">
                        <DockPanel>
                            <TextBlock x:Name="Chevron" DockPanel.Dock="Right" Style="{StaticResource Lib.Glyph}" Text="&#xE70D;" FontSize="11" Margin="12,0,2,0"
                                       Foreground="{TemplateBinding Foreground}" RenderTransformOrigin="0.5,0.5">
                                <TextBlock.RenderTransform>
                                    <RotateTransform Angle="0" />
                                </TextBlock.RenderTransform>
                            </TextBlock>
                            <ContentPresenter VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Chevron" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface1}" />
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.FocusRing}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Schaltfläche der Kopfzeile über dem Titelbild: dunkles Glas, helle Schrift (Prototyp .pl.glass, .ib.glass) -->
    <Style x:Key="Lib.GlassButton" TargetType="ButtonBase">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextOnArt}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="13,0,15,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ButtonBase">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="14" Background="{StaticResource Lib.Brush.HeaderGlass}" BorderBrush="{StaticResource Lib.Brush.HeaderLine}" BorderThickness="1" />
                        <Border x:Name="Ring" CornerRadius="14" BorderThickness="1" BorderBrush="{StaticResource Lib.Brush.AmberRing}" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="16" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{StaticResource Lib.Brush.HeaderGlassHover}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="ToggleButton.IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            <Setter Property="Foreground" Value="{StaticResource Lib.Brush.AmberText}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Lib.GlassIconButton" TargetType="ButtonBase" BasedOn="{StaticResource Lib.GlassButton}">
        <Setter Property="Width" Value="44" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!-- Pause-Schalter der Kopfzeile: eingeschaltet in Bernstein (Prototyp .pz.on) -->
    <Style x:Key="Lib.PauseChip" TargetType="ToggleButton" BasedOn="{StaticResource Lib.GlassButton}" />

    <!--
        „HDR einschalten“ in der Kapsel (Prototyp .hb): Akzentverlauf mit Kontrastschrift und Glanzkante; bei
        eingeschaltetem HDR (Tag = True) als Glas („HDR ausschalten“).
    -->
    <Style x:Key="Lib.HdrButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextOnAccent}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Padding" Value="13,0,17,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="18" Margin="-6,-2,-6,-10" IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush RadiusX="0.55" RadiusY="0.6" Center="0.5,0.62" GradientOrigin="0.5,0.62">
                                    <GradientStop Color="{DynamicResource Hp.Color.C2}" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Body" CornerRadius="13" Background="{DynamicResource Hp.Brush.Accent}" />
                        <Border x:Name="Shine" CornerRadius="13" BorderThickness="0,1,0,0" BorderBrush="#73FFFFFF" />
                        <Border x:Name="Focus" CornerRadius="15" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Opacity" Value="0.92" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Tag" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="#1FFFFFFF" />
                            <Setter TargetName="Shine" Property="BorderThickness" Value="1" />
                            <Setter TargetName="Shine" Property="BorderBrush" Value="#33FFFFFF" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextOnArt}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Akzent-Schaltfläche (Starten, Übernehmen): Verlauf Akzent → Atmosphäre, Glanzkante oben, weicher Hof aus einem
        Verlauf (kein Effekt). Anheben beim Überfahren nur bei erlaubten Übergängen.
    -->
    <Style x:Key="Lib.AccentButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextOnAccent}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1" ScaleY="1" />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Glow" CornerRadius="16" Margin="-8,-2,-8,-12" Opacity="0.55" IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush RadiusX="0.52" RadiusY="0.6" Center="0.5,0.64" GradientOrigin="0.5,0.64">
                                    <GradientStop Color="{DynamicResource Hp.Color.C2}" Offset="0" />
                                    <GradientStop Color="#00000000" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="Body" CornerRadius="12" Background="{DynamicResource Hp.Brush.Accent}" />
                        <Border CornerRadius="12" BorderThickness="0,1,0,0" BorderBrush="#66FFFFFF" />
                        <Border x:Name="Focus" CornerRadius="14" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Visibility="Collapsed" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsFull, Source={x:Static lib:LibraryMotion.Instance}}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.02" Duration="0:0:0.18" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.02" Duration="0:0:0.18" EasingFunction="{StaticResource Hp.Ease.Out}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Glow" Storyboard.TargetProperty="Opacity" To="0.55" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.25" />
                                        <DoubleAnimation Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsMouseOver, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding IsFull, Source={x:Static lib:LibraryMotion.Instance}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Glow" Property="Opacity" Value="1" />
                        </MultiDataTrigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Body" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="Tag" Value="Running">
                            <Setter TargetName="Body" Property="Background" Value="{StaticResource Lib.Brush.Running}" />
                            <Setter TargetName="Glow" Property="Opacity" Value="0" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Schaltfläche im Detailbereich (Prototyp .pbtn): leichte Fläche mit feiner Linie -->
    <Style x:Key="Lib.PaneButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
