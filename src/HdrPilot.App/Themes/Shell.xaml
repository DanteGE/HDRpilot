<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:HdrPilot.App.Views.Shell"
                    xmlns:res="clr-namespace:HdrPilot.App.Resources">
    <!--
        Shell: Stile für Tray-Menü und Einstellungen. Farben nur über DynamicResource aus Tokens.Dark/Light.xaml.
        Bewegung: Zustandswechsel sind sofort sichtbar (Setter); kurze Zier-Animationen laufen nur, wenn Windows
        „Animationseffekte“ erlaubt (SystemParameters.ClientAreaAnimation). Effekte (Schatten, Unschärfe) sitzen nur
        auf einzelnen Elementen, nie auf Listenzeilen.
    -->

    <BooleanToVisibilityConverter x:Key="Hp.Shell.BoolToVisibility" />
    <views:InverseBooleanToVisibilityConverter x:Key="Hp.Shell.InverseBoolToVisibility" />
    <views:NoHdrBadgeVisibilityConverter x:Key="Hp.Shell.NoHdrBadgeVisibility" />

    <!-- Symbol (Segoe Fluent Icons) -->
    <Style x:Key="Hp.Shell.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <!-- Feldbeschriftung -->
    <Style x:Key="Hp.Shell.Label" TargetType="TextBlock" BasedOn="{StaticResource Hp.Text.Body}">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Wert-Anzeige neben Reglern -->
    <Style x:Key="Hp.Shell.ValuePill" TargetType="Border">
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="9,2,9,3" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.SurfaceSelected}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Hp.Shell.ValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Display}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
    </Style>

    <!-- Abzeichen mit Akzent-Rahmen (z. B. „HDR-fähig“) -->
    <Style x:Key="Hp.Shell.Badge.Accent" TargetType="Border" BasedOn="{StaticResource Hp.Badge}">
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
    </Style>
    <Style x:Key="Hp.Shell.BadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
    </Style>

    <!--
        Abschnitt als Karte: Symbol-Kachel, Titel, Inhalt. Beim Überfahren hebt sich die Karte leicht an und bekommt
        einen Verlaufsrahmen mit weichem Leuchten (ShellMotion.HoverLift, Effekt nur auf der gerade überfahrenen Karte).
    -->
    <Style x:Key="Hp.Shell.Section" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,16" />
        <Setter Property="views:ShellMotion.HoverLift" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid x:Name="Root">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <Border x:Name="PART_Glow" CornerRadius="16" Margin="4" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" IsHitTestVisible="False" />
                        <Border Background="{DynamicResource Hp.Brush.Surface}" BorderBrush="{DynamicResource Hp.Brush.Border}" BorderThickness="1" CornerRadius="16" Padding="22,16,22,18">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12" LastChildFill="True">
                                    <Grid Width="34" Height="34" Margin="0,0,14,0" VerticalAlignment="Center">
                                        <Border CornerRadius="11" Background="{DynamicResource Hp.Brush.SurfaceSelected}" BorderBrush="{DynamicResource Hp.Brush.BorderStrong}" BorderThickness="1" />
                                        <TextBlock Style="{StaticResource Hp.Shell.Glyph}" Text="{TemplateBinding Tag}" FontSize="17"
                                                   Foreground="{DynamicResource Hp.Brush.Accent}" HorizontalAlignment="Center" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource Hp.Text.Subtitle}" VerticalAlignment="Center"
                                               Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                                </DockPanel>
                                <ContentPresenter />
                            </DockPanel>
                        </Border>
                        <Border x:Name="PART_Ring" CornerRadius="16" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.Accent}" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Zeile mit Text links und Schalter rechts -->
    <Style x:Key="Hp.Shell.SettingRow" TargetType="Border">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.SurfaceInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Border}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Regler: Spur mit HDR-Verlauf bis zum Knopf, Knopf mit Halo bei Hover/Ziehen -->
    <Style x:Key="Hp.Shell.SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" Margin="0,0,-4,0" VerticalAlignment="Center" Background="{DynamicResource Hp.Brush.HdrOn}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hp.Shell.SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hp.Shell.SliderThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse x:Name="Halo" Margin="-6" Fill="{DynamicResource Hp.Brush.AccentSolid}" Opacity="0" />
                        <Ellipse Fill="{DynamicResource Hp.Brush.ToggleThumb}" Stroke="{DynamicResource Hp.Brush.AccentSolid}" StrokeThickness="3" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.22" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="0.34" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hp.Shell.Slider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="30" Background="Transparent">
                        <Border x:Name="Focus" Margin="-6,0" CornerRadius="10" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.AccentSolid}" Opacity="0" />
                        <Border Height="6" CornerRadius="3" Margin="2,0" VerticalAlignment="Center" Background="{DynamicResource Hp.Brush.HdrOff}" />
                        <Track x:Name="PART_Track" Margin="2,0">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Hp.Shell.SliderFill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Hp.Shell.SliderRest}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Hp.Shell.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eingabefeld -->
    <Style x:Key="Hp.Shell.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.SurfaceInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.BorderStrong}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Focus" CornerRadius="12" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Passwortfeld (Bot-Passwort): wie das Eingabefeld, zeigt nur Punkte -->
    <Style x:Key="Hp.Shell.PasswordBox" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.SurfaceInput}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.BorderStrong}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="12" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Focus" CornerRadius="12" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.TextMuted}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Link (öffnet eine Webseite im Standardbrowser): Akzentfarbe, unterstrichen bei Fokus und beim Überfahren -->
    <Style x:Key="Hp.Shell.LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.AccentSolid}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="2,1">
                        <TextBlock x:Name="Text" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Listen -->
    <Style x:Key="Hp.Shell.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <!-- Liste in scrollender Seite: Mausrad geht an die Seite weiter, wenn die Liste nicht (mehr) scrollen kann. -->
        <Setter Property="views:ShellScroll.ChainWheel" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Auswählbare Zeile: Hover-Fläche, Auswahl mit Akzentbalken (keine Effekte pro Zeile) -->
    <Style x:Key="Hp.Shell.ListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Body" CornerRadius="9" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" Margin="3,7" HorizontalAlignment="Left" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="9" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.AccentSolid}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceSelected}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Zeile ohne eigene Auswahl (Inhalt ist z. B. eine CheckBox) -->
    <Style x:Key="Hp.Shell.PlainListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Auswahl-Kästchen als Karte (Bildschirm-Auswahl): ganze Zeile klickbar, Haken im Verlauf. Der Haken „springt“
        kurz auf, wenn Animationen erlaubt sind; sonst erscheint er sofort.
    -->
    <Style x:Key="Hp.Shell.CheckCard" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="12" Background="{DynamicResource Hp.Brush.SurfaceInput}" BorderBrush="{DynamicResource Hp.Brush.Border}" BorderThickness="1" />
                        <Border x:Name="Selected" CornerRadius="12" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <Grid Margin="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="22" Height="22" VerticalAlignment="Center">
                                <Border x:Name="Box" CornerRadius="7" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.BorderStrong}" Background="{DynamicResource Hp.Brush.Surface}" />
                                <Border x:Name="Fill" CornerRadius="7" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                                <TextBlock x:Name="Check" Style="{StaticResource Hp.Shell.Glyph}" Text="&#xE73E;" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource Hp.Brush.TextOnAccent}" HorizontalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Grid>
                        <Border x:Name="Focus" CornerRadius="12" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.AccentSolid}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="1" />
                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                            <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceSelected}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Path=(views:ShellMotion.IsEnabled)}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.4" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource Hp.Ease.Snappy}" />
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.4" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource Hp.Ease.Snappy}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="0.85" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Auswahlliste -->
    <Style x:Key="Hp.Shell.ComboBoxToggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Body" CornerRadius="12" Background="{DynamicResource Hp.Brush.SurfaceInput}" BorderBrush="{DynamicResource Hp.Brush.BorderStrong}" BorderThickness="1">
                        <TextBlock x:Name="Arrow" Style="{StaticResource Hp.Shell.Glyph}" Text="&#xE70D;" FontSize="11" Margin="0,0,14,0"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.TextMuted}" />
                            <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                            <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hp.Shell.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Body" CornerRadius="9" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" Margin="3,8" HorizontalAlignment="Left" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hp.Shell.ComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Hp.Shell.ComboBoxItem}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Hp.Shell.ComboBoxToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter IsHitTestVisible="False" Margin="14,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Border x:Name="Focus" CornerRadius="12" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.Accent}" Opacity="0" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
                            <Grid Margin="0,4,14,14" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <Border CornerRadius="12" Background="{DynamicResource Hp.Brush.WindowBackground}">
                                    <Border.Effect>
                                        <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.4" Color="{DynamicResource Hp.Color.Shadow}" />
                                    </Border.Effect>
                                </Border>
                                <Border CornerRadius="12" Background="{DynamicResource Hp.Brush.WindowBackground}" BorderBrush="{DynamicResource Hp.Brush.BorderStrong}" BorderThickness="1" Padding="4">
                                    <ScrollViewer Focusable="False">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Schaltflächen-Inhalt: Symbol + Text -->
    <Style x:Key="Hp.Shell.ButtonGlyph" TargetType="TextBlock" BasedOn="{StaticResource Hp.Shell.Glyph}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>

    <!--
        Tray-Menü: abgerundet, App-Verlauf als Hintergrund, Kopf mit Status-Pille. Schatten auf einem eigenen
        Element hinter dem Menü (Texte bleiben ClearType-scharf).
    -->
    <Style x:Key="Hp.Shell.TrayMenu" TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid x:Name="PART_Body" Margin="10,6,14,16">
                        <Border CornerRadius="14" Background="{DynamicResource Hp.Brush.WindowBackground}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.45" Color="{DynamicResource Hp.Color.Shadow}" />
                            </Border.Effect>
                        </Border>
                        <Border CornerRadius="14" Background="{DynamicResource Hp.Brush.WindowBackground}" BorderBrush="{DynamicResource Hp.Brush.BorderStrong}" BorderThickness="1">
                            <Grid>
                                <Border CornerRadius="14" Background="{DynamicResource Hp.Brush.BackgroundGlow}" />
                                <StackPanel Margin="6">
                                    <Grid Margin="10,10,10,10">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="34" Height="34" Margin="0,0,12,0">
                                            <Border CornerRadius="10" Background="{DynamicResource Hp.Brush.Accent}" />
                                            <TextBlock Text="H" FontFamily="{StaticResource Hp.Font.Display}" FontWeight="Black" FontSize="18"
                                                       Foreground="{DynamicResource Hp.Brush.TextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static res:CommonStrings.AppName}" FontFamily="{StaticResource Hp.Font.Display}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Hp.Brush.Text}" />
                                            <TextBlock Text="{Binding StatusDetail}" Style="{StaticResource Hp.Text.Caption}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxWidth="170" />
                                        </StackPanel>
                                        <Grid Grid.Column="2" VerticalAlignment="Center" Margin="10,0,0,0">
                                            <Border x:Name="PillOff" CornerRadius="9" Padding="10,3,10,4" Background="{DynamicResource Hp.Brush.HdrOff}">
                                                <TextBlock Text="{Binding StatusTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" />
                                            </Border>
                                            <Border x:Name="PillOn" CornerRadius="9" Padding="10,3,10,4" Background="{DynamicResource Hp.Brush.HdrOn}" Visibility="Collapsed">
                                                <TextBlock Text="{Binding StatusTitle}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextOnAccent}" />
                                            </Border>
                                        </Grid>
                                    </Grid>
                                    <Rectangle Height="1" Margin="8,0,8,6" Fill="{DynamicResource Hp.Brush.Border}" />
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHdrOn}" Value="True">
                            <Setter TargetName="PillOn" Property="Visibility" Value="Visible" />
                            <Setter TargetName="PillOff" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hp.Shell.TrayMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,9" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid Background="Transparent" Margin="0,1">
                        <Border x:Name="Hover" CornerRadius="9" Background="{DynamicResource Hp.Brush.SurfaceHover}" Opacity="0" />
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" Margin="2,9" HorizontalAlignment="Left" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <Grid x:Name="Switch" Grid.Column="2" Width="32" Height="18" Margin="14,0,2,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border x:Name="Track" CornerRadius="9" Background="{DynamicResource Hp.Brush.HdrOff}" />
                                <Border x:Name="TrackOn" CornerRadius="9" Background="{DynamicResource Hp.Brush.HdrOn}" Opacity="0" />
                                <Ellipse x:Name="Knob" Width="12" Height="12" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Hp.Brush.ToggleThumb}" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.AccentSolid}" />
                        </Trigger>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="Switch" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TrackOn" Property="Opacity" Value="1" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hp.Shell.TrayMenuSeparator" TargetType="Separator">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Margin="12,5" Fill="{DynamicResource Hp.Brush.Border}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
