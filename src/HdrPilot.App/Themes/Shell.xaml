<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:views="clr-namespace:HdrPilot.App.Views.Shell"
                    xmlns:res="clr-namespace:HdrPilot.App.Resources">
    <!--
        Shell im Showcase-Stil (E89): Einstellungen mit Navigation und Bereichskarten, Seite „Darstellung“, Tray-Menü.
        Farben nur über DynamicResource aus den Farb-Ressourcen der Darstellung (Theming/ThemeKeys.cs). Leuchten und Schatten
        sind vorab gezeichnete Verläufe hinter den Elementen, nie BlurEffect oder DropShadowEffect. Bewegung: Zustandswechsel
        sind sofort sichtbar (Setter); kurze Zier-Animationen laufen nur, wenn Windows „Animationseffekte“ erlaubt.
    -->

    <BooleanToVisibilityConverter x:Key="Hp.Shell.BoolToVisibility" />
    <views:InverseBooleanToVisibilityConverter x:Key="Hp.Shell.InverseBoolToVisibility" />
    <views:NoHdrBadgeVisibilityConverter x:Key="Hp.Shell.NoHdrBadgeVisibility" />
    <views:NullToVisibilityConverter x:Key="Hp.Shell.NullToVisibility" />
    <views:ResourceKeyToBrushConverter x:Key="Hp.Shell.ResourceBrush" />
    <views:FractionToWidthConverter x:Key="Hp.Shell.FractionWidth" />
    <views:UpperCaseConverter x:Key="Hp.Shell.Upper" />
    <views:WidthAtLeastToVisibilityConverter x:Key="Hp.Shell.WidthAtLeast" />

