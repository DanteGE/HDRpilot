    <!-- Symbol (Segoe Fluent Icons) -->
    <Style x:Key="Hp.Shell.Glyph" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Icons}" />
        <Setter Property="FontSize" Value="16" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextOptions.TextRenderingMode" Value="Grayscale" />
    </Style>

    <!-- Feldbeschriftung -->
    <Style x:Key="Hp.Shell.Label" TargetType="TextBlock" BasedOn="{StaticResource Hp.Text.Body}">
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Kleine Großbuchstaben-Zeile (.cap2) -->
    <Style x:Key="Hp.Shell.Overline" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Wert-Anzeige neben Reglern -->
    <Style x:Key="Hp.Shell.ValuePill" TargetType="Border">
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="10,3,10,4" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Hp.Shell.ValueText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource Hp.Font.Mono}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
    </Style>

    <!-- Abzeichen mit Akzent-Rahmen (z. B. „HDR-fähig“) -->
    <Style x:Key="Hp.Shell.Badge.Accent" TargetType="Border" BasedOn="{StaticResource Hp.Badge}">
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentStrong}" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.SelectionFill}" />
    </Style>
    <Style x:Key="Hp.Shell.BadgeText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
    </Style>

    <!-- Kennzeichen (.tg2): Großbuchstaben auf leichter Fläche; .nat mit Glanz-Ring -->
    <Style x:Key="Hp.Shell.Tag" TargetType="Border">
        <Setter Property="CornerRadius" Value="5" />
        <Setter Property="Padding" Value="6,3,6,3" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Hp.Shell.TagShine" TargetType="Border" BasedOn="{StaticResource Hp.Shell.Tag}">
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.AccentSoft}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentStrong}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Hp.Shell.TagText" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
    </Style>

    <!-- Symbol-Kachel im Kopf einer Karte (.cib): Akzent 14 %, Ring Akzent, Symbol in Akzenttext -->
    <Style x:Key="Hp.Shell.IconBox" TargetType="Border">
        <Setter Property="Width" Value="38" />
        <Setter Property="Height" Value="38" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.SelectionFill}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentSoft}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.AccentText}" />
    </Style>

    <!--
        Bereich als Karte (.card): Kartenfläche mit feinem Rand, Innenlicht oben und leichtem Leuchten der Atmosphäre links
        oben; Kopf mit Symbol-Kachel, Titel in der Titelschrift, Unterzeile und Bedienelementen rechts (Tag). Beim Überfahren hebt
        sich die Karte leicht an (ShellMotion.HoverLift), Ring und Leuchten sind vorab gezeichnete Verläufe.
    -->
    <Style x:Key="Hp.Shell.Section" TargetType="HeaderedContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0" />
        <Setter Property="views:ShellMotion.HoverLift" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="HeaderedContentControl">
                    <Grid x:Name="Root">
                        <Grid.RenderTransform>
                            <TranslateTransform />
                        </Grid.RenderTransform>
                        <!-- Schatten unter der Karte als weicher radialer Verlauf -->
                        <Border Margin="18,30,18,-16" CornerRadius="40" IsHitTestVisible="False" Opacity="0.55">
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.62" GradientOrigin="0.5,0.62" RadiusX="0.56" RadiusY="0.5">
                                    <GradientStop Color="{DynamicResource Hp.Color.Shadow}" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border x:Name="PART_Glow" Margin="-10" CornerRadius="30" Opacity="0" IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush RadiusX="0.62" RadiusY="0.62">
                                    <GradientStop Color="{DynamicResource Hp.Color.C2}" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="22" Background="{DynamicResource Hp.Brush.Panel}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1" />
                        <Border CornerRadius="22" IsHitTestVisible="False" Opacity="0.12">
                            <Border.Background>
                                <RadialGradientBrush Center="0,0" GradientOrigin="0,0" RadiusX="1" RadiusY="0.5">
                                    <GradientStop Color="{DynamicResource Hp.Color.C2}" Offset="0" />
                                    <GradientStop Color="Transparent" Offset="0.6" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border Margin="1" CornerRadius="21" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource Hp.Brush.PanelHighlight}" IsHitTestVisible="False" />
                        <DockPanel Margin="20,18,20,20">
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Hp.Shell.IconBox}" Margin="0,0,12,0" VerticalAlignment="Center">
                                    <views:LineIcon Width="18" Height="18" Data="{Binding (views:SettingsSection.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                                </Border>
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock FontFamily="{DynamicResource Hp.Font.Display}" FontSize="17" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}"
                                               TextTrimming="CharacterEllipsis" Text="{Binding Header, RelativeSource={RelativeSource TemplatedParent}}" />
                                    <TextBlock x:Name="Description" Style="{StaticResource Hp.Text.Caption}" FontSize="12.5" Margin="0,3,0,0"
                                               Text="{Binding (views:SettingsSection.Description), RelativeSource={RelativeSource TemplatedParent}}" />
                                </StackPanel>
                                <ContentPresenter Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center" Content="{TemplateBinding Tag}" />
                            </Grid>
                            <ContentPresenter />
                        </DockPanel>
                        <Border x:Name="PART_Ring" CornerRadius="22" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.AccentStrong}" Opacity="0" IsHitTestVisible="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Description" Property="Text" Value="{x:Null}">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger SourceName="Description" Property="Text" Value="">
                            <Setter TargetName="Description" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Zeile mit Text links und Schalter rechts (.cr) -->
    <Style x:Key="Hp.Shell.SettingRow" TargetType="Border">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>

    <!-- Schlichte Schalterzeile mit Trennlinie oben (.prow) -->
    <Style x:Key="Hp.Shell.PlainRow" TargetType="Border">
        <Setter Property="Padding" Value="2,8" />
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Line}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>

    <!-- Unterkarte innerhalb einer Karte (.so) -->
    <Style x:Key="Hp.Shell.SubCard" TargetType="Border">
        <Setter Property="Padding" Value="14,12" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="Hp.Shell.SubCard.Primary" TargetType="Border" BasedOn="{StaticResource Hp.Shell.SubCard}">
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentStrong}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>

    <!-- Hinweis mit Info-Symbol (.src-l) -->
    <Style x:Key="Hp.Shell.Note" TargetType="TextBlock" BasedOn="{StaticResource Hp.Text.Caption}">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LineHeight" Value="17" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextMuted}" />
    </Style>

    <!-- Regler: Spur 6 px, gefüllt im Verlauf der Bedienelemente bis zum Knopf, Knopf weiß mit Akzentring -->
    <Style x:Key="Hp.Shell.SliderFill" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent">
                        <Border Height="6" CornerRadius="3" Margin="0,0,-4,0" VerticalAlignment="Center" Background="{DynamicResource Hp.Brush.ToggleOn}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hp.Shell.SliderRest" TargetType="RepeatButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RepeatButton">
                    <Grid Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hp.Shell.SliderThumb" TargetType="Thumb">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Width" Value="20" />
        <Setter Property="Height" Value="20" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Grid>
                        <Ellipse x:Name="Halo" Margin="-6" Fill="{DynamicResource Hp.Brush.AccentSoft}" Opacity="0" />
                        <Ellipse Fill="{DynamicResource Hp.Brush.ToggleThumb}" Stroke="{DynamicResource Hp.Brush.FocusRing}" StrokeThickness="3" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Halo" Property="Opacity" Value="1" />
                            <Setter TargetName="Halo" Property="Margin" Value="-8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hp.Shell.Slider" TargetType="Slider">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid Height="30" Background="Transparent">
                        <Border x:Name="Focus" Margin="-6,0" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                        <Border Height="6" CornerRadius="3" Margin="2,0" VerticalAlignment="Center" Background="{DynamicResource Hp.Brush.HdrOff}" />
                        <Track x:Name="PART_Track" Margin="2,0">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource Hp.Shell.SliderFill}" />
                            </Track.DecreaseRepeatButton>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource Hp.Shell.SliderRest}" />
                            </Track.IncreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb Style="{StaticResource Hp.Shell.SliderThumb}" />
                            </Track.Thumb>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Eingabefeld (.key label): leichte Fläche, feiner Rand, Fokusring -->
    <Style x:Key="Hp.Shell.TextBox" TargetType="TextBox">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Line}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Focus" CornerRadius="11" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Passwortfeld (Bot-Passwort, API-Schlüssel): wie das Eingabefeld, zeigt nur Punkte -->
    <Style x:Key="Hp.Shell.PasswordBox" TargetType="PasswordBox">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Line}" />
        <Setter Property="CaretBrush" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource Hp.Brush.AccentSolid}" />
        <Setter Property="SelectionOpacity" Value="0.35" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="11" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" />
                        <Border x:Name="Focus" CornerRadius="11" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Link (öffnet eine Webseite im Standardbrowser): Akzenttext, unterstrichen bei Fokus und beim Überfahren -->
    <Style x:Key="Hp.Shell.LinkButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.AccentText}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border Background="Transparent" Padding="2,1">
                        <TextBlock x:Name="Text" Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Text" Property="TextDecorations" Value="Underline" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Listen -->
    <Style x:Key="Hp.Shell.ListBox" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.VirtualizationMode" Value="Recycling" />
        <!-- Liste in scrollender Seite: Mausrad geht an die Seite weiter, wenn die Liste nicht (mehr) scrollen kann. -->
        <Setter Property="views:ShellScroll.ChainWheel" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                            <ItemsPresenter />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Auswählbare Zeile: Hover-Fläche, Auswahl in Akzent 14 % mit Akzentbalken (keine Effekte pro Zeile) -->
    <Style x:Key="Hp.Shell.ListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Body" CornerRadius="10" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" Margin="3,8" HorizontalAlignment="Left" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SelectionFill}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Zeile ohne eigene Auswahl (Inhalt ist z. B. eine CheckBox) -->
    <Style x:Key="Hp.Shell.PlainListBoxItem" TargetType="ListBoxItem">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Auswahl-Kästchen als Karte (Bildschirm-Auswahl): ganze Zeile klickbar, Haken im Akzentverlauf, gewählt mit Ring.
        Der Haken „springt“ kurz auf, wenn Animationen erlaubt sind; sonst erscheint er sofort.
    -->
    <Style x:Key="Hp.Shell.CheckCard" TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="16" Background="{DynamicResource Hp.Brush.Surface1}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1" />
                        <Border x:Name="Selected" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.SelectionRing}" Opacity="0" />
                        <Grid Margin="14,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Width="22" Height="22" VerticalAlignment="Center">
                                <Border x:Name="Box" CornerRadius="7" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.LineStrong}" Background="{DynamicResource Hp.Brush.Surface2}" />
                                <Border x:Name="Fill" CornerRadius="7" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                                <TextBlock x:Name="Check" Style="{StaticResource Hp.Shell.Glyph}" Text="&#xE73E;" FontSize="12" FontWeight="Bold"
                                           Foreground="{DynamicResource Hp.Brush.TextOnAccent}" HorizontalAlignment="Center" Opacity="0" RenderTransformOrigin="0.5,0.5">
                                    <TextBlock.RenderTransform>
                                        <ScaleTransform />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Grid>
                            <ContentPresenter Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        </Grid>
                        <Border x:Name="Focus" CornerRadius="18" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentStrong}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Fill" Property="Opacity" Value="1" />
                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                            <Setter TargetName="Selected" Property="Opacity" Value="1" />
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SelectionFill}" />
                        </Trigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding IsChecked, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Path=(views:ShellMotion.IsEnabled)}" Value="True" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" From="0.4" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource Hp.Ease.Snappy}" />
                                        <DoubleAnimation Storyboard.TargetName="Check" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" From="0.4" To="1" Duration="0:0:0.22" EasingFunction="{StaticResource Hp.Ease.Snappy}" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </MultiDataTrigger.EnterActions>
                        </MultiDataTrigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Auswahlliste -->
    <Style x:Key="Hp.Shell.ComboBoxToggle" TargetType="ToggleButton">
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="ClickMode" Value="Press" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToggleButton">
                    <Border x:Name="Body" CornerRadius="11" Background="{DynamicResource Hp.Brush.Surface2}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1">
                        <TextBlock x:Name="Arrow" Style="{StaticResource Hp.Shell.Glyph}" Text="&#xE70D;" FontSize="11" Margin="0,0,14,0"
                                   HorizontalAlignment="Right" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentStrong}" />
                            <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Hp.Brush.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.FocusRing}" />
                            <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource Hp.Brush.AccentText}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hp.Shell.ComboBoxItem" TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="AutomationProperties.Name" Value="{Binding Label}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid Background="Transparent">
                        <Border x:Name="Body" CornerRadius="9" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" Margin="3,8" HorizontalAlignment="Left" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.SurfaceHover}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hp.Shell.ComboBox" TargetType="ComboBox">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Height" Value="38" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource Hp.Shell.ComboBoxItem}" />
        <Setter Property="ScrollViewer.CanContentScroll" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton Style="{StaticResource Hp.Shell.ComboBoxToggle}"
                                      IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" />
                        <ContentPresenter IsHitTestVisible="False" Margin="14,0,36,0" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                          ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" />
                        <Border x:Name="Focus" CornerRadius="11" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" IsHitTestVisible="False" />
                        <Popup x:Name="PART_Popup" Placement="Bottom" AllowsTransparency="True" Focusable="False"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}">
                            <Grid Margin="0,4,14,16" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <!-- Schatten als weicher Verlauf unter der Liste -->
                                <Border Margin="6,10,-8,-14" CornerRadius="18" Opacity="0.6" IsHitTestVisible="False">
                                    <Border.Background>
                                        <RadialGradientBrush Center="0.5,0.6" GradientOrigin="0.5,0.6" RadiusX="0.6" RadiusY="0.6">
                                            <GradientStop Color="{DynamicResource Hp.Color.Shadow}" Offset="0.3" />
                                            <GradientStop Color="Transparent" Offset="1" />
                                        </RadialGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Border CornerRadius="12" Background="{DynamicResource Hp.Brush.Menu}" BorderBrush="{DynamicResource Hp.Brush.LineStrong}" BorderThickness="1" Padding="4">
                                    <ScrollViewer Focusable="False">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Schaltflächen-Inhalt: Symbol + Text -->
    <Style x:Key="Hp.Shell.ButtonGlyph" TargetType="TextBlock" BasedOn="{StaticResource Hp.Shell.Glyph}">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Margin" Value="0,0,8,0" />
    </Style>
    <Style x:Key="Hp.Shell.ButtonIcon" TargetType="views:LineIcon">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        Navigation der Einstellungen (.navb): Symbol und Name; der gerade sichtbare Bereich ist hinterlegt, hat einen
        Verlaufsbalken links und ein Symbol in der Akzentfarbe. Unterpunkte eingerückt und kleiner.
    -->
    <Style x:Key="Hp.Shell.NavButton" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="12" Background="Transparent" />
                        <Border x:Name="Bar" Width="3" CornerRadius="0,3,3,0" Margin="-14,9,0,9" HorizontalAlignment="Left" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="12" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                        <StackPanel Orientation="Horizontal" Margin="{TemplateBinding Padding}" VerticalAlignment="Center">
                            <views:LineIcon x:Name="Icon" Width="16" Height="16" Margin="0,0,12,0" Data="{Binding (views:SettingsSection.Icon), RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter VerticalAlignment="Center" />
                        </StackPanel>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="Icon" Property="Data" Value="{x:Null}">
                            <Setter TargetName="Icon" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface1}" />
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="views:SettingsSection.IsCurrent" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource Hp.Brush.AccentText}" />
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hp.Shell.NavSubButton" TargetType="Button" BasedOn="{StaticResource Hp.Shell.NavButton}">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="40,0,12,0" />
    </Style>

    <!-- Umschalter mit zwei oder drei Teilen (.seg): gewählter Teil im Akzentverlauf -->
    <Style x:Key="Hp.Shell.SegmentHost" TargetType="Border">
        <Setter Property="Padding" Value="3" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface1}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Hp.Shell.Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextSecondary}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="MinWidth" Value="58" />
        <Setter Property="Height" Value="30" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="8" Background="Transparent" />
                        <Border x:Name="Focus" CornerRadius="8" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                        <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Accent}" />
                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.TextOnAccent}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="Hp.Shell.SegmentSmall" TargetType="RadioButton" BasedOn="{StaticResource Hp.Shell.Segment}">
        <Setter Property="Height" Value="24" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Padding" Value="8,0" />
    </Style>

    <!-- Quadratische Symbol-Schaltfläche (.ibtn) -->
    <Style x:Key="Hp.Shell.SquareButton" TargetType="Button" BasedOn="{StaticResource Hp.GhostButton}">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!--
        Farbvorlage (.pc): Verlaufsfläche mit DUO/TRI-Kennzeichen, Name darunter; gewählt mit 2-px-Ring in der Farbe der
        Bedienelemente und Haken rechts oben. Hebt sich beim Überfahren leicht.
    -->
    <Style x:Key="Hp.Shell.PresetTile" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="Height" Value="70" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="RenderTransform">
            <Setter.Value>
                <TranslateTransform />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="14" Background="{DynamicResource Hp.Brush.Surface1}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1" />
                        <Border Margin="4,4,4,0" Height="38" VerticalAlignment="Top" CornerRadius="10" Background="{Binding Gradient}" />
                        <Border Margin="8,8,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" CornerRadius="4" Background="#6B000000" Padding="4,2,4,2">
                            <TextBlock Text="{Binding Tag}" FontSize="9" FontWeight="Bold" Foreground="White" />
                        </Border>
                        <Grid x:Name="Mark" Width="16" Height="16" Margin="0,8,8,0" HorizontalAlignment="Right" VerticalAlignment="Top" Visibility="Collapsed">
                            <Ellipse Fill="White" />
                            <views:LineIcon Width="11" Height="11" StrokeThickness="3.2" Foreground="#FF111111" Data="{StaticResource Hp.Icon.Check}" />
                        </Grid>
                        <TextBlock Margin="4,0,4,8" VerticalAlignment="Bottom" HorizontalAlignment="Center" FontWeight="Bold" FontSize="11.5"
                                   TextTrimming="CharacterEllipsis" Text="{Binding Name}" />
                        <Border x:Name="Ring" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.SelectionRing}" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="16" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                            <Setter TargetName="Mark" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Auswahlkarte für Thema und Effektstufe (.tho, .fo): Vorschau oben, Name und Erklärung darunter -->
    <Style x:Key="Hp.Shell.ChoiceCard" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="16" Background="{DynamicResource Hp.Brush.Surface1}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1" />
                        <ContentPresenter Margin="8,8,8,10" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        <Border x:Name="Ring" CornerRadius="16" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.SelectionRing}" Opacity="0" />
                        <Border x:Name="Focus" CornerRadius="18" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Ring" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Farbfeld (.wl): Farbfläche mit Nummer und Stift, Rolle, Hex-Wert, Erklärung -->
    <Style x:Key="Hp.Shell.ColorWell" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Border x:Name="Body" CornerRadius="16" Background="{DynamicResource Hp.Brush.Surface1}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1" />
                        <ContentPresenter Margin="10" />
                        <Border x:Name="Focus" CornerRadius="18" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Body" Property="BorderBrush" Value="{DynamicResource Hp.Brush.AccentStrong}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Cursor" Value="Arrow" />
                            <Setter TargetName="Body" Property="Opacity" Value="0.8" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Kontrast-Kennzeichen (.cchip) -->
    <Style x:Key="Hp.Shell.Chip" TargetType="Border">
        <Setter Property="Height" Value="22" />
        <Setter Property="Padding" Value="8,0,4,0" />
        <Setter Property="CornerRadius" Value="7" />
        <Setter Property="Background" Value="{DynamicResource Hp.Brush.Surface2}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Hp.Brush.Line}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Margin" Value="0,0,6,0" />
    </Style>

    <!-- Vorschau-Spiel (.mt): Bildstreifen, gewählt mit Ring -->
    <Style x:Key="Hp.Shell.PreviewThumb" TargetType="RadioButton">
        <Setter Property="Width" Value="96" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,0,8,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid x:Name="Root" Opacity="0.72">
                        <Border CornerRadius="10" Background="{Binding Field}" />
                        <Border CornerRadius="10" ClipToBounds="True">
                            <Border.Background>
                                <ImageBrush ImageSource="{Binding Thumbnail}" Stretch="UniformToFill" />
                            </Border.Background>
                        </Border>
                        <Border x:Name="Ring" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.Line}" />
                        <Border x:Name="Focus" CornerRadius="12" Margin="-3" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Root" Property="Opacity" Value="1" />
                            <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource Hp.Brush.SelectionRing}" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Focus" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Tray-Menü (E89): wie das Windows-11-Menü mit Kopf (Programmsymbol in der Kachel, Name, Zustand mit Punkt), Einträgen
        mit Linien-Symbolen und hervorgehobenem „HDR jetzt …“. Schatten auf einem eigenen Element hinter dem Menü als
        weicher Verlauf; die Texte bleiben ClearType-scharf.
    -->
    <Style x:Key="Hp.Shell.TrayMenu" TargetType="ContextMenu">
        <Setter Property="FontFamily" Value="{StaticResource Hp.Font.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="MinWidth" Value="300" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Grid x:Name="PART_Body" Margin="10,6,16,20">
                        <Border Margin="4,14,-10,-18" CornerRadius="26" Opacity="0.7" IsHitTestVisible="False">
                            <Border.Background>
                                <RadialGradientBrush Center="0.5,0.58" GradientOrigin="0.5,0.58" RadiusX="0.58" RadiusY="0.56">
                                    <GradientStop Color="{DynamicResource Hp.Color.Shadow}" Offset="0.45" />
                                    <GradientStop Color="Transparent" Offset="1" />
                                </RadialGradientBrush>
                            </Border.Background>
                        </Border>
                        <Border CornerRadius="14" Background="{DynamicResource Hp.Brush.Menu}" BorderBrush="{DynamicResource Hp.Brush.LineStrong}" BorderThickness="1">
                            <Grid>
                                <Border CornerRadius="14" Background="{DynamicResource Hp.Brush.BackgroundGlow}" Opacity="0.7" />
                                <StackPanel Margin="6">
                                    <Grid Margin="8,8,8,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid Width="32" Height="32" Margin="0,0,12,0">
                                            <Border x:Name="LogoOff" CornerRadius="10" Background="{DynamicResource Hp.Brush.Surface2}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1" />
                                            <Border x:Name="LogoOn" CornerRadius="10" Background="{DynamicResource Hp.Brush.HdrOn}" Visibility="Collapsed" />
                                            <views:LineIcon x:Name="LogoSun" Width="20" Height="20" StrokeThickness="0" Fill="{DynamicResource Hp.Brush.AccentText}" Data="{StaticResource Hp.Icon.LogoSun}" />
                                            <views:LineIcon x:Name="LogoGlyph" Width="20" Height="20" StrokeThickness="2" Foreground="{DynamicResource Hp.Brush.AccentText}" Data="{StaticResource Hp.Icon.Logo}" />
                                        </Grid>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock Text="{x:Static res:CommonStrings.AppName}" FontFamily="{DynamicResource Hp.Font.Display}" FontWeight="Bold" FontSize="15" Foreground="{DynamicResource Hp.Brush.Text}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                                <Ellipse x:Name="Dot" Width="7" Height="7" Margin="0,1,7,0" Fill="{DynamicResource Hp.Brush.TextMuted}" VerticalAlignment="Center" />
                                                <TextBlock Text="{Binding StatusTitle}" FontSize="11.5" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                                                <TextBlock Text=" · " FontSize="11.5" Foreground="{DynamicResource Hp.Brush.TextMuted}" />
                                                <TextBlock Text="{Binding StatusDetail}" FontSize="11.5" Foreground="{DynamicResource Hp.Brush.TextSecondary}" TextTrimming="CharacterEllipsis" MaxWidth="170" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Margin="8,0,8,4" Fill="{DynamicResource Hp.Brush.Line}" />
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" KeyboardNavigation.TabNavigation="Cycle" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsHdrOn}" Value="True">
                            <Setter TargetName="LogoOn" Property="Visibility" Value="Visible" />
                            <Setter TargetName="LogoOff" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="LogoSun" Property="Fill" Value="{DynamicResource Hp.Brush.TextOnAccent}" />
                            <Setter TargetName="LogoGlyph" Property="Foreground" Value="{DynamicResource Hp.Brush.TextOnAccent}" />
                            <Setter TargetName="Dot" Property="Fill" Value="{DynamicResource Hp.Brush.Shine}" />
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hp.Shell.TrayMenuItem" TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Text}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid Background="Transparent" Margin="0,1">
                        <Border x:Name="Hover" CornerRadius="8" Background="{DynamicResource Hp.Brush.SurfaceHover}" Opacity="0" />
                        <Border x:Name="Bar" Width="3" CornerRadius="1.5" Margin="2,8" HorizontalAlignment="Left" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter x:Name="IconHost" ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"
                                              TextElement.Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" />
                            <Grid x:Name="Switch" Grid.Column="2" Width="34" Height="20" Margin="14,0,2,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border x:Name="Track" CornerRadius="10" Background="{DynamicResource Hp.Brush.HdrOff}" BorderBrush="{DynamicResource Hp.Brush.LineStrong}" BorderThickness="1" />
                                <Border x:Name="TrackOn" CornerRadius="10" Background="{DynamicResource Hp.Brush.ToggleOn}" Opacity="0" />
                                <Ellipse x:Name="Knob" Width="14" Height="14" Margin="3,0" HorizontalAlignment="Left" Fill="{DynamicResource Hp.Brush.ToggleOff}" />
                            </Grid>
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                            <Setter TargetName="Bar" Property="Opacity" Value="1" />
                            <Setter TargetName="IconHost" Property="TextElement.Foreground" Value="{DynamicResource Hp.Brush.AccentText}" />
                        </Trigger>
                        <Trigger Property="IsCheckable" Value="True">
                            <Setter TargetName="Switch" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="TrackOn" Property="Opacity" Value="1" />
                            <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource Hp.Brush.ToggleThumb}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Hervorgehobener Eintrag „HDR jetzt …“ (.tm-i.hl): Akzent 24 % hinterlegt -->
    <Style x:Key="Hp.Shell.TrayMenuItem.Highlight" TargetType="MenuItem" BasedOn="{StaticResource Hp.Shell.TrayMenuItem}">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid Background="Transparent" Margin="0,1">
                        <Border CornerRadius="8" Background="{DynamicResource Hp.Brush.AccentSoft}" />
                        <Border x:Name="Hover" CornerRadius="8" BorderThickness="1" BorderBrush="{DynamicResource Hp.Brush.AccentStrong}" Opacity="0" />
                        <Grid Margin="{TemplateBinding Padding}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left" TextElement.Foreground="{DynamicResource Hp.Brush.AccentText}" />
                            <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True" VerticalAlignment="Center" TextElement.FontWeight="SemiBold" />
                        </Grid>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Hover" Property="Opacity" Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Infozeile im Tray-Menü (Version): grau, nicht anklickbar (IsEnabled aus), nicht fokussierbar. Die Pfeiltasten
        überspringen sie: Pfeil nach unten wählt den Eintrag darunter, Pfeil nach oben von dort den letzten
        (phase6-traymenu.ps1, TrayMenuKeyboardTests).
    -->
    <Style x:Key="Hp.Shell.TrayMenuInfo" TargetType="MenuItem">
        <Setter Property="IsEnabled" Value="False" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="10,3,10,4" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Grid Margin="{TemplateBinding Padding}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter ContentSource="Icon" VerticalAlignment="Center" HorizontalAlignment="Left"
                                          TextElement.Foreground="{DynamicResource Hp.Brush.TextMuted}" />
                        <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="False" VerticalAlignment="Center"
                                          TextElement.Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Hp.Shell.TrayMenuSeparator" TargetType="Separator">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Separator">
                    <Rectangle Height="1" Margin="12,4" Fill="{DynamicResource Hp.Brush.Line}" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
