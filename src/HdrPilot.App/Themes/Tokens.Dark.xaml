<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design-Token, dunkle Variante. Alle Ansichten benutzen nur diese Schlüssel (DynamicResource). -->
    <Color x:Key="Hp.Color.Accent1">#FFFFB300</Color>
    <Color x:Key="Hp.Color.Accent2">#FFD62862</Color>
    <Color x:Key="Hp.Color.Accent3">#FF7C4DFF</Color>
    <Color x:Key="Hp.Color.Glow">#FFFF4D8D</Color>
    <Color x:Key="Hp.Color.Shadow">#FF000000</Color>

    <LinearGradientBrush x:Key="Hp.Brush.WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FF171A2B" Offset="0" />
        <GradientStop Color="#FF0F1019" Offset="0.55" />
        <GradientStop Color="#FF0A0B10" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Hp.Brush.BackgroundGlow" Center="0.85,0.0" GradientOrigin="0.85,0.0" RadiusX="0.7" RadiusY="0.6">
        <GradientStop Color="#33D62862" Offset="0" />
        <GradientStop Color="#00D62862" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Hp.Brush.TitleBar" Color="#00000000" />
    <SolidColorBrush x:Key="Hp.Brush.Surface" Color="#D9181B28" />
    <SolidColorBrush x:Key="Hp.Brush.SurfaceHover" Color="#FF20243A" />
    <SolidColorBrush x:Key="Hp.Brush.SurfaceSelected" Color="#FF282D48" />
    <SolidColorBrush x:Key="Hp.Brush.SurfaceInput" Color="#FF11131D" />
    <SolidColorBrush x:Key="Hp.Brush.Border" Color="#FF2B3048" />
    <SolidColorBrush x:Key="Hp.Brush.BorderStrong" Color="#FF3D4366" />
    <SolidColorBrush x:Key="Hp.Brush.Text" Color="#FFF2F3F8" />
    <SolidColorBrush x:Key="Hp.Brush.TextSecondary" Color="#FFA1A7BF" />
    <SolidColorBrush x:Key="Hp.Brush.TextMuted" Color="#FF6C728C" />
    <SolidColorBrush x:Key="Hp.Brush.TextOnAccent" Color="#FFFFFFFF" />

    <LinearGradientBrush x:Key="Hp.Brush.Accent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFFB300" Offset="0" />
        <GradientStop Color="#FFFF5A5F" Offset="0.5" />
        <GradientStop Color="#FFD62862" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Hp.Brush.AccentSolid" Color="#FFFF4D8D" />
    <LinearGradientBrush x:Key="Hp.Brush.HdrOn" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFC24D" Offset="0" />
        <GradientStop Color="#FFFF4D8D" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Hp.Brush.HdrOff" Color="#FF363B55" />
    <SolidColorBrush x:Key="Hp.Brush.ToggleThumb" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Hp.Brush.Success" Color="#FF2BD9A0" />
    <SolidColorBrush x:Key="Hp.Brush.Warning" Color="#FFFFB547" />
    <SolidColorBrush x:Key="Hp.Brush.Danger" Color="#FFFF5370" />

    <!-- Farben der Quellen-Abzeichen -->
    <SolidColorBrush x:Key="Hp.Brush.Source.Steam" Color="#FF66C0F4" />
    <SolidColorBrush x:Key="Hp.Brush.Source.Epic" Color="#FFE0E0E0" />
    <SolidColorBrush x:Key="Hp.Brush.Source.Xbox" Color="#FF52B043" />
    <SolidColorBrush x:Key="Hp.Brush.Source.Gog" Color="#FFB66DFF" />
    <SolidColorBrush x:Key="Hp.Brush.Source.Ubisoft" Color="#FF4C9AFF" />
    <SolidColorBrush x:Key="Hp.Brush.Source.EA" Color="#FFFF5C5C" />
    <SolidColorBrush x:Key="Hp.Brush.Source.BattleNet" Color="#FF27B8FF" />
    <SolidColorBrush x:Key="Hp.Brush.Source.Manual" Color="#FFB0B5C8" />

    <!--
      Showcase Hero (E89): Schlüssel aus Theming/ThemeKeys.cs mit den Werten der Vorlage „Abendrot“ (Duoton). Zur Laufzeit
      erzeugt die Darstellung sie aus Palette und Thema neu; diese Werte gelten im Testhost und vor dem ersten Anwenden.
    -->
    <Color x:Key="Hp.Color.C1">#FFFF8A3D</Color>
    <Color x:Key="Hp.Color.C2">#FFFF3D7F</Color>
    <Color x:Key="Hp.Color.C3">#FFFF94B9</Color>
    <Color x:Key="Hp.Color.OnAccent">#FF0B0C12</Color>
    <Color x:Key="Hp.Color.AccentText">#FFFF8A3D</Color>
    <Color x:Key="Hp.Color.Background">#FF120B12</Color>
    <Color x:Key="Hp.Color.Ambient1">#FF32101F</Color>
    <Color x:Key="Hp.Color.Ambient2">#FFFF3D7F</Color>
    <Color x:Key="Hp.Color.Ambient3">#FFFF94B9</Color>

    <SolidColorBrush x:Key="Hp.Brush.Surface1" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="Hp.Brush.Surface2" Color="#1CFFFFFF" />
    <SolidColorBrush x:Key="Hp.Brush.Surface3" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="Hp.Brush.Line" Color="#17FFFFFF" />
    <SolidColorBrush x:Key="Hp.Brush.LineStrong" Color="#29FFFFFF" />
    <SolidColorBrush x:Key="Hp.Brush.TextOnArt" Color="#FFF5F6FA" />
    <SolidColorBrush x:Key="Hp.Brush.TextOnArtSecondary" Color="#FFC9CDDB" />
    <LinearGradientBrush x:Key="Hp.Brush.AccentShine" StartPoint="0,0.4" EndPoint="1,0.6">
        <GradientStop Color="#FFFF8A3D" Offset="0" />
        <GradientStop Color="#FFFF94B9" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Hp.Brush.AccentText" Color="#FFFF8A3D" />
    <SolidColorBrush x:Key="Hp.Brush.AccentSoft" Color="#38FF8A3D" />
    <SolidColorBrush x:Key="Hp.Brush.AccentStrong" Color="#9EFF8A3D" />
    <SolidColorBrush x:Key="Hp.Brush.AtmosphereSoft" Color="#8CFF3D7F" />
    <SolidColorBrush x:Key="Hp.Brush.Shine" Color="#FFFFBFD5" />
    <SolidColorBrush x:Key="Hp.Brush.SelectionFill" Color="#24FF8A3D" />
    <SolidColorBrush x:Key="Hp.Brush.SelectionRing" Color="#73FF8A3D" />
    <SolidColorBrush x:Key="Hp.Brush.FocusRing" Color="#FFFF8A3D" />
    <LinearGradientBrush x:Key="Hp.Brush.Panel" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Color="#ED13141C" Offset="0" />
        <GradientStop Color="#F20A0B10" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Hp.Brush.PanelHighlight" Color="#24FFFFFF" />
    <SolidColorBrush x:Key="Hp.Brush.Menu" Color="#FA101118" />
    <SolidColorBrush x:Key="Hp.Brush.Glass" Color="#A80C0D13" />
    <SolidColorBrush x:Key="Hp.Brush.ToggleOff" Color="#FFC9CCD8" />

    <FontFamily x:Key="Hp.Font.Display">Bahnschrift, Segoe UI</FontFamily>
    <FontFamily x:Key="Hp.Font.Text">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="Hp.Font.Mono">Cascadia Mono, Consolas</FontFamily>
</ResourceDictionary>
