<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design-Token, helle Variante (gleiche Schlüssel wie Tokens.Dark.xaml). -->
    <Color x:Key="Hp.Color.Accent1">#FFFF9F00</Color>
    <Color x:Key="Hp.Color.Accent2">#FFD62862</Color>
    <Color x:Key="Hp.Color.Accent3">#FF6A3DF0</Color>
    <Color x:Key="Hp.Color.Glow">#FFFF4D8D</Color>
    <Color x:Key="Hp.Color.Shadow">#FF6B7189</Color>

    <LinearGradientBrush x:Key="Hp.Brush.WindowBackground" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFDFBFF" Offset="0" />
        <GradientStop Color="#FFF3F4FA" Offset="0.55" />
        <GradientStop Color="#FFE9EBF4" Offset="1" />
    </LinearGradientBrush>
    <RadialGradientBrush x:Key="Hp.Brush.BackgroundGlow" Center="0.85,0.0" GradientOrigin="0.85,0.0" RadiusX="0.7" RadiusY="0.6">
        <GradientStop Color="#26FF9F00" Offset="0" />
        <GradientStop Color="#00FF9F00" Offset="1" />
    </RadialGradientBrush>
    <SolidColorBrush x:Key="Hp.Brush.TitleBar" Color="#00FFFFFF" />
    <SolidColorBrush x:Key="Hp.Brush.Surface" Color="#E6FFFFFF" />
    <SolidColorBrush x:Key="Hp.Brush.SurfaceHover" Color="#FFF4F0FA" />
    <SolidColorBrush x:Key="Hp.Brush.SurfaceSelected" Color="#FFEDE4F7" />
    <SolidColorBrush x:Key="Hp.Brush.SurfaceInput" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="Hp.Brush.Border" Color="#FFDCDEEA" />
    <SolidColorBrush x:Key="Hp.Brush.BorderStrong" Color="#FFC3C7D9" />
    <SolidColorBrush x:Key="Hp.Brush.Text" Color="#FF15171F" />
    <SolidColorBrush x:Key="Hp.Brush.TextSecondary" Color="#FF545A70" />
    <SolidColorBrush x:Key="Hp.Brush.TextMuted" Color="#FF8A90A6" />
    <SolidColorBrush x:Key="Hp.Brush.TextOnAccent" Color="#FFFFFFFF" />

    <LinearGradientBrush x:Key="Hp.Brush.Accent" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#FFFF9F00" Offset="0" />
        <GradientStop Color="#FFFF4F5A" Offset="0.5" />
        <GradientStop Color="#FFD62862" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Hp.Brush.AccentSolid" Color="#FFD62862" />
    <LinearGradientBrush x:Key="Hp.Brush.HdrOn" StartPoint="0,0" EndPoint="1,0">
        <GradientStop Color="#FFFFA31A" Offset="0" />
        <GradientStop Color="#FFE8306F" Offset="1" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="Hp.Brush.HdrOff" Color="#FFC7CBDA" />
    <SolidColorBrush x:Key="Hp.Brush.ToggleThumb" Color="#FFFFFFFF" />

    <SolidColorBrush x:Key="Hp.Brush.Success" Color="#FF0FA77A" />
    <SolidColorBrush x:Key="Hp.Brush.Warning" Color="#FFC77A00" />
    <SolidColorBrush x:Key="Hp.Brush.Danger" Color="#FFD72C4B" />

    <SolidColorBrush x:Key="Hp.Brush.Source.Steam" Color="#FF1B6FA8" />
    <SolidColorBrush x:Key="Hp.Brush.Source.Epic" Color="#FF3A3A3A" />
    <SolidColorBrush x:Key="Hp.Brush.Source.Xbox" Color="#FF2E8B2A" />
    <SolidColorBrush x:Key="Hp.Brush.Source.Gog" Color="#FF8A3FD1" />
    <SolidColorBrush x:Key="Hp.Brush.Source.Ubisoft" Color="#FF1F6FD6" />
    <SolidColorBrush x:Key="Hp.Brush.Source.EA" Color="#FFD63636" />
    <SolidColorBrush x:Key="Hp.Brush.Source.BattleNet" Color="#FF0088CC" />
    <SolidColorBrush x:Key="Hp.Brush.Source.Manual" Color="#FF6B7189" />
</ResourceDictionary>
