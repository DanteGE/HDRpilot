<infra:ChromeWindow x:Class="HdrPilot.App.Views.Library.AddGameDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:HdrPilot.App.Infrastructure"
                    xmlns:res="clr-namespace:HdrPilot.App.Resources"
                    xmlns:vm="clr-namespace:HdrPilot.App.ViewModels.Library"
                    Title="{x:Static res:LibraryStrings.AddGame_Title}"
                    AutomationProperties.AutomationId="AddGameDialog"
                    AutomationProperties.Name="{x:Static res:LibraryStrings.AddGame_Title}"
                    Width="580" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner">
    <StackPanel x:Name="Body" Margin="28,4,28,26">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="48" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid Width="48" Height="48">
                <Border CornerRadius="14" Background="{DynamicResource Hp.Brush.Accent}" Opacity="0.2" />
                <Border CornerRadius="14" BorderThickness="1.5" BorderBrush="{DynamicResource Hp.Brush.Accent}" Opacity="0.6" />
                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE7FC;" FontSize="22" HorizontalAlignment="Center" Foreground="{DynamicResource Hp.Brush.AccentSolid}" />
            </Grid>
            <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource Hp.Text.Subtitle}" FontSize="20" FontWeight="Bold" Text="{x:Static res:LibraryStrings.AddGame_Title}" />
                <TextBlock Style="{StaticResource Hp.Text.Caption}" FontSize="13" Margin="0,3,0,0" Text="{x:Static res:LibraryStrings.AddGame_Intro}" />
            </StackPanel>
        </Grid>

        <TextBlock Text="{x:Static res:LibraryStrings.AddGame_PathLabel}" FontWeight="SemiBold" Margin="0,24,0,8" Foreground="{DynamicResource Hp.Brush.Text}" />
        <TextBox x:Name="PathBox" Style="{StaticResource Lib.TextBox}" Tag="{x:Static res:LibraryStrings.AddGame_PathPlaceholder}"
                 Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="AddGamePath" AutomationProperties.Name="{x:Static res:LibraryStrings.AddGame_PathLabel}" />
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <Button Style="{StaticResource Lib.SmallGhostButton}" Command="{Binding BrowseExeCommand}"
                    AutomationProperties.AutomationId="AddGameBrowseExe" AutomationProperties.Name="{x:Static res:LibraryStrings.AddGame_BrowseExe}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xECAA;" FontSize="13" Margin="0,0,7,0" />
                    <TextBlock Text="{x:Static res:LibraryStrings.AddGame_BrowseExe}" />
                </StackPanel>
            </Button>
            <Button Style="{StaticResource Lib.SmallGhostButton}" Margin="8,0,0,0" Command="{Binding BrowseFolderCommand}"
                    AutomationProperties.AutomationId="AddGameBrowseFolder" AutomationProperties.Name="{x:Static res:LibraryStrings.AddGame_BrowseFolder}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE8B7;" FontSize="13" Margin="0,0,7,0" />
                    <TextBlock Text="{x:Static res:LibraryStrings.AddGame_BrowseFolder}" />
                </StackPanel>
            </Button>
        </StackPanel>

        <TextBlock Text="{x:Static res:LibraryStrings.AddGame_NameLabel}" FontWeight="SemiBold" Margin="0,22,0,8" Foreground="{DynamicResource Hp.Brush.Text}" />
        <TextBox x:Name="NameBox" Style="{StaticResource Lib.TextBox}" Tag="{Binding NamePlaceholder}"
                 Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                 AutomationProperties.AutomationId="AddGameName" AutomationProperties.Name="{x:Static res:LibraryStrings.AddGame_NameLabel}" />
        <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,6,0,0" Text="{x:Static res:LibraryStrings.AddGame_NameHint}" />

        <!-- Hinweis: manuell hinzugefügte Spiele schalten HDR automatisch -->
        <Grid Margin="0,20,0,0">
            <Border Style="{StaticResource Lib.StatusTint}" Tag="{x:Static vm:StatusKind.Info}" />
            <DockPanel Margin="12,10">
                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE706;" Foreground="{DynamicResource Hp.Brush.AccentSolid}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{x:Static res:LibraryStrings.AddGame_AutoHint}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hp.Brush.Text}" />
            </DockPanel>
        </Grid>

        <!-- Fehler -->
        <Grid Margin="0,10,0,0" Visibility="{Binding HasError, Converter={StaticResource Lib.BoolToVisibility}}">
            <Border Style="{StaticResource Lib.StatusTint}" Tag="{x:Static vm:StatusKind.Error}" />
            <DockPanel Margin="12,10">
                <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{x:Static vm:StatusKind.Error}" Margin="0,0,10,0" VerticalAlignment="Top" />
                <TextBlock Text="{Binding Error}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hp.Brush.Text}"
                           AutomationProperties.AutomationId="AddGameError" />
            </DockPanel>
        </Grid>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button Style="{StaticResource Hp.GhostButton}" MinWidth="110" IsCancel="True"
                    Content="{x:Static res:LibraryStrings.Dialog_Cancel}"
                    AutomationProperties.AutomationId="AddGameCancel" AutomationProperties.Name="{x:Static res:LibraryStrings.Dialog_Cancel}" />
            <Button Style="{StaticResource Hp.AccentButton}" Margin="10,0,0,0" MinWidth="140" IsDefault="True" Command="{Binding ConfirmCommand}"
                    AutomationProperties.AutomationId="AddGameConfirm" AutomationProperties.Name="{x:Static res:LibraryStrings.AddGame_Confirm}">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE710;" FontSize="13" Margin="0,0,8,0" />
                    <TextBlock Text="{x:Static res:LibraryStrings.AddGame_Confirm}" />
                </StackPanel>
            </Button>
        </StackPanel>
    </StackPanel>
</infra:ChromeWindow>
