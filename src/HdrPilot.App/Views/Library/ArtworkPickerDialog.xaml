<infra:ChromeWindow x:Class="HdrPilot.App.Views.Library.ArtworkPickerDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:infra="clr-namespace:HdrPilot.App.Infrastructure"
                    xmlns:lib="clr-namespace:HdrPilot.App.Views.Library"
                    xmlns:res="clr-namespace:HdrPilot.App.Resources"
                    xmlns:vm="clr-namespace:HdrPilot.App.ViewModels.Library"
                    Title="{x:Static res:LibraryStrings.Picker_Title}"
                    AutomationProperties.AutomationId="ArtworkPickerDialog"
                    AutomationProperties.Name="{x:Static res:LibraryStrings.Picker_Title}"
                    Width="880" SizeToContent="Height" ResizeMode="NoResize" ShowInTaskbar="False"
                    WindowStartupLocation="CenterOwner">
    <infra:ChromeWindow.Resources>
        <!-- Eine Möglichkeit (Prototyp .cho): Vorschau, „AKTUELL“, Beschriftung, Hinweis, Größe -->
        <DataTemplate x:Key="ChoiceTemplate" DataType="{x:Type vm:ArtworkChoiceViewModel}">
            <StackPanel>
                <Grid x:Name="PreviewBox" Height="96" ClipToBounds="True">
                    <Border CornerRadius="16,16,0,0" Background="#FF0B0C11" />
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xEB9F;" FontSize="26" HorizontalAlignment="Center" Foreground="{DynamicResource Hp.Brush.TextMuted}" />
                    <Border CornerRadius="16,16,0,0" lib:ImageFill.Source="{Binding Preview}" Visibility="{Binding Preview, Converter={StaticResource Lib.BoolToVisibility}}" />
                    <Border CornerRadius="5" Padding="6,3" Margin="8" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource Hp.Brush.Accent}"
                            Visibility="{Binding IsCurrent, Converter={StaticResource Lib.BoolToVisibility}}">
                        <TextBlock Text="{x:Static res:LibraryStrings.Picker_Current}" FontSize="9.5" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextOnAccent}" />
                    </Border>
                </Grid>
                <StackPanel Margin="11,9,11,11">
                    <TextBlock Text="{Binding Label}" FontSize="13" FontWeight="Bold" TextWrapping="Wrap" Foreground="{DynamicResource Hp.Brush.Text}" />
                    <TextBlock Text="{Binding SizeText}" FontSize="11.5" Margin="0,3,0,0" Foreground="{DynamicResource Hp.Brush.TextSecondary}"
                               Visibility="{Binding SizeText, Converter={StaticResource Lib.BoolToVisibility}}" />
                    <TextBlock Text="{Binding Note}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Hp.Brush.TextSecondary}"
                               Visibility="{Binding HasNote, Converter={StaticResource Lib.BoolToVisibility}}" />
                </StackPanel>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding DataContext.IsCover, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter TargetName="PreviewBox" Property="Height" Value="150" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </infra:ChromeWindow.Resources>

    <Grid x:Name="Body" Margin="24,0,24,20">
        <Border Height="1" VerticalAlignment="Top" Margin="0,0,0,0" Background="{DynamicResource Hp.Brush.AccentShine}" Opacity="0.8" />
        <StackPanel Margin="0,14,0,0">
            <Grid>
                <StackPanel>
                    <TextBlock Text="{x:Static res:LibraryStrings.Picker_Title}" FontFamily="{StaticResource Lib.Font.Display}" FontSize="21" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" />
                    <TextBlock Text="{Binding Subtitle}" FontSize="13" Margin="0,6,0,0" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                </StackPanel>
            </Grid>

            <!-- Bildart -->
            <Border Style="{StaticResource Lib.SegmentFrame}" HorizontalAlignment="Left" Margin="0,16,0,0" AutomationProperties.Name="{x:Static res:LibraryStrings.Picker_Tabs}">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Style="{StaticResource Lib.SegmentRadio}" GroupName="ArtworkKind" IsChecked="{Binding IsHero}" Padding="12,0"
                                 AutomationProperties.AutomationId="ArtworkTabHero" AutomationProperties.Name="{x:Static res:LibraryStrings.Picker_TabHero}"
                                 Content="{x:Static res:LibraryStrings.Picker_TabHero}" />
                    <RadioButton Style="{StaticResource Lib.SegmentRadio}" GroupName="ArtworkKind" IsChecked="{Binding IsLogo}" Padding="12,0"
                                 AutomationProperties.AutomationId="ArtworkTabLogo" AutomationProperties.Name="{x:Static res:LibraryStrings.Picker_TabLogo}"
                                 Content="{x:Static res:LibraryStrings.Picker_TabLogo}" />
                    <RadioButton Style="{StaticResource Lib.SegmentRadio}" GroupName="ArtworkKind" IsChecked="{Binding IsCover}" Padding="12,0"
                                 AutomationProperties.AutomationId="ArtworkTabCover" AutomationProperties.Name="{x:Static res:LibraryStrings.Picker_TabCover}"
                                 Content="{x:Static res:LibraryStrings.Picker_TabCover}" />
                </StackPanel>
            </Border>

            <!-- Möglichkeiten und „Eigene Datei…“ -->
            <WrapPanel Margin="0,14,0,0">
                <ListBox x:Name="Candidates" Style="{StaticResource Lib.ListBox}" ItemsSource="{Binding Candidates}" SelectedItem="{Binding Selected}"
                         ItemContainerStyle="{StaticResource Lib.ChoiceItem}" ItemTemplate="{StaticResource ChoiceTemplate}"
                         ScrollViewer.VerticalScrollBarVisibility="Disabled" MaxWidth="830"
                         AutomationProperties.AutomationId="ArtworkCandidates" AutomationProperties.Name="{x:Static res:LibraryStrings.Picker_ListName}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
                <Button Width="150" Style="{StaticResource Lib.IconButton}" Margin="0,0,0,12" Command="{Binding PickFileCommand}" VerticalAlignment="Top"
                        AutomationProperties.AutomationId="ArtworkPickFileButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Picker_PickFile}">
                    <Grid>
                        <Border CornerRadius="16" Background="{DynamicResource Hp.Brush.Surface1}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1" />
                        <StackPanel>
                            <Grid Height="96">
                                <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE898;" FontSize="24" HorizontalAlignment="Center" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                            </Grid>
                            <StackPanel Margin="11,9,11,11">
                                <TextBlock Text="{x:Static res:LibraryStrings.Picker_PickFile}" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" />
                                <TextBlock Text="{x:Static res:LibraryStrings.Picker_PickFileHint}" FontSize="11.5" Margin="0,3,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Button>
            </WrapPanel>

            <!-- Fehler beim Lesen einer Datei -->
            <Grid Margin="0,2,0,0" Visibility="{Binding HasMessage, Converter={StaticResource Lib.BoolToVisibility}}">
                <Border Style="{StaticResource Lib.StatusTint}" Tag="{x:Static vm:StatusKind.Error}" />
                <DockPanel Margin="12,9">
                    <TextBlock Style="{StaticResource Lib.StatusGlyph}" Tag="{x:Static vm:StatusKind.Error}" Margin="0,0,10,0" VerticalAlignment="Top" />
                    <TextBlock Text="{Binding Message}" TextWrapping="Wrap" FontSize="12.5" Foreground="{DynamicResource Hp.Brush.Text}"
                               AutomationProperties.AutomationId="ArtworkPickerMessage" />
                </DockPanel>
            </Grid>

            <!-- Herkunft der Bilder: nur lokal, SteamGridDB nur auf Wunsch -->
            <Border Margin="0,10,0,0" CornerRadius="12" Padding="12,10" Background="{DynamicResource Hp.Brush.Surface1}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1">
                <DockPanel>
                    <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE946;" FontSize="13" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Hp.Brush.AccentText}" />
                    <TextBlock Text="{Binding SourceNote}" FontSize="12.5" TextWrapping="Wrap" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                </DockPanel>
            </Border>

            <DockPanel Margin="0,18,0,0">
                <Button DockPanel.Dock="Left" Style="{StaticResource Lib.PaneButton}" Padding="16,0" Command="{Binding ResetCommand}"
                        AutomationProperties.AutomationId="ArtworkResetButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Picker_Reset}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE777;" FontSize="12" Margin="0,0,8,0" />
                        <TextBlock Text="{x:Static res:LibraryStrings.Picker_Reset}" />
                    </StackPanel>
                </Button>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="CancelButton" Style="{StaticResource Lib.PaneButton}" Padding="16,0" IsCancel="True" Click="OnCancel"
                            AutomationProperties.AutomationId="ArtworkCancelButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Dialog_Cancel}"
                            Content="{x:Static res:LibraryStrings.Dialog_Cancel}" />
                    <Button x:Name="ApplyButton" Style="{StaticResource Lib.AccentButton}" Margin="8,0,0,0" Padding="18,0" IsDefault="True" Click="OnApply"
                            AutomationProperties.AutomationId="ArtworkApplyButton" AutomationProperties.Name="{x:Static res:LibraryStrings.Picker_Apply}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource Lib.Glyph}" Text="&#xE73E;" FontSize="12" Margin="0,0,8,0" />
                            <TextBlock Text="{x:Static res:LibraryStrings.Picker_Apply}" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </DockPanel>
        </StackPanel>
    </Grid>
</infra:ChromeWindow>
