<UserControl x:Class="HdrPilot.App.Views.Shell.ColorPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:res="clr-namespace:HdrPilot.App.Resources"
             x:Name="Self"
             Width="268" PreviewKeyDown="OnPreviewKey">
    <!--
        Eigener Farbwähler (E89): Feld für Sättigung und Helligkeit über dem Farbton, Leiste für den Farbton, Hex-Feld.
        Pfeiltasten verschieben die Marken, das Hex-Feld nimmt #RRGGBB an. Kein Paket, kein Systemdialog.
    -->
    <Border CornerRadius="18" Background="{DynamicResource Hp.Brush.Menu}" BorderBrush="{DynamicResource Hp.Brush.LineStrong}" BorderThickness="1" Padding="16">
        <StackPanel>
            <TextBlock Style="{StaticResource Hp.Text.Overline}" Text="{x:Static res:ShellStrings.ColorPickerTitle}" Margin="2,0,0,10" />
            <Grid x:Name="Field" Height="150" Focusable="True" Cursor="Cross" ClipToBounds="True"
                  AutomationProperties.AutomationId="ColorPickerField" AutomationProperties.Name="{x:Static res:ShellStrings.ColorPickerField}"
                  MouseLeftButtonDown="OnFieldDown" MouseMove="OnFieldMove" MouseLeftButtonUp="OnPointerUp" KeyDown="OnFieldKey"
                  FocusVisualStyle="{x:Null}">
                <Border x:Name="HueLayer" CornerRadius="10" Background="Red" />
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFFFFFF" Offset="0" />
                            <GradientStop Color="#00FFFFFF" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border CornerRadius="10">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                            <GradientStop Color="#00000000" Offset="0" />
                            <GradientStop Color="#FF000000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="FieldFocus" CornerRadius="10" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                <Canvas IsHitTestVisible="False">
                    <Ellipse x:Name="FieldThumb" Width="16" Height="16" Stroke="White" StrokeThickness="2.5">
                        <Ellipse.Fill>
                            <SolidColorBrush x:Name="FieldThumbFill" Color="Red" />
                        </Ellipse.Fill>
                    </Ellipse>
                </Canvas>
            </Grid>
            <Grid x:Name="Hue" Height="16" Margin="0,12,0,0" Focusable="True" Cursor="Hand"
                  AutomationProperties.AutomationId="ColorPickerHue" AutomationProperties.Name="{x:Static res:ShellStrings.ColorPickerHue}"
                  MouseLeftButtonDown="OnHueDown" MouseMove="OnHueMove" MouseLeftButtonUp="OnPointerUp" KeyDown="OnHueKey"
                  FocusVisualStyle="{x:Null}">
                <Border CornerRadius="8">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFFF0000" Offset="0" />
                            <GradientStop Color="#FFFFFF00" Offset="0.1667" />
                            <GradientStop Color="#FF00FF00" Offset="0.3333" />
                            <GradientStop Color="#FF00FFFF" Offset="0.5" />
                            <GradientStop Color="#FF0000FF" Offset="0.6667" />
                            <GradientStop Color="#FFFF00FF" Offset="0.8333" />
                            <GradientStop Color="#FFFF0000" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <Border x:Name="HueFocus" CornerRadius="9" Margin="-2" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.FocusRing}" Opacity="0" />
                <Canvas IsHitTestVisible="False">
                    <Border x:Name="HueThumb" Width="10" Height="20" Canvas.Top="-2" CornerRadius="5" BorderBrush="White" BorderThickness="2.5" Background="Transparent" />
                </Canvas>
            </Grid>
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="38" Height="38" CornerRadius="11" BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,10,0">
                    <Border.Background>
                        <SolidColorBrush x:Name="Swatch" Color="Red" />
                    </Border.Background>
                </Border>
                <TextBox x:Name="HexBox" Grid.Column="1" Style="{StaticResource Hp.Shell.TextBox}" FontFamily="{DynamicResource Hp.Font.Mono}"
                         AutomationProperties.AutomationId="ColorPickerHex" AutomationProperties.Name="{x:Static res:ShellStrings.ColorPickerHexName}"
                         MaxLength="7" SpellCheck.IsEnabled="False" TextChanged="OnHexChanged" />
            </Grid>
            <TextBlock x:Name="HexError" Style="{StaticResource Hp.Text.Caption}" Foreground="{DynamicResource Hp.Brush.Danger}" Margin="2,6,0,0"
                       Text="{x:Static res:ShellStrings.ColorPickerInvalid}" Visibility="Collapsed" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                <Button Style="{StaticResource Hp.GhostButton}" Content="{x:Static res:ShellStrings.ColorPickerCancel}"
                        AutomationProperties.AutomationId="ColorPickerCancel" Command="{Binding CancelPickerCommand}" />
                <Button Style="{StaticResource Hp.AccentButton}" Margin="8,0,0,0" Content="{x:Static res:ShellStrings.ColorPickerApply}"
                        AutomationProperties.AutomationId="ColorPickerApply" Command="{Binding ApplyPickerCommand}" />
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
