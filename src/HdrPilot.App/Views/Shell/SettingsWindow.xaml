<infra:ChromeWindow x:Class="HdrPilot.App.Views.Shell.SettingsWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:infra="clr-namespace:HdrPilot.App.Infrastructure"
                    xmlns:res="clr-namespace:HdrPilot.App.Resources"
                    xmlns:views="clr-namespace:HdrPilot.App.Views.Shell"
                    xmlns:vm="clr-namespace:HdrPilot.App.ViewModels.Shell"
                    mc:Ignorable="d"
                    d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
                    Title="{x:Static res:ShellStrings.SettingsWindowTitle}"
                    AutomationProperties.AutomationId="SettingsWindow"
                    AutomationProperties.Name="{x:Static res:ShellStrings.SettingsWindowTitle}"
                    Width="1360" Height="900" MinWidth="980" MinHeight="600"
                    WindowStartupLocation="CenterScreen">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
        <KeyBinding Key="S" Modifiers="Control" Command="{Binding SaveCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <!-- Kleine Vorschau eines Themas (.tpv): Titelbild-Streifen, Zeilen, Akzent-Pille -->
        <ControlTemplate x:Key="ThemeSampleLight" TargetType="ContentControl">
            <Grid Background="#FFEEF0F5">
                <Border Margin="8,8,8,0" Height="22" VerticalAlignment="Top" CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.4" EndPoint="1,0.6">
                            <GradientStop Color="{DynamicResource Hp.Color.Ambient1}" Offset="0" />
                            <GradientStop Color="{DynamicResource Hp.Color.C2}" Offset="1.6" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Margin="8,36,22,0" VerticalAlignment="Top">
                    <Border Height="6" CornerRadius="3" Background="#24000000" />
                    <Border Height="6" CornerRadius="3" Background="#24000000" Margin="0,6,0,0" />
                    <Border Height="6" CornerRadius="3" Background="#24000000" Margin="0,6,0,0" />
                </StackPanel>
                <Border Width="26" Height="10" CornerRadius="4" Margin="0,0,8,8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource Hp.Brush.Accent}" />
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="ThemeSampleDark" TargetType="ContentControl">
            <Grid Background="#FF0B0C12">
                <Border Margin="8,8,8,0" Height="22" VerticalAlignment="Top" CornerRadius="5">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0.4" EndPoint="1,0.6">
                            <GradientStop Color="{DynamicResource Hp.Color.Ambient1}" Offset="0" />
                            <GradientStop Color="{DynamicResource Hp.Color.C2}" Offset="1.6" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Margin="8,36,22,0" VerticalAlignment="Top">
                    <Border Height="6" CornerRadius="3" Background="#2EFFFFFF" />
                    <Border Height="6" CornerRadius="3" Background="#2EFFFFFF" Margin="0,6,0,0" />
                    <Border Height="6" CornerRadius="3" Background="#2EFFFFFF" Margin="0,6,0,0" />
                </StackPanel>
                <Border Width="26" Height="10" CornerRadius="4" Margin="0,0,8,8" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource Hp.Brush.Accent}" />
            </Grid>
        </ControlTemplate>

        <!-- Hintergrund der Vorführkarten der Effektstufen (.demo): Atmosphäre in Nacht, Glanz als Lichtfleck -->
        <ControlTemplate x:Key="EffectDemoBackground" TargetType="ContentControl">
            <Grid Background="#FF0B0C12">
                <Rectangle Opacity="0.4">
                    <Rectangle.Fill>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0.7">
                            <GradientStop Color="{DynamicResource Hp.Color.C2}" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </LinearGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
                <Rectangle Opacity="0.6">
                    <Rectangle.Fill>
                        <RadialGradientBrush Center="0.7,0.4" GradientOrigin="0.7,0.4" RadiusX="0.4" RadiusY="0.7">
                            <GradientStop Color="{DynamicResource Hp.Color.C3}" Offset="0" />
                            <GradientStop Color="Transparent" Offset="1" />
                        </RadialGradientBrush>
                    </Rectangle.Fill>
                </Rectangle>
            </Grid>
        </ControlTemplate>

        <!-- Zelle der Abdeckungstabelle: Balken (bei schmaler Tabelle ausgeblendet), „631/636“, „+3“ -->
        <DataTemplate x:Key="CoverageCell" DataType="{x:Type vm:CoverageCellItem}">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding AutomationName}">
                <Grid Width="40" Height="5" Margin="0,0,6,0" VerticalAlignment="Center"
                      Visibility="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Hp.Shell.WidthAtLeast}, ConverterParameter=560}">
                    <Border CornerRadius="2.5" Background="{DynamicResource Hp.Brush.Surface2}" />
                    <Border x:Name="Fill" CornerRadius="2.5" HorizontalAlignment="Left" Background="{DynamicResource Hp.Brush.Accent}"
                            Width="{Binding Fraction, Converter={StaticResource Hp.Shell.FractionWidth}, ConverterParameter=40}" />
                </Grid>
                <TextBlock FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.TextSecondary}" Text="{Binding Text}" VerticalAlignment="Center" />
                <TextBlock Margin="2,-4,0,0" FontSize="9" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Warning}" Text="{Binding Extra}" VerticalAlignment="Top"
                           Visibility="{Binding HasExtra, Converter={StaticResource Hp.Shell.BoolToVisibility}}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsZero}" Value="True">
                    <Setter TargetName="Fill" Property="Background" Value="#FF8A8FA5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <!--
        Einstellungen im Showcase-Stil (E89, G10.8): links die Navigation, rechts EIN scrollender Inhalt mit drei Gruppen
        (Allgemein, Darstellung, Erweitert). Jede Gruppe ist ein Raster mit Höchstbreite je Bereich (SettingsGridPanel): eine
        Spalte bei schmalen, zwei oder drei Spalten bei breiten Fenstern; im Vollbild bleibt der Rest als Rand. Die Navigation
        springt zu Ankern, alle Bereiche bleiben im Baum (UI-Automation erreicht jede Kennung ohne Navigation).
    -->
    <Grid x:Name="Root">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="256" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Navigation ================= -->
        <Border x:Name="Nav" Background="{DynamicResource Hp.Brush.Glass}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="0,0,1,0">
            <Grid Margin="14,10,14,18">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid x:Name="Header" Margin="6,0,6,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid Width="44" Height="44" Margin="0,0,12,0">
                        <Border CornerRadius="14" Background="{DynamicResource Hp.Brush.Surface2}" BorderBrush="{DynamicResource Hp.Brush.LineStrong}" BorderThickness="1" />
                        <views:LineIcon Width="26" Height="26" StrokeThickness="0" Fill="{DynamicResource Hp.Brush.AccentText}" Data="{StaticResource Hp.Icon.LogoSun}" />
                        <views:LineIcon Width="26" Height="26" StrokeThickness="2" Foreground="{DynamicResource Hp.Brush.AccentText}" Data="{StaticResource Hp.Icon.Logo}" />
                    </Grid>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock x:Name="NavTitle" Text="{x:Static res:ShellStrings.SettingsHeading}" FontFamily="{DynamicResource Hp.Font.Display}" FontSize="19" FontWeight="Bold"
                                   Foreground="{DynamicResource Hp.Brush.Text}" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="VersionText" Margin="0,4,0,0" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.TextSecondary}"
                                   Text="{x:Static infra:AppVersion.DisplayText}"
                                   AutomationProperties.AutomationId="SettingsVersion"
                                   AutomationProperties.Name="{x:Static infra:AppVersion.DisplayText}" />
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="NavItems" Grid.Row="1" ClipToBounds="True"
                            AutomationProperties.AutomationId="SettingsNav" AutomationProperties.Name="{x:Static res:ShellStrings.SettingsNavName}">
                    <Button x:Name="NavGeneral" Style="{StaticResource Hp.Shell.NavButton}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Settings}"
                            AutomationProperties.AutomationId="NavGeneral" Content="{x:Static res:ShellStrings.NavGeneral}" Click="OnNavigate" />
                    <Button x:Name="NavDisplays" Style="{StaticResource Hp.Shell.NavButton}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Monitor}"
                            AutomationProperties.AutomationId="NavDisplays" Content="{x:Static res:ShellStrings.NavDisplays}" Click="OnNavigate" />
                    <Button x:Name="NavAutomation" Style="{StaticResource Hp.Shell.NavButton}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Clock}"
                            AutomationProperties.AutomationId="NavAutomation" Content="{x:Static res:ShellStrings.NavAutomation}" Click="OnNavigate" />
                    <Button x:Name="NavSearchFolders" Style="{StaticResource Hp.Shell.NavButton}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Folder}"
                            AutomationProperties.AutomationId="NavSearchFolders" Content="{x:Static res:ShellStrings.NavSearchFolders}" Click="OnNavigate" />
                    <Button x:Name="NavHelpers" Style="{StaticResource Hp.Shell.NavButton}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Filter}"
                            AutomationProperties.AutomationId="NavHelpers" Content="{x:Static res:ShellStrings.NavHelpers}" Click="OnNavigate" />
                    <Button x:Name="NavAppearance" Style="{StaticResource Hp.Shell.NavButton}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Palette}"
                            AutomationProperties.AutomationId="NavAppearance" Content="{x:Static res:ShellStrings.NavAppearance}" Click="OnNavigate" />
                    <Button x:Name="NavAppearanceColors" Style="{StaticResource Hp.Shell.NavSubButton}"
                            AutomationProperties.AutomationId="NavAppearanceColors" Content="{x:Static res:ShellStrings.NavAppearanceColors}" Click="OnNavigate" />
                    <Button x:Name="NavAppearanceArtwork" Style="{StaticResource Hp.Shell.NavSubButton}"
                            AutomationProperties.AutomationId="NavAppearanceArtwork" Content="{x:Static res:ShellStrings.NavAppearanceArtwork}" Click="OnNavigate" />
                    <Button x:Name="NavAppearanceTray" Style="{StaticResource Hp.Shell.NavSubButton}"
                            AutomationProperties.AutomationId="NavAppearanceTray" Content="{x:Static res:ShellStrings.NavAppearanceTray}" Click="OnNavigate" />
                    <Button x:Name="NavAdvanced" Style="{StaticResource Hp.Shell.NavButton}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Wrench}"
                            AutomationProperties.AutomationId="NavAdvanced" Content="{x:Static res:ShellStrings.NavAdvanced}" Click="OnNavigate" />
                    <Button x:Name="NavLogs" Style="{StaticResource Hp.Shell.NavButton}" views:SettingsSection.Icon="{StaticResource Hp.Icon.File}"
                            AutomationProperties.AutomationId="NavLogs" Content="{x:Static res:ShellStrings.NavLogs}" Click="OnNavigate" />
                </StackPanel>

                <!-- Bibliothek (.sidef) -->
                <Border x:Name="LibraryCard" Grid.Row="2" Padding="14" CornerRadius="16" Background="{DynamicResource Hp.Brush.Surface1}"
                        BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Hp.Shell.Overline}" Text="{Binding Source={x:Static res:ShellStrings.LibraryCardOverline}, Converter={StaticResource Hp.Shell.Upper}}" />
                        <TextBlock Margin="0,6,0,10" FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" TextWrapping="Wrap" Text="{Binding LibrarySummary}" />
                        <Button Style="{StaticResource Hp.GhostButton}" HorizontalContentAlignment="Stretch"
                                AutomationProperties.AutomationId="OpenLibraryButton" AutomationProperties.Name="{x:Static res:ShellStrings.OpenLibrary}"
                                Command="{Binding OpenLibraryCommand}">
                            <DockPanel>
                                <views:LineIcon DockPanel.Dock="Right" Width="15" Height="15" Margin="8,0,0,0" Data="{StaticResource Hp.Icon.Arrow}" />
                                <TextBlock Text="{x:Static res:ShellStrings.OpenLibrary}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- ================= Inhalt ================= -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="Page" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="32,14,32,32"
                          ScrollChanged="OnPageScrollChanged">
                <StackPanel x:Name="PageContent">

                    <!-- ===== Gruppe: Allgemein ===== -->
                    <Grid x:Name="GroupGeneral" Margin="0,0,0,20">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hp.Shell.Overline}" Text="{Binding Source={x:Static res:ShellStrings.SettingsHeading}, Converter={StaticResource Hp.Shell.Upper}}" />
                            <TextBlock Margin="0,6,0,0" Text="{x:Static res:ShellStrings.NavGeneral}" FontFamily="{DynamicResource Hp.Font.Display}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Hp.Text.Caption}" FontSize="13.5" Text="{x:Static res:ShellStrings.GroupGeneralHint}" />
                        </StackPanel>
                    </Grid>
                    <views:SettingsGridPanel x:Name="GeneralGrid">
                        <!-- Start und Hinweise -->
                        <HeaderedContentControl x:Name="StartupSection" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionStartup}"
                                                views:SettingsSection.Description="{x:Static res:ShellStrings.SectionStartupHint}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Power}">
                            <StackPanel>
                                <Border Style="{StaticResource Hp.Shell.SettingRow}">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                                  Style="{StaticResource Hp.ToggleSwitch}"
                                                  AutomationProperties.AutomationId="AutostartToggle"
                                                  AutomationProperties.Name="{x:Static res:ShellStrings.AutostartLabel}"
                                                  AutomationProperties.HelpText="{x:Static res:ShellStrings.AutostartHint}"
                                                  IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hp.Shell.Label}" Text="{x:Static res:ShellStrings.AutostartLabel}" />
                                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,3,0,0" Text="{x:Static res:ShellStrings.AutostartHint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Hp.Shell.SettingRow}" Margin="0">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                                  Style="{StaticResource Hp.ToggleSwitch}"
                                                  AutomationProperties.AutomationId="NotificationsToggle"
                                                  AutomationProperties.Name="{x:Static res:ShellStrings.NotificationsLabel}"
                                                  AutomationProperties.HelpText="{x:Static res:ShellStrings.NotificationsHint}"
                                                  IsChecked="{Binding Notifications, Mode=TwoWay}" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hp.Shell.Label}" Text="{x:Static res:ShellStrings.NotificationsLabel}" />
                                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,3,0,0" Text="{x:Static res:ShellStrings.NotificationsHint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Bildschirme -->
                        <HeaderedContentControl x:Name="DisplaysSection" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionDisplays}"
                                                views:SettingsSection.Description="{x:Static res:ShellStrings.SectionDisplaysHint}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Monitor}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,0,0,14" Text="{x:Static res:ShellStrings.DisplaysHint}" />
                                <ListBox AutomationProperties.AutomationId="TargetDisplays"
                                         AutomationProperties.Name="{x:Static res:ShellStrings.SectionDisplays}"
                                         Style="{StaticResource Hp.Shell.ListBox}"
                                         ItemContainerStyle="{StaticResource Hp.Shell.PlainListBoxItem}"
                                         ItemsSource="{Binding Displays}"
                                         KeyboardNavigation.TabNavigation="Continue">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:DisplayOptionViewModel}">
                                            <CheckBox Style="{StaticResource Hp.Shell.CheckCard}"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      AutomationProperties.Name="{Binding Name}">
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource Hp.Shell.Label}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    <WrapPanel Margin="0,7,0,0">
                                                        <Border Style="{StaticResource Hp.Badge}" Margin="0,0,6,0"
                                                                Visibility="{Binding IsPrimary, Converter={StaticResource Hp.Shell.BoolToVisibility}}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Style="{StaticResource Hp.Shell.Glyph}" Text="&#xE80F;" FontSize="10" Margin="0,0,5,0" Foreground="{DynamicResource Hp.Brush.TextSecondary}" />
                                                                <TextBlock Style="{StaticResource Hp.Shell.BadgeText}" Text="{x:Static res:ShellStrings.BadgePrimary}" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource Hp.Shell.Badge.Accent}" Margin="0,0,6,0"
                                                                Visibility="{Binding HdrSupported, Converter={StaticResource Hp.Shell.BoolToVisibility}}">
                                                            <TextBlock Style="{StaticResource Hp.Shell.BadgeText}" Foreground="{DynamicResource Hp.Brush.AccentText}" Text="{x:Static res:ShellStrings.BadgeHdrCapable}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Hp.Badge}" Margin="0,0,6,0">
                                                            <Border.Visibility>
                                                                <MultiBinding Converter="{StaticResource Hp.Shell.NoHdrBadgeVisibility}">
                                                                    <Binding Path="HdrSupported" />
                                                                    <Binding Path="IsConnected" />
                                                                </MultiBinding>
                                                            </Border.Visibility>
                                                            <TextBlock Style="{StaticResource Hp.Shell.BadgeText}" Text="{x:Static res:ShellStrings.BadgeNoHdr}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Hp.Badge.New}" Margin="0,0,6,0"
                                                                Visibility="{Binding HdrEnabled, Converter={StaticResource Hp.Shell.BoolToVisibility}}">
                                                            <TextBlock Style="{StaticResource Hp.Shell.BadgeText}" Foreground="{DynamicResource Hp.Brush.TextOnAccent}" Text="{x:Static res:ShellStrings.BadgeHdrOn}" />
                                                        </Border>
                                                        <Border Style="{StaticResource Hp.Badge}" Margin="0,0,6,0" BorderBrush="{DynamicResource Hp.Brush.Warning}"
                                                                Visibility="{Binding IsConnected, Converter={StaticResource Hp.Shell.InverseBoolToVisibility}}">
                                                            <TextBlock Style="{StaticResource Hp.Shell.BadgeText}" Foreground="{DynamicResource Hp.Brush.Warning}" Text="{x:Static res:ShellStrings.BadgeDisconnected}" />
                                                        </Border>
                                                    </WrapPanel>
                                                </StackPanel>
                                            </CheckBox>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                                <TextBlock Style="{StaticResource Hp.Text.Body}" Margin="0,0,0,8" Text="{x:Static res:ShellStrings.DisplaysEmpty}"
                                           Visibility="{Binding HasDisplays, Converter={StaticResource Hp.Shell.InverseBoolToVisibility}}" />
                                <DockPanel Margin="2,2,0,0">
                                    <views:LineIcon Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Hp.Brush.TextMuted}" Data="{StaticResource Hp.Icon.Info}" />
                                    <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{Binding DisplaysSummary}" />
                                </DockPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Automatik -->
                        <HeaderedContentControl x:Name="AutomationSection" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionAutomation}"
                                                views:SettingsSection.Description="{x:Static res:ShellStrings.SectionAutomationHint}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Clock}">
                            <StackPanel>
                                <DockPanel>
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Hp.Shell.ValuePill}">
                                        <TextBlock Style="{StaticResource Hp.Shell.ValueText}" Text="{Binding PollIntervalText}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource Hp.Shell.Label}" Text="{x:Static res:ShellStrings.PollIntervalLabel}" />
                                </DockPanel>
                                <Slider AutomationProperties.AutomationId="PollInterval"
                                        AutomationProperties.Name="{x:Static res:ShellStrings.PollIntervalLabel}"
                                        AutomationProperties.HelpText="{x:Static res:ShellStrings.PollIntervalHint}"
                                        Style="{StaticResource Hp.Shell.Slider}" Margin="0,6,0,2"
                                        Minimum="250" Maximum="5000"
                                        TickFrequency="50" IsSnapToTickEnabled="True" SmallChange="50" LargeChange="250"
                                        Value="{Binding PollIntervalMs, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:ShellStrings.PollIntervalHint}" />

                                <DockPanel Margin="0,20,0,0">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Hp.Shell.ValuePill}">
                                        <TextBlock Style="{StaticResource Hp.Shell.ValueText}" Text="{Binding GracePeriodText}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource Hp.Shell.Label}" Text="{x:Static res:ShellStrings.GracePeriodLabel}" />
                                </DockPanel>
                                <Slider AutomationProperties.AutomationId="GracePeriod"
                                        AutomationProperties.Name="{x:Static res:ShellStrings.GracePeriodLabel}"
                                        AutomationProperties.HelpText="{x:Static res:ShellStrings.GracePeriodHint}"
                                        Style="{StaticResource Hp.Shell.Slider}" Margin="0,6,0,2"
                                        Minimum="0" Maximum="120"
                                        TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                                        Value="{Binding GracePeriodSeconds, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:ShellStrings.GracePeriodHint}" />

                                <!-- Neustart-Puffer (E85): Minuten und Sekunden, zusammen höchstens 30:00, 0:00 = aus -->
                                <DockPanel Margin="0,20,0,0">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Hp.Shell.ValuePill}">
                                        <TextBlock Style="{StaticResource Hp.Shell.ValueText}" Text="{Binding RestartBufferText}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource Hp.Shell.Label}" Text="{x:Static res:ShellStrings.RestartBufferLabel}" />
                                </DockPanel>
                                <Grid Margin="0,6,0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource Hp.Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Text="{x:Static res:ShellStrings.RestartBufferMinutesLabel}" />
                                    <Slider Grid.Column="1"
                                            AutomationProperties.AutomationId="RestartBufferMinutes"
                                            AutomationProperties.Name="{x:Static res:ShellStrings.RestartBufferMinutesName}"
                                            AutomationProperties.HelpText="{x:Static res:ShellStrings.RestartBufferHint}"
                                            Style="{StaticResource Hp.Shell.Slider}"
                                            Minimum="0" Maximum="30"
                                            TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="5"
                                            Value="{Binding RestartBufferMinutes, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="3" Style="{StaticResource Hp.Text.Caption}" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Text="{x:Static res:ShellStrings.RestartBufferSecondsLabel}" />
                                    <Slider Grid.Column="4"
                                            AutomationProperties.AutomationId="RestartBufferSeconds"
                                            AutomationProperties.Name="{x:Static res:ShellStrings.RestartBufferSecondsName}"
                                            AutomationProperties.HelpText="{x:Static res:ShellStrings.RestartBufferHint}"
                                            Style="{StaticResource Hp.Shell.Slider}"
                                            Minimum="0" Maximum="59"
                                            TickFrequency="1" IsSnapToTickEnabled="True" SmallChange="1" LargeChange="10"
                                            Value="{Binding RestartBufferSeconds, Mode=TwoWay}" />
                                </Grid>
                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:ShellStrings.RestartBufferHint}" />

                                <DockPanel Margin="0,20,0,0">
                                    <Border DockPanel.Dock="Right" Style="{StaticResource Hp.Shell.ValuePill}">
                                        <TextBlock Style="{StaticResource Hp.Shell.ValueText}" Text="{Binding LaunchTimeoutText}" />
                                    </Border>
                                    <TextBlock Style="{StaticResource Hp.Shell.Label}" Text="{x:Static res:ShellStrings.LaunchTimeoutLabel}" />
                                </DockPanel>
                                <Slider AutomationProperties.AutomationId="LaunchTimeout"
                                        AutomationProperties.Name="{x:Static res:ShellStrings.LaunchTimeoutLabel}"
                                        AutomationProperties.HelpText="{x:Static res:ShellStrings.LaunchTimeoutHint}"
                                        Style="{StaticResource Hp.Shell.Slider}" Margin="0,6,0,2"
                                        Minimum="30" Maximum="600"
                                        TickFrequency="5" IsSnapToTickEnabled="True" SmallChange="5" LargeChange="30"
                                        Value="{Binding LaunchTimeoutSeconds, Mode=TwoWay}" />
                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Text="{x:Static res:ShellStrings.LaunchTimeoutHint}" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Suchordner -->
                        <HeaderedContentControl x:Name="SearchSection" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionSearchFolders}"
                                                views:SettingsSection.Description="{x:Static res:ShellStrings.SectionSearchFoldersHint}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Folder}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,0,0,12" Text="{x:Static res:ShellStrings.SearchFoldersHint}" />
                                <Border CornerRadius="14" Padding="4" MinHeight="58" Background="{DynamicResource Hp.Brush.Surface1}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1">
                                    <Grid>
                                        <ListBox AutomationProperties.AutomationId="SearchFolders"
                                                 AutomationProperties.Name="{x:Static res:ShellStrings.SectionSearchFolders}"
                                                 Style="{StaticResource Hp.Shell.ListBox}"
                                                 ItemContainerStyle="{StaticResource Hp.Shell.ListBoxItem}"
                                                 MaxHeight="190"
                                                 ItemsSource="{Binding SearchFolders}"
                                                 SelectedItem="{Binding SelectedSearchFolder, Mode=TwoWay}">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <DockPanel>
                                                        <views:LineIcon Width="15" Height="15" Margin="0,0,10,0" Foreground="{DynamicResource Hp.Brush.AccentText}" Data="{StaticResource Hp.Icon.Folder}" />
                                                        <TextBlock Text="{Binding}" FontSize="13" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" VerticalAlignment="Center" />
                                                    </DockPanel>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="12,0" VerticalAlignment="Center" TextAlignment="Center"
                                                   Text="{x:Static res:ShellStrings.SearchFoldersEmpty}"
                                                   Visibility="{Binding HasSearchFolders, Converter={StaticResource Hp.Shell.InverseBoolToVisibility}}" />
                                    </Grid>
                                </Border>
                                <WrapPanel Margin="0,12,0,0">
                                    <Button Style="{StaticResource Hp.GhostButton}" Margin="0,0,8,0"
                                            AutomationProperties.AutomationId="AddSearchFolderButton"
                                            AutomationProperties.Name="{x:Static res:ShellStrings.AddSearchFolder}"
                                            Command="{Binding AddSearchFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <views:LineIcon Style="{StaticResource Hp.Shell.ButtonIcon}" Data="{StaticResource Hp.Icon.Plus}" />
                                            <TextBlock Text="{x:Static res:ShellStrings.AddSearchFolder}" />
                                        </StackPanel>
                                    </Button>
                                    <Button Style="{StaticResource Hp.GhostButton}"
                                            AutomationProperties.AutomationId="RemoveSearchFolderButton"
                                            AutomationProperties.Name="{x:Static res:ShellStrings.RemoveSearchFolder}"
                                            Command="{Binding RemoveSearchFolderCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <views:LineIcon Style="{StaticResource Hp.Shell.ButtonIcon}" Data="{StaticResource Hp.Icon.Minus}" />
                                            <TextBlock Text="{x:Static res:ShellStrings.RemoveSearchFolder}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- Hilfsprozesse -->
                        <HeaderedContentControl x:Name="HelpersSection" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionHelpers}"
                                                views:SettingsSection.Description="{x:Static res:ShellStrings.SectionHelpersHint}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Filter}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,0,0,12" Text="{x:Static res:ShellStrings.HelpersHint}" />
                                <TextBox AutomationProperties.AutomationId="HelperPatterns"
                                         AutomationProperties.Name="{x:Static res:ShellStrings.SectionHelpers}"
                                         AutomationProperties.HelpText="{x:Static res:ShellStrings.HelpersHint}"
                                         Style="{StaticResource Hp.Shell.TextBox}"
                                         Height="269.34" AcceptsReturn="True" AcceptsTab="False" TextWrapping="NoWrap"
                                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                                         FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="12.5"
                                         SpellCheck.IsEnabled="False"
                                         Text="{Binding HelperPatternsText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <DockPanel Margin="0,12,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Hp.GhostButton}"
                                            AutomationProperties.AutomationId="ResetHelperPatternsButton"
                                            AutomationProperties.Name="{x:Static res:ShellStrings.ResetHelperPatterns}"
                                            Command="{Binding ResetHelperPatternsCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <views:LineIcon Style="{StaticResource Hp.Shell.ButtonIcon}" Data="{StaticResource Hp.Icon.Reset}" />
                                            <TextBlock Text="{x:Static res:ShellStrings.ResetHelperPatterns}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Style="{StaticResource Hp.Shell.ValuePill}">
                                            <TextBlock Style="{StaticResource Hp.Shell.ValueText}" FontSize="12" Text="{Binding HelperPatternCountText}" />
                                        </Border>
                                        <Border Style="{StaticResource Hp.Shell.Badge.Accent}" Margin="8,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Hp.Shell.BadgeText}" Foreground="{DynamicResource Hp.Brush.AccentText}" Text="{Binding HelperPatternsKind}" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </views:SettingsGridPanel>

                    <!-- ===== Gruppe: Darstellung (wirkt sofort) ===== -->
                    <Grid x:Name="GroupAppearance" Margin="0,48,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hp.Shell.Overline}" Text="{Binding Source={x:Static res:ShellStrings.SettingsHeading}, Converter={StaticResource Hp.Shell.Upper}}" />
                            <TextBlock Margin="0,6,0,0" Text="{x:Static res:ShellStrings.NavAppearance}" FontFamily="{DynamicResource Hp.Font.Display}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Hp.Text.Caption}" FontSize="13.5" Text="{x:Static res:ShellStrings.GroupAppearanceHint}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom" Margin="16,0,0,2">
                            <Border x:Name="AppliedChip" Height="34" Padding="12,0" CornerRadius="17" Margin="0,0,8,0" Background="{DynamicResource Hp.Brush.SelectionFill}"
                                    BorderBrush="{DynamicResource Hp.Brush.AccentStrong}" BorderThickness="1"
                                    AutomationProperties.AutomationId="AppearanceAppliedHint" AutomationProperties.Name="{x:Static res:ShellStrings.AppearanceAppliedHint}">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Grid Width="7" Height="7" Margin="0,0,8,0">
                                        <Ellipse Margin="-4" Opacity="0.5">
                                            <Ellipse.Fill>
                                                <RadialGradientBrush>
                                                    <GradientStop Color="{DynamicResource Hp.Color.C1}" Offset="0" />
                                                    <GradientStop Color="Transparent" Offset="1" />
                                                </RadialGradientBrush>
                                            </Ellipse.Fill>
                                        </Ellipse>
                                        <Ellipse Fill="{DynamicResource Hp.Brush.FocusRing}" />
                                    </Grid>
                                    <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.AccentText}" Text="{x:Static res:ShellStrings.AppearanceAppliedHint}" />
                                </StackPanel>
                            </Border>
                            <Button Style="{StaticResource Hp.GhostButton}" DataContext="{Binding Appearance}"
                                    AutomationProperties.AutomationId="AppearanceResetButton" AutomationProperties.Name="{x:Static res:ShellStrings.AppearanceResetName}"
                                    Command="{Binding ResetCommand}">
                                <StackPanel Orientation="Horizontal">
                                    <views:LineIcon Style="{StaticResource Hp.Shell.ButtonIcon}" Data="{StaticResource Hp.Icon.Reset}" />
                                    <TextBlock Text="{x:Static res:ShellStrings.AppearanceReset}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                    <views:SettingsGridPanel x:Name="AppearanceGrid" DataContext="{Binding Appearance}">

                        <!-- ===== Farbschema ===== -->
                        <HeaderedContentControl x:Name="SectionPalette" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionPalette}"
                                                AutomationProperties.AutomationId="SectionPalette" AutomationProperties.Name="{x:Static res:ShellStrings.SectionPalette}"
                                                views:SettingsSection.Description="{x:Static res:ShellStrings.SectionPaletteHint}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Palette}">
                            <HeaderedContentControl.Tag>
                                <StackPanel Orientation="Horizontal">
                                    <Button Style="{StaticResource Hp.Shell.SquareButton}" Margin="0,0,8,0" Command="{Binding SwapCommand}"
                                            ToolTip="{x:Static res:ShellStrings.PaletteSwap}"
                                            AutomationProperties.AutomationId="PaletteSwapButton" AutomationProperties.Name="{x:Static res:ShellStrings.PaletteSwap}">
                                        <views:LineIcon Width="16" Height="16" Data="{StaticResource Hp.Icon.Swap}" />
                                    </Button>
                                    <Border Style="{StaticResource Hp.Shell.SegmentHost}" AutomationProperties.Name="{x:Static res:ShellStrings.PaletteModeName}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Hp.Shell.Segment}" GroupName="PaletteMode" Content="{x:Static res:ShellStrings.PaletteModeDuotone}"
                                                         AutomationProperties.AutomationId="PaletteModeDuotone" IsChecked="{Binding IsDuotone, Mode=TwoWay}" />
                                            <RadioButton Style="{StaticResource Hp.Shell.Segment}" GroupName="PaletteMode" Content="{x:Static res:ShellStrings.PaletteModeTritone}"
                                                         AutomationProperties.AutomationId="PaletteModeTritone" IsChecked="{Binding IsTritone, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </HeaderedContentControl.Tag>
                            <StackPanel>
                                <ItemsControl ItemsSource="{Binding Wells}" Focusable="False">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <views:AdaptiveGrid Columns="3,1" MinItemWidth="150" Gap="10" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ColorWellItem}">
                                            <Button x:Name="Well" Style="{StaticResource Hp.Shell.ColorWell}" Command="{Binding EditCommand}" CommandParameter="{Binding}"
                                                    AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding AutomationName}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <Grid Width="42" Height="42" Margin="0,0,12,0" VerticalAlignment="Top">
                                                        <Border x:Name="Swatch" CornerRadius="13" Background="{Binding Brush}" BorderBrush="#40FFFFFF" BorderThickness="1" />
                                                        <TextBlock Margin="5,3,0,0" FontSize="10" FontWeight="Bold" Foreground="#8C000000" Text="{Binding Number}" />
                                                        <Grid x:Name="Pen" Width="16" Height="16" Margin="0,0,-4,-4" HorizontalAlignment="Right" VerticalAlignment="Bottom">
                                                            <Ellipse Fill="{DynamicResource Hp.Brush.Menu}" Stroke="{DynamicResource Hp.Brush.Line}" />
                                                            <views:LineIcon Width="10" Height="10" StrokeThickness="2.4" Foreground="{DynamicResource Hp.Brush.TextSecondary}" Data="M15 5l4 4L9 19H5v-4z" />
                                                        </Grid>
                                                    </Grid>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" Text="{Binding Role}" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Margin="0,3,0,0" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="11" Foreground="{DynamicResource Hp.Brush.TextMuted}" Text="{Binding Caption}" />
                                                        <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource Hp.Brush.TextSecondary}" TextWrapping="Wrap" Text="{Binding RoleHint}" />
                                                    </StackPanel>
                                                </Grid>
                                            </Button>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsAutomatic}" Value="True">
                                                    <Setter TargetName="Pen" Property="Visibility" Value="Collapsed" />
                                                    <Setter TargetName="Well" Property="Cursor" Value="Arrow" />
                                                    <Setter TargetName="Well" Property="Opacity" Value="0.85" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Height="8" Margin="2,14,2,4" CornerRadius="4" Background="{Binding PaletteBar}" />
                                <DockPanel Margin="0,12,0,8">
                                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Hp.Text.Caption}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding PresetCaption}" />
                                    <TextBlock Style="{StaticResource Hp.Shell.Overline}" Text="{Binding Source={x:Static res:ShellStrings.PresetsCaption}, Converter={StaticResource Hp.Shell.Upper}}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding Presets}" Focusable="False"
                                              AutomationProperties.AutomationId="PalettePresets" AutomationProperties.Name="{x:Static res:ShellStrings.PresetsName}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <views:AdaptiveGrid Columns="8,4,2" MinItemWidth="76" Gap="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:PalettePresetItem}">
                                            <RadioButton Style="{StaticResource Hp.Shell.PresetTile}" GroupName="Preset" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                         AutomationProperties.Name="{Binding Name}" ToolTip="{Binding Name}" />
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Border Style="{StaticResource Hp.Shell.SettingRow}" Margin="0,12,0,0">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Hp.ToggleSwitch}"
                                                  AutomationProperties.AutomationId="AutoTextOnAccentToggle" AutomationProperties.Name="{x:Static res:ShellStrings.AutoTextOnAccentLabel}"
                                                  IsChecked="{Binding AutoTextOnAccent, Mode=TwoWay}" />
                                        <Border DockPanel.Dock="Left" Width="46" Height="36" CornerRadius="10" Margin="0,0,14,0" Background="{DynamicResource Hp.Brush.Accent}">
                                            <TextBlock Text="Aa" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextOnAccent}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Hp.Shell.Label}" TextWrapping="Wrap" Text="{x:Static res:ShellStrings.AutoTextOnAccentLabel}" />
                                            <WrapPanel Margin="0,6,0,0">
                                                <Border Style="{StaticResource Hp.Shell.Chip}" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" Text="{x:Static res:ShellStrings.ContrastOnAccent}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <Border x:Name="OnAccentChip" CornerRadius="5" Padding="5,2" Background="{Binding OnAccentGradeSoftBrush, Converter={StaticResource Hp.Shell.ResourceBrush}}">
                                                            <TextBlock x:Name="OnAccentChipText" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="10" FontWeight="Bold" Foreground="{Binding OnAccentGradeBrush, Converter={StaticResource Hp.Shell.ResourceBrush}}" Text="{Binding OnAccentContrast}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                                <Border Style="{StaticResource Hp.Shell.Chip}" Margin="0,0,6,4">
                                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                        <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" Text="{x:Static res:ShellStrings.ContrastAccentText}" Margin="0,0,6,0" VerticalAlignment="Center" />
                                                        <Border x:Name="AccentTextChip" CornerRadius="5" Padding="5,2" Background="{Binding AccentTextGradeSoftBrush, Converter={StaticResource Hp.Shell.ResourceBrush}}">
                                                            <TextBlock x:Name="AccentTextChipText" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="10" FontWeight="Bold" Foreground="{Binding AccentTextGradeBrush, Converter={StaticResource Hp.Shell.ResourceBrush}}" Text="{Binding AccentTextContrast}" />
                                                        </Border>
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Border Style="{StaticResource Hp.Shell.SettingRow}" Margin="0">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Hp.ToggleSwitch}"
                                                  AutomationProperties.AutomationId="BackgroundFollowsGameToggle" AutomationProperties.Name="{x:Static res:ShellStrings.BackgroundFollowsGameLabel}"
                                                  IsChecked="{Binding BackgroundFollowsGame, Mode=TwoWay}" />
                                        <Border DockPanel.Dock="Left" Width="46" Height="36" CornerRadius="10" Margin="0,0,14,0" Background="{Binding FollowSample}"
                                                BorderBrush="#33FFFFFF" BorderThickness="1" RenderOptions.BitmapScalingMode="Linear" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Hp.Shell.Label}" TextWrapping="Wrap" Text="{x:Static res:ShellStrings.BackgroundFollowsGameLabel}" />
                                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,3,0,0" Text="{x:Static res:ShellStrings.BackgroundFollowsGameHint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <TextBlock Margin="2,10,0,0" Style="{StaticResource Hp.Text.Caption}" Foreground="{DynamicResource Hp.Brush.Danger}" Text="{Binding ErrorMessage}"
                                           Visibility="{Binding HasError, Converter={StaticResource Hp.Shell.BoolToVisibility}}" />
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- ===== Live-Vorschau ===== -->
                        <HeaderedContentControl x:Name="SectionPreview" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionPreview}"
                                                AutomationProperties.AutomationId="SectionPreview" AutomationProperties.Name="{x:Static res:ShellStrings.SectionPreview}"
                                                views:SettingsSection.Description="{x:Static res:ShellStrings.SectionPreviewHint}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Eye}">
                            <HeaderedContentControl.Tag>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Hp.Shell.Overline}" Margin="0,0,10,0" Text="{x:Static res:ShellStrings.PreviewHdr}" />
                                    <CheckBox Style="{StaticResource Hp.ToggleSwitch}" AutomationProperties.AutomationId="PreviewHdrToggle"
                                              AutomationProperties.Name="{x:Static res:ShellStrings.PreviewHdrName}" IsChecked="{Binding PreviewHdr, Mode=TwoWay}" />
                                </StackPanel>
                            </HeaderedContentControl.Tag>
                            <StackPanel>
                                <Grid x:Name="Stage" Height="250" views:RoundedClip.Radius="16" Background="#FF07080C">
                                    <Border Background="{Binding PreviewFieldBrush}" />
                                    <Image Source="{Binding PreviewField}" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" />
                                    <Grid x:Name="StageArt" RenderTransformOrigin="0.62,0.42">
                                        <Grid.RenderTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="StageZoom" ScaleX="1.02" ScaleY="1.02" />
                                                <TranslateTransform x:Name="StageDrift" />
                                            </TransformGroup>
                                        </Grid.RenderTransform>
                                        <Image Source="{Binding PreviewHero}" Stretch="UniformToFill" VerticalAlignment="Top" HorizontalAlignment="Center" />
                                        <Image x:Name="StageBoost" Source="{Binding PreviewBoost}" Stretch="UniformToFill" VerticalAlignment="Top" HorizontalAlignment="Center" Opacity="0" />
                                    </Grid>
                                    <Rectangle x:Name="StageVeil" Fill="#38060810" />
                                    <Rectangle x:Name="StageBloom" Fill="{Binding PreviewGlow}" Opacity="0" />
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#D905060A" Offset="0" />
                                                <GradientStop Color="#5905060A" Offset="0.5" />
                                                <GradientStop Color="#0005060A" Offset="0.75" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <Rectangle IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                <GradientStop Color="#B305060A" Offset="0" />
                                                <GradientStop Color="#0005060A" Offset="0.5" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                    </Rectangle>
                                    <!-- Lichtstreifen des HDR-Moments (einmalig, nur beim Einschalten der Vorschau) -->
                                    <Rectangle x:Name="StageSweep" Width="160" HorizontalAlignment="Left" Margin="0,-60" Opacity="0" IsHitTestVisible="False">
                                        <Rectangle.Fill>
                                            <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                <GradientStop Color="#00FFFFFF" Offset="0" />
                                                <GradientStop Color="{DynamicResource Hp.Color.C3}" Offset="0.26" />
                                                <GradientStop Color="#F2FFFFFF" Offset="0.5" />
                                                <GradientStop Color="{DynamicResource Hp.Color.C1}" Offset="0.74" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Rectangle.Fill>
                                        <Rectangle.RenderTransform>
                                            <TransformGroup>
                                                <SkewTransform AngleX="-20" />
                                                <TranslateTransform x:Name="StageSweepMove" X="-220" />
                                            </TransformGroup>
                                        </Rectangle.RenderTransform>
                                    </Rectangle>
                                    <!-- Logo oder Name, Quelle, Datum, Starten / Desktop (nur Anschauung) -->
                                    <StackPanel Margin="20,0,0,18" VerticalAlignment="Bottom" HorizontalAlignment="Left" MaxWidth="320" IsHitTestVisible="False">
                                        <Image Source="{Binding PreviewLogo}" MaxHeight="64" MaxWidth="240" HorizontalAlignment="Left" Stretch="Uniform"
                                               Visibility="{Binding PreviewLogo, Converter={StaticResource Hp.Shell.NullToVisibility}}" />
                                        <TextBlock Text="{Binding PreviewName}" FontFamily="{DynamicResource Hp.Font.Display}" FontSize="22" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextOnArt}"
                                                   TextWrapping="Wrap" MaxHeight="58" TextTrimming="CharacterEllipsis"
                                                   Visibility="{Binding PreviewShowsName, Converter={StaticResource Hp.Shell.BoolToVisibility}}" />
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Border CornerRadius="10" Padding="9,3,10,4" Background="#A80C0D13" BorderBrush="#33FFFFFF" BorderThickness="1" Margin="0,0,10,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <Ellipse Width="7" Height="7" Margin="0,0,7,0" Fill="{Binding PreviewSourceBrushKey, Converter={StaticResource Hp.Shell.ResourceBrush}}" VerticalAlignment="Center" />
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.TextOnArt}" Text="{Binding PreviewSource}" />
                                                </StackPanel>
                                            </Border>
                                            <TextBlock FontSize="12" Foreground="{DynamicResource Hp.Brush.TextOnArtSecondary}" VerticalAlignment="Center" Text="{Binding PreviewWhen}" />
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                            <Border Height="38" CornerRadius="12" Padding="14,0,18,0" Background="{DynamicResource Hp.Brush.Accent}" Margin="0,0,8,0">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <views:LineIcon Width="15" Height="15" Margin="0,0,8,0" StrokeThickness="0" Fill="{DynamicResource Hp.Brush.TextOnAccent}" Data="{StaticResource Hp.Icon.Play}" />
                                                    <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextOnAccent}" Text="{x:Static res:ShellStrings.PreviewLaunch}" />
                                                </StackPanel>
                                            </Border>
                                            <Border Height="38" CornerRadius="12" Padding="12,0" Background="#A80C0D13" BorderBrush="#33FFFFFF" BorderThickness="1">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <views:LineIcon Width="15" Height="15" Margin="0,0,8,0" Foreground="{DynamicResource Hp.Brush.TextOnArt}" Data="{StaticResource Hp.Icon.Desktop}" />
                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource Hp.Brush.TextOnArt}" Text="{x:Static res:ShellStrings.PreviewDesktop}" />
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>
                                    <!-- Kapsel mit echter Spitze des Bildschirms (nie ein fester Wert) -->
                                    <Border Margin="0,12,12,0" Height="34" Padding="12,0" CornerRadius="11" HorizontalAlignment="Right" VerticalAlignment="Top"
                                            Background="#A80C0D13" BorderBrush="#33FFFFFF" BorderThickness="1" IsHitTestVisible="False">
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Ellipse x:Name="StageDot" Width="8" Height="8" Margin="0,0,9,0" Fill="#FF8A8FA5" />
                                            <TextBlock FontFamily="{DynamicResource Hp.Font.Display}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextOnArt}" Text="{Binding PreviewHdrText}" Margin="0,0,10,0" />
                                            <TextBlock FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="11.5" Foreground="{DynamicResource Hp.Brush.TextOnArtSecondary}" Text="{Binding PreviewNitsText}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <DockPanel Margin="0,12,0,0">
                                    <ItemsControl ItemsSource="{Binding PreviewGames}" Focusable="False">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:PreviewGameItem}">
                                                <RadioButton Style="{StaticResource Hp.Shell.PreviewThumb}" GroupName="PreviewGame" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                             AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding Name}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Margin="8,0,0,0" Style="{StaticResource Hp.Text.Caption}" TextAlignment="Right" VerticalAlignment="Center" TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis" Text="{Binding PreviewName}" />
                                </DockPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- ===== Thema ===== -->
                        <HeaderedContentControl x:Name="SectionTheme" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionTheme}"
                                                AutomationProperties.AutomationId="SectionTheme" AutomationProperties.Name="{x:Static res:ShellStrings.SectionTheme}"
                                                views:SettingsSection.Description="{Binding ThemeCaption}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Theme}">
                            <views:AdaptiveGrid Columns="3,1" MinItemWidth="140" Gap="10">
                                <RadioButton Style="{StaticResource Hp.Shell.ChoiceCard}" GroupName="Theme" IsChecked="{Binding IsThemeSystem, Mode=TwoWay}"
                                             AutomationProperties.AutomationId="ThemeSystem" AutomationProperties.Name="{x:Static res:ShellStrings.ThemeSystem}">
                                    <StackPanel>
                                        <Grid Height="74" views:RoundedClip.Radius="10">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl Template="{DynamicResource ThemeSampleLight}" Focusable="False" />
                                            <ContentControl Grid.Column="1" Template="{DynamicResource ThemeSampleDark}" Focusable="False" />
                                        </Grid>
                                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Text="{x:Static res:ShellStrings.ThemeSystem}" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Hp.Text.Caption}" FontSize="11.5" TextAlignment="Center" Text="{x:Static res:ShellStrings.ThemeSystemHint}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Hp.Shell.ChoiceCard}" GroupName="Theme" IsChecked="{Binding IsThemeLight, Mode=TwoWay}"
                                             AutomationProperties.AutomationId="ThemeLight" AutomationProperties.Name="{x:Static res:ShellStrings.ThemeLight}">
                                    <StackPanel>
                                        <ContentControl Height="74" views:RoundedClip.Radius="10" Template="{DynamicResource ThemeSampleLight}" Focusable="False" />
                                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Text="{x:Static res:ShellStrings.ThemeLight}" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Hp.Text.Caption}" FontSize="11.5" TextAlignment="Center" Text="{x:Static res:ShellStrings.ThemeLightHint}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton Style="{StaticResource Hp.Shell.ChoiceCard}" GroupName="Theme" IsChecked="{Binding IsThemeDark, Mode=TwoWay}"
                                             AutomationProperties.AutomationId="ThemeDark" AutomationProperties.Name="{x:Static res:ShellStrings.ThemeDark}">
                                    <StackPanel>
                                        <ContentControl Height="74" views:RoundedClip.Radius="10" Template="{DynamicResource ThemeSampleDark}" Focusable="False" />
                                        <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" FontSize="13" FontWeight="Bold" Text="{x:Static res:ShellStrings.ThemeDark}" />
                                        <TextBlock Margin="0,2,0,0" Style="{StaticResource Hp.Text.Caption}" FontSize="11.5" TextAlignment="Center" Text="{x:Static res:ShellStrings.ThemeDarkHint}" />
                                    </StackPanel>
                                </RadioButton>
                            </views:AdaptiveGrid>
                        </HeaderedContentControl>

                        <!-- ===== Effekte ===== -->
                        <HeaderedContentControl x:Name="SectionEffects" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionEffects}"
                                                AutomationProperties.AutomationId="SectionEffects" AutomationProperties.Name="{x:Static res:ShellStrings.SectionEffects}"
                                                views:SettingsSection.Description="{x:Static res:ShellStrings.SectionEffectsHint}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Spark}">
                            <StackPanel>
                                <views:AdaptiveGrid Columns="3,1" MinItemWidth="140" Gap="10">
                                    <RadioButton Style="{StaticResource Hp.Shell.ChoiceCard}" GroupName="Effects" IsChecked="{Binding IsEffectFull, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="EffectFull" AutomationProperties.Name="{x:Static res:ShellStrings.EffectFull}">
                                        <StackPanel>
                                            <Grid x:Name="DemoFull" Height="64" views:RoundedClip.Radius="11">
                                                <ContentControl Template="{DynamicResource EffectDemoBackground}" Focusable="False" />
                                                <Rectangle x:Name="DemoSweep" Width="44" HorizontalAlignment="Left" Margin="0,-14" Opacity="0">
                                                    <Rectangle.Fill>
                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                            <GradientStop Color="#00FFFFFF" Offset="0" />
                                                            <GradientStop Color="#8CFFFFFF" Offset="0.5" />
                                                            <GradientStop Color="#00FFFFFF" Offset="1" />
                                                        </LinearGradientBrush>
                                                    </Rectangle.Fill>
                                                    <Rectangle.RenderTransform>
                                                        <TransformGroup>
                                                            <SkewTransform AngleX="-20" />
                                                            <TranslateTransform x:Name="DemoSweepMove" X="-60" />
                                                        </TransformGroup>
                                                    </Rectangle.RenderTransform>
                                                </Rectangle>
                                                <Canvas x:Name="DemoParticles" IsHitTestVisible="False">
                                                    <Ellipse Canvas.Left="96" Canvas.Top="36" Width="6" Height="6" Fill="White" Opacity="0.9" />
                                                    <Ellipse Canvas.Left="112" Canvas.Top="24" Width="6" Height="6" Fill="White" Opacity="0.7" />
                                                    <Ellipse Canvas.Left="84" Canvas.Top="18" Width="5" Height="5" Fill="White" Opacity="0.55" />
                                                </Canvas>
                                            </Grid>
                                            <TextBlock Margin="2,10,0,0" FontSize="13.5" FontWeight="Bold" Text="{x:Static res:ShellStrings.EffectFull}" />
                                            <TextBlock Margin="2,3,0,0" Style="{StaticResource Hp.Text.Caption}" FontSize="11.5" Text="{x:Static res:ShellStrings.EffectFullHint}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Hp.Shell.ChoiceCard}" GroupName="Effects" IsChecked="{Binding IsEffectReduced, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="EffectReduced" AutomationProperties.Name="{x:Static res:ShellStrings.EffectReduced}">
                                        <StackPanel>
                                            <Grid Height="64" views:RoundedClip.Radius="11">
                                                <ContentControl Template="{DynamicResource EffectDemoBackground}" Focusable="False" />
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="2,10,0,0">
                                                <TextBlock FontSize="13.5" FontWeight="Bold" Text="{x:Static res:ShellStrings.EffectReduced}" VerticalAlignment="Center" />
                                                <Border Style="{StaticResource Hp.Shell.TagShine}" Margin="8,0,0,0"
                                                        Visibility="{Binding ReducedIsEffective, Converter={StaticResource Hp.Shell.BoolToVisibility}}">
                                                    <TextBlock Style="{StaticResource Hp.Shell.TagText}" Foreground="{DynamicResource Hp.Brush.Text}" Text="{Binding Source={x:Static res:ShellStrings.EffectEffectiveTag}, Converter={StaticResource Hp.Shell.Upper}}" />
                                                </Border>
                                            </StackPanel>
                                            <TextBlock Margin="2,3,0,0" Style="{StaticResource Hp.Text.Caption}" FontSize="11.5" Text="{x:Static res:ShellStrings.EffectReducedHint}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton Style="{StaticResource Hp.Shell.ChoiceCard}" GroupName="Effects" IsChecked="{Binding IsEffectOff, Mode=TwoWay}"
                                                 AutomationProperties.AutomationId="EffectOff" AutomationProperties.Name="{x:Static res:ShellStrings.EffectOff}">
                                        <StackPanel>
                                            <Grid Height="64" views:RoundedClip.Radius="11" Opacity="0.7">
                                                <ContentControl Template="{DynamicResource EffectDemoBackground}" Focusable="False" />
                                            </Grid>
                                            <TextBlock Margin="2,10,0,0" FontSize="13.5" FontWeight="Bold" Text="{x:Static res:ShellStrings.EffectOff}" />
                                            <TextBlock Margin="2,3,0,0" Style="{StaticResource Hp.Text.Caption}" FontSize="11.5" Text="{x:Static res:ShellStrings.EffectOffHint}" />
                                        </StackPanel>
                                    </RadioButton>
                                </views:AdaptiveGrid>
                                <StackPanel Margin="0,10,0,0">
                                    <Border Style="{StaticResource Hp.Shell.PlainRow}" BorderThickness="0">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Hp.ToggleSwitch}"
                                                      AutomationProperties.AutomationId="PauseWhilePlayingToggle" AutomationProperties.Name="{x:Static res:ShellStrings.PauseWhilePlayingLabel}"
                                                      IsChecked="{Binding PauseWhilePlaying, Mode=TwoWay}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Hp.Shell.Label}" TextWrapping="Wrap" Text="{x:Static res:ShellStrings.PauseWhilePlayingLabel}" />
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,2,0,0" Text="{x:Static res:ShellStrings.PauseWhilePlayingHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Hp.Shell.PlainRow}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Hp.ToggleSwitch}"
                                                      AutomationProperties.AutomationId="PauseInBackgroundToggle" AutomationProperties.Name="{x:Static res:ShellStrings.PauseInBackgroundLabel}"
                                                      IsChecked="{Binding PauseInBackground, Mode=TwoWay}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Hp.Shell.Label}" TextWrapping="Wrap" Text="{x:Static res:ShellStrings.PauseInBackgroundLabel}" />
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,2,0,0" Text="{x:Static res:ShellStrings.PauseInBackgroundHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Hp.Shell.PlainRow}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Hp.ToggleSwitch}"
                                                      AutomationProperties.AutomationId="RespectWindowsAnimationsToggle" AutomationProperties.Name="{x:Static res:ShellStrings.RespectWindowsAnimationsLabel}"
                                                      IsChecked="{Binding RespectWindowsAnimations, Mode=TwoWay}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Hp.Shell.Label}" TextWrapping="Wrap" Text="{x:Static res:ShellStrings.RespectWindowsAnimationsLabel}" />
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,2,0,0" Text="{Binding RespectWindowsAnimationsHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                    <Border Style="{StaticResource Hp.Shell.PlainRow}">
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="14,0,0,0" Style="{StaticResource Hp.ToggleSwitch}"
                                                      AutomationProperties.AutomationId="MinimizeToTrayAfterLaunchToggle" AutomationProperties.Name="{x:Static res:ShellStrings.MinimizeToTrayLabel}"
                                                      IsChecked="{Binding MinimizeToTrayAfterLaunch, Mode=TwoWay}" />
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock Style="{StaticResource Hp.Shell.Label}" TextWrapping="Wrap" Text="{x:Static res:ShellStrings.MinimizeToTrayLabel}" />
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,2,0,0" Text="{x:Static res:ShellStrings.MinimizeToTrayHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                    </Border>
                                </StackPanel>
                                <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="12" Background="{DynamicResource Hp.Brush.WarningSoft}" BorderBrush="{DynamicResource Hp.Brush.Warning}" BorderThickness="1">
                                    <DockPanel>
                                        <views:LineIcon Width="16" Height="16" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource Hp.Brush.Warning}" Data="{StaticResource Hp.Icon.Bolt}" />
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" LineHeight="17" Text="{x:Static res:ShellStrings.EffectsPerformanceNote}" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- ===== Bilder ===== -->
                        <HeaderedContentControl x:Name="SectionArtwork" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionArtwork}"
                                                AutomationProperties.AutomationId="SectionArtwork" AutomationProperties.Name="{x:Static res:ShellStrings.SectionArtwork}"
                                                views:SettingsSection.Description="{x:Static res:ShellStrings.SectionArtworkHint}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Image}">
                            <StackPanel>
                                <!-- Lokal · Launcher-Caches -->
                                <Border Style="{StaticResource Hp.Shell.SubCard.Primary}">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Right" Height="28" Padding="10,0" CornerRadius="14" VerticalAlignment="Top" Margin="10,0,0,0"
                                                    Background="{DynamicResource Hp.Brush.Surface2}" BorderBrush="{DynamicResource Hp.Brush.LineStrong}" BorderThickness="1"
                                                    ToolTip="{x:Static res:ShellStrings.ArtworkAlwaysOnHint}">
                                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                    <views:LineIcon Width="13" Height="13" Margin="0,0,6,0" Foreground="{DynamicResource Hp.Brush.AccentText}" Data="{StaticResource Hp.Icon.Lock}" />
                                                    <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextSecondary}" Text="{x:Static res:ShellStrings.ArtworkAlwaysOn}" />
                                                </StackPanel>
                                            </Border>
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="11" Margin="0,0,12,0" VerticalAlignment="Top" Background="{DynamicResource Hp.Brush.Surface2}">
                                                <views:LineIcon Width="17" Height="17" Foreground="{DynamicResource Hp.Brush.AccentText}" Data="{StaticResource Hp.Icon.Disk}" />
                                            </Border>
                                            <StackPanel>
                                                <WrapPanel>
                                                    <TextBlock FontSize="13.5" FontWeight="Bold" Text="{x:Static res:ShellStrings.ArtworkLocalTitle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource Hp.Shell.TagShine}">
                                                        <TextBlock Style="{StaticResource Hp.Shell.TagText}" Foreground="{DynamicResource Hp.Brush.Text}" Text="{Binding Source={x:Static res:ShellStrings.ArtworkLocalTag}, Converter={StaticResource Hp.Shell.Upper}}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,3,0,0" Text="{x:Static res:ShellStrings.ArtworkLocalHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Grid x:Name="CoverageTable" Margin="0,10,0,0" AutomationProperties.AutomationId="ArtworkCoverageTable" AutomationProperties.Name="{x:Static res:ShellStrings.CoverageTableName}">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid Margin="0,0,0,4">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="1.35*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Style="{StaticResource Hp.Shell.Overline}" Text="{Binding Source={x:Static res:ShellStrings.CoverageLauncher}, Converter={StaticResource Hp.Shell.Upper}}" />
                                                <TextBlock Grid.Column="1" Style="{StaticResource Hp.Shell.Overline}" Text="{Binding Source={x:Static res:ShellStrings.CoverageHero}, Converter={StaticResource Hp.Shell.Upper}}" />
                                                <TextBlock Grid.Column="2" Style="{StaticResource Hp.Shell.Overline}" Text="{Binding Source={x:Static res:ShellStrings.CoverageLogo}, Converter={StaticResource Hp.Shell.Upper}}" />
                                                <TextBlock Grid.Column="3" Style="{StaticResource Hp.Shell.Overline}" Text="{Binding Source={x:Static res:ShellStrings.CoverageCover}, Converter={StaticResource Hp.Shell.Upper}}" />
                                                <TextBlock Grid.Column="4" Style="{StaticResource Hp.Shell.Overline}" Text="{Binding Source={x:Static res:ShellStrings.CoverageIcon}, Converter={StaticResource Hp.Shell.Upper}}" />
                                            </Grid>
                                            <ItemsControl Grid.Row="1" ItemsSource="{Binding Coverage}" Focusable="False">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:CoverageRowItem}">
                                                        <Border BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="0,1,0,0" Padding="0,7">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="1.35*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                    <ColumnDefinition Width="*" />
                                                                </Grid.ColumnDefinitions>
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Rectangle Width="7" Height="7" Margin="0,0,8,0" VerticalAlignment="Center" Fill="{Binding SourceBrushKey, Converter={StaticResource Hp.Shell.ResourceBrush}}" />
                                                                    <TextBlock FontSize="12" FontWeight="SemiBold" Text="{Binding Source}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                                </StackPanel>
                                                                <ContentControl Grid.Column="1" Content="{Binding Hero}" ContentTemplate="{DynamicResource CoverageCell}" Focusable="False" />
                                                                <ContentControl Grid.Column="2" Content="{Binding Logo}" ContentTemplate="{DynamicResource CoverageCell}" Focusable="False" />
                                                                <ContentControl Grid.Column="3" Content="{Binding Cover}" ContentTemplate="{DynamicResource CoverageCell}" Focusable="False" />
                                                                <ContentControl Grid.Column="4" Content="{Binding Icon}" ContentTemplate="{DynamicResource CoverageCell}" Focusable="False" />
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,6,0,0" Text="{Binding CoverageStatus}"
                                                   Visibility="{Binding CoverageStatus, Converter={StaticResource Hp.Shell.NullToVisibility}}" />
                                        <DockPanel Margin="0,8,0,0">
                                            <views:LineIcon Width="13" Height="13" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Hp.Brush.TextMuted}" Data="{StaticResource Hp.Icon.Info}" />
                                            <TextBlock Style="{StaticResource Hp.Shell.Note}" Text="{x:Static res:ShellStrings.CoverageLegend}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Erzeugte Bilder -->
                                <Border Style="{StaticResource Hp.Shell.SubCard}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="11" Margin="0,0,12,0" VerticalAlignment="Top" Background="{DynamicResource Hp.Brush.Surface2}">
                                                <views:LineIcon Width="17" Height="17" Foreground="{DynamicResource Hp.Brush.AccentText}" Data="{StaticResource Hp.Icon.Generate}" />
                                            </Border>
                                            <StackPanel>
                                                <TextBlock FontSize="13.5" FontWeight="Bold" Text="{x:Static res:ShellStrings.ArtworkGeneratedTitle}" />
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,3,0,0" Text="{x:Static res:ShellStrings.ArtworkGeneratedHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding FallbackExamples}" Focusable="False"
                                                      AutomationProperties.AutomationId="FallbackExamples" AutomationProperties.Name="{x:Static res:ShellStrings.ArtworkGeneratedTitle}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <views:AdaptiveGrid Columns="4,2" MinItemWidth="190" Gap="10" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:FallbackExampleItem}">
                                                    <Border CornerRadius="14" Background="{DynamicResource Hp.Brush.Surface1}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="1"
                                                            AutomationProperties.Name="{Binding AutomationName}" ToolTip="{Binding AutomationName}">
                                                        <StackPanel>
                                                            <Grid Height="124" views:RoundedClip.Radius="13" Background="#FF07080C">
                                                                <Border x:Name="Field" Background="{Binding Field}" Visibility="Collapsed" />
                                                                <Image x:Name="Wide" Source="{Binding Image}" Stretch="UniformToFill" />
                                                                <Rectangle x:Name="NameShade" Visibility="Collapsed">
                                                                    <Rectangle.Fill>
                                                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                                                            <GradientStop Color="#CC05060A" Offset="0" />
                                                                            <GradientStop Color="#0005060A" Offset="0.75" />
                                                                        </LinearGradientBrush>
                                                                    </Rectangle.Fill>
                                                                </Rectangle>
                                                                <TextBlock x:Name="NameText" Visibility="Collapsed" Margin="10,0,30,10" VerticalAlignment="Bottom" FontFamily="{DynamicResource Hp.Font.Display}"
                                                                           FontSize="14" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.TextOnArt}" TextTrimming="CharacterEllipsis" Text="{Binding GameName}" />
                                                                <Grid x:Name="Covers" Visibility="Collapsed" Margin="0,6">
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="*" />
                                                                        <ColumnDefinition Width="Auto" />
                                                                        <ColumnDefinition Width="*" />
                                                                    </Grid.ColumnDefinitions>
                                                                    <Image x:Name="OriginalCover" Source="{Binding Original}" Stretch="Uniform" HorizontalAlignment="Right" Opacity="0.85" Visibility="Collapsed" />
                                                                    <Grid x:Name="Arrow" Grid.Column="1" Width="22" Height="22" Margin="10,0" Visibility="Collapsed">
                                                                        <Ellipse Fill="{DynamicResource Hp.Brush.Accent}" />
                                                                        <views:LineIcon Width="13" Height="13" StrokeThickness="2.4" Foreground="{DynamicResource Hp.Brush.TextOnAccent}" Data="{StaticResource Hp.Icon.Arrow}" />
                                                                    </Grid>
                                                                    <Image x:Name="GeneratedCover" Grid.Column="0" Grid.ColumnSpan="3" Source="{Binding Image}" Stretch="Uniform" HorizontalAlignment="Center" />
                                                                </Grid>
                                                            </Grid>
                                                            <TextBlock Margin="10,8,10,0" FontSize="12" FontWeight="Bold" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="10,2,10,10" Style="{StaticResource Hp.Text.Caption}" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" Text="{Binding Caption}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding ShowsName}" Value="True">
                                                            <Setter TargetName="NameShade" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="NameText" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsCover}" Value="True">
                                                            <Setter TargetName="Wide" Property="Visibility" Value="Collapsed" />
                                                            <Setter TargetName="Field" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="Covers" Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding HasOriginal}" Value="True">
                                                            <Setter TargetName="OriginalCover" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                                                            <Setter TargetName="GeneratedCover" Property="Grid.Column" Value="2" />
                                                            <Setter TargetName="GeneratedCover" Property="Grid.ColumnSpan" Value="1" />
                                                            <Setter TargetName="GeneratedCover" Property="HorizontalAlignment" Value="Left" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,8,0,0" Text="{Binding FallbackStatus}"
                                                   Visibility="{Binding FallbackStatus, Converter={StaticResource Hp.Shell.NullToVisibility}}" />
                                    </StackPanel>
                                </Border>

                                <!-- SteamGridDB (online, optional) -->
                                <Border Style="{StaticResource Hp.Shell.SubCard}" Margin="0,10,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="12,0,0,0" Style="{StaticResource Hp.ToggleSwitch}"
                                                      AutomationProperties.AutomationId="SteamGridDbToggle" AutomationProperties.Name="{x:Static res:ShellStrings.SteamGridDbToggleName}"
                                                      IsChecked="{Binding SteamGridDbEnabled, Mode=TwoWay}" />
                                            <Border DockPanel.Dock="Left" Width="36" Height="36" CornerRadius="11" Margin="0,0,12,0" VerticalAlignment="Top" Background="{DynamicResource Hp.Brush.Surface2}">
                                                <views:LineIcon Width="17" Height="17" Foreground="{DynamicResource Hp.Brush.AccentText}" Data="{StaticResource Hp.Icon.Cloud}" />
                                            </Border>
                                            <StackPanel>
                                                <WrapPanel>
                                                    <TextBlock FontSize="13.5" FontWeight="Bold" Text="{x:Static res:ShellStrings.SteamGridDbTitle}" Margin="0,0,8,0" VerticalAlignment="Center" />
                                                    <Border Style="{StaticResource Hp.Shell.Tag}">
                                                        <TextBlock Style="{StaticResource Hp.Shell.TagText}" Text="{Binding Source={x:Static res:ShellStrings.SteamGridDbTag}, Converter={StaticResource Hp.Shell.Upper}}" />
                                                    </Border>
                                                </WrapPanel>
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,3,0,0" Text="{Binding SteamGridDbHint}" />
                                            </StackPanel>
                                        </DockPanel>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid x:Name="KeyField" IsEnabled="{Binding SteamGridDbEnabled}">
                                                <PasswordBox x:Name="SteamGridDbKey" Style="{StaticResource Hp.Shell.PasswordBox}" Padding="34,9,10,9" FontFamily="{DynamicResource Hp.Font.Mono}"
                                                             AutomationProperties.AutomationId="SteamGridDbKey" AutomationProperties.Name="{x:Static res:ShellStrings.SteamGridDbKeyName}"
                                                             PasswordChanged="OnSteamGridDbKeyChanged" />
                                                <views:LineIcon Width="15" Height="15" Margin="12,0,0,0" HorizontalAlignment="Left" IsHitTestVisible="False" Foreground="{DynamicResource Hp.Brush.TextMuted}" Data="{StaticResource Hp.Icon.Key}" />
                                                <TextBlock x:Name="KeyPlaceholder" Margin="35,0,10,0" VerticalAlignment="Center" IsHitTestVisible="False" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="12.5"
                                                           Foreground="{DynamicResource Hp.Brush.TextMuted}" TextTrimming="CharacterEllipsis" Text="{x:Static res:ShellStrings.SteamGridDbKeyPlaceholder}" />
                                            </Grid>
                                            <Button Grid.Column="1" Style="{StaticResource Hp.GhostButton}" Margin="8,0,0,0" IsEnabled="{Binding SteamGridDbEnabled}"
                                                    AutomationProperties.AutomationId="SteamGridDbCheckButton" AutomationProperties.Name="{x:Static res:ShellStrings.SteamGridDbCheckName}"
                                                    Content="{x:Static res:ShellStrings.SteamGridDbCheck}" Command="{Binding CheckSteamGridDbCommand}" />
                                        </Grid>
                                        <TextBlock Margin="2,8,0,0" FontSize="12" AutomationProperties.AutomationId="SteamGridDbStatus"
                                                   AutomationProperties.Name="{x:Static res:ShellStrings.SteamGridDbStatusName}" Text="{Binding SteamGridDbStatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hp.Text.Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding SteamGridDbStatusIsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <DockPanel Margin="0,8,0,0">
                                            <views:LineIcon Width="13" Height="13" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Hp.Brush.TextMuted}" Data="{StaticResource Hp.Icon.Info}" />
                                            <TextBlock Style="{StaticResource Hp.Shell.Note}" Text="{x:Static res:ShellStrings.SteamGridDbKeyNote}" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                                <DockPanel Margin="2,10,0,0">
                                    <views:LineIcon Width="13" Height="13" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Hp.Brush.TextMuted}" Data="{StaticResource Hp.Icon.Image}" />
                                    <TextBlock Style="{StaticResource Hp.Shell.Note}" Text="{x:Static res:ShellStrings.ArtworkPerGameHint}" />
                                </DockPanel>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!-- ===== Symbole und Tray ===== -->
                        <HeaderedContentControl x:Name="SectionTray" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionTray}"
                                                AutomationProperties.AutomationId="SectionTray" AutomationProperties.Name="{x:Static res:ShellStrings.SectionTray}"
                                                views:SettingsSection.Description="{x:Static res:ShellStrings.SectionTrayHint}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Tray}">
                            <HeaderedContentControl.Tag>
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Style="{StaticResource Hp.Shell.Overline}" Margin="0,0,10,0" Text="{Binding Source={x:Static res:ShellStrings.TaskbarCaption}, Converter={StaticResource Hp.Shell.Upper}}" />
                                    <Border Style="{StaticResource Hp.Shell.SegmentHost}" AutomationProperties.Name="{x:Static res:ShellStrings.TaskbarName}">
                                        <StackPanel Orientation="Horizontal">
                                            <RadioButton Style="{StaticResource Hp.Shell.SegmentSmall}" GroupName="Taskbar" Content="{x:Static res:ShellStrings.TaskbarLight}"
                                                         AutomationProperties.AutomationId="TaskbarPreviewLight" IsChecked="{Binding TaskbarLight, Mode=TwoWay}" />
                                            <RadioButton Style="{StaticResource Hp.Shell.SegmentSmall}" GroupName="Taskbar" Content="{x:Static res:ShellStrings.TaskbarDark}"
                                                         AutomationProperties.AutomationId="TaskbarPreviewDark" IsChecked="{Binding TaskbarDark, Mode=TwoWay}" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </HeaderedContentControl.Tag>
                            <StackPanel>
                                <Border x:Name="TrayScene" CornerRadius="16" Padding="12,12,12,0" views:RoundedClip.Radius="16"
                                        AutomationProperties.AutomationId="TrayPreview" AutomationProperties.Name="{x:Static res:ShellStrings.TrayPreviewName}">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background">
                                                <Setter.Value>
                                                    <RadialGradientBrush Center="0.2,0" GradientOrigin="0.2,0" RadiusX="1.2" RadiusY="0.9">
                                                        <GradientStop Color="#FF2E2B38" Offset="0" />
                                                        <GradientStop Color="#FF14151C" Offset="1" />
                                                    </RadialGradientBrush>
                                                </Setter.Value>
                                            </Setter>
                                            <Setter Property="TextElement.Foreground" Value="White" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding TaskbarLight}" Value="True">
                                                    <Setter Property="Background">
                                                        <Setter.Value>
                                                            <RadialGradientBrush Center="0.2,0" GradientOrigin="0.2,0" RadiusX="1.2" RadiusY="0.9">
                                                                <GradientStop Color="#FFE6E3EE" Offset="0" />
                                                                <GradientStop Color="#FFCFD5E2" Offset="1" />
                                                            </RadialGradientBrush>
                                                        </Setter.Value>
                                                    </Setter>
                                                    <Setter Property="TextElement.Foreground" Value="#FF12131A" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <StackPanel>
                                        <views:AdaptiveGrid Columns="2,1" MinItemWidth="252" Gap="12">
                                            <StackPanel>
                                                <ItemsControl ItemsSource="{Binding TrayStates}" Focusable="False">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <views:AdaptiveGrid Columns="4,2" MinItemWidth="62" Gap="8" />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type vm:TrayStateItem}">
                                                            <Grid AutomationProperties.AutomationId="{Binding AutomationId}" AutomationProperties.Name="{Binding Label}">
                                                                <Border x:Name="Tile" CornerRadius="14" Background="#12FFFFFF" BorderBrush="#1AFFFFFF" BorderThickness="1" />
                                                                <StackPanel Margin="4,12,4,10">
                                                                    <Image Width="46" Height="46" Source="{Binding Icon}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                                    <TextBlock Margin="0,8,0,0" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="11.5" FontWeight="Bold" Text="{Binding Label}" />
                                                                    <TextBlock HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap" FontSize="10.5" Opacity="0.62" Text="{Binding Hint}" />
                                                                </StackPanel>
                                                                <Border x:Name="Current" CornerRadius="14" BorderThickness="2" BorderBrush="{DynamicResource Hp.Brush.SelectionRing}" Visibility="Collapsed" />
                                                            </Grid>
                                                            <DataTemplate.Triggers>
                                                                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                                    <Setter TargetName="Current" Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding DataContext.TaskbarLight, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                                                                    <Setter TargetName="Tile" Property="Background" Value="#99FFFFFF" />
                                                                    <Setter TargetName="Tile" Property="BorderBrush" Value="#14000000" />
                                                                </DataTrigger>
                                                            </DataTemplate.Triggers>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                <Border Margin="0,10,0,0" Padding="12,10" CornerRadius="14" Background="#40000000">
                                                    <StackPanel>
                                                        <TextBlock FontSize="10.5" FontWeight="Bold" Opacity="0.65" Text="{Binding Source={x:Static res:ShellStrings.TrayRealSize}, Converter={StaticResource Hp.Shell.Upper}}" />
                                                        <ItemsControl Margin="0,10,0,0" ItemsSource="{Binding TraySizes}" Focusable="False">
                                                            <ItemsControl.ItemsPanel>
                                                                <ItemsPanelTemplate>
                                                                    <WrapPanel />
                                                                </ItemsPanelTemplate>
                                                            </ItemsControl.ItemsPanel>
                                                            <ItemsControl.ItemTemplate>
                                                                <DataTemplate DataType="{x:Type vm:TraySizeItem}">
                                                                    <StackPanel Margin="0,0,16,4">
                                                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Height="32">
                                                                            <Image Width="{Binding Size}" Height="{Binding Size}" Source="{Binding Off}" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="NearestNeighbor" Margin="0,0,6,0" />
                                                                            <Image Width="{Binding Size}" Height="{Binding Size}" Source="{Binding On}" VerticalAlignment="Bottom" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                                        </StackPanel>
                                                                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontFamily="{DynamicResource Hp.Font.Mono}" FontSize="10" Opacity="0.9" Text="{Binding Label}" />
                                                                    </StackPanel>
                                                                </DataTemplate>
                                                            </ItemsControl.ItemTemplate>
                                                        </ItemsControl>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>

                                            <!-- Tray-Menü als Vorschau (nicht bedienbar) -->
                                            <Border x:Name="TrayMenuPreview" Padding="6" CornerRadius="12" VerticalAlignment="Top" IsHitTestVisible="False"
                                                    AutomationProperties.AutomationId="TrayMenuPreview" AutomationProperties.Name="{x:Static res:ShellStrings.TrayMenuPreviewName}">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#F7202128" />
                                                        <Setter Property="BorderBrush" Value="#1AFFFFFF" />
                                                        <Setter Property="BorderThickness" Value="1" />
                                                        <Setter Property="TextElement.Foreground" Value="#FFF2F3F7" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding TaskbarLight}" Value="True">
                                                                <Setter Property="Background" Value="#FAF9F9FB" />
                                                                <Setter Property="BorderBrush" Value="#14000000" />
                                                                <Setter Property="TextElement.Foreground" Value="#FF1A1B22" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <StackPanel TextElement.FontSize="12.5">
                                                    <DockPanel Margin="8,8,8,6">
                                                        <Grid Width="30" Height="30" Margin="0,0,10,0">
                                                            <Border CornerRadius="9" Background="#9E0A0B11" />
                                                            <views:LineIcon Width="18" Height="18" StrokeThickness="0" Fill="{DynamicResource Hp.Brush.AccentText}" Data="{StaticResource Hp.Icon.LogoSun}" />
                                                            <views:LineIcon Width="18" Height="18" StrokeThickness="2" Foreground="{DynamicResource Hp.Brush.AccentText}" Data="{StaticResource Hp.Icon.Logo}" />
                                                        </Grid>
                                                        <StackPanel VerticalAlignment="Center">
                                                            <TextBlock FontSize="13" FontWeight="Bold" Text="{x:Static res:CommonStrings.AppName}" />
                                                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0" Opacity="0.75">
                                                                <Ellipse Width="6" Height="6" Margin="0,0,6,0" Fill="#FF8A8FA5" VerticalAlignment="Center" />
                                                                <TextBlock FontSize="11" Text="{Binding TrayMenuStatus}" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </DockPanel>
                                                    <TextBlock Margin="48,0,8,6" FontSize="10.5" Opacity="0.6" Text="{Binding TrayMenuNits}"
                                                               Visibility="{Binding HasTrayMenuNits, Converter={StaticResource Hp.Shell.BoolToVisibility}}" />
                                                    <Rectangle Height="1" Margin="6,4" Fill="#40808080" />
                                                    <Border Height="30" CornerRadius="6" Padding="10,0" Background="{DynamicResource Hp.Brush.AccentSoft}">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <views:LineIcon Width="15" Height="15" Margin="0,0,10,0" Data="{StaticResource Hp.Icon.Sun}" />
                                                            <TextBlock Text="{Binding TrayMenuToggleText}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Height="30" Padding="10,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <views:LineIcon Width="15" Height="15" Margin="0,0,10,0" Data="{StaticResource Hp.Icon.Pause}" />
                                                            <TextBlock Text="{x:Static res:ShellStrings.TrayMenuPause}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Height="30" Padding="10,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <views:LineIcon Width="15" Height="15" Margin="0,0,10,0" Data="{StaticResource Hp.Icon.Pulse}" />
                                                            <TextBlock Text="{Binding TrayMenuAutoHdrText}" TextTrimming="CharacterEllipsis" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Rectangle Height="1" Margin="6,4" Fill="#40808080" />
                                                    <Border Height="30" Padding="10,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <views:LineIcon Width="15" Height="15" Margin="0,0,10,0" Data="{StaticResource Hp.Icon.Library}" />
                                                            <TextBlock Text="{x:Static res:ShellStrings.TrayMenuOpen}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Height="30" Padding="10,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <views:LineIcon Width="15" Height="15" Margin="0,0,10,0" Data="{StaticResource Hp.Icon.Settings}" />
                                                            <TextBlock Text="{x:Static res:ShellStrings.TrayMenuSettings}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Border Height="30" Padding="10,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <views:LineIcon Width="15" Height="15" Margin="0,0,10,0" Data="{StaticResource Hp.Icon.Logs}" />
                                                            <TextBlock Text="{x:Static res:ShellStrings.TrayMenuLogs}" />
                                                        </StackPanel>
                                                    </Border>
                                                    <Rectangle Height="1" Margin="6,4" Fill="#40808080" />
                                                    <Border Height="30" Padding="10,0">
                                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                            <views:LineIcon Width="15" Height="15" Margin="0,0,10,0" Data="{StaticResource Hp.Icon.Power}" />
                                                            <TextBlock Text="{x:Static res:ShellStrings.TrayMenuExit}" />
                                                        </StackPanel>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                        </views:AdaptiveGrid>

                                        <!-- Taskleiste mit Fenster- und Tray-Symbol -->
                                        <Border x:Name="TaskbarStrip" Height="48" Margin="-12,12,-12,0" Padding="12,0" BorderThickness="0,1,0,0">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Background" Value="#E61C1D24" />
                                                    <Setter Property="BorderBrush" Value="#14FFFFFF" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding TaskbarLight}" Value="True">
                                                            <Setter Property="Background" Value="#F0F3F4F8" />
                                                            <Setter Property="BorderBrush" Value="#14000000" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Grid>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                                    <Grid Width="40" Height="40">
                                                        <Border Width="24" Height="24" CornerRadius="6">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#FF7AA7FF" Offset="0" />
                                                                    <GradientStop Color="#FF4F6BFF" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Width="40" Height="40" Margin="4,0">
                                                        <Border Width="24" Height="24" CornerRadius="6">
                                                            <Border.Background>
                                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                                    <GradientStop Color="#FFFFD36B" Offset="0" />
                                                                    <GradientStop Color="#FFF59E0B" Offset="1" />
                                                                </LinearGradientBrush>
                                                            </Border.Background>
                                                        </Border>
                                                    </Grid>
                                                    <Grid Width="40" Height="40" AutomationProperties.Name="{x:Static res:ShellStrings.WindowIconPreviewName}">
                                                        <Border CornerRadius="6" Background="#1AFFFFFF" />
                                                        <Image Width="24" Height="24" Source="{Binding WindowIconPreview}" RenderOptions.BitmapScalingMode="HighQuality" />
                                                        <Border Height="3" Width="10" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="0,0,0,2" Background="{DynamicResource Hp.Brush.FocusRing}" />
                                                    </Grid>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                                    <views:LineIcon Width="14" Height="14" Margin="0,0,10,0" Data="M6 15l6-6 6 6" />
                                                    <Grid Width="30" Height="36" AutomationProperties.Name="{x:Static res:ShellStrings.TrayIconPreviewName}">
                                                        <Border CornerRadius="5" Background="#1AFFFFFF" />
                                                        <Image Width="16" Height="16" Source="{Binding TrayIconPreview}" RenderOptions.BitmapScalingMode="NearestNeighbor" />
                                                    </Grid>
                                                    <views:LineIcon Width="15" Height="15" Margin="8,0,10,0" Data="M2 9a15 15 0 0 1 20 0M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M12 19.5h0.01" />
                                                    <StackPanel VerticalAlignment="Center">
                                                        <TextBlock x:Name="ClockTime" FontSize="11" HorizontalAlignment="Right" />
                                                        <TextBlock x:Name="ClockDate" FontSize="11" HorizontalAlignment="Right" />
                                                    </StackPanel>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                                <DockPanel Margin="2,10,0,0">
                                    <views:LineIcon Width="13" Height="13" Margin="0,2,8,0" VerticalAlignment="Top" Foreground="{DynamicResource Hp.Brush.TextMuted}" Data="{StaticResource Hp.Icon.Info}" />
                                    <TextBlock Style="{StaticResource Hp.Shell.Note}" Text="{x:Static res:ShellStrings.TrayPreviewNote}" />
                                </DockPanel>
                            </StackPanel>
                        </HeaderedContentControl>
                    </views:SettingsGridPanel>

                    <!-- ===== Gruppe: Erweitert ===== -->
                    <Grid x:Name="GroupAdvanced" Margin="0,48,0,20">
                        <StackPanel>
                            <TextBlock Style="{StaticResource Hp.Shell.Overline}" Text="{Binding Source={x:Static res:ShellStrings.SettingsHeading}, Converter={StaticResource Hp.Shell.Upper}}" />
                            <TextBlock Margin="0,6,0,0" Text="{x:Static res:ShellStrings.NavAdvanced}" FontFamily="{DynamicResource Hp.Font.Display}" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource Hp.Brush.Text}" />
                            <TextBlock Margin="0,6,0,0" Style="{StaticResource Hp.Text.Caption}" FontSize="13.5" Text="{x:Static res:ShellStrings.GroupAdvancedHint}" />
                        </StackPanel>
                    </Grid>
                    <views:SettingsGridPanel x:Name="AdvancedGrid">
                        <!-- Notlösung -->
                        <HeaderedContentControl x:Name="AdvancedSection" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionFallback}"
                                                views:SettingsSection.Description="{x:Static res:ShellStrings.SectionFallbackHint}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Bolt}">
                            <Border Style="{StaticResource Hp.Shell.SettingRow}" Margin="0">
                                <DockPanel>
                                    <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                              Style="{StaticResource Hp.ToggleSwitch}"
                                              AutomationProperties.AutomationId="HotkeyFallbackToggle"
                                              AutomationProperties.Name="{x:Static res:ShellStrings.HotkeyFallbackLabel}"
                                              AutomationProperties.HelpText="{x:Static res:ShellStrings.HotkeyFallbackHint}"
                                              IsChecked="{Binding HotkeyFallback, Mode=TwoWay}" />
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <views:LineIcon Width="15" Height="15" Margin="0,0,8,0" Foreground="{DynamicResource Hp.Brush.Warning}" Data="{StaticResource Hp.Icon.Bolt}" />
                                            <TextBlock Style="{StaticResource Hp.Shell.Label}" Text="{x:Static res:ShellStrings.HotkeyFallbackLabel}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,3,0,0" Text="{x:Static res:ShellStrings.HotkeyFallbackHint}" />
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                        </HeaderedContentControl>

                        <!-- Protokolle -->
                        <HeaderedContentControl x:Name="LogsSection" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionLogs}"
                                                views:SettingsSection.Description="{x:Static res:ShellStrings.SectionLogsHint}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Logs}">
                            <StackPanel>
                                <Border Style="{StaticResource Hp.Shell.SettingRow}">
                                    <DockPanel>
                                        <ComboBox DockPanel.Dock="Right" Width="196" Margin="16,0,0,0" VerticalAlignment="Center"
                                                  Style="{StaticResource Hp.Shell.ComboBox}"
                                                  AutomationProperties.AutomationId="LogLevel"
                                                  AutomationProperties.Name="{x:Static res:ShellStrings.LogLevelLabel}"
                                                  AutomationProperties.HelpText="{x:Static res:ShellStrings.LogLevelHint}"
                                                  ItemsSource="{Binding LogLevels}"
                                                  DisplayMemberPath="Label"
                                                  SelectedValuePath="Value"
                                                  SelectedValue="{Binding LogLevel, Mode=TwoWay}" />
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Style="{StaticResource Hp.Shell.Label}" Text="{x:Static res:ShellStrings.LogLevelLabel}" />
                                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,3,0,0" Text="{x:Static res:ShellStrings.LogLevelHint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <Button Style="{StaticResource Hp.GhostButton}" HorizontalAlignment="Left"
                                        AutomationProperties.AutomationId="OpenLogFolderButton"
                                        AutomationProperties.Name="{x:Static res:ShellStrings.OpenLogFolder}"
                                        Command="{Binding OpenLogFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <views:LineIcon Style="{StaticResource Hp.Shell.ButtonIcon}" Data="{StaticResource Hp.Icon.Folder}" />
                                        <TextBlock Text="{x:Static res:ShellStrings.OpenLogFolder}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </HeaderedContentControl>

                        <!--
                            HDR-Liste (PCGamingWiki): oben Abgleich und Stand, darunter das optionale Konto. Die Knöpfe hier wirken
                            sofort; „Bei jedem Start abgleichen“ wird mit „Speichern“ übernommen.
                        -->
                        <HeaderedContentControl x:Name="HdrListSection" Style="{StaticResource Hp.Shell.Section}" Header="{x:Static res:ShellStrings.SectionHdrList}"
                                                views:SettingsSection.Description="{x:Static res:ShellStrings.SectionHdrListHint}" views:SettingsSection.Icon="{StaticResource Hp.Icon.Pulse}"
                                                DataContext="{Binding HdrList}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,0,0,12" Text="{x:Static res:ShellStrings.HdrListHint}" />
                                <Border Style="{StaticResource Hp.Shell.SettingRow}">
                                    <DockPanel>
                                        <CheckBox DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"
                                                  Style="{StaticResource Hp.ToggleSwitch}"
                                                  AutomationProperties.AutomationId="HdrListSyncToggle"
                                                  AutomationProperties.Name="{x:Static res:ShellStrings.HdrListSyncLabel}"
                                                  AutomationProperties.HelpText="{x:Static res:ShellStrings.HdrListSyncHint}"
                                                  IsChecked="{Binding DataContext.HdrListSync, ElementName=Root, Mode=TwoWay}" />
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource Hp.Shell.Label}" Text="{x:Static res:ShellStrings.HdrListSyncLabel}" />
                                            <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,3,0,0" Text="{x:Static res:ShellStrings.HdrListSyncHint}" />
                                        </StackPanel>
                                    </DockPanel>
                                </Border>
                                <DockPanel Margin="0,2,0,0">
                                    <Button DockPanel.Dock="Right" Style="{StaticResource Hp.GhostButton}" Margin="12,0,0,0" VerticalAlignment="Top"
                                            AutomationProperties.AutomationId="HdrListSyncNowButton"
                                            AutomationProperties.Name="{x:Static res:ShellStrings.HdrListSyncNow}"
                                            Command="{Binding SyncNowCommand}">
                                        <StackPanel Orientation="Horizontal">
                                            <views:LineIcon Style="{StaticResource Hp.Shell.ButtonIcon}" Data="M20 11a8 8 0 1 0-2.3 5.7M20 4v7h-7" />
                                            <TextBlock Text="{x:Static res:ShellStrings.HdrListSyncNow}" />
                                        </StackPanel>
                                    </Button>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock AutomationProperties.AutomationId="HdrListStatus"
                                                   AutomationProperties.Name="{x:Static res:ShellStrings.HdrListStatusName}"
                                                   Text="{Binding StatusText}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hp.Text.Body}">
                                                    <Setter Property="FontSize" Value="13" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasStatusError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Warning}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,3,0,0" Text="{Binding ModeText}" />
                                    </StackPanel>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,16,0,2" Text="{x:Static res:ShellStrings.PcgwAttribution}" />
                                <WrapPanel>
                                    <Button Style="{StaticResource Hp.Shell.LinkButton}" Margin="0,0,14,0"
                                            AutomationProperties.AutomationId="PcgwSiteLink"
                                            AutomationProperties.Name="{x:Static res:ShellStrings.PcgwSiteLink}"
                                            ToolTip="{x:Static vm:HdrListViewModel.SiteUrl}"
                                            Command="{Binding OpenSiteCommand}" Content="{x:Static res:ShellStrings.PcgwSiteLink}" />
                                    <Button Style="{StaticResource Hp.Shell.LinkButton}"
                                            AutomationProperties.AutomationId="PcgwLicenseLink"
                                            AutomationProperties.Name="{x:Static res:ShellStrings.PcgwLicenseLink}"
                                            ToolTip="{x:Static vm:HdrListViewModel.LicenseUrl}"
                                            Command="{Binding OpenLicenseCommand}" Content="{x:Static res:ShellStrings.PcgwLicenseLink}" />
                                </WrapPanel>

                                <!-- Optionales Konto: vollständige Liste, keine Spielnamen gesendet -->
                                <Border Style="{StaticResource Hp.Shell.SubCard}" Margin="0,14,0,0" Padding="16,14">
                                    <StackPanel>
                                        <StackPanel Orientation="Horizontal">
                                            <views:LineIcon Width="15" Height="15" Margin="0,0,8,0" Foreground="{DynamicResource Hp.Brush.AccentText}" Data="{StaticResource Hp.Icon.Key}" />
                                            <TextBlock Style="{StaticResource Hp.Shell.Label}" Text="{x:Static res:ShellStrings.PcgwAccountTitle}" />
                                        </StackPanel>
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,6,0,0" Text="{x:Static res:ShellStrings.PcgwAccountHint}" />
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,8,0,0" Text="{x:Static res:ShellStrings.PcgwStep1}" />
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,3,0,0" Text="{x:Static res:ShellStrings.PcgwStep2}" />
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="0,3,0,0" Text="{x:Static res:ShellStrings.PcgwStep3}" />
                                        <WrapPanel Margin="0,6,0,0">
                                            <Button Style="{StaticResource Hp.Shell.LinkButton}" Margin="0,0,14,0"
                                                    AutomationProperties.AutomationId="PcgwCreateAccountLink"
                                                    AutomationProperties.Name="{x:Static res:ShellStrings.PcgwCreateAccount}"
                                                    ToolTip="{x:Static vm:HdrListViewModel.CreateAccountUrl}"
                                                    Command="{Binding OpenCreateAccountCommand}" Content="{x:Static res:ShellStrings.PcgwCreateAccount}" />
                                            <Button Style="{StaticResource Hp.Shell.LinkButton}"
                                                    AutomationProperties.AutomationId="PcgwBotPasswordsLink"
                                                    AutomationProperties.Name="{x:Static res:ShellStrings.PcgwBotPasswords}"
                                                    ToolTip="{x:Static vm:HdrListViewModel.BotPasswordsUrl}"
                                                    Command="{Binding OpenBotPasswordsCommand}" Content="{x:Static res:ShellStrings.PcgwBotPasswords}" />
                                        </WrapPanel>
                                        <Grid Margin="0,12,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="12" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="2,0,0,4" Text="{x:Static res:ShellStrings.PcgwUserNameLabel}" />
                                                <TextBox Style="{StaticResource Hp.Shell.TextBox}"
                                                         AutomationProperties.AutomationId="PcgwUserName"
                                                         AutomationProperties.Name="{x:Static res:ShellStrings.PcgwUserNameLabel}"
                                                         SpellCheck.IsEnabled="False"
                                                         Text="{Binding UserName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="2,0,0,4" Text="{x:Static res:ShellStrings.PcgwPasswordLabel}" />
                                                <PasswordBox x:Name="PcgwPassword" Style="{StaticResource Hp.Shell.PasswordBox}"
                                                             AutomationProperties.AutomationId="PcgwBotPassword"
                                                             AutomationProperties.Name="{x:Static res:ShellStrings.PcgwPasswordLabel}"
                                                             PasswordChanged="OnPcgwPasswordChanged" />
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="2,6,0,0"
                                                   AutomationProperties.AutomationId="PcgwAccountStored"
                                                   Text="{Binding AccountUserText}"
                                                   Visibility="{Binding HasAccount, Converter={StaticResource Hp.Shell.BoolToVisibility}}" />
                                        <TextBlock Style="{StaticResource Hp.Text.Caption}" Margin="2,2,0,0" Foreground="{DynamicResource Hp.Brush.TextMuted}"
                                                   Text="{x:Static res:ShellStrings.PcgwPasswordStoredHint}"
                                                   Visibility="{Binding HasAccount, Converter={StaticResource Hp.Shell.BoolToVisibility}}" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button Style="{StaticResource Hp.GhostButton}" Margin="0,0,8,0"
                                                    AutomationProperties.AutomationId="PcgwSaveAccountButton"
                                                    AutomationProperties.Name="{x:Static res:ShellStrings.PcgwSaveAccount}"
                                                    Command="{Binding SaveAccountCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <views:LineIcon Style="{StaticResource Hp.Shell.ButtonIcon}" Data="{StaticResource Hp.Icon.Check}" />
                                                    <TextBlock Text="{x:Static res:ShellStrings.PcgwSaveAccount}" />
                                                </StackPanel>
                                            </Button>
                                            <Button Style="{StaticResource Hp.GhostButton}"
                                                    AutomationProperties.AutomationId="PcgwRemoveAccountButton"
                                                    AutomationProperties.Name="{x:Static res:ShellStrings.PcgwRemoveAccount}"
                                                    Command="{Binding RemoveAccountCommand}">
                                                <StackPanel Orientation="Horizontal">
                                                    <views:LineIcon Style="{StaticResource Hp.Shell.ButtonIcon}" Data="{StaticResource Hp.Icon.Minus}" />
                                                    <TextBlock Text="{x:Static res:ShellStrings.PcgwRemoveAccount}" />
                                                </StackPanel>
                                            </Button>
                                        </WrapPanel>
                                        <TextBlock Margin="2,10,0,0" FontSize="12.5"
                                                   AutomationProperties.AutomationId="PcgwAccountMessage"
                                                   Text="{Binding AccountMessage}"
                                                   Visibility="{Binding HasAccountMessage, Converter={StaticResource Hp.Shell.BoolToVisibility}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource Hp.Text.Caption}">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding AccountMessageIsError}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Hp.Brush.Danger}" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </HeaderedContentControl>
                    </views:SettingsGridPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- Fuß: Status links, Abbrechen/Speichern rechts (gilt für Allgemein und Erweitert; Darstellung wirkt sofort) -->
            <Border x:Name="Footer" Grid.Row="1" Background="{DynamicResource Hp.Brush.Glass}" BorderBrush="{DynamicResource Hp.Brush.Line}" BorderThickness="0,1,0,0" Padding="32,12,32,14">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource Hp.GhostButton}" MinWidth="120"
                                AutomationProperties.AutomationId="CancelSettingsButton"
                                AutomationProperties.Name="{x:Static res:ShellStrings.CancelSettings}"
                                Command="{Binding CancelCommand}"
                                Content="{x:Static res:ShellStrings.CancelSettings}" />
                        <Button Style="{StaticResource Hp.AccentButton}" MinWidth="150" Margin="12,0,0,0"
                                AutomationProperties.AutomationId="SaveSettingsButton"
                                AutomationProperties.Name="{x:Static res:ShellStrings.SaveSettings}"
                                Command="{Binding SaveCommand}">
                            <StackPanel Orientation="Horizontal">
                                <views:LineIcon Width="15" Height="15" Margin="0,0,8,0" StrokeThickness="2.4" Data="{StaticResource Hp.Icon.Check}" />
                                <TextBlock Text="{x:Static res:ShellStrings.SaveSettings}" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Visibility="{Binding HasError, Converter={StaticResource Hp.Shell.InverseBoolToVisibility}}">
                            <Ellipse x:Name="StatusDot" Width="8" Height="8" Margin="0,0,10,0">
                                <Ellipse.Style>
                                    <Style TargetType="Ellipse">
                                        <Setter Property="Fill" Value="{DynamicResource Hp.Brush.Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding HasChanges}" Value="True">
                                                <Setter Property="Fill" Value="{DynamicResource Hp.Brush.Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Ellipse.Style>
                            </Ellipse>
                            <TextBlock Style="{StaticResource Hp.Text.Caption}" FontSize="13" VerticalAlignment="Center" Text="{Binding ChangeStatus}" />
                        </StackPanel>
                        <DockPanel Visibility="{Binding HasError, Converter={StaticResource Hp.Shell.BoolToVisibility}}">
                            <TextBlock Style="{StaticResource Hp.Shell.Glyph}" Text="&#xE7BA;" FontSize="14" Margin="0,0,10,0" Foreground="{DynamicResource Hp.Brush.Danger}" />
                            <TextBlock Style="{StaticResource Hp.Text.Body}" FontSize="13" Foreground="{DynamicResource Hp.Brush.Danger}" VerticalAlignment="Center" Text="{Binding ErrorMessage}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </DockPanel>
                    </Grid>
                </DockPanel>
            </Border>

            <!-- Farbwähler für eigene Farben (über der Seite, schließt beim Klick daneben) -->
            <Popup x:Name="ColorPopup" DataContext="{Binding Appearance}" IsOpen="{Binding IsPickerOpen, Mode=TwoWay}" StaysOpen="False" AllowsTransparency="True"
                   Placement="Center" PlacementTarget="{Binding ElementName=Page}" PopupAnimation="Fade">
                <views:ColorPicker x:Name="Picker" Margin="12" Color="{Binding PickerColor, Mode=TwoWay}" />
            </Popup>
        </Grid>
    </Grid>
</infra:ChromeWindow>
