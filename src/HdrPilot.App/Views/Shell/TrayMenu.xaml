<ContextMenu x:Class="HdrPilot.App.Views.Shell.TrayMenu"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:infra="clr-namespace:HdrPilot.App.Infrastructure"
             xmlns:res="clr-namespace:HdrPilot.App.Resources"
             xmlns:views="clr-namespace:HdrPilot.App.Views.Shell"
             xmlns:vm="clr-namespace:HdrPilot.App.ViewModels.Shell"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance vm:TrayMenuViewModel}"
             Style="{StaticResource Hp.Shell.TrayMenu}"
             AutomationProperties.AutomationId="TrayMenu"
             AutomationProperties.Name="{x:Static res:ShellStrings.TrayMenuName}">
    <ContextMenu.Resources>
        <Style TargetType="MenuItem" BasedOn="{StaticResource Hp.Shell.TrayMenuItem}" />
        <Style x:Key="MenuIcon" TargetType="views:LineIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>
    </ContextMenu.Resources>

    <!-- Erste Zeile unter dem Kopf: Version (grau, nicht anklickbar, von den Pfeiltasten übersprungen) -->
    <MenuItem Style="{StaticResource Hp.Shell.TrayMenuInfo}"
              AutomationProperties.AutomationId="TrayVersion"
              AutomationProperties.Name="{Binding VersionText}"
              Header="{Binding VersionText}">
        <MenuItem.Icon>
            <views:LineIcon Style="{StaticResource MenuIcon}" Width="14" Height="14" Data="{StaticResource Hp.Icon.Info}" />
        </MenuItem.Icon>
    </MenuItem>
    <Separator Style="{StaticResource Hp.Shell.TrayMenuSeparator}" />
    <MenuItem Style="{StaticResource Hp.Shell.TrayMenuItem.Highlight}"
              AutomationProperties.AutomationId="TrayToggleHdr"
              AutomationProperties.Name="{Binding ToggleHdrText}"
              Header="{Binding ToggleHdrText}"
              Command="{Binding ToggleHdrCommand}">
        <MenuItem.Icon>
            <views:LineIcon Style="{StaticResource MenuIcon}" Data="{StaticResource Hp.Icon.Sun}" />
        </MenuItem.Icon>
    </MenuItem>
    <!-- Globaler Auto-HDR-Schalter von Windows (G9.9): beim Öffnen gelesen, gilt ab dem nächsten Spielstart; nicht lesbar: gesperrt.
         Symbol wie das Kennzeichen „AUTO HDR“ der Liste, sonst nirgends -->
    <MenuItem AutomationProperties.AutomationId="TrayAutoHdr"
              AutomationProperties.Name="{x:Static res:ShellStrings.TrayMenuAutoHdr}"
              AutomationProperties.HelpText="{Binding AutoHdrHint}"
              Header="{x:Static res:ShellStrings.TrayMenuAutoHdr}"
              ToolTip="{Binding AutoHdrHint}"
              ToolTipService.ShowOnDisabled="True"
              IsCheckable="True"
              IsEnabled="{Binding CanToggleAutoHdr}"
              IsChecked="{Binding IsAutoHdrOn, Mode=TwoWay}">
        <MenuItem.Icon>
            <TextBlock Style="{StaticResource Hp.Shell.Glyph}" FontSize="16" Text="{x:Static infra:AppGlyphs.AutoHdr}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem AutomationProperties.AutomationId="TrayPause"
              AutomationProperties.Name="{x:Static res:ShellStrings.TrayMenuPause}"
              Header="{x:Static res:ShellStrings.TrayMenuPause}"
              IsCheckable="True"
              IsChecked="{Binding IsPaused, Mode=TwoWay}">
        <MenuItem.Icon>
            <views:LineIcon Style="{StaticResource MenuIcon}" Data="{StaticResource Hp.Icon.Pause}" />
        </MenuItem.Icon>
    </MenuItem>
    <Separator Style="{StaticResource Hp.Shell.TrayMenuSeparator}" />
    <MenuItem AutomationProperties.AutomationId="TrayOpen"
              AutomationProperties.Name="{x:Static res:ShellStrings.TrayMenuOpen}"
              Header="{x:Static res:ShellStrings.TrayMenuOpen}"
              FontWeight="SemiBold"
              Command="{Binding OpenCommand}">
        <MenuItem.Icon>
            <views:LineIcon Style="{StaticResource MenuIcon}" Data="{StaticResource Hp.Icon.Library}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem AutomationProperties.AutomationId="TraySettings"
              AutomationProperties.Name="{x:Static res:ShellStrings.TrayMenuSettings}"
              Header="{x:Static res:ShellStrings.TrayMenuSettings}"
              Command="{Binding SettingsCommand}">
        <MenuItem.Icon>
            <views:LineIcon Style="{StaticResource MenuIcon}" Data="{StaticResource Hp.Icon.Settings}" />
        </MenuItem.Icon>
    </MenuItem>
    <MenuItem AutomationProperties.AutomationId="TrayLogs"
              AutomationProperties.Name="{x:Static res:ShellStrings.TrayMenuLogs}"
              Header="{x:Static res:ShellStrings.TrayMenuLogs}"
              Command="{Binding LogsCommand}">
        <MenuItem.Icon>
            <views:LineIcon Style="{StaticResource MenuIcon}" Data="{StaticResource Hp.Icon.Logs}" />
        </MenuItem.Icon>
    </MenuItem>
    <Separator Style="{StaticResource Hp.Shell.TrayMenuSeparator}" />
    <MenuItem AutomationProperties.AutomationId="TrayExit"
              AutomationProperties.Name="{x:Static res:ShellStrings.TrayMenuExit}"
              Header="{x:Static res:ShellStrings.TrayMenuExit}"
              Command="{Binding ExitCommand}">
        <MenuItem.Icon>
            <views:LineIcon Style="{StaticResource MenuIcon}" Data="{StaticResource Hp.Icon.Power}" />
        </MenuItem.Icon>
    </MenuItem>
</ContextMenu>
