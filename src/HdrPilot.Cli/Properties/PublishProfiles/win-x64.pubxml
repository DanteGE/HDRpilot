<?xml version="1.0" encoding="utf-8"?>
<!--
  Kommandozeile für Fehlersuche und Skripte: ebenfalls eine einzelne, eigenständige EXE (hdrpilot.exe).
  Aufruf: tools\publish.ps1 (oder dotnet publish src\HdrPilot.Cli -p:PublishProfile=win-x64).
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Kurzlebiges Werkzeug: komprimiert (rund halb so groß); die App selbst bleibt unkomprimiert (E60). -->
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <PublishDocumentationFile>false</PublishDocumentationFile>
  </PropertyGroup>
</Project>
