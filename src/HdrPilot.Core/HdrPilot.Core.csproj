<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>HdrPilot.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
  </ItemGroup>

  <!-- Texte, die der Nutzer sieht (Tray-Hinweise, Schaltergebnisse); neutral = Deutsch, Englisch in CoreStrings.en.resx (E95). -->
  <ItemGroup>
    <EmbeddedResource Update="Resources\CoreStrings.resx">
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>HdrPilot.Core.Resources</StronglyTypedNamespace>
      <StronglyTypedClassName>CoreStrings</StronglyTypedClassName>
      <StronglyTypedFileName>$(IntermediateOutputPath)CoreStrings.Designer.cs</StronglyTypedFileName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="HdrPilot.Tests" />
    <InternalsVisibleTo Include="hdrpilot" />
    <InternalsVisibleTo Include="HdrPilot" />
  </ItemGroup>

</Project>
