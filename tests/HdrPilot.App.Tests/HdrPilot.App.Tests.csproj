<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Tests der Oberfläche (ViewModels, Dienste der App). Eigenes Projekt, weil HdrPilot.Tests die Kommandozeile
    hdrpilot.dll referenziert und Windows hdrpilot.dll und HdrPilot.dll (App) nicht unterscheidet (E41).
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <RootNamespace>HdrPilot.App.Tests</RootNamespace>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
    <PackageReference Include="xunit.v3" Version="3.2.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.5" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\HdrPilot.Core\HdrPilot.Core.csproj" />
    <ProjectReference Include="..\..\src\HdrPilot.App\HdrPilot.App.csproj" />
  </ItemGroup>

  <!-- Gemeinsame Attrappen aus HdrPilot.Tests (verlinkt, nicht kopiert). -->
  <ItemGroup>
    <Compile Include="..\HdrPilot.Tests\TestSupport\FakeActivityProbe.cs" Link="TestSupport\FakeActivityProbe.cs" />
    <Compile Include="..\HdrPilot.Tests\TestSupport\FakeClock.cs" Link="TestSupport\FakeClock.cs" />
    <Compile Include="..\HdrPilot.Tests\TestSupport\FakeEnvironment.cs" Link="TestSupport\FakeEnvironment.cs" />
    <Compile Include="..\HdrPilot.Tests\TestSupport\FakeRegistry.cs" Link="TestSupport\FakeRegistry.cs" />
    <Compile Include="..\HdrPilot.Tests\TestSupport\InMemoryFileSystem.cs" Link="TestSupport\InMemoryFileSystem.cs" />
    <Compile Include="..\HdrPilot.Tests\TestSupport\ListLogger.cs" Link="TestSupport\ListLogger.cs" />
    <Compile Include="..\HdrPilot.Tests\TestSupport\SessionFakes.cs" Link="TestSupport\SessionFakes.cs" />
  </ItemGroup>

</Project>