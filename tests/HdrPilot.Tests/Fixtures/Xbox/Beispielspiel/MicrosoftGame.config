<?xml version="1.0" encoding="utf-8"?>
<!-- Erfundenes Spiel im echten Format: Name nur als ms-resource, mehrere EXEs, eine davon nur für die Konsole. -->
<Game configVersion="1">
  <Identity Name="Contoso.Beispielspiel" Publisher="CN=Contoso Spiele GmbH, O=Contoso Spiele GmbH, L=Berlin, C=DE" Version="2.3.104.0" />
  <ShellVisuals DefaultDisplayName="ms-resource:ApplicationDisplayName" PublisherDisplayName="ms-resource:PublisherDisplayName" StoreLogo="Assets\StoreLogo.png" Square150x150Logo="Assets\Logo.png" Square44x44Logo="Assets\SmallLogo.png" Description="ms-resource:ApplicationDescription" ForegroundText="light" BackgroundColor="#1A1A1A" SplashScreenImage="Assets\SplashScreen.png" />
  <Resources>
    <Resource Language="de-DE" />
    <Resource Language="en-US" />
  </Resources>
  <ExecutableList>
    <Executable Name="Beispiel/Binaries/WinGDK/Beispiel-WinGDK-Shipping.exe" Id="Game" TargetDeviceFamily="PC" />
    <Executable Name="Tools\BeispielBenchmark.exe" Id="Benchmark" OverrideDisplayName="ms-resource:BenchmarkDisplayName" />
    <Executable Name="Beispiel/Binaries/Scarlett/Beispiel-Scarlett-Shipping.exe" Id="Game" TargetDeviceFamily="Scarlett" />
  </ExecutableList>
  <TitleId>0a1b2c3d</TitleId>
  <StoreId>9ZZZZZZZZZZZ</StoreId>
  <RequiresXboxLive>false</RequiresXboxLive>
  <DesktopRegistration>
    <ProcessorArchitecture>x64</ProcessorArchitecture>
    <DependencyList>
      <KnownDependency Name="VC14" />
    </DependencyList>
  </DesktopRegistration>
</Game>
