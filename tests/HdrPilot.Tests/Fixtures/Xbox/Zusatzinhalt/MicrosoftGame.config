<?xml version="1.0" encoding="utf-8"?>
<!-- Zusatzinhalt (DLC) im Format der GDK-Dokumentation "Packaging downloadable content (DLC)": keine ExecutableList, dafür
     TargetDeviceFamilyForDLC, AllowedProducts und DesktopRegistration/MainPackageDependency. Erfundene Werte; am Zielrechner ist
     kein Zusatzinhalt installiert. -->
<Game configVersion="1">
  <Identity Name="Contoso.BeispielspielSoundtrack" Publisher="CN=Contoso Spiele GmbH, O=Contoso Spiele GmbH, L=Berlin, C=DE" Version="1.0.0.0" />
  <ShellVisuals DefaultDisplayName="Beispielspiel - Soundtrack" PublisherDisplayName="Contoso Spiele GmbH" StoreLogo="StoreLogo.png" Square150x150Logo="Logo.png" Square44x44Logo="SmallLogo.png" Description="Zusatzinhalt" BackgroundColor="#1A1A1A" SplashScreenImage="SplashScreen.png" />
  <StoreId>9YYYYYYYYYYY</StoreId>
  <TargetDeviceFamilyForDLC>PC</TargetDeviceFamilyForDLC>
  <AllowedProducts>
    <AllowedProduct>9ZZZZZZZZZZZ</AllowedProduct>
  </AllowedProducts>
  <DesktopRegistration>
    <MainPackageDependency Name="Contoso.Beispielspiel" />
    <ProcessorArchitecture>x64</ProcessorArchitecture>
  </DesktopRegistration>
</Game>
